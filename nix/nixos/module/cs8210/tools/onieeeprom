#!/usr/bin/env python3

# Self contained python module to handle ONIE EEPROM data
#
# https://opencomputeproject.github.io/onie/design-spec/hw_requirements.html#non-volatile-board-info
#

from struct import unpack, pack
import logging
import binascii
import sys
import tempfile

ID_STR = b'TlvInfo\0'
VERSION_1 = b'\x01'
T_CRC = 0xfe

class IDStrMismatch(Exception):
    def __init__(self, found):
        self.found = found

class UnsupportedTlvVersion(Exception):
    def __init__(self, v):
        self.version = v

class InvalidEepromLength(Exception):
    def __init__(self, elen):
        self.elen = elen

class UnexpectedCrcType(Exception):
    def __init__(self, t):
        self.t
class UnexpectedCrcLength(Exception):
    def __init__(self, l):
        self.l
class CrcMismatch(Exception):
    def __init__(self, c, r):
        self.c = c
        self.r = r
class UnknownNamedType(Exception):
    def __init__(self, n, v):
        self.n = n
        self.v = v

class Reader:
    """A reader that calculates a CRC32"""
    def __init__(self, fobj):
        self.crc = binascii.crc32(b'')
        self.fobj = fobj
        self.count = 0

    def read(self, sz):
        """Read exactly (sz) bytes"""
        data = b''
        remaining = sz
        while remaining > 0:
            buf = self.fobj.read(remaining)
            if len(buf) == 0:
                raise IOError('Unexpected EoF')
            data += buf
            remaining -= len(buf)
        self.count += sz
        self.crc = binascii.crc32(data, self.crc)
        return data

    def read_1byte_uint(self):
        return unpack('B', self.read(1))[0]

    def read_2byte_uint(self):
        return unpack('>H', self.read(2))[0]

    def read_tlv(self):
        tlvcode = self.read_1byte_uint()
        tlvlen = self.read_1byte_uint()
        tlvdata = self.read(tlvlen)
        return (tlvcode, tlvdata)

    def read_crc(self):
        """
        Read the next TLV as the final CRC in the EEPROM

        The CRC32 includes every byte in the EEPROM up to the CRC value itself
        including the CRC TLV and length fields. But naturally excluding the CRC in
        the EEPROM.
        """
