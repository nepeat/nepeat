#!/usr/bin/env bash
# Bring the CS8210 switch ASIC and the Credo PHYs up with the vendor SDK, the
# way the vendor's integrator_mode does it for knet mode, but with the PHYs in
# MACsec bypass instead of the vendor's fixed test key.
#
#   cs8210-switch-up [port-mode]      default port mode: 32x400
#   cs8210-switch-down
#
# Result: innovium.user and phy_server running inside the SDK chroot, and
# front-panel netdevs fpp1..fpp32 (CPU path only; forwarding is whatever the
# SDK was told, nothing is offloaded from Linux).
#
# Port modes are the vendor's: 32x400 32x200 64x100 128x100 32x100 32x40
# 128x25 128x10. Ports 1-16 sit behind Credo CMS50216 PHYs and get "copper"
# (host link training) on the ASIC side, as integrator_mode does.
set -euo pipefail

SDK=${CS8210_SDK_DIR:-/root/sdk/R3181-J0001-01_V0.1.7_Briggs_SDK}
MACSEC=${CS8210_MACSEC:-macsecbypass}

if [ "${1:-}" = "--down" ]; then
  cs8210-sdk-chroot /bin/bash -c "cd $SDK && ./c-phy/auto_load_user.sh -r; ./cls_shell exit" || true
  for _ in $(seq 1 20); do
    pgrep -x innovium.user >/dev/null || pgrep -x phy_server >/dev/null || exit 0
    sleep 1
  done
  pkill -x innovium.user || true
  pkill -x phy_server || true
  sleep 2
  exit 0
fi

MODE=${1:-32x400}

case "$MODE" in
  32x400) media=1x400G ;;
  32x200) media=1x200G ;;
  64x100) media=2x100G ;;
  128x100) media=4x100G ;;
  32x100) media=1x100G ;;
  32x40) media=1x40G ;;
  128x25) media=4x25G ;;
  128x10) media=4x10G ;;
  *) echo "unknown port mode $MODE" >&2; exit 2 ;;
esac
innv="1-16:copper_${media}:fec-def;17-32:optics_${media}:fec-def"
# Per-port override of the ASIC side, in the vendor dynamic_config.sh syntax,
# e.g. "1-16:copper_1x400G:fec-def;17:copper_4x10G;18-32:optics_1x400G:fec-def"
# for a QSA + 10G SFP+ DAC in cage 17. Breakouts add logical ports, so the
# devport (and fpp) numbers after a breakout shift.
innv=${CS8210_INNV_PORTS:-$innv}
credo="1-32:optics_${media}:fec-def"
# Same for the Credo PHYs (ports 1-16), in the c-phy auto_load_user.sh syntax,
# e.g. "1:optics_1x400G;2:copper_4x10G;3-32:optics_1x400G". A breakout on a
# Credo port needs the same mode on both sides. MACsec mode stays $MACSEC.
credo=${CS8210_CREDO_PORTS:-$credo}

if [ ! -c /dev/ipd ]; then
  echo "cs8210-switch-up: /dev/ipd missing (ipd module not loaded with legacy_abi=1?)" >&2
  exit 1
fi
if pgrep -x innovium.user >/dev/null; then
  echo "cs8210-switch-up: innovium.user is already running (cs8210-switch-down first)" >&2
  exit 1
fi

# Base MAC from the ONIE TlvInfo, first byte +2, as the vendor script does.
# `|| true`: with pipefail an unreadable EEPROM would otherwise end the script
# here, silently, instead of reaching the fallback below.
base=$(cs8210-show eeprom 2>/dev/null | sed -n 's/^MAC#1Base: //p') || true
if [[ "$base" =~ ^[0-9a-fA-F]{12}$ ]]; then
  first=$(( (0x${base:0:2} + 2) % 256 ))
  mac=$(printf '%02X:%s:%s:%s:%s:%s' "$first" "${base:2:2}" "${base:4:2}" "${base:6:2}" "${base:8:2}" "${base:10:2}")
  macarg="-a $mac"
else
  macarg=""
fi

# Tell ipd each front-panel netdev's speed (ipd-ethtool-link-ksettings.patch):
# the SDK never does, and bonding needs speed + full duplex for 802.3ad.
# Netdevs are fpp<cage> for one port per cage and fpp<cage>-<k> for breakouts.
set_speeds() {
  local entry range mode n g first last c k dev
  local -a entries
  IFS=';' read -ra entries <<<"$1"
  for entry in "${entries[@]}"; do
    range=${entry%%:*}
    mode=${entry#*:}; mode=${mode%%:*}; mode=${mode##*_}; mode=${mode,,}; mode=${mode%g}
    if [[ $mode =~ ^([0-9]+)x([0-9]+)$ ]]; then
      n=${BASH_REMATCH[1]}; g=${BASH_REMATCH[2]}
    elif [[ $mode =~ ^([0-9]+)$ ]]; then
      n=1; g=${BASH_REMATCH[1]}
    else
      echo "cs8210-switch-up: cannot parse port mode '$entry' for speeds" >&2; continue
    fi
    first=${range%-*}; last=${range#*-}
    for ((c = first; c <= last; c++)); do
      for ((k = 1; k <= n; k++)); do
        if ((n == 1)); then dev=fpp$c; else dev=fpp$c-$k; fi
        [ -e "/sys/class/net/$dev" ] || continue
        ethtool -s "$dev" speed $((g * 1000)) duplex full autoneg off ||
          echo "cs8210-switch-up: could not set speed on $dev" >&2
      done
    done
  done
}

# fpp netdevs that are bond members must carry the bond's MAC: replies to the
# bond MAC arriving on a member with a different address are classed
# PACKET_OTHERHOST and dropped before the bond sees them. networkd enslaves
# (and bonding re-addresses) a member the moment the SDK renames it to
# fpp*, but the SDK assigns its own per-port MAC ~50 ms *after* the rename
# (ip monitor, 2026-11-10), overwriting the bond MAC. By the time
# auto_load_user.sh has returned that is done, so put the bond MAC back.
# The bond's DHCP client already tried during that window (or while the
# Credo double CRC below still corrupted every received frame), lost the
# replies and sits in retry backoff (no lease minutes later), so restart
# networkd's configuration of every bond with fpp members.
sync_bond_macs() {
  local d dev master want
  local -A fixed=() bonds=()
  for d in /sys/class/net/fpp*; do
    [ -e "$d/master/bonding" ] || continue
    dev=${d##*/}
    master=$(readlink -f "$d/master")
    bonds[${master##*/}]=1
    want=$(cat "$master/address")
    [ "$(cat "$d/address")" = "$want" ] && continue
    if ip link set dev "$dev" address "$want"; then
      fixed[${master##*/}]=1
    else
      echo "cs8210-switch-up: could not set $dev to bond MAC $want" >&2
    fi
  done
  if ((${#bonds[@]})) && systemctl -q is-active systemd-networkd; then
    networkctl reconfigure "${!bonds[@]}" ||
      echo "cs8210-switch-up: networkctl reconfigure ${!bonds[*]} failed" >&2
  fi
}

sync
# One chroot invocation for both daemons: they share its /tmp (fifos, logs).
cs8210-sdk-chroot /bin/bash -c "
  set -e
  cd $SDK
  ./auto_load_user.sh -m '$innv' -k $macarg -d
  ./c-phy/auto_load_user.sh -m '$credo' -e $MACSEC -l
  # The Credo loader writes 'double_CRC ... enable=1' for every port, also in
  # MACsec bypass. In bypass every frame the PHY passes to the ASIC then
  # fails the ASIC's FCS check (100% rx_frames_err_crc with a clean PCS;
  # 10G breakout on cage 2, 2026-11-11), and with it off frames pass. Turn it
  # off for each port the loader configured. Revisit for real MACsec.
  if [ '$MACSEC' = macsecbypass ]; then
    sed -n 's/^double_CRC \(slice_id=[0-9]* port=[0-9]*\) enable=1\$/\1/p' c-phy/dynamic_config.txt |
      while read -r s p; do
        (cd c-phy && ./phy_shell \"double_CRC \$s \$p enable=0\" >/dev/null) ||
          echo \"cs8210-switch-up: double_CRC off failed for \$s \$p\" >&2
      done
  fi
  # devport 129: the 10G AUX lane wired to the CPU card's second NIC
  # (enp0s3). The vendor config defines it but leaves it disabled.
  ./cls_shell 'port enable 129' >/dev/null
"
set_speeds "$innv"
sync_bond_macs
