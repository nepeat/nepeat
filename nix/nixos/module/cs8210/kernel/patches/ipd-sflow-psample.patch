+/* psample=1: an sFlow netlink (IPD_CREATE_NETLINK, nl_app_type INNO_NL_SFLOW)
+ * hands its samples to the kernel's psample (groups 1 = ingress, 2 = egress,
+ * in the initial network namespace) instead of registering a generic-netlink
+ * family of its own; with psample.ko holding the "psample" name that family
+ * could not be registered. Takes effect for netlinks created afterwards. */
+static bool ipd_psample;
+module_param_named(psample, ipd_psample, bool, 0644);
+MODULE_PARM_DESC(psample, "sFlow samples to the kernel's psample (groups 1/2) instead of an own genetlink family (default 0)");
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 0, 0)
