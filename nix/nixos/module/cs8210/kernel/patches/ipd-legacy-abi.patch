+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Legacy ioctl argument layouts of ipd 0.12.x (SDK "R3181-J0001-01 V0.1.x",
+ * libifcs built 2020/2021).  Layouts were recovered from the DWARF of the
+ * vendor ipd.ko 0.12.41.1.0.1; ioctl numbers are unchanged.
+ * Selected with the module parameter legacy_abi=1.
+ */
+#ifndef __IPD_IOCTL_LEGACY_H__
+#define __IPD_IOCTL_LEGACY_H__
+
+#include "inno_ioctl.h"
+
+#define IPD_V0_RUPT_WORDS 8
+#define IPD_V0_LDH_SIZE   24
+#define IPD_V0_IFNAMSIZ   16
+
+typedef struct {
+    inno_ioctl_hdr_t hdr;
+    uint64_t serial_num;
+    uint64_t bar0;
+    uint64_t bar0_size;
+    uint64_t pool_baddr;
+    uint16_t vendor_id;
+    uint16_t device_id;
+    uint8_t  rev_id;
+    uint8_t  bus_num;
+    uint8_t  dev_num;
+    uint8_t  fn_num;
+    uint32_t pool_size;
+    uint32_t rupt_wb_size;
+    uint32_t rupt_wb_offset;
+    uint32_t sync_blk_size;
+    uint32_t sync_blk_offset;
+    uint32_t sync_wb_size;
+    uint32_t sync_wb_offset;
+    uint32_t dma_cache_align;
+    uint8_t  version[VERSION_SIZE];
+} inno_ioctl_query_v0_t;
+
+typedef struct {
+    inno_ioctl_hdr_t hdr;
+    uint16_t vector;
+    uint32_t mask[IPD_V0_RUPT_WORDS];
+} inno_ioctl_rupt_mask_v0_t;
+
+typedef struct {
+    inno_ioctl_hdr_t hdr;
+    uint64_t timeout;
+    uint64_t remaining_time;
+    uint32_t vector;
+    uint32_t rupts[IPD_V0_RUPT_WORDS];
+} inno_ioctl_rupt_wait_v0_t;
+
+typedef struct {
+    inno_ioctl_hdr_t hdr;
+    uint64_t ring;
+    uint64_t wb;
+    uint16_t count;
+    uint16_t vector;
+    uint32_t flags;
+    uint8_t  num;
+    uint32_t idx_offset;
+    uint16_t cidx;
+    uint16_t pidx;
+} inno_ioctl_ring_v0_t;
+
+typedef struct {
+    inno_ioctl_hdr_t hdr;
+    uint64_t hrr;
+    uint16_t size;
+    uint16_t count;
+    uint16_t descriptors;
+    uint32_t hrr_pidx_offset;
+} inno_ioctl_hrr_v0_t;
+
+typedef struct {
+    inno_ioctl_hdr_t hdr;
+    uint64_t learn_ba;
+    uint64_t wb_ba;
+    uint16_t count;
+    uint32_t pidx_offset;
+    uint16_t cidx;
+    uint16_t pidx;
+} inno_ioctl_learn_v0_t;
+
+typedef struct {
+    inno_ioctl_hdr_t hdr;
+    uint64_t wb_ba;
+    uint32_t count;
+} inno_ioctl_pic_st_v0_t;
+
+typedef struct {
+    inno_ioctl_hdr_t hdr;
+    uint64_t buf;
+    uint8_t  ring_num;
+    uint32_t buf_len;
+    uint16_t start_pidx;
+    uint16_t last_pidx;
+    uint8_t  ldh[IPD_V0_LDH_SIZE];
+    uint8_t  num_ldh;
+    uint32_t flags;
+} inno_ioctl_tx_send_v0_t;
+
+typedef struct {
+    inno_ioctl_hdr_t hdr;
+    uint16_t sysport;
+    struct sockaddr ethaddr;
+    uint32_t flag;
+    char     intf_name[IPD_V0_IFNAMSIZ];
+} inno_ioctl_netdev_v0_t;
+
+typedef struct __attribute__((__packed__)) {
+    inno_ioctl_hdr_t hdr;
+    uint16_t id;
+    uint16_t sysport;
+    union {
+        struct {
+            uint8_t syshdr1[24];
+            uint8_t syshdr1_cnt;
+            uint8_t syshdr1_abp[24];
+            uint8_t syshdr2[12];
+        } ldh;
+        struct {
+            uint32_t type;
+            uint32_t num;
+            uint64_t packets;
+            uint64_t bytes;
+        } ring;
+        struct sockaddr ethaddr;
+        char     intf_name[IPD_V0_IFNAMSIZ];
+        uint16_t vtag;
+        uint16_t ifstate;
+        uint16_t linkstate;
+        uint16_t mtu;
+        uint8_t  raw[64];
+    } u;
+} inno_ioctl_netdev_info_v0_t;
+
+typedef struct {
+    inno_ioctl_hdr_t hdr;
+    uint64_t buf_ba;
+    uint32_t ring_type;
+    uint8_t  ring_num;
+    uint32_t idx;
+} inno_ioctl_ring_page_alloc_v0_t;
+
+#ifdef __KERNEL__
+#include <linux/build_bug.h>
+#define IPD_V0_SIZE(t, n) static_assert(sizeof(t) == (n))
+IPD_V0_SIZE(inno_ioctl_query_v0_t, 112);
+IPD_V0_SIZE(inno_ioctl_rupt_mask_v0_t, 44);
+IPD_V0_SIZE(inno_ioctl_rupt_wait_v0_t, 64);
+IPD_V0_SIZE(inno_ioctl_ring_v0_t, 48);
+IPD_V0_SIZE(inno_ioctl_hrr_v0_t, 32);
+IPD_V0_SIZE(inno_ioctl_learn_v0_t, 40);
+IPD_V0_SIZE(inno_ioctl_pic_st_v0_t, 24);
+IPD_V0_SIZE(inno_ioctl_tx_send_v0_t, 64);
+IPD_V0_SIZE(inno_ioctl_netdev_v0_t, 48);
+IPD_V0_SIZE(inno_ioctl_netdev_info_v0_t, 76);
+IPD_V0_SIZE(inno_ioctl_ring_page_alloc_v0_t, 32);
+static_assert(offsetof(inno_ioctl_query_v0_t, pool_baddr) == 0x20);
+static_assert(offsetof(inno_ioctl_query_v0_t, dma_cache_align) == 0x4c);
+static_assert(offsetof(inno_ioctl_ring_v0_t, idx_offset) == 0x24);
+static_assert(offsetof(inno_ioctl_tx_send_v0_t, flags) == 0x38);
+static_assert(offsetof(inno_ioctl_netdev_info_v0_t, u.ldh.syshdr2) == 0x3d);
+static_assert(offsetof(inno_ioctl_ring_page_alloc_v0_t, idx) == 0x18);
+#endif
+
+#endif /* __IPD_IOCTL_LEGACY_H__ */
