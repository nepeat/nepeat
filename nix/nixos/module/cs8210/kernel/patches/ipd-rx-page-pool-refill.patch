 #include <linux/etherdevice.h>
 #include <net/genetlink.h>
 #include <linux/cdev.h>
+#include <net/page_pool/helpers.h>
 
 /** @file ipd.h
  *
@@ -156,8 +157,43 @@
 
     inno_dma_alloc_t      *pages;       /** Array of ring pages */
 
+    struct page_pool      *pp;          /** RX buffer pool (netdev RX rings) */
+
 } inno_ring_t;
 
+/* Netdev RX ring buffers come from a page_pool: pages stay DMA-mapped and
+ * are recycled when the stack frees the skb.  Allocation and "in_napi"
+ * frees are serialized by idev->napi_lock. */
+static inline int
+inno_rx_buf_alloc(inno_ring_t *ring, inno_dma_alloc_t *dma, gfp_t gfp)
+{
+    struct page *page = page_pool_alloc_pages(ring->pp, gfp);
+
+    if (page == NULL) {
+        return -ENOMEM;
+    }
+    dma->page     = page;
+    dma->dma_addr = page_pool_get_dma_addr(page);
+    dma->vmaddr   = page_address(page);
+    return 0;
+}
+
+/* Give an RX buffer that was not handed to the stack back to the pool */
+static inline void
+inno_rx_buf_free(inno_ring_t *ring, inno_dma_alloc_t *dma, bool in_napi)
+{
+    page_pool_put_full_page(ring->pp, dma->page, in_napi);
+    memset(dma, 0, sizeof(inno_dma_alloc_t));
+}
+
+/* Make @len bytes the device wrote into an RX buffer visible to the CPU */
+static inline void
+inno_rx_buf_sync(inno_ring_t *ring, inno_dma_alloc_t *dma, uint32_t len)
+{
+    page_pool_dma_sync_for_cpu(ring->pp, dma->page, 0,
+                               min_t(uint32_t, len, PAGE_SIZE));
+}
+
 /** @brief Interrupt vector definition */
 typedef struct inno_rupt_vector_s {
     uint16_t          vector;                    /** Vector number */
