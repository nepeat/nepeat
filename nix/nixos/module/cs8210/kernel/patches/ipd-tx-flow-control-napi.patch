+/** @brief Reap all netdev TX rings once
+ *
+ *  @return Number of packets completed, capped at @budget
+ */
+static int
+inno_tx_rings_reap(inno_device_t *idev, int budget)
+{
+    int ring_num;
+    int done = 0;
+
+    spin_lock(&idev->tx_reap_lock);
+    for (ring_num = 0; ring_num < NUM_TX_RINGS && done < budget; ring_num++) {
+        inno_ring_t *tx = &idev->tx_ring[ring_num];
+        if ((tx->flags & INNO_RING_INIT) &&
+            (tx->flags & INNO_RING_NETDEV)) {
+            done += inno_tx_ring_reap(tx, budget - done);
+        }
+    }
+    spin_unlock(&idev->tx_reap_lock);
+
+    return done;
+}
