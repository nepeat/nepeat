+static int
+inno_tx_napi_poll(struct napi_struct *napi,
+                  int                budget)
+{
+    inno_device_t *idev = container_of(napi, inno_device_t, napi_tx);
+    int           done;
+    int           i;
+
+    done = inno_tx_rings_reap(idev, budget);
+    if (done >= budget) {
+        return budget;
+    }
+
+    /* Same race as in inno_ring_poll(): the interrupt was cleared in the
+     * handler while a CIDX writeback may still have been in flight.  A
+     * PCIe read forces the round trip, then look once more. */
+    (void) REG32(SYNC_MODE);
+    done += inno_tx_rings_reap(idev, budget - done);
+    if (done >= budget) {
+        return budget;
+    }
+
+    if (napi_complete_done(napi, done)) {
+        /* Re-enable the TX completion interrupts */
+        for (i = 0; i < rupt_mask_words; i++) {
+            if (idev->napi_tx_mask[i] != 0) {
+                REG32(idev->inno_intr_regs.intr_inms + i * 4) =
+                    idev->napi_tx_mask[i];
+            }
+        }
+    }
+
+    return done;
 }
 
 
