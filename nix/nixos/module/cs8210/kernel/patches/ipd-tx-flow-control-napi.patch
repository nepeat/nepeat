+/* TX flow control.
+ *
+ * All netdevs share one TX descriptor ring.  A netdev stops its queue as
+ * soon as the ring cannot take another worst-case packet (so the stack
+ * never sees NETDEV_TX_BUSY in the common case) and the completion path
+ * wakes every stopped netdev once a quarter of the ring is free again. */
+#define INNO_TX_STOP_THRESH    (MAX_SKB_FRAGS + 3)
+/* Packets reaped per call from the xmit path / from the shared NAPI */
+#define INNO_TX_XMIT_REAP      64
+#define INNO_TX_NAPI_REAP      256
+
+static inline uint32_t
+inno_tx_wake_thresh(const inno_ring_t *tx)
+{
+    return min_t(uint32_t, tx->count,
+                 max_t(uint32_t, tx->count / 4, 2 * INNO_TX_STOP_THRESH));
+}
+
+static inline uint32_t
+inno_tx_ring_space(const inno_ring_t *tx)
+{
+    uint32_t pidx = READ_ONCE(tx->pidx);
+    uint32_t cidx = READ_ONCE(tx->work_cidx);
+
+    return RING_SPACE(tx->count, pidx, cidx);
+}
+
+/* Stop @dev's queue; the caller re-checks the ring space afterwards (the
+ * completion path may have run in between, see inno_tx_ring_reap()). */
+static inline void
+inno_tx_stop_queue(inno_device_t *idev, struct net_device *dev)
+{
+    netif_stop_queue(dev);
+    set_bit(0, &idev->tx_stopped);
+    smp_mb__after_atomic();
+}
+
+/* Wake every netdev that stopped itself on a full TX ring */
+static void
+inno_tx_wake_queues(inno_device_t *idev)
+{
+    int i;
+
+    if (!test_and_clear_bit(0, &idev->tx_stopped)) {
+        return;
+    }
+    for (i = 0; i < NUM_SYSPORTS; i++) {
+        struct net_device *ndev = READ_ONCE(idev->sysport_devs[i]);
+
+        if (ndev && netif_running(ndev) && netif_queue_stopped(ndev)) {
+            netif_wake_queue(ndev);
+        }
+    }
+}
+
+static int inno_tx_ring_reap(inno_ring_t *tx, int budget);
+
