# Darwin rebuild helper
# Default recipe
default:
    @just --list

# Update flake and channel, then rebuild system
update machine_name="":
    #!/bin/zsh
    set -e

    # Get machine name from argument, /etc/machine_name, or error
    if [ -n "{{ machine_name }}" ]; then
        MACHINE="{{ machine_name }}"
    elif [ -f /etc/machine_name ]; then
        MACHINE=$(cat /etc/machine_name)
    else
        echo "Error: No machine name provided and /etc/machine_name not found" >&2
        exit 1
    fi

    echo "Updating for machine: $MACHINE"

    # Update flake and channel (shared across all machines)
    nix flake update -vvv
    nix-channel --update

    # `nix flake update` moves openviking-src, which invalidates the vendored
    # cargo/npm hashes pinned in package/openviking.nix.
    just refresh-openviking-hashes

    # Build and switch the system
    just switch "$MACHINE"

# Bump OpenViking to the latest upstream master and refresh its hashes
update-openviking:
    #!/bin/zsh
    set -e
    nix flake update openviking-src
    just refresh-openviking-hashes

# Recompute the vendored cargo/npm hashes in package/openviking.nix.
# Each is deliberately invalidated, then read back from the build failure.
refresh-openviking-hashes:
    #!/bin/zsh
    set -e

    PKG="package/openviking.nix"
    FAKE="sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

    # A hash only lands in the flake's view of the tree once git knows about
    # the file, so an untracked package file would silently use a stale copy.
    git add -N "$PKG" 2>/dev/null || true

    refresh() {
        local name="$1" attr="$2" got

        # Skip the rebuild when the pin is already correct.
        if nix build ".#openviking.$attr" --no-link 2>/dev/null; then
            echo "$name: already up to date"
            return
        fi

        # -i.bak + rm is the only in-place form GNU and BSD sed agree on.
        sed -i.bak "s|^  $name = \"sha256-[^\"]*\";|  $name = \"$FAKE\";|" "$PKG" && rm -f "$PKG.bak"
        got=$(nix build ".#openviking.$attr" --no-link 2>&1 \
                | awk '/got:/ { print $2; exit }')

        if [ -z "$got" ]; then
            echo "error: could not determine $name; build failed for another reason" >&2
            nix build ".#openviking.$attr" --no-link 2>&1 | tail -30 >&2
            exit 1
        fi

        sed -i.bak "s|^  $name = \"sha256-[^\"]*\";|  $name = \"$got\";|" "$PKG" && rm -f "$PKG.bak"
        echo "$name: $got"
    }

    # cargoHash first — ovCli cannot build until the vendor tree resolves.
    refresh cargoHash ovCli
    refresh npmDepsHash webStudio

# Build and switch the system without updating the flake
switch machine_name="":
    #!/bin/zsh
    set -e

    # Get machine name from argument, /etc/machine_name, or error
    if [ -n "{{ machine_name }}" ]; then
        MACHINE="{{ machine_name }}"
    elif [ -f /etc/machine_name ]; then
        MACHINE=$(cat /etc/machine_name)
    else
        echo "Error: No machine name provided and /etc/machine_name not found" >&2
        exit 1
    fi

    echo "Switching for machine: $MACHINE"

    # Build the system
    nix build -vL --always-allow-substitutes --log-format internal-json ".#darwinConfigurations.$MACHINE.system" |& nix run 'nixpkgs#nix-output-monitor' -- --json

    # Apply the update using darwin-rebuild if available, otherwise use result
    if command -v darwin-rebuild &> /dev/null; then
        echo "Using darwin-rebuild from PATH"
        sudo darwin-rebuild switch --flake ".#$MACHINE" -vL
    else
        echo "Using darwin-rebuild from built result"
        sudo ./result/sw/bin/darwin-rebuild switch --flake ".#$MACHINE" -vL
    fi

# Clean nix store
clean:
    nix-store --gc

# --- Vault AppRole enrollment -------------------------------------------------
# Ported from the generalprogramming megarepo. Both recipes need a Vault/OpenBao
# token that can read the role_id and mint secret_ids for the AppRole
# (VAULT_TOKEN or ~/.vault-token).

# Fresh-install a NixOS machine, seeding its Vault AppRole credentials.
vault-provision machine target role="nixos-core":
    #!/usr/bin/env bash
    set -euo pipefail
    command -v vault >/dev/null && VAULT_CMD=vault || VAULT_CMD=bao
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT

    # Impermanent machines bind-mount /var/lib from /persist, so the credentials
    # have to be planted there to survive the rollback.
    creds="$tmp/var/lib/vault-agent"
    if [ "$(nix eval .#nixosConfigurations.{{machine}}.config.impermanence.enable 2>/dev/null)" = "true" ]; then
        creds="$tmp/persist/var/lib/vault-agent"
    fi

    install -d -m 0700 "$creds"
    umask 077
    "$VAULT_CMD" read -field=role_id "auth/approle/role/{{role}}/role-id" > "$creds/approle_id"
    "$VAULT_CMD" write -f -field=secret_id "auth/approle/role/{{role}}/secret-id" > "$creds/approle_secret"

    nix run github:nix-community/nixos-anywhere -- \
        --flake .#{{machine}} \
        --extra-files "$tmp" \
        root@{{target}}

# Mint and push a fresh AppRole secret_id to an already-installed machine.
vault-rekey machine target="" role="nixos-core":
    #!/usr/bin/env bash
    set -euo pipefail
    command -v vault >/dev/null && VAULT_CMD=vault || VAULT_CMD=bao
    host="{{target}}"
    [ -n "$host" ] || host="{{machine}}"

    "$VAULT_CMD" read -field=role_id "auth/approle/role/{{role}}/role-id" \
        | ssh "root@$host" 'umask 077; install -d -m 0700 /var/lib/vault-agent; cat > /var/lib/vault-agent/approle_id'
    "$VAULT_CMD" write -f -field=secret_id "auth/approle/role/{{role}}/secret-id" \
        | ssh "root@$host" 'umask 077; cat > /var/lib/vault-agent/approle_secret; systemctl try-restart vault-agent-node.service'

    echo "rekeyed $host"
