# nix-darwin / NixOS rebuild helper
# Default recipe
default:
    @just --list

# Update flake and channel, then rebuild system
update machine_name="":
    #!/usr/bin/env bash
    set -e

    MACHINE=$(just _machine "{{ machine_name }}")

    echo "Updating for machine: $MACHINE"

    # Update flake and channel (shared across all machines)
    nix flake update -vvv
    nix-channel --update

    # `nix flake update` moves openviking-src, which invalidates the vendored
    # cargo/npm hashes pinned in package/openviking.nix.
    just refresh-openviking-hashes

    # Build and switch the system
    just switch "$MACHINE"

# Bump OpenViking to the latest upstream master and refresh its hashes
update-openviking:
    #!/usr/bin/env bash
    set -e
    nix flake update openviking-src
    just refresh-openviking-hashes

# Recompute the vendored cargo/npm hashes in package/openviking.nix.
refresh-openviking-hashes:
    #!/usr/bin/env bash
    set -e

    PKG="package/openviking.nix"
    HASH_REFRESH_TMP=$(mktemp -d)
    trap 'rm -rf "$HASH_REFRESH_TMP"' EXIT

    # A hash only lands in the flake's view of the tree once git knows about
    # the file, so an untracked package file would silently use a stale copy.
    git add -N "$PKG" 2>/dev/null || true

    probe() {
        local name="$1" attr="$2" got
        local log="$HASH_REFRESH_TMP/$name.log"

        # Build only the fixed-output dependency derivation.  Any stale hash is
        # already sufficient to make nix report the new value; fakeHash would
        # just make it fetch and hash the same dependency tree a second time.
        if nix build ".#openviking.$attr" --no-link >"$log" 2>&1; then
            : > "$HASH_REFRESH_TMP/$name.ok"
            return
        fi

        got=$(awk '/got:/ { print $2; exit }' "$log")
        if [ -z "$got" ]; then
            return 1
        fi
        printf '%s\n' "$got" > "$HASH_REFRESH_TMP/$name.hash"
    }

    # The two dependency trees are independent, so let the nix daemon realise
    # them concurrently.  Separate logs keep each reported hash unambiguous.
    probe cargoHash ovCli.cargoDeps &
    cargo_pid=$!
    probe npmDepsHash webStudio.npmDeps &
    npm_pid=$!

    failed=0
    wait "$cargo_pid" || failed=1
    wait "$npm_pid" || failed=1
    if [ "$failed" -ne 0 ]; then
        for name in cargoHash npmDepsHash; do
            if [ ! -e "$HASH_REFRESH_TMP/$name.hash" ] && [ ! -e "$HASH_REFRESH_TMP/$name.ok" ]; then
                echo "error: could not determine $name; build failed for another reason" >&2
                tail -30 "$HASH_REFRESH_TMP/$name.log" >&2
            fi
        done
        exit 1
    fi

    for name in cargoHash npmDepsHash; do
        if [ -e "$HASH_REFRESH_TMP/$name.ok" ]; then
            echo "$name: already up to date"
            continue
        fi

        got=$(<"$HASH_REFRESH_TMP/$name.hash")
        # -i.bak + rm is the only in-place form GNU and BSD sed agree on.
        sed -i.bak "s|^  $name = \"sha256-[^\"]*\";|  $name = \"$got\";|" "$PKG" && rm -f "$PKG.bak"
        echo "$name: $got"
    done

# Build and switch the system without updating the flake
switch machine_name="":
    #!/usr/bin/env bash
    set -euo pipefail

    MACHINE=$(just _machine "{{ machine_name }}")

    echo "Switching for machine: $MACHINE"

    if [ "$(uname -s)" = Darwin ]; then
        ATTR="darwinConfigurations.$MACHINE.system"
        REBUILD=darwin-rebuild
    else
        ATTR="nixosConfigurations.$MACHINE.config.system.build.toplevel"
        REBUILD=nixos-rebuild
    fi

    # Build the system
    nix build -vL --always-allow-substitutes --log-format internal-json ".#$ATTR" 2>&1 | nix run 'nixpkgs#nix-output-monitor' -- --json

    # Apply the update using the rebuild tool from PATH, falling back to the
    # one in the freshly built result (darwin-rebuild lives in the system
    # closure; nixos-rebuild only does when it's in systemPackages).
    if command -v "$REBUILD" &> /dev/null; then
        echo "Using $REBUILD from PATH"
        REBUILD=$(command -v "$REBUILD")
    else
        echo "Using $REBUILD from built result"
        REBUILD="$PWD/result/sw/bin/$REBUILD"
    fi

    if [ "$(uname -s)" = Darwin ]; then
        sudo "$REBUILD" switch --flake ".#$MACHINE" -vL
    else
        # Activate exactly what we built as the invoking user. Root needn't
        # evaluate the flake again with a different HOME or Git/SSH config.
        # Skip nixos-rebuild's self-rebuild, which otherwise evaluates the
        # legacy <nixpkgs/nixos> configuration even with --store-path.
        sudo "$REBUILD" switch --no-reexec --store-path "$(readlink -f result)" -v
    fi

# Resolve the target machine: explicit arg, /etc/machine_name, or (NixOS) the hostname
[private]
_machine machine_name="":
    #!/usr/bin/env bash
    set -e
    if [ -n "{{ machine_name }}" ]; then
        echo "{{ machine_name }}"
    elif [ -f /etc/machine_name ]; then
        cat /etc/machine_name
    elif [ "$(uname -s)" != Darwin ]; then
        # mkNixos sets networking.hostName to the config name.
        hostname
    else
        echo "Error: No machine name provided and /etc/machine_name not found" >&2
        exit 1
    fi

# Clean nix store
clean:
    nix-store --gc

# --- Vault AppRole enrollment -------------------------------------------------
# Ported from the generalprogramming megarepo. Both recipes need a Vault/OpenBao
# token that can read the role_id and mint secret_ids for the AppRole
# (VAULT_TOKEN or ~/.vault-token).

# Fresh-install a NixOS machine, seeding its Vault AppRole credentials.
vault-provision machine target role="nixos-core":
    #!/usr/bin/env bash
    set -euo pipefail
    command -v vault >/dev/null && VAULT_CMD=vault || VAULT_CMD=bao
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT

    # Impermanent machines bind-mount /var/lib from /persist, so the credentials
    # have to be planted there to survive the rollback.
    creds="$tmp/var/lib/vault-agent"
    if [ "$(nix eval .#nixosConfigurations.{{machine}}.config.impermanence.enable 2>/dev/null)" = "true" ]; then
        creds="$tmp/persist/var/lib/vault-agent"
    fi

    install -d -m 0700 "$creds"
    umask 077
    "$VAULT_CMD" read -field=role_id "auth/approle/role/{{role}}/role-id" > "$creds/approle_id"
    "$VAULT_CMD" write -f -field=secret_id "auth/approle/role/{{role}}/secret-id" > "$creds/approle_secret"

    nix run github:nix-community/nixos-anywhere -- \
        --flake .#{{machine}} \
        --extra-files "$tmp" \
        root@{{target}}

# Mint and push a fresh AppRole secret_id to an already-installed machine.
vault-rekey machine target="" role="nixos-core":
    #!/usr/bin/env bash
    set -euo pipefail
    command -v vault >/dev/null && VAULT_CMD=vault || VAULT_CMD=bao
    host="{{target}}"
    [ -n "$host" ] || host="{{machine}}"

    "$VAULT_CMD" read -field=role_id "auth/approle/role/{{role}}/role-id" \
        | ssh "root@$host" 'umask 077; install -d -m 0700 /var/lib/vault-agent; cat > /var/lib/vault-agent/approle_id'
    "$VAULT_CMD" write -f -field=secret_id "auth/approle/role/{{role}}/secret-id" \
        | ssh "root@$host" 'umask 077; cat > /var/lib/vault-agent/approle_secret; systemctl try-restart vault-agent-node.service'

    echo "rekeyed $host"
