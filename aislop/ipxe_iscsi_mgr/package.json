{
  "name": "ipxe-iscsi-mgr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iSCSI boot volume manager: Cloudflare Worker control plane + iPXE config server, with a local validating CLI",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ipxe-iscsi-mgr --local",
    "db:migrate:remote": "wrangler d1 migrations apply ipxe-iscsi-mgr --remote",
    "ipxectl": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.126.0"
  }
}
