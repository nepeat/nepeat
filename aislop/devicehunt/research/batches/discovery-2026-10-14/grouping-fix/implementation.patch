+def grouped_search(catalog, query, target, limit, exact_model, exact_part_number, include_source_facts):
+    """Present complete, record-local evidence under conservative identical keys.
+
+    This deliberately bypasses the flat view's legacy within-source collapse.
+    All metadata is read in bulk; no query is issued for an individual member.
+    """
+    if exact_part_number and not query.strip():
+        raise ValueError('Exact part-number lookup requires a part number')
+    canonical = target_for(target) if target else None
+    if target and canonical is None:
+        raise ValueError('Unknown target: ' + target)
+    matched = {}
+    records = None
+    devices = None
+    if exact_part_number:
+        wanted = query.strip().casefold()
+        for row in catalog.db.execute(
+                "SELECT record_id,value FROM identifiers WHERE kind='part_number' ORDER BY record_id,value"):
+            if row['value'].strip().casefold() == wanted:
+                matched.setdefault(row['record_id'], []).append(row['value'])
+        records = set(matched)
+    elif exact_model:
+        if not query.strip():
+            raise ValueError('Exact model lookup requires a model string')
+        wanted = query.strip().casefold()
+        records = {row['id'] for row in catalog.db.execute(
+            'SELECT r.id,d.model FROM records r JOIN devices d ON d.id=r.device_id')
+            if row['model'].strip().casefold() == wanted}
+        records.update(row['record_id'] for row in catalog.db.execute(
+            "SELECT record_id,value FROM identifiers WHERE kind IN ('alias','model_search','manufacturer_model')")
+            if row['value'].strip().casefold() == wanted)
+    else:
+        devices = {row['id'] for row in catalog.search(query, target=target, limit=-1)}
+    if records == set() or devices == set():
+        return []
+
+    names = {}
+    if include_source_facts:
+        for (name,) in catalog.db.execute('SELECT DISTINCT name FROM facts'):
+            category = source_fact_category(name)
+            if category:
+                names[name] = category
+    fact_names = list(CATEGORIES) + list(names)
+    args = list(fact_names)
+    clause = ''
+    if canonical:
+        clause = ' AND EXISTS (SELECT 1 FROM affiliations a WHERE a.record_id=r.id AND a.target=?)'
+        args.append(canonical)
+    rows = []
+    for row in catalog.db.execute(
+            'SELECT r.id AS record_id,d.id AS device_id,d.brand,d.model,d.revision,'
+            'f.name,f.value,r.source_id,r.source_key,r.source_url,s.tier '
+            'FROM facts f JOIN records r ON r.id=f.record_id '
+            'JOIN devices d ON d.id=r.device_id JOIN sources s ON s.id=r.source_id '
+            'WHERE f.name IN (' + ','.join('?' for _ in fact_names) + ')' + clause +
+            ' ORDER BY d.brand,d.model,d.revision,d.id,r.source_id,r.id,f.name,f.value', args):
+        if records is not None and row['record_id'] not in records:
+            continue
+        if devices is not None and row['device_id'] not in devices:
+            continue
+        curated = row['name'] in CATEGORIES
+        statement = row['value'] if curated else source_fact_statement(row['name'], row['value'])
+        if statement is None:
+            continue
+        member = {key: row[key] for key in ('record_id', 'device_id', 'brand', 'model', 'revision')}
+        member.update(category=row['name'] if curated else names[row['name']], statement=statement,
+                      source_id=row['source_id'], source_url=row['source_url'], tier=row['tier'],
+                      origin='curated statement' if curated else 'source fact',
+                      source_fact_name='' if curated else row['name'], source_key=row['source_key'],
+                      raw_fact={'name': row['name'], 'value': row['value']}, affiliations=[])
+        if exact_part_number:
+            member['matched_part_numbers'] = matched[row['record_id']]
+        rows.append(member)
+    rows.sort(key=lambda r: (r['brand'], r['model'], r['revision'], r['device_id'], r['source_id'],
+                            r['record_id'], r['category'], r['origin'] != 'curated statement',
+                            r['source_fact_name'], r['statement']))
+    affiliations = {}
+    eligible = {row['record_id'] for row in rows}
+    if rows:
+        for row in catalog.db.execute(
+                'SELECT record_id,company,target,role FROM affiliations ORDER BY record_id,company,target,role'):
+            if row['record_id'] in eligible:
+                affiliations.setdefault(row['record_id'], []).append(
+                    {key: row[key] for key in ('company', 'target', 'role')})
+    groups = {}
+    for member in rows:
+        member['affiliations'] = affiliations.get(member['record_id'], [])
+        key = tuple(member[field] for field in ('device_id', 'category', 'origin', 'source_fact_name', 'statement'))
+        key += (member['raw_fact']['value'],)
+        if key not in groups:
+            groups[key] = {field: member[field] for field in
+                           ('device_id', 'brand', 'model', 'revision', 'category', 'statement', 'origin', 'source_fact_name')}
+            groups[key].update(evidence_count=0, record_count=0, source_count=0, evidence=[])
+        groups[key]['evidence'].append(member)
+    result = list(groups.values())
+    for group in result:
+        group['evidence_count'] = len(group['evidence'])
+        group['record_count'] = len({row['record_id'] for row in group['evidence']})
+        group['source_count'] = len({row['source_id'] for row in group['evidence']})
+    return result if limit == -1 else result[:limit]
