+        report = self.report('Oracle Server E4-2C', 'Oracle')
+        statements = report['categories']['firmware_boot_software']['statements']
+        configurations = [value for name, value in facts if name == 'cmvp_tested_configuration']
+        self.assertEqual([s['statement'] for s in statements], sorted(configurations))
+        self.assertEqual([s['fact_name'] for s in statements], ['cmvp_tested_configuration'] * 2)
+        self.assertEqual(len(report['matched_records']), 1)
+        record = report['matched_records'][0]
