+            ('cmvp_module_status_at_capture', 'Historical'),
+            ('cmvp_module_historical_reason', 'Moved to historical list due to sunsetting'),
+            ('cmvp_module_caveat', 'When operated in FIPS mode. No assurance of the minimum strength of generated keys.'),
+            ('cmvp_module_vendor_literal', 'Oracle Corporation'),
+            ('cmvp_module_validation_history_row', '["5/3/2023", "Initial", "Acumen Security"]'),
+            ('cmvp_module_validation_history_row', '["3/26/2025", "Update", "Lightship Security, Inc."]'),
+            ('source_sha256', '47bf103fab0e61eb214ac5ad17bae892951663a320d2bed427e8bf22e5455064'),
+            ('source_location', 'Details panel: #module-name; #module-standard; Tested Configuration(s) list items 14-15, HTML lines 583-584; Software Versions lines 685-689; #validation-history-table rows 1-2'),
+            ('source_scope', 'Saved NIST CMVP certificate 4506 software-module tested-platform detail; two exact E4-2C rows, preserving PAA and single-user-mode modifiers. Status/date are snapshot/module statements.'),
+            ('configuration_limit', 'No assertion of general/current OS support, installed CPU or OS, hardware certification, manufacturing, deployment, bootability, firmware access or secondhand software entitlement. Validation history dates are module events and are not separately assigned to either platform row.'),
+        ]
+        capture = self.path.parent / 'cmvp.txt'
+        capture.write_bytes(b'saved CMVP capture')
+        self.c.source('cmvp', 'https://example.org/cmvp', 'regulatory', 'test',
+                      'saved module detail', path=capture)
+        self.c.add('cmvp', 'e4-detail', 'https://example.org/cmvp', 'Oracle',
+                   'Oracle Server E4-2C', 'Oracle Server E4-2C', 'server platform', {},
+                   [('Oracle', 'tested_platform_vendor')], facts=facts)
+        self.c.finish('cmvp', 1)
+        self.add('other-model', model='Oracle Server E4-2', vendor='Oracle',
+                 facts=[('cmvp_tested_configuration', 'OTHER MODEL'), ('cpu', 'OTHER CPU')])
+        self.add('other-vendor', model='Oracle Server E4-2C', vendor='Hyve',
