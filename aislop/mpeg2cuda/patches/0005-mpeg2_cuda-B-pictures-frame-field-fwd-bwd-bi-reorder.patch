+                         &s->mb_w, &s->mb_h, &lambda, &mv_max,
+                         &s->intra_cost_bias, &s->field_bias, &s->motion };
+        ret = launch(avctx, F_ME_FIELD, (n_mb * 32 + 127) / 128, 1, 128, 1, args);
+    }
+    return ret;
+}
