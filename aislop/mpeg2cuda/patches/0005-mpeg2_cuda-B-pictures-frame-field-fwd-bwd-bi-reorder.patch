+/* quantiser of picture type t relative to P */
+static double rc_k(const MPEG2CudaContext *s, int t)
+{
+    return t == 1 ? 1.0 / s->ip_ratio : t == 3 ? s->pb_ratio : 1.0;
+}
+
 static double rc_get_qscale(AVCodecContext *avctx, int pict_type)
 {
     MPEG2CudaContext *s = avctx->priv_data;
     AVRational fr = ff_mpeg12_frame_rate_tab[s->frame_rate_code];
     double fps = av_q2d(fr);
     double br  = avctx->bit_rate;
