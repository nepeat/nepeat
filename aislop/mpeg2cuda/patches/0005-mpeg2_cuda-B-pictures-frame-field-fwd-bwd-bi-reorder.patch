-                 (1.0 + s->rc_left[2] * s->rc_x[2] / (s->rc_x[1] * s->ip_ratio));
-    else
-        target = s->rc_remaining /
-                 (s->rc_left[2] + s->rc_left[1] * s->ip_ratio * s->rc_x[1] / s->rc_x[2]);
-    target = FFMAX(target, br / (8.0 * fps));
-    free_target = target;
+    /* TM5 step 1 generalised: with q_t = k_t * q_P and bits_t = X_t / q_t,
+     * the remaining GOP budget fixes q_P directly */
+    /* the picture being coded always counts (end of stream codes past the
+     * GOP's nominal composition) */
+    s->rc_left[pict_type] = FFMAX(s->rc_left[pict_type], 1);
+    for (int t = 1; t <= 3; t++)
+        work += FFMAX(s->rc_left[t], 0) * s->rc_x[t] / rc_k(s, t);
+    qp = work / FFMAX(s->rc_remaining, br / fps);
+
+    /* Constant-ish q is what quality wants: follow the budget smoothly and
+     * let only the VBV limits force a jump */
+    if (s->rc_last_q[2] > 0)
+        qp = av_clipd(qp, s->rc_last_q[2] / 1.2, s->rc_last_q[2] * 1.2);
+    q = qp * rc_k(s, pict_type);
 
     /* don't let one picture drain the VBV */
-    target = FFMIN(target, FFMAX(s->vbv_fullness - br / fps, br / fps));
+    target = FFMAX(s->vbv_fullness - br / fps, br / fps);
 
-    /* leave room for the next I picture: what the P pictures before it may
