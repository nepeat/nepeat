+    if (pict_type != 1 && s->rc_last_i_bits > 0) {
+        int n = FFMAX(s->gop - s->gop_pos, 1);
         double i_est = FFMIN(s->rc_last_i_bits, 0.6 * s->vbv_size * 16384.0);
         double spare = s->vbv_fullness + n * br / fps - i_est;
         target    = FFMIN(target, FFMAX(spare / n, br / (16.0 * fps)));
         s->rc_cap = FFMIN(s->rc_cap, spare - (n - 1) * 8192.0);
     }
-
-    /* Constant-ish q is what quality wants; TM5's full-gain feedback makes
-     * q swing between extremes from one P picture to the next. Follow the
-     * budget smoothly (I pictures track the P quantiser by ip_ratio), and let
-     * only the VBV limits force a jump. */
-    q_free = s->rc_x[pict_type] / free_target;
