+    double target, q, qp, work = 0;
 
-    if (avctx->flags & AV_CODEC_FLAG_QSCALE)
-        return 2 * av_clip(avctx->global_quality / FF_QP2LAMBDA, 1, 31);
+    if (avctx->flags & AV_CODEC_FLAG_QSCALE) {
+        int q = 2 * av_clip(avctx->global_quality / FF_QP2LAMBDA, 1, 31);
+        return pict_type == 3 ? FFMIN(62, q * s->pb_ratio) : q;
+    }
 
     if (s->gop_pos == 0) {
-        int n = avctx->gop_size;
-        s->rc_remaining += br * n / fps;
+        int anchors = s->gop / (s->bf + 1);
+        s->rc_remaining += br * s->gop / fps;
         s->rc_left[1] = 1;
-        s->rc_left[2] = n - 1;
+        s->rc_left[2] = anchors - 1;
+        s->rc_left[3] = s->gop - anchors;
     }
 
-    double free_target, q_free;
