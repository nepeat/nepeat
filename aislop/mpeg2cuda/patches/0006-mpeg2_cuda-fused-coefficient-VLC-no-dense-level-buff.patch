---
 libavcodec/mpeg2_cuda.c  |  50 +++---
 libavcodec/mpeg2_cuda.cu | 320 +++++++++++++++++++++++++++++----------
 libavcodec/mpeg2_cuda.h  |   7 +-
 3 files changed, 276 insertions(+), 101 deletions(-)

