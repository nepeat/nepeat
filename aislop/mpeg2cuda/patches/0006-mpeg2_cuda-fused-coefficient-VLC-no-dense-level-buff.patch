-#define ME_NB_CAND 39
+#define ME_NB_CAND 32
+
+/* full-pel candidate k for the refinement, one per lane: the 5x5 window
+ * around the coarse vector without its corners (21), zero and its 4
+ * orthogonal neighbours (5), the neighbours' coarse vectors (4), the
+ * temporal predictor and zero's diagonal (+1,+1) */
+__constant__ int8_t c_win21[21][2] = {
+    { -1, -2 }, { 0, -2 }, { 1, -2 },
+    { -2, -1 }, { -1, -1 }, { 0, -1 }, { 1, -1 }, { 2, -1 },
+    { -2,  0 }, { -1,  0 }, { 0,  0 }, { 1,  0 }, { 2,  0 },
+    { -2,  1 }, { -1,  1 }, { 0,  1 }, { 1,  1 }, { 2,  1 },
+    { -1,  2 }, { 0,  2 }, { 1,  2 },
+};
 
-/* full-pel candidate k for the refinement: coarse +-2, zero +-1, neighbours */
 static __device__ __forceinline__ short2 me_candidate(int k, short2 cv, short2 tv,
                                                       const short2 *coarse,
                                                       int mb, int mx, int my, int mb_w, int mb_h)
 {
-    if (k < 25)
-        return make_short2(cv.x + k % 5 - 2, cv.y + k / 5 - 2);
-    if (k < 34)
-        return make_short2((k - 25) % 3 - 1, (k - 25) / 3 - 1);
+    if (k < 21)
+        return make_short2(cv.x + c_win21[k][0], cv.y + c_win21[k][1]);
     switch (k) {
-    case 34: return mx > 0        ? coarse[mb - 1]    : cv;
-    case 35: return mx < mb_w - 1 ? coarse[mb + 1]    : cv;
-    case 36: return my > 0        ? coarse[mb - mb_w] : cv;
-    case 37: return my < mb_h - 1 ? coarse[mb + mb_w] : cv;
-    default: return tv;
+    case 21: return make_short2(0, 0);
+    case 22: return make_short2(-1, 0);
+    case 23: return make_short2(1, 0);
+    case 24: return make_short2(0, -1);
+    case 25: return make_short2(0, 1);
+    case 26: return mx > 0        ? coarse[mb - 1]    : cv;
+    case 27: return mx < mb_w - 1 ? coarse[mb + 1]    : cv;
+    case 28: return my > 0        ? coarse[mb - mb_w] : cv;
+    case 29: return my < mb_h - 1 ? coarse[mb + mb_w] : cv;
+    case 30: return tv;
+    default: return make_short2(1, 1);
     }
 }
 
