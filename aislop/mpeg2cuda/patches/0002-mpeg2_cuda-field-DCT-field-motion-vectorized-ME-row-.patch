diff --git a/libavcodec/mpeg2_cuda.cu b/libavcodec/mpeg2_cuda.cu
index 5e0c49e..0090438 100644
--- a/libavcodec/mpeg2_cuda.cu
+++ b/libavcodec/mpeg2_cuda.cu
@@ -126,8 +126,29 @@ extern "C" __global__ void k_down4(const uint8_t *src, int pitch,
 
 /* ------------------------------------------------------------------------ */
 
-/* Exhaustive +-range search on 1/4 resolution planes, one warp per MB.
- * Output is a full-pel vector. */
+/* unaligned 32-bit load built from two aligned ones (planes have slack at the end) */
+static __device__ __forceinline__ uint32_t ldu32(const uint8_t *p)
+{
+    const uint32_t *w = (const uint32_t *)((uintptr_t)p & ~(uintptr_t)3);
+    return __funnelshift_rc(w[0], w[1], ((uintptr_t)p & 3) * 8);
+}
+
+static __device__ __forceinline__ void warp_argmin3(int &cost, int &idx, int &extra, int width)
+{
+    for (int off = width >> 1; off; off >>= 1) {
+        int oc = __shfl_xor_sync(FULL_MASK, cost,  off);
+        int oi = __shfl_xor_sync(FULL_MASK, idx,   off);
+        int oe = __shfl_xor_sync(FULL_MASK, extra, off);
+        if (oc < cost || (oc == cost && oi < idx)) {
+            cost  = oc;
+            idx   = oi;
+            extra = oe;
+        }
+    }
+}
+
+/* Exhaustive +-range search on 1/4 resolution planes, one warp per MB,
+ * one candidate per lane. Output is a full-pel vector. */
