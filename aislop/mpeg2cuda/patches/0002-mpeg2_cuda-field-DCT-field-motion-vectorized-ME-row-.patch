                                        int qpitch, int qw, int qh,
                                        int mb_w, int mb_h, int range, int lambda,
@@ -140,9 +161,9 @@ extern "C" __global__ void k_me_coarse(const uint8_t *cq, const uint8_t *rq,
 
     int mx = warp % mb_w, my = warp / mb_w;
     int x0 = mx * 4, y0 = my * 4;
-    int c[16];
-    for (int i = 0; i < 16; i++)
-        c[i] = cq[(y0 + (i >> 2)) * qpitch + x0 + (i & 3)];
+    uint32_t c[4];
+    for (int i = 0; i < 4; i++)
+        c[i] = *(const uint32_t *)(cq + (y0 + i) * qpitch + x0);
 
     int side = 2 * range + 1;
     int best = 0x7fffffff, bidx = side * side;
@@ -153,8 +174,8 @@ extern "C" __global__ void k_me_coarse(const uint8_t *cq, const uint8_t *rq,
             continue;
         const uint8_t *r = rq + ry * qpitch + rx;
         int s = 0;
-        for (int i = 0; i < 16; i++)
-            s += abs(c[i] - r[(i >> 2) * qpitch + (i & 3)]);
+        for (int i = 0; i < 4; i++)
+            s += __vsadu4(c[i], ldu32(r + i * qpitch));
         s = s * 16 + lambda * (mv_bits(8 * dx) + mv_bits(8 * dy));
         if (s < best) {
             best = s;
@@ -166,135 +187,313 @@ extern "C" __global__ void k_me_coarse(const uint8_t *cq, const uint8_t *rq,
         out[warp] = make_short2((bidx % side - range) * 4, (bidx / side - range) * 4);
 }
 
