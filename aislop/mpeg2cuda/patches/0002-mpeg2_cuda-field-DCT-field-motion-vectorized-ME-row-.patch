+/* per picture: int32 n_mb, int32 pict_type, M2CMBInfo[n_mb], int32 bitlen[n_mb] */
+static int dump_mb(AVCodecContext *avctx, int pict_type)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    int n_mb = s->mb_w * s->mb_h, ret;
+    size_t sz = n_mb * (sizeof(M2CMBInfo) + sizeof(int));
+    uint8_t *buf = av_malloc(sz);
