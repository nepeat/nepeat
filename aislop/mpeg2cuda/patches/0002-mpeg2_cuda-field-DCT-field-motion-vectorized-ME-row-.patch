 /* ------------------------------------------------------------------------ */
-/* rate control */
+/* rate control, in quantiser_scale units (2..62 linear, 1..112 non-linear) */
+
+static int qscale_of(const MPEG2CudaContext *s, int code)
+{
+    return s->pic_nl ? ff_mpeg2_non_linear_qscale[code] : 2 * code;
+}
+
+/* pick q_scale_type for a picture: linear unless it cannot reach q */
+static void choose_scale_type(MPEG2CudaContext *s, double q)
+{
+    s->pic_nl = s->nonlinear_q || q > 62;
+}
+
+/* code whose quantiser_scale is closest to q */
+static int code_of(const MPEG2CudaContext *s, double q)
+{
+    int best = 1;
+    for (int c = 1; c < 32; c++)
+        if (fabs(qscale_of(s, c) - q) < fabs(qscale_of(s, best) - q))
+            best = c;
+    return best;
+}
 
 static void rc_init(AVCodecContext *avctx)
 {
     MPEG2CudaContext *s = avctx->priv_data;
     double br = avctx->bit_rate;
 
