+    if (!buf)
+        return AVERROR(ENOMEM);
+    ret = CHECK_CU(s->cu->cuMemcpyDtoH(buf, s->mbinfo, n_mb * sizeof(M2CMBInfo)));
+    if (ret >= 0)
+        ret = CHECK_CU(s->cu->cuMemcpyDtoH(buf + n_mb * sizeof(M2CMBInfo), s->bitlen,
