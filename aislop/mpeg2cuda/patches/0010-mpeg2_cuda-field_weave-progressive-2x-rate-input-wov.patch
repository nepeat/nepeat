From 9173f3ecaf33c49b65a679d12cbad69243015d8c Mon Sep 17 00:00:00 2001
From: nepeat <nepeat@gmail.com>
Date: Fri, 16 Oct 2026 01:43:46 -0700
Subject: [PATCH 10/10] mpeg2_cuda: field_weave (progressive 2x-rate input
 woven into interlaced pictures on the GPU)

---
 libavcodec/mpeg2_cuda.c  | 63 +++++++++++++++++++++++++++++++++-------
 libavcodec/mpeg2_cuda.cu | 18 ++++++++----
 2 files changed, 65 insertions(+), 16 deletions(-)

diff --git a/libavcodec/mpeg2_cuda.c b/libavcodec/mpeg2_cuda.c
index 5d33a77..ded7323 100644
--- a/libavcodec/mpeg2_cuda.c
+++ b/libavcodec/mpeg2_cuda.c
@@ -114,6 +114,7 @@ typedef struct MPEG2CudaContext {
     uint8_t pic_flags[256];      /* per display number: 1 progressive, 2 tff */
     int64_t coded;
     int     eof;
+    int     weave_half;          /* field weave: top field loaded, waiting for the bottom */
 
     int64_t pts[256];            /* input pts by display number (ring) */
     int64_t dur;
@@ -148,6 +149,7 @@ typedef struct MPEG2CudaContext {
     char *recon_file;
     char *dump_file;
     int   frame_mode;
+    int   field_weave;
     int   me_range;
     int   me_flags;
     int   fcode;
@@ -461,7 +463,7 @@ static void rc_update(AVCodecContext *avctx, int pict_type, int qcode, int bits)
 
 /* ------------------------------------------------------------------------ */
 
-static int upload_frame(AVCodecContext *avctx, const AVFrame *frame, int slot)
+static int upload_frame(AVCodecContext *avctx, const AVFrame *frame, int slot, int bottom_only)
 {
     MPEG2CudaContext *s = avctx->priv_data;
     CUdeviceptr y, u, v;
@@ -505,7 +507,7 @@ static int upload_frame(AVCodecContext *avctx, const AVFrame *frame, int slot)
         int w = avctx->width, h = avctx->height;
         void *args[] = { &y, &pitch_y, &u, &v, &pitch_uv, &nv12, &w, &h,
                          &s->src[slot][0], &s->src[slot][1], &s->src[slot][2],
-                         &s->py, &s->pc, &s->pw, &s->ph };
+                         &s->py, &s->pc, &s->pw, &s->ph, &bottom_only };
         return launch(avctx, F_LOAD, FFALIGN(s->pw / 8, 32) / 32, FFALIGN(s->ph, 8) / 8,
                       32, 8, args);
     }
@@ -881,13 +883,42 @@ static int code_group(AVCodecContext *avctx, int anchor_type, int slot, int64_t
     return ret;
 }
 
+/* a complete source picture n is in src[slot]: code it or buffer it */
+static int picture_ready(AVCodecContext *avctx, int64_t n, int slot)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    s->n_in++;
+    if (n % s->gop == 0)
+        return code_group(avctx, 1, slot, n);
+    if (n % (s->bf + 1) == 0)
+        return code_group(avctx, 2, slot, n);
+    s->pend_n[s->npend++] = n;
+    return 0;
+}
+
 static int submit_frame(AVCodecContext *avctx, const AVFrame *frame)
 {
     MPEG2CudaContext *s = avctx->priv_data;
-    int64_t n = s->n_in++;
+    int64_t n = s->n_in;
     int slot = n % (s->bf + 1);
     int ret;
 
+    if (s->field_weave) {
+        /* two progressive frames make one interlaced picture: the first
+         * fills the whole frame (so a lone last frame still codes), the
+         * second overwrites the bottom field */
+        if (!s->weave_half) {
+            s->pts[n & 255]       = frame->pts;
+            s->pic_flags[n & 255] = 2;          /* interlaced, top field first */
+            ret = upload_frame(avctx, frame, slot, 0);
+            s->weave_half = 1;
+            return ret;
+        }
+        s->weave_half = 0;
+        ret = upload_frame(avctx, frame, slot, 1);
+        return ret < 0 ? ret : picture_ready(avctx, n, slot);
+    }
+
     s->pts[n & 255] = frame->pts;
     /* follow the source: interlaced frames keep their field order, progressive
      * frames are coded as progressive_frame (frame DCT and prediction) unless
@@ -898,15 +929,10 @@ static int submit_frame(AVCodecContext *avctx, const AVFrame *frame)
         int prog = !il && s->frame_mode == 0;
         s->pic_flags[n & 255] = prog | tff << 1;
     }
-    ret = upload_frame(avctx, frame, slot);
+    ret = upload_frame(avctx, frame, slot, 0);
     if (ret < 0)
         return ret;
-    if (n % s->gop == 0)
-        return code_group(avctx, 1, slot, n);
-    if (n % (s->bf + 1) == 0)
-        return code_group(avctx, 2, slot, n);
-    s->pend_n[s->npend++] = n;
-    return 0;
+    return picture_ready(avctx, n, slot);
 }
 
 /* end of stream: the last buffered picture becomes a P anchor */
@@ -927,6 +953,17 @@ static int mpeg2_cuda_receive_packet(AVCodecContext *avctx, AVPacket *pkt)
     /* hold one packet back so the last one can carry sequence_end_code */
     while (s->out_count < 2 && !(s->eof && s->out_count)) {
         if (s->eof) {
+            if (s->weave_half) {
+                s->weave_half = 0;
+                ret = CHECK_CU(s->cu->cuCtxPushCurrent(s->hwctx->cuda_ctx));
+                if (ret < 0)
+                    return ret;
+                ret = picture_ready(avctx, s->n_in, s->n_in % (s->bf + 1));
+                CHECK_CU(s->cu->cuCtxPopCurrent(&dummy));
+                if (ret < 0)
+                    return ret;
+                continue;
+            }
             if (!s->npend)
                 return AVERROR_EOF;
         } else {
@@ -1078,6 +1115,9 @@ static av_cold int mpeg2_cuda_init(AVCodecContext *avctx)
 {
     MPEG2CudaContext *s = avctx->priv_data;
     AVRational fr = avctx->framerate.num ? avctx->framerate : av_inv_q(avctx->time_base);
+    /* field weave codes one picture per two input frames */
+    if (s->field_weave)
+        fr = av_mul_q(fr, (AVRational){ 1, 2 });
     AVRational dar;
     CUcontext dummy;
     int n_mb, ret;
@@ -1268,6 +1308,9 @@ static const AVOption options[] = {
       AV_OPT_TYPE_INT, { .i64 = 0 }, 0, 1, VE, .unit = "frame_mode" },
         { "auto",       "follow the source: progressive frames as progressive_frame, interlaced keep their field order", 0, AV_OPT_TYPE_CONST, { .i64 = 0 }, 0, 0, VE, .unit = "frame_mode" },
         { "interlaced", "code every picture as an interlaced frame (top field first for progressive input)", 0, AV_OPT_TYPE_CONST, { .i64 = 1 }, 0, 0, VE, .unit = "frame_mode" },
+    { "field_weave",     "input is progressive at twice the frame rate: weave frame pairs into "
+                         "the top and bottom fields of interlaced pictures (60p -> 1080i30)", OFFSET(field_weave),
+      AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, VE },
     { "fcode",           "largest f_code (search range +-8 << f_code pels); each picture uses the smallest that fits", OFFSET(fcode),
       AV_OPT_TYPE_INT, { .i64 = 4 }, 1, 5, VE },
     { "me_flags",        "motion search tools", OFFSET(me_flags),
diff --git a/libavcodec/mpeg2_cuda.cu b/libavcodec/mpeg2_cuda.cu
index 7b9d5e8..06b60f7 100644
--- a/libavcodec/mpeg2_cuda.cu
+++ b/libavcodec/mpeg2_cuda.cu
@@ -99,8 +99,10 @@ extern "C" __global__ void k_load(const uint8_t *sy, int sy_pitch,
                                   const uint8_t *su, const uint8_t *sv, int suv_pitch,
                                   int nv12, int w, int h,
                                   uint8_t *dy, uint8_t *du, uint8_t *dv,
-                                  int py, int pc, int pw, int ph)
+                                  int py, int pc, int pw, int ph, int bottom_only)
 {
+    /* bottom_only (field weave): write only the bottom field's rows, i.e.
+     * odd luma rows and odd chroma rows, from the same rows of the source */
     const int x = (blockIdx.x * blockDim.x + threadIdx.x) * 8;
     const int y = blockIdx.y * blockDim.y + threadIdx.y;
     if (x >= pw || y >= ph)
@@ -108,16 +110,20 @@ extern "C" __global__ void k_load(const uint8_t *sy, int sy_pitch,
 
     const int ys = min(y, h - 1);
     const uint8_t *srow = sy + ys * sy_pitch;
-    if (x + 8 <= w && !((uintptr_t)(srow + x) & 7)) {
-        *(uint2 *)(dy + y * py + x) = *(const uint2 *)(srow + x);
-    } else {
-        for (int k = 0; k < 8; k++)
-            dy[y * py + x + k] = srow[min(x + k, w - 1)];
+    if (!bottom_only || (y & 1)) {
+        if (x + 8 <= w && !((uintptr_t)(srow + x) & 7)) {
+            *(uint2 *)(dy + y * py + x) = *(const uint2 *)(srow + x);
+        } else {
+            for (int k = 0; k < 8; k++)
+                dy[y * py + x + k] = srow[min(x + k, w - 1)];
+        }
     }
 
     if (y & 1)
         return;
     const int cx = x >> 1, cy = y >> 1;
+    if (bottom_only && !(cy & 1))
+        return;
     const int cw = (w + 1) >> 1;
     const int scy = min(cy, ((h + 1) >> 1) - 1);
     uint8_t *du_ = du + cy * pc + cx, *dv_ = dv + cy * pc + cx;
-- 
2.55.0

