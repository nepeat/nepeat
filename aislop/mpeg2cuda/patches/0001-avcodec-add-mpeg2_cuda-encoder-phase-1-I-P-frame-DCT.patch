+
+/*
+ * Pipeline per picture (one CUDA stream, no host round trips until the
+ * finished bitstream is copied back):
+ *
+ *   k_load        input frame (nv12 / yuv420p, device memory) -> padded planes
+ *   k_down4       4x4 decimation for the coarse motion search        (P only)
+ *   k_me_coarse   full search on the decimated planes, warp per MB   (P only)
+ *   k_me_refine   full-pel + half-pel refinement, intra/inter choice (P only)
+ *   k_encode_mb   prediction, fDCT, quant, dequant, mismatch control,
+ *                 bit-exact simple_idct reconstruction, block per MB
+ *   k_vlc         macroblock layer VLC, thread per MB into private slots
+ *   k_pack        one slice per MB row, bit-shift MB slots into place
+ *   k_concat      byte-aligned slices -> one contiguous buffer
+ */
+
+#include "mpeg2_cuda.h"
+
+#define FULL_MASK 0xffffffffu
+
+__device__ M2CTables g_tab;
+
+static __device__ __forceinline__ int clip_u8(int v)
+{
+    return v < 0 ? 0 : (v > 255 ? 255 : v);
+}
+
+static __device__ __forceinline__ int warp_sum(int v)
+{
+    for (int off = 16; off; off >>= 1)
+        v += __shfl_xor_sync(FULL_MASK, v, off);
+    return v;
+}
+
+static __device__ __forceinline__ void warp_argmin(int &cost, int &idx)
+{
+    for (int off = 16; off; off >>= 1) {
+        int oc = __shfl_xor_sync(FULL_MASK, cost, off);
+        int oi = __shfl_xor_sync(FULL_MASK, idx,  off);
+        if (oc < cost || (oc == cost && oi < idx)) {
+            cost = oc;
+            idx  = oi;
+        }
+    }
+}
+
+/* approximate VLC length of one motion vector component (half-pel units) */
+static __device__ __forceinline__ int mv_bits(int v)
+{
+    v = abs(v);
+    return v ? 2 * (32 - __clz(v)) + 1 : 1;
+}
+
+/* ------------------------------------------------------------------------ */
+
+/* ffnvcodec only exposes the legacy 32-bit cuModuleGetGlobal, so the tables
+ * are copied into place by a kernel instead. */
+extern "C" __global__ void k_init_tables(const uint32_t *src, int words)
+{
+    uint32_t *dst = (uint32_t *)&g_tab;
+    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < words; i += gridDim.x * blockDim.x)
+        dst[i] = src[i];
+}
+
+extern "C" __global__ void k_load(const uint8_t *sy, int sy_pitch,
+                                  const uint8_t *su, const uint8_t *sv, int suv_pitch,
+                                  int nv12, int w, int h,
+                                  uint8_t *dy, uint8_t *du, uint8_t *dv,
+                                  int py, int pc, int pw, int ph)
+{
+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= pw || y >= ph)
+        return;
+
+    dy[y * py + x] = sy[min(y, h - 1) * sy_pitch + min(x, w - 1)];
+
+    if (!(x & 1) && !(y & 1)) {
+        int cx  = x >> 1, cy = y >> 1;
+        int scx = min(cx, ((w + 1) >> 1) - 1);
+        int scy = min(cy, ((h + 1) >> 1) - 1);
+        if (nv12) {
+            du[cy * pc + cx] = su[scy * suv_pitch + 2 * scx];
+            dv[cy * pc + cx] = su[scy * suv_pitch + 2 * scx + 1];
+        } else {
+            du[cy * pc + cx] = su[scy * suv_pitch + scx];
+            dv[cy * pc + cx] = sv[scy * suv_pitch + scx];
+        }
+    }
+}
+
+extern "C" __global__ void k_down4(const uint8_t *src, int pitch,
+                                   uint8_t *dst, int qpitch, int qw, int qh)
+{
+    int x = blockIdx.x * blockDim.x + threadIdx.x;
+    int y = blockIdx.y * blockDim.y + threadIdx.y;
+    if (x >= qw || y >= qh)
+        return;
+
+    const uint8_t *s = src + 4 * y * pitch + 4 * x;
+    int sum = 0;
+    for (int j = 0; j < 4; j++)
+        for (int i = 0; i < 4; i++)
+            sum += s[j * pitch + i];
+    dst[y * qpitch + x] = (sum + 8) >> 4;
+}
+
+/* ------------------------------------------------------------------------ */
+
+/* Exhaustive +-range search on 1/4 resolution planes, one warp per MB.
+ * Output is a full-pel vector. */
+extern "C" __global__ void k_me_coarse(const uint8_t *cq, const uint8_t *rq,
+                                       int qpitch, int qw, int qh,
+                                       int mb_w, int mb_h, int range, int lambda,
+                                       short2 *out)
+{
+    int warp = (blockIdx.x * blockDim.x + threadIdx.x) >> 5;
+    int lane = threadIdx.x & 31;
+    if (warp >= mb_w * mb_h)
+        return;
+
+    int mx = warp % mb_w, my = warp / mb_w;
+    int x0 = mx * 4, y0 = my * 4;
+    int c[16];
+    for (int i = 0; i < 16; i++)
+        c[i] = cq[(y0 + (i >> 2)) * qpitch + x0 + (i & 3)];
+
+    int side = 2 * range + 1;
+    int best = 0x7fffffff, bidx = side * side;
+    for (int k = lane; k < side * side; k += 32) {
+        int dx = k % side - range, dy = k / side - range;
+        int rx = x0 + dx, ry = y0 + dy;
+        if (rx < 0 || ry < 0 || rx + 4 > qw || ry + 4 > qh)
+            continue;
+        const uint8_t *r = rq + ry * qpitch + rx;
+        int s = 0;
+        for (int i = 0; i < 16; i++)
+            s += abs(c[i] - r[(i >> 2) * qpitch + (i & 3)]);
+        s = s * 16 + lambda * (mv_bits(8 * dx) + mv_bits(8 * dy));
+        if (s < best) {
+            best = s;
+            bidx = k;
+        }
+    }
+    warp_argmin(best, bidx);
+    if (lane == 0)
+        out[warp] = make_short2((bidx % side - range) * 4, (bidx / side - range) * 4);
+}
+
+struct MECtx {
+    const uint8_t *ref;
+    int py, x0, y0, r, c0;
+    int cp[8];
+};
+
+static __device__ __forceinline__ int sad_full(const MECtx &m, int dx, int dy)
+{
+    const uint8_t *rp = m.ref + (m.y0 + m.r + dy) * m.py + m.x0 + m.c0 + dx;
+    int s = 0;
+    for (int k = 0; k < 8; k++)
+        s += abs(m.cp[k] - rp[k]);
+    return warp_sum(s);
+}
+
+static __device__ __forceinline__ int sad_half(const MECtx &m, int mvx, int mvy)
+{
+    const uint8_t *rp = m.ref + (m.y0 + m.r + (mvy >> 1)) * m.py + m.x0 + m.c0 + (mvx >> 1);
+    int hx = mvx & 1, hy = mvy & 1;
+    int s = 0;
+    for (int k = 0; k < 8; k++) {
+        int a = rp[k], p;
+        if (hx && hy)
+            p = (a + rp[k + 1] + rp[k + m.py] + rp[k + m.py + 1] + 2) >> 2;
+        else if (hx)
+            p = (a + rp[k + 1] + 1) >> 1;
+        else if (hy)
+            p = (a + rp[k + m.py] + 1) >> 1;
+        else
+            p = a;
+        s += abs(m.cp[k] - p);
+    }
+    return warp_sum(s);
+}
+
+/* Full-pel refinement around a handful of predictors followed by a half-pel
+ * step, one warp per MB. Also makes the intra/inter decision. */
+extern "C" __global__ void k_me_refine(const uint8_t *cur, const uint8_t *ref,
+                                       int py, int pw, int ph,
+                                       int mb_w, int mb_h,
+                                       const short2 *coarse, int lambda, int mv_max,
+                                       int intra_bias, M2CMotion *out)
+{
+    int warp = (blockIdx.x * blockDim.x + threadIdx.x) >> 5;
+    int lane = threadIdx.x & 31;
+    if (warp >= mb_w * mb_h)
+        return;
+
+    int mx = warp % mb_w, my = warp / mb_w;
+    MECtx m;
+    m.ref = ref;
+    m.py  = py;
+    m.x0  = mx * 16;
+    m.y0  = my * 16;
+    m.r   = lane >> 1;
+    m.c0  = (lane & 1) * 8;
+    const uint8_t *cr = cur + (m.y0 + m.r) * py + m.x0 + m.c0;
+    int sum = 0;
+    for (int k = 0; k < 8; k++) {
+        m.cp[k] = cr[k];
+        sum += m.cp[k];
+    }
+    int mean = (warp_sum(sum) + 128) >> 8;
+    int dev  = 0;
+    for (int k = 0; k < 8; k++)
+        dev += abs(m.cp[k] - mean);
+    int intra_cost = warp_sum(dev);
+
+    /* legal vector range in half-pel units: stay inside the picture and
+     * inside the f_code range */
+    int lo_x = max(-2 * m.x0, -mv_max - 1), hi_x = min(2 * (pw - 16 - m.x0), mv_max);
+    int lo_y = max(-2 * m.y0, -mv_max - 1), hi_y = min(2 * (ph - 16 - m.y0), mv_max);
+
+    int best_cost = 0x7fffffff, best_sad = 0, bx = 0, by = 0;
+
+#define TRY_FULL(DX, DY) do {                                                   \
+        int dx_ = (DX), dy_ = (DY);                                             \
+        if (2 * dx_ >= lo_x && 2 * dx_ <= hi_x &&                               \
+            2 * dy_ >= lo_y && 2 * dy_ <= hi_y) {                               \
+            int s_ = sad_full(m, dx_, dy_);                                     \
+            int c_ = s_ + lambda * (mv_bits(2 * dx_) + mv_bits(2 * dy_));       \
+            if (c_ < best_cost) {                                               \
+                best_cost = c_; best_sad = s_; bx = dx_; by = dy_;              \
+            }                                                                   \
+        }                                                                       \
+    } while (0)
+
+    short2 cv = coarse[warp];
+    for (int j = -2; j <= 2; j++)
+        for (int i = -2; i <= 2; i++)
+            TRY_FULL(cv.x + i, cv.y + j);
+    for (int j = -1; j <= 1; j++)
+        for (int i = -1; i <= 1; i++)
+            TRY_FULL(i, j);
+    if (mx > 0)        { short2 n = coarse[warp - 1];    TRY_FULL(n.x, n.y); }
+    if (mx < mb_w - 1) { short2 n = coarse[warp + 1];    TRY_FULL(n.x, n.y); }
+    if (my > 0)        { short2 n = coarse[warp - mb_w]; TRY_FULL(n.x, n.y); }
+    if (my < mb_h - 1) { short2 n = coarse[warp + mb_w]; TRY_FULL(n.x, n.y); }
+#undef TRY_FULL
+
+    int bmx = 2 * bx, bmy = 2 * by;
+    int cx = bmx, cy = bmy;
+    for (int j = -1; j <= 1; j++) {
+        for (int i = -1; i <= 1; i++) {
+            int vx = cx + i, vy = cy + j;
+            if (!(i | j) || vx < lo_x || vx > hi_x || vy < lo_y || vy > hi_y)
+                continue;
+            int s = sad_half(m, vx, vy);
+            int c = s + lambda * (mv_bits(vx) + mv_bits(vy));
+            if (c < best_cost) {
+                best_cost = c;
+                best_sad  = s;
+                bmx = vx;
+                bmy = vy;
+            }
+        }
+    }
+
+    if (lane == 0) {
+        M2CMotion o;
+        o.mvx   = bmx;
+        o.mvy   = bmy;
+        o.intra = intra_cost + intra_bias < best_sad;
+        o.sad   = best_sad;
+        out[warp] = o;
+    }
+}
+
+/* ------------------------------------------------------------------------ */
+
+/* simple_idct (8-bit) constants, see libavcodec/simple_idct_template.c */
+#define W1 22725
+#define W2 21407
+#define W3 19266
+#define W4 16383
+#define W5 12873
+#define W6  8867
+#define W7  4520
+
+static __device__ __forceinline__ void idct_ab(const short *v, int stride, unsigned a0_init,
+                                               unsigned a[4], unsigned b[4])
+{
+    int v1 = v[stride], v2 = v[2 * stride], v3 = v[3 * stride];
+    int v4 = v[4 * stride], v5 = v[5 * stride], v6 = v[6 * stride], v7 = v[7 * stride];
+    unsigned a0 = a0_init;
+    a[0] = a0 + (unsigned)W2 * v2 + (unsigned)W4 * v4 + (unsigned)W6 * v6;
+    a[1] = a0 + (unsigned)W6 * v2 - (unsigned)W4 * v4 - (unsigned)W2 * v6;
+    a[2] = a0 - (unsigned)W6 * v2 - (unsigned)W4 * v4 + (unsigned)W2 * v6;
+    a[3] = a0 - (unsigned)W2 * v2 + (unsigned)W4 * v4 - (unsigned)W6 * v6;
+    b[0] = (unsigned)W1 * v1 + (unsigned)W3 * v3 + (unsigned)W5 * v5 + (unsigned)W7 * v7;
+    b[1] = (unsigned)W3 * v1 - (unsigned)W7 * v3 - (unsigned)W1 * v5 - (unsigned)W5 * v7;
+    b[2] = (unsigned)W5 * v1 - (unsigned)W1 * v3 + (unsigned)W7 * v5 + (unsigned)W3 * v7;
+    b[3] = (unsigned)W7 * v1 - (unsigned)W5 * v3 + (unsigned)W3 * v5 - (unsigned)W1 * v7;
+}
+
+static __device__ __forceinline__ int idct_out(const unsigned a[4], const unsigned b[4],
+                                               int i, int shift)
+{
+    return i < 4 ? (int)(a[i] + b[i]) >> shift : (int)(a[7 - i] - b[7 - i]) >> shift;
+}
+
+/* One thread block (384 threads = 6 blocks x 64 coefficients) per MB. */
+extern "C" __global__ void __launch_bounds__(384)
+k_encode_mb(M2CEncodeParams p)
+{
+    __shared__ float s_a[384], s_b[384];
+    __shared__ short s_c[384], s_r[384];
+    __shared__ int   s_last[6], s_par[12], s_dc[6];
+
+    const int mb  = blockIdx.x;
+    const int mx  = mb % p.mb_w, my = mb / p.mb_w;
+    const int t   = threadIdx.x;
+    const int blk = t >> 6, r = t & 63, y = r >> 3, x = r & 7;
+
+    int intra = 1, mvx = 0, mvy = 0;
+    if (p.pict_type == 2) {
+        M2CMotion mo = p.motion[mb];
+        intra = mo.intra;
+        if (!intra) {
+            mvx = mo.mvx;
+            mvy = mo.mvy;
+        }
+    }
+
+    const uint8_t *cplane, *rplane;
+    uint8_t *oplane;
+    int pitch, X, Y, vx, vy;
+    if (blk < 4) {
+        cplane = p.cur_y; rplane = p.ref_y; oplane = p.rec_y;
+        pitch  = p.py;
+        X  = mx * 16 + (blk & 1) * 8 + x;
+        Y  = my * 16 + (blk >> 1) * 8 + y;
+        vx = mvx;
+        vy = mvy;
+    } else {
+        cplane = blk == 4 ? p.cur_u : p.cur_v;
+        rplane = blk == 4 ? p.ref_u : p.ref_v;
+        oplane = blk == 4 ? p.rec_u : p.rec_v;
+        pitch  = p.pc;
+        X  = mx * 8 + x;
+        Y  = my * 8 + y;
+        vx = mvx / 2;   /* truncation towards zero, as in the spec */
+        vy = mvy / 2;
+    }
+
+    int src  = cplane[Y * pitch + X];
+    int pred = 0;
+    if (!intra) {
+        const uint8_t *rp = rplane + (Y + (vy >> 1)) * pitch + X + (vx >> 1);
+        int hx = vx & 1, hy = vy & 1, a = rp[0];
+        if (hx && hy)
+            pred = (a + rp[1] + rp[pitch] + rp[pitch + 1] + 2) >> 2;
+        else if (hx)
+            pred = (a + rp[1] + 1) >> 1;
+        else if (hy)
+            pred = (a + rp[pitch] + 1) >> 1;
+        else
+            pred = a;
+    }
+
+    s_a[t] = (float)(src - pred);
+    if (t < 6)
+        s_last[t] = -1;
+    __syncthreads();
+
+    /* separable forward DCT, F(u,v) = C(u)C(v)/4 sum f(x,y) cos() cos() */
+    float acc = 0.0f;
+    for (int k = 0; k < 8; k++)
+        acc += s_a[blk * 64 + y * 8 + k] * g_tab.dct[x][k];
+    s_b[t] = acc;
+    __syncthreads();
+    acc = 0.0f;
+    for (int k = 0; k < 8; k++)
+        acc += s_b[blk * 64 + k * 8 + x] * g_tab.dct[y][k];
+
+    /* quantisation; quantiser_scale = 2 * code (q_scale_type 0) */
+    const int qs = 2 * p.qcode;
+    int level, W;
+    if (intra) {
+        W = g_tab.intra_matrix[r];
+        if (r == 0) {
+            level = clip_u8(__float2int_rn(acc * 0.125f));
+        } else {
+            int lmax = min(2047, 32767 / (qs * W));
+            int a    = min(lmax, (int)(fabsf(acc) * 16.0f / (qs * W) + p.intra_bias));
+            level    = acc < 0 ? -a : a;
+        }
+    } else {
+        W = g_tab.inter_matrix[r];
+        int lmax = min(2047, (65535 / (qs * W) - 1) >> 1);
+        int a    = min(lmax, (int)(fabsf(acc) * 16.0f / (qs * W) + p.inter_bias));
+        level    = acc < 0 ? -a : a;
+    }
+
+    const int sp = g_tab.iscan[r];
+    p.levels[mb * 384 + blk * 64 + sp] = level;
+    if (level && !(intra && r == 0))
+        atomicMax(&s_last[blk], sp);
+    if (intra && r == 0)
+        s_dc[blk] = level;
+    __syncthreads();
+
+    int cbp = 0;
+    for (int b = 0; b < 6; b++)
+        if (s_last[b] >= 0)
+            cbp |= 32 >> b;
+    const int coded = intra || s_last[blk] >= 0;
+
+    /* dequantisation exactly as libavcodec/mpeg12dec.c does it */
+    int d = 0;
+    if (intra) {
+        if (r == 0) {
+            d = level * 8;
+        } else if (level) {
+            d = (abs(level) * qs * W) >> 4;
+            d = level < 0 ? -d : d;
+        }
+    } else if (level) {
+        d = ((2 * abs(level) + 1) * qs * W) >> 5;
+        d = level < 0 ? -d : d;
+    }
+
+    /* mismatch control: toggle the LSB of coefficient 63 if the sum is even */
+    unsigned bal = __ballot_sync(FULL_MASK, d & 1);
+    if ((t & 31) == 0)
+        s_par[t >> 5] = __popc(bal);
+    __syncthreads();
+    if (r == 63 && coded && !((s_par[2 * blk] + s_par[2 * blk + 1]) & 1))
+        d ^= 1;
+    s_c[t] = d;
+    __syncthreads();
+
+    /* simple_idct rows, including its DC-only shortcut */
+    {
+        const short *row = s_c + blk * 64 + y * 8;
+        short out;
+        if (!(row[1] | row[2] | row[3] | row[4] | row[5] | row[6] | row[7])) {
+            out = (short)(row[0] * 8);
+        } else {
+            unsigned a[4], b[4];
+            idct_ab(row, 1, (unsigned)W4 * row[0] + (1 << 10), a, b);
+            out = (short)idct_out(a, b, x, 11);
+        }
+        s_r[t] = out;
+    }
+    __syncthreads();
+
+    int rec;
+    {
+        const short *col = s_r + blk * 64 + x;
+        unsigned a[4], b[4];
+        idct_ab(col, 8, (unsigned)W4 * (col[0] + 32), a, b);
+        int res = idct_out(a, b, y, 20);
+        if (intra)
+            rec = clip_u8(res);
+        else if (coded)
+            rec = clip_u8(pred + res);
+        else
+            rec = pred;
+    }
+    oplane[Y * pitch + X] = rec;
+
+    if (t == 0) {
+        M2CMBInfo mi;
+        mi.mvx   = mvx;
+        mi.mvy   = mvy;
+        mi.intra = intra;
+        mi.cbp   = intra ? 63 : cbp;
+        mi.skip  = !intra && p.pict_type == 2 && !(mvx | mvy) && !cbp &&
+                   mx > 0 && mx < p.mb_w - 1;
+        mi.pad   = 0;
+        mi.dc[0] = intra ? s_dc[3] : 0;
+        mi.dc[1] = intra ? s_dc[4] : 0;
+        mi.dc[2] = intra ? s_dc[5] : 0;
+        for (int b = 0; b < 6; b++)
+            mi.last[b] = s_last[b];
+        p.mbinfo[mb] = mi;
+    }
+}
+
+/* ------------------------------------------------------------------------ */
+
+struct BitWriter {
+    uint32_t *out;
+    unsigned long long acc;
+    int n, words;
+};
+
+static __device__ __forceinline__ void bw_put(BitWriter &bw, uint32_t code, int len)
+{
+    bw.acc = (bw.acc << len) | code;
+    bw.n  += len;
+    if (bw.n >= 32) {
+        bw.out[bw.words++] = (uint32_t)(bw.acc >> (bw.n - 32));
+        bw.n -= 32;
+    }
+}
+
+static __device__ __forceinline__ void bw_put_vlc(BitWriter &bw, uint32_t e)
+{
+    bw_put(bw, e & 0xffffff, e >> 24);
+}
+
+static __device__ __forceinline__ int bw_flush(BitWriter &bw)
+{
+    int bits = bw.words * 32 + bw.n;
+    if (bw.n)
+        bw.out[bw.words++] = (uint32_t)(bw.acc << (32 - bw.n));
+    return bits;
+}
+
+static __device__ void put_motion(BitWriter &bw, int val, int fcode)
+{
+    if (!val) {
+        bw_put(bw, 1, 1);
+        return;
+    }
+    int bit_size = fcode - 1;
+    int shift    = 32 - (5 + bit_size);
+    val = (val << shift) >> shift;   /* modulo wrap into the f_code range */
+    int sign = val < 0;
+    val = abs(val) - 1;
+    int code = (val >> bit_size) + 1;
+    bw_put_vlc(bw, g_tab.mv[code]);
+    bw_put(bw, sign, 1);
+    if (bit_size)
+        bw_put(bw, val & ((1 << bit_size) - 1), bit_size);
+}
+
+static __device__ void put_dc(BitWriter &bw, int diff, int chroma)
+{
+    int size = diff ? 32 - __clz(abs(diff)) : 0;
+    bw_put_vlc(bw, g_tab.dc[chroma][size]);
+    if (size)
+        bw_put(bw, (diff > 0 ? diff : diff - 1) & ((1 << size) - 1), size);
+}
+
+static __device__ void put_block(BitWriter &bw, const short *lev, int start, int last,
+                                 int tbl, int first_special)
+{
+    int prev = start - 1;
+    for (int i = start; i <= last; i++) {
+        int level = lev[i];
+        if (!level)
+            continue;
+        int run   = i - prev - 1;
+        int alev  = abs(level);
+        int sign  = level < 0;
+        prev = i;
+        if (first_special && i == 0 && alev == 1) {
+            bw_put(bw, 2 | sign, 2);
+            continue;
+        }
+        uint32_t e = alev <= 40 ? g_tab.ac[tbl][run][alev] : 0;
+        if (e) {
+            bw_put(bw, ((e & 0xffffff) << 1) | sign, (e >> 24) + 1);
+        } else {
+            bw_put(bw, (1 << 6) | run, 12);
+            bw_put(bw, level & 0xfff, 12);
+        }
+    }
+    bw_put_vlc(bw, g_tab.eob[tbl]);
+}
+
+/* macroblock layer, one thread per MB into a private slot */
+extern "C" __global__ void k_vlc(const M2CMBInfo *mbi, const short *levels,
+                                 int mb_w, int mb_h, int pict_type, int fcode,
+                                 uint32_t *slots, int *bitlen)
+{
+    int mb = blockIdx.x * blockDim.x + threadIdx.x;
+    if (mb >= mb_w * mb_h)
+        return;
+
+    M2CMBInfo m = mbi[mb];
+    if (m.skip) {
+        bitlen[mb] = 0;
+        return;
+    }
+
+    const int mx = mb % mb_w;
+    BitWriter bw;
+    bw.out   = slots + (size_t)mb * M2C_SLOT_WORDS;
+    bw.acc   = 0;
+    bw.n     = 0;
+    bw.words = 0;
+
+    /* macroblock_address_increment: 1 + preceding skipped run */
+    int inc = 1;
+    for (int k = mb - 1; k >= mb - mx && mbi[k].skip; k--)
+        inc++;
+    while (inc > 33) {
+        bw_put(bw, 0x008, 11);
+        inc -= 33;
+    }
+    bw_put_vlc(bw, g_tab.addr[inc - 1]);
+
+    /* predictors from the previous MB of the slice */
+    int pmvx = 0, pmvy = 0, dcp[3] = { 128, 128, 128 };
+    if (mx > 0) {
+        M2CMBInfo l = mbi[mb - 1];
+        if (!l.skip && !l.intra) {
+            pmvx = l.mvx;
+            pmvy = l.mvy;
+        }
+        if (l.intra) {
+            dcp[0] = l.dc[0];
+            dcp[1] = l.dc[1];
+            dcp[2] = l.dc[2];
+        }
+    }
+
+    const short *lev = levels + (size_t)mb * 384;
+    if (m.intra) {
+        if (pict_type == 1)
+            bw_put(bw, 1, 1);        /* intra */
+        else
+            bw_put(bw, 3, 5);        /* intra in P: 0001 1 */
+        for (int b = 0; b < 6; b++) {
+            int c  = b < 4 ? 0 : b - 3;
+            int dc = lev[b * 64];
+            put_dc(bw, dc - dcp[c], c > 0);
+            dcp[c] = dc;
+            put_block(bw, lev + b * 64, 1, m.last[b], 1, 0);
+        }
+    } else {
+        int has_mv = (m.mvx | m.mvy) || !m.cbp;
+        if (m.cbp)
+            bw_put(bw, 1, has_mv ? 1 : 2);   /* '1' MC coded, '01' no-MC coded */
+        else
+            bw_put(bw, 1, 3);                /* '001' MC not coded */
+        if (has_mv) {
+            put_motion(bw, m.mvx - pmvx, fcode);
+            put_motion(bw, m.mvy - pmvy, fcode);
+        }
+        if (m.cbp) {
+            bw_put_vlc(bw, g_tab.cbp[m.cbp]);
+            for (int b = 0; b < 6; b++)
+                if (m.cbp & (32 >> b))
+                    put_block(bw, lev + b * 64, 0, m.last[b], 0, 1);
+        }
+    }
+
+    bitlen[mb] = bw_flush(bw);
+}
+
+/* one slice per MB row: slice header + bit-shifted MB slots, byte aligned */
+extern "C" __global__ void k_pack(const uint32_t *slots, const int *bitlen,
+                                  int mb_w, int qcode, uint32_t *rows,
+                                  int row_words, int *row_bytes)
+{
+    __shared__ int s_off[M2C_MAX_MB_W + 1];
+    const int row = blockIdx.x, t = threadIdx.x;
+    uint32_t *out = rows + (size_t)row * row_words;
+
+    int len = t < mb_w ? bitlen[row * mb_w + t] : 0;
+    s_off[t + 1] = len;
+    if (t == 0)
+        s_off[0] = 0;
+    __syncthreads();
+    /* inclusive scan of s_off[1..] */
+    for (int d = 1; d < M2C_MAX_MB_W; d <<= 1) {
+        int v = t >= d ? s_off[t + 1 - d] : 0;
+        __syncthreads();
+        s_off[t + 1] += v;
+        __syncthreads();
+    }
+
+    const int hdr_bits   = 38;
+    const int total_bits = hdr_bits + s_off[mb_w];
+    const int nwords     = (total_bits + 31) >> 5;
+    for (int i = t; i < nwords + 1; i += blockDim.x)
+        out[i] = 0;
+    __syncthreads();
+
+    if (t == 0) {
+        out[0] = 0x00000101u + row;   /* slice_start_code */
+        atomicOr(&out[1], (uint32_t)qcode << 27);   /* quantiser_scale_code, extra_bit_slice=0 */
+    }
+
+    if (t < mb_w && len) {
+        const uint32_t *src = slots + (size_t)(row * mb_w + t) * M2C_SLOT_WORDS;
+        int off   = hdr_bits + s_off[t];
+        int base  = off >> 5, shift = off & 31;
+        int words = (len + 31) >> 5;
+        for (int j = 0; j < words; j++) {
+            uint32_t w = src[j];
+            atomicOr(&out[base + j], w >> shift);
+            if (shift)
+                atomicOr(&out[base + j + 1], w << (32 - shift));
+        }
+    }
+
+    if (t == 0)
+        row_bytes[row] = (total_bits + 7) >> 3;
+}
+
+extern "C" __global__ void k_concat(const uint32_t *rows, int row_words,
+                                    const int *row_bytes, uint8_t *out)
+{
+    const int row = blockIdx.x;
+    int off = 0;
+    for (int i = 0; i < row; i++)
+        off += row_bytes[i];
+
+    const uint32_t *src = rows + (size_t)row * row_words;
+    const int n = row_bytes[row];
+    for (int b = threadIdx.x; b < n; b += blockDim.x)
+        out[off + b] = src[b >> 2] >> (24 - 8 * (b & 3));
+}
