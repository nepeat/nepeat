+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/*
+ * Everything from motion estimation to slice packing runs on the GPU; the
+ * host only writes sequence/GOP/picture headers and runs rate control.
+ * Pictures are coded as interlaced frame pictures (I and P), one slice per
+ * macroblock row.
+ */
+
+#include <math.h>
+#include <stdio.h>
+
+#include "libavutil/cuda_check.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_cuda_internal.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+#if CONFIG_SHADER_COMPRESSION
+#include "libavutil/zlib_utils.h"
+#endif
+
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "encode.h"
+#include "hwconfig.h"
+#include "mpeg12data.h"
+#include "mpeg12vlc.h"
+#include "mpegvideodata.h"
+#include "put_bits.h"
+#include "mpeg2_cuda.h"
+
+#define CHECK_CU(x) FF_CUDA_CHECK_DL(avctx, s->cu, x)
+
+#define FCODE 3          /* +-32 pel vectors */
+#define HDR_MAX 256
+
+enum { F_INIT_TABLES, F_LOAD, F_DOWN4, F_ME_COARSE, F_ME_REFINE, F_ENCODE_MB,
+       F_VLC, F_PACK, F_CONCAT, F_NB };
+
+static const char *const kernel_names[F_NB] = {
+    "k_init_tables", "k_load", "k_down4", "k_me_coarse", "k_me_refine",
+    "k_encode_mb", "k_vlc", "k_pack", "k_concat",
+};
+
+typedef struct MPEG2CudaContext {
+    const AVClass *class;
+
+    AVBufferRef         *device_ref;
+    AVCUDADeviceContext *hwctx;
+    CudaFunctions       *cu;
+    CUstream             stream;
+    CUmodule             module;
+    CUfunction           func[F_NB];
+
+    int mb_w, mb_h, pw, ph, py, pc;
+    int qw, qh, qpitch;
+    int row_words;
+
+    CUdeviceptr src[3];
+    CUdeviceptr rec[2][3];
+    CUdeviceptr staging[3];
+    CUdeviceptr srcq, refq;
+    CUdeviceptr coarse, motion, mbinfo, levels, slots, bitlen;
+    CUdeviceptr rows, row_bytes, out;
+
+    uint8_t *host_out;
+    int     *host_row_bytes;
+    size_t   out_max;
+
+    int     ref_idx;
+    int     gop_pos;
+    int64_t coded;
+
+    int frame_rate_code;
+    int aspect_code;
+    int vbv_size;               /* units of 16384 bits */
+
+    /* rate control, TM5 step 1 with X expressed in quantiser_scale_code units */
+    double rc_x[3];
+    double rc_remaining;
+    int    rc_left[3];
+    double vbv_fullness;
+
+    FILE *recon_fp;
+
+    /* options */
+    char *recon_file;
+    int   me_range;
+    int   intra_cost_bias;
+    float intra_bias;
+    float inter_bias;
+} MPEG2CudaContext;
+
+static int alloc_dev(AVCodecContext *avctx, CUdeviceptr *p, size_t size)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    return CHECK_CU(s->cu->cuMemAlloc(p, size));
+}
+
+static void free_dev(MPEG2CudaContext *s, CUdeviceptr *p)
+{
+    if (*p)
+        s->cu->cuMemFree(*p);
+    *p = 0;
+}
+
+static int launch(AVCodecContext *avctx, int f, int gx, int gy, int bx, int by, void **args)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    return CHECK_CU(s->cu->cuLaunchKernel(s->func[f], gx, gy, 1, bx, by, 1,
+                                          0, s->stream, args, NULL));
+}
+
+static void build_tables(M2CTables *t)
+{
+    memset(t, 0, sizeof(*t));
+
+    for (int u = 0; u < 8; u++)
+        for (int x = 0; x < 8; x++)
+            t->dct[u][x] = (u ? 0.5 : 0.5 * M_SQRT1_2) * cos((2 * x + 1) * u * M_PI / 16);
+
+    for (int i = 0; i < MPEG12_RL_NB_ELEMS; i++) {
+        int run = ff_mpeg12_run[i], level = ff_mpeg12_level[i];
+        t->ac[0][run][level] = ff_mpeg1_vlc_table[i][1] << 24 | ff_mpeg1_vlc_table[i][0];
+        t->ac[1][run][level] = ff_mpeg2_vlc_table[i][1] << 24 | ff_mpeg2_vlc_table[i][0];
+    }
+    t->eob[0] = ff_mpeg1_vlc_table[MPEG12_RL_NB_ELEMS + 1][1] << 24 |
+                ff_mpeg1_vlc_table[MPEG12_RL_NB_ELEMS + 1][0];
+    t->eob[1] = ff_mpeg2_vlc_table[MPEG12_RL_NB_ELEMS + 1][1] << 24 |
+                ff_mpeg2_vlc_table[MPEG12_RL_NB_ELEMS + 1][0];
+
+    for (int i = 0; i < 12; i++) {
+        t->dc[0][i] = ff_mpeg12_vlc_dc_lum_bits[i]    << 24 | ff_mpeg12_vlc_dc_lum_code[i];
+        t->dc[1][i] = ff_mpeg12_vlc_dc_chroma_bits[i] << 24 | ff_mpeg12_vlc_dc_chroma_code[i];
+    }
+    for (int i = 0; i < 33; i++)
+        t->addr[i] = ff_mpeg12_mbAddrIncrTable[i][1] << 24 | ff_mpeg12_mbAddrIncrTable[i][0];
+    for (int i = 0; i < 64; i++)
+        t->cbp[i] = ff_mpeg12_mbPatTable[i][1] << 24 | ff_mpeg12_mbPatTable[i][0];
+    for (int i = 0; i < 17; i++)
+        t->mv[i] = ff_mpeg12_mbMotionVectorTable[i][1] << 24 | ff_mpeg12_mbMotionVectorTable[i][0];
+
+    for (int i = 0; i < 64; i++) {
+        t->iscan[ff_alternate_vertical_scan[i]] = i;
+        t->intra_matrix[i] = ff_mpeg1_default_intra_matrix[i];
+        t->inter_matrix[i] = 16;
+    }
+}
+
+/* ------------------------------------------------------------------------ */
+/* headers */
+
+static void put_sequence_header(AVCodecContext *avctx, PutBitContext *pb)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    int64_t br = avctx->bit_rate > 0 ? (avctx->bit_rate + 399) / 400 : 0x3FFFFFFF;
+    int profile_level = (avctx->width <= 720 && avctx->height <= 576) ? 0x48 : 0x44;
+
+    put_bits32(pb, 0x000001B3);
+    put_bits(pb, 12, avctx->width  & 0xFFF);
+    put_bits(pb, 12, avctx->height & 0xFFF);
+    put_bits(pb, 4, s->aspect_code);
+    put_bits(pb, 4, s->frame_rate_code);
+    put_bits(pb, 18, br & 0x3FFFF);
+    put_bits(pb, 1, 1);                         /* marker */
+    put_bits(pb, 10, s->vbv_size & 0x3FF);
+    put_bits(pb, 1, 0);                         /* constrained_parameters_flag */
+    put_bits(pb, 1, 0);                         /* load_intra_quantiser_matrix */
+    put_bits(pb, 1, 0);                         /* load_non_intra_quantiser_matrix */
+
+    put_bits32(pb, 0x000001B5);                 /* sequence_extension */
+    put_bits(pb, 4, 1);
+    put_bits(pb, 8, profile_level);
+    put_bits(pb, 1, 0);                         /* progressive_sequence */
+    put_bits(pb, 2, 1);                         /* chroma_format 4:2:0 */
+    put_bits(pb, 2, avctx->width  >> 12);
+    put_bits(pb, 2, avctx->height >> 12);
+    put_bits(pb, 12, (br >> 18) & 0xFFF);
+    put_bits(pb, 1, 1);                         /* marker */
+    put_bits(pb, 8, (s->vbv_size >> 10) & 0xFF);
+    put_bits(pb, 1, 1);                         /* low_delay: no B-pictures */
+    put_bits(pb, 2, 0);                         /* frame_rate_extension_n */
+    put_bits(pb, 5, 0);                         /* frame_rate_extension_d */
+    align_put_bits(pb);
+}
+
+static void put_gop_header(AVCodecContext *avctx, PutBitContext *pb)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    AVRational fr = ff_mpeg12_frame_rate_tab[s->frame_rate_code];
+    int fps   = (fr.num + fr.den / 2) / fr.den;
+    int64_t t = s->coded;
+
+    put_bits32(pb, 0x000001B8);
+    put_bits(pb, 1, 0);                         /* drop_frame_flag */
+    put_bits(pb, 5, (t / (fps * 3600)) % 24);
+    put_bits(pb, 6, (t / (fps * 60)) % 60);
+    put_bits(pb, 1, 1);
+    put_bits(pb, 6, (t / fps) % 60);
+    put_bits(pb, 6, t % fps);
+    put_bits(pb, 1, 1);                         /* closed_gop */
+    put_bits(pb, 1, 0);                         /* broken_link */
+    align_put_bits(pb);
+}
+
+static void put_picture_header(AVCodecContext *avctx, PutBitContext *pb, int pict_type)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    int fcode = pict_type == 2 ? FCODE : 15;
+
+    put_bits32(pb, 0x00000100);
+    put_bits(pb, 10, s->gop_pos & 0x3FF);       /* temporal_reference */
+    put_bits(pb, 3, pict_type);
+    put_bits(pb, 16, 0xFFFF);                   /* vbv_delay */
+    if (pict_type == 2) {
+        put_bits(pb, 1, 0);                     /* full_pel_forward_vector */
+        put_bits(pb, 3, 7);                     /* forward_f_code */
+    }
+    put_bits(pb, 1, 0);                         /* extra_bit_picture */
+    align_put_bits(pb);
+
+    put_bits32(pb, 0x000001B5);                 /* picture_coding_extension */
+    put_bits(pb, 4, 8);
+    put_bits(pb, 4, fcode);
+    put_bits(pb, 4, fcode);
+    put_bits(pb, 4, 15);
+    put_bits(pb, 4, 15);
+    put_bits(pb, 2, 0);                         /* intra_dc_precision: 8 bits */
+    put_bits(pb, 2, 3);                         /* picture_structure: frame */
+    put_bits(pb, 1, 1);                         /* top_field_first */
+    put_bits(pb, 1, 1);                         /* frame_pred_frame_dct */
+    put_bits(pb, 1, 0);                         /* concealment_motion_vectors */
+    put_bits(pb, 1, 0);                         /* q_scale_type */
+    put_bits(pb, 1, 1);                         /* intra_vlc_format */
+    put_bits(pb, 1, 1);                         /* alternate_scan */
+    put_bits(pb, 1, 0);                         /* repeat_first_field */
+    put_bits(pb, 1, 0);                         /* chroma_420_type */
+    put_bits(pb, 1, 0);                         /* progressive_frame */
+    put_bits(pb, 1, 0);                         /* composite_display_flag */
+    align_put_bits(pb);
+}
+
+/* ------------------------------------------------------------------------ */
+/* rate control */
+
+static void rc_init(AVCodecContext *avctx)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    double br = avctx->bit_rate;
+
+    s->rc_x[1] = 160.0 * br / 115.0 / 2.0;
+    s->rc_x[2] =  60.0 * br / 115.0 / 2.0;
+    s->rc_remaining = 0;
+    s->vbv_fullness = s->vbv_size * 16384.0 * 0.9;
+}
+
+static int rc_get_qcode(AVCodecContext *avctx, int pict_type)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    AVRational fr = ff_mpeg12_frame_rate_tab[s->frame_rate_code];
+    double fps = av_q2d(fr);
+    double br  = avctx->bit_rate;
+    double target, q;
+
+    if (avctx->flags & AV_CODEC_FLAG_QSCALE)
+        return av_clip(avctx->global_quality / FF_QP2LAMBDA, 1, 31);
+
+    if (s->gop_pos == 0) {
+        int n = avctx->gop_size;
+        s->rc_remaining += br * n / fps;
+        s->rc_left[1] = 1;
+        s->rc_left[2] = n - 1;
+    }
+
+    if (pict_type == 1)
+        target = s->rc_remaining /
+                 (1.0 + s->rc_left[2] * s->rc_x[2] / s->rc_x[1]);
+    else
+        target = s->rc_remaining /
+                 (s->rc_left[2] + s->rc_left[1] * s->rc_x[1] / s->rc_x[2]);
+    target = FFMAX(target, br / (8.0 * fps));
+
+    /* don't let one picture drain the VBV */
+    target = FFMIN(target, FFMAX(s->vbv_fullness - br / fps, br / fps));
+
+    q = s->rc_x[pict_type] / target;
+    return av_clip(lrint(q), 1, 31);
+}
+
+static void rc_update(AVCodecContext *avctx, int pict_type, int qcode, int bits)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    double fps = av_q2d(ff_mpeg12_frame_rate_tab[s->frame_rate_code]);
+    double vbv = s->vbv_size * 16384.0;
+
+    if (avctx->flags & AV_CODEC_FLAG_QSCALE)
+        return;
+
+    s->rc_x[pict_type] = (double)bits * qcode;
+    s->rc_remaining   -= bits;
+    s->rc_left[pict_type]--;
+
+    s->vbv_fullness -= bits;
+    if (s->vbv_fullness < 0)
+        av_log(avctx, AV_LOG_WARNING, "VBV underflow by %.0f bits\n", -s->vbv_fullness);
+    s->vbv_fullness = FFMIN(s->vbv_fullness + avctx->bit_rate / fps, vbv);
+}
+
+/* ------------------------------------------------------------------------ */
+
+static int upload_frame(AVCodecContext *avctx, const AVFrame *frame)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    CUdeviceptr y, u, v;
+    int pitch_y, pitch_uv, nv12, ret;
+
+    if (frame->format == AV_PIX_FMT_CUDA) {
+        AVHWFramesContext *fc = (AVHWFramesContext *)frame->hw_frames_ctx->data;
+        nv12     = fc->sw_format == AV_PIX_FMT_NV12;
+        y        = (CUdeviceptr)frame->data[0];
+        u        = (CUdeviceptr)frame->data[1];
+        v        = nv12 ? u : (CUdeviceptr)frame->data[2];
+        pitch_y  = frame->linesize[0];
+        pitch_uv = frame->linesize[1];
+    } else {
+        int planes = frame->format == AV_PIX_FMT_NV12 ? 2 : 3;
+        nv12 = planes == 2;
+        for (int i = 0; i < planes; i++) {
+            int w = i == 0 ? avctx->width  : (nv12 ? (avctx->width + 1) & ~1 : (avctx->width + 1) >> 1);
+            int h = i == 0 ? avctx->height : (avctx->height + 1) >> 1;
+            CUDA_MEMCPY2D cpy = {
+                .srcMemoryType = CU_MEMORYTYPE_HOST,
+                .srcHost       = frame->data[i],
+                .srcPitch      = frame->linesize[i],
+                .dstMemoryType = CU_MEMORYTYPE_DEVICE,
+                .dstDevice     = s->staging[i],
+                .dstPitch      = s->py,
+                .WidthInBytes  = w,
+                .Height        = h,
+            };
+            ret = CHECK_CU(s->cu->cuMemcpy2DAsync(&cpy, s->stream));
+            if (ret < 0)
+                return ret;
+        }
+        y = s->staging[0];
+        u = s->staging[1];
+        v = nv12 ? u : s->staging[2];
+        pitch_y = pitch_uv = s->py;
+    }
+
+    {
+        int w = avctx->width, h = avctx->height;
+        void *args[] = { &y, &pitch_y, &u, &v, &pitch_uv, &nv12, &w, &h,
+                         &s->src[0], &s->src[1], &s->src[2],
+                         &s->py, &s->pc, &s->pw, &s->ph };
+        return launch(avctx, F_LOAD, FFALIGN(s->pw, 32) / 32, FFALIGN(s->ph, 8) / 8,
+                      32, 8, args);
+    }
+}
+
+static int encode_picture(AVCodecContext *avctx, int pict_type, int qcode, int *out_size)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    const int n_mb = s->mb_w * s->mb_h;
+    const int cur  = s->ref_idx ^ 1;
+    int ret;
+
+    if (pict_type == 2) {
+        int lambda = qcode, mv_max = (16 << (FCODE - 1)) - 1;
+        {
+            void *args[] = { &s->src[0], &s->py, &s->srcq, &s->qpitch, &s->qw, &s->qh };
+            ret = launch(avctx, F_DOWN4, FFALIGN(s->qw, 32) / 32, FFALIGN(s->qh, 8) / 8, 32, 8, args);
+            if (ret < 0)
+                return ret;
+        }
+        {
+            void *args[] = { &s->rec[s->ref_idx][0], &s->py, &s->refq, &s->qpitch, &s->qw, &s->qh };
+            ret = launch(avctx, F_DOWN4, FFALIGN(s->qw, 32) / 32, FFALIGN(s->qh, 8) / 8, 32, 8, args);
+            if (ret < 0)
+                return ret;
+        }
+        {
+            void *args[] = { &s->srcq, &s->refq, &s->qpitch, &s->qw, &s->qh,
+                             &s->mb_w, &s->mb_h, &s->me_range, &lambda, &s->coarse };
+            ret = launch(avctx, F_ME_COARSE, (n_mb * 32 + 127) / 128, 1, 128, 1, args);
+            if (ret < 0)
+                return ret;
+        }
+        {
+            void *args[] = { &s->src[0], &s->rec[s->ref_idx][0], &s->py, &s->pw, &s->ph,
+                             &s->mb_w, &s->mb_h, &s->coarse, &lambda, &mv_max,
+                             &s->intra_cost_bias, &s->motion };
+            ret = launch(avctx, F_ME_REFINE, (n_mb * 32 + 127) / 128, 1, 128, 1, args);
+            if (ret < 0)
+                return ret;
+        }
+    }
+
+    {
+        M2CEncodeParams p = {
+            .cur_y = s->src[0], .cur_u = s->src[1], .cur_v = s->src[2],
+            .ref_y = s->rec[s->ref_idx][0], .ref_u = s->rec[s->ref_idx][1],
+            .ref_v = s->rec[s->ref_idx][2],
+            .rec_y = s->rec[cur][0], .rec_u = s->rec[cur][1], .rec_v = s->rec[cur][2],
+            .motion = s->motion, .mbinfo = s->mbinfo, .levels = s->levels,
+            .py = s->py, .pc = s->pc, .mb_w = s->mb_w, .mb_h = s->mb_h,
+            .pict_type = pict_type, .qcode = qcode,
+            .intra_bias = s->intra_bias, .inter_bias = s->inter_bias,
+        };
+        void *args[] = { &p };
+        ret = launch(avctx, F_ENCODE_MB, n_mb, 1, 384, 1, args);
+        if (ret < 0)
+            return ret;
+    }
+    {
+        int fcode = FCODE;
+        void *args[] = { &s->mbinfo, &s->levels, &s->mb_w, &s->mb_h, &pict_type, &fcode,
+                         &s->slots, &s->bitlen };
+        ret = launch(avctx, F_VLC, (n_mb + 63) / 64, 1, 64, 1, args);
+        if (ret < 0)
+            return ret;
+    }
+    {
+        void *args[] = { &s->slots, &s->bitlen, &s->mb_w, &qcode, &s->rows,
+                         &s->row_words, &s->row_bytes };
+        ret = launch(avctx, F_PACK, s->mb_h, 1, M2C_MAX_MB_W, 1, args);
+        if (ret < 0)
+            return ret;
+    }
+    {
+        void *args[] = { &s->rows, &s->row_words, &s->row_bytes, &s->out };
+        ret = launch(avctx, F_CONCAT, s->mb_h, 1, 256, 1, args);
+        if (ret < 0)
+            return ret;
+    }
+
+    ret = CHECK_CU(s->cu->cuMemcpyDtoHAsync(s->host_row_bytes, s->row_bytes,
+                                            s->mb_h * sizeof(int), s->stream));
+    if (ret < 0)
+        return ret;
+    ret = CHECK_CU(s->cu->cuStreamSynchronize(s->stream));
+    if (ret < 0)
+        return ret;
+
+    *out_size = 0;
+    for (int i = 0; i < s->mb_h; i++)
+        *out_size += s->host_row_bytes[i];
+
+    ret = CHECK_CU(s->cu->cuMemcpyDtoHAsync(s->host_out, s->out, *out_size, s->stream));
+    if (ret < 0)
+        return ret;
+    return CHECK_CU(s->cu->cuStreamSynchronize(s->stream));
+}
+
+static int dump_recon(AVCodecContext *avctx, int idx)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    int cw = (avctx->width + 1) >> 1, ch = (avctx->height + 1) >> 1;
+    uint8_t *buf = av_malloc((size_t)s->py * s->ph);
+    int ret = 0;
+
+    if (!buf)
+        return AVERROR(ENOMEM);
+    for (int i = 0; i < 3 && ret >= 0; i++) {
+        int pitch = i ? s->pc : s->py;
+        int w = i ? cw : avctx->width, h = i ? ch : avctx->height;
+        ret = CHECK_CU(s->cu->cuMemcpyDtoH(buf, s->rec[idx][i], (size_t)pitch * h));
+        for (int y = 0; ret >= 0 && y < h; y++)
+            fwrite(buf + y * pitch, 1, w, s->recon_fp);
+    }
+    av_free(buf);
+    return ret;
+}
+
+static int mpeg2_cuda_encode(AVCodecContext *avctx, AVPacket *pkt,
+                             const AVFrame *frame, int *got_packet)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    CUcontext dummy;
+    PutBitContext pb;
+    uint8_t hdr[HDR_MAX];
+    int pict_type = s->gop_pos == 0 ? 1 : 2;
+    int qcode, size, hdr_size, ret;
+
+    qcode = rc_get_qcode(avctx, pict_type);
+
+    ret = CHECK_CU(s->cu->cuCtxPushCurrent(s->hwctx->cuda_ctx));
+    if (ret < 0)
+        return ret;
+    ret = upload_frame(avctx, frame);
+    if (ret >= 0)
+        ret = encode_picture(avctx, pict_type, qcode, &size);
+    if (ret >= 0 && s->recon_fp)
+        ret = dump_recon(avctx, s->ref_idx ^ 1);
+    CHECK_CU(s->cu->cuCtxPopCurrent(&dummy));
+    if (ret < 0)
+        return ret;
+
+    init_put_bits(&pb, hdr, sizeof(hdr));
+    if (pict_type == 1) {
+        put_sequence_header(avctx, &pb);
+        put_gop_header(avctx, &pb);
+    }
+    put_picture_header(avctx, &pb, pict_type);
+    flush_put_bits(&pb);
+    hdr_size = put_bytes_output(&pb);
+
+    ret = ff_get_encode_buffer(avctx, pkt, hdr_size + size, 0);
+    if (ret < 0)
+        return ret;
+    memcpy(pkt->data, hdr, hdr_size);
+    memcpy(pkt->data + hdr_size, s->host_out, size);
+
+    pkt->pts = pkt->dts = frame->pts;
+    if (pict_type == 1)
+        pkt->flags |= AV_PKT_FLAG_KEY;
+    *got_packet = 1;
+
+    rc_update(avctx, pict_type, qcode, (hdr_size + size) * 8);
+    av_log(avctx, AV_LOG_DEBUG, "pic %"PRId64" type %c q %d bits %d\n",
+           s->coded, pict_type == 1 ? 'I' : 'P', qcode, (hdr_size + size) * 8);
+
+    s->ref_idx ^= 1;
+    s->coded++;
+    s->gop_pos = (s->gop_pos + 1) % avctx->gop_size;
+    return 0;
+}
+
+/* ------------------------------------------------------------------------ */
+
+static av_cold int mpeg2_cuda_close(AVCodecContext *avctx)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    CUcontext dummy;
+
+    if (s->hwctx) {
+        s->cu->cuCtxPushCurrent(s->hwctx->cuda_ctx);
+        for (int i = 0; i < 3; i++) {
+            free_dev(s, &s->src[i]);
+            free_dev(s, &s->rec[0][i]);
+            free_dev(s, &s->rec[1][i]);
+            free_dev(s, &s->staging[i]);
+        }
+        free_dev(s, &s->srcq);
+        free_dev(s, &s->refq);
+        free_dev(s, &s->coarse);
+        free_dev(s, &s->motion);
+        free_dev(s, &s->mbinfo);
+        free_dev(s, &s->levels);
+        free_dev(s, &s->slots);
+        free_dev(s, &s->bitlen);
+        free_dev(s, &s->rows);
+        free_dev(s, &s->row_bytes);
+        free_dev(s, &s->out);
+        if (s->module)
+            s->cu->cuModuleUnload(s->module);
+        s->module = NULL;
+        if (s->stream)
+            s->cu->cuStreamDestroy(s->stream);
+        s->stream = NULL;
+        s->cu->cuCtxPopCurrent(&dummy);
+    }
+    av_freep(&s->host_out);
+    av_freep(&s->host_row_bytes);
+    if (s->recon_fp)
+        fclose(s->recon_fp);
+    s->recon_fp = NULL;
+    av_buffer_unref(&s->device_ref);
+    s->hwctx = NULL;
+    return 0;
+}
+
+static int load_module(AVCodecContext *avctx)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    extern const unsigned char ff_mpeg2_cuda_ptx_data[];
+    M2CTables tab;
+    CUdeviceptr tmp;
+    int words = sizeof(tab) / 4;
+    int ret;
+
+#if CONFIG_SHADER_COMPRESSION
+    extern const unsigned int ff_mpeg2_cuda_ptx_len;
+    uint8_t *ptx;
+    size_t ptx_len;
+    ret = ff_zlib_expand(avctx, &ptx, &ptx_len, ff_mpeg2_cuda_ptx_data, ff_mpeg2_cuda_ptx_len);
+    if (ret < 0)
+        return ret;
+    ret = CHECK_CU(s->cu->cuModuleLoadData(&s->module, ptx));
+    av_free(ptx);
+#else
+    ret = CHECK_CU(s->cu->cuModuleLoadData(&s->module, ff_mpeg2_cuda_ptx_data));
+#endif
+    if (ret < 0)
+        return ret;
+
+    for (int i = 0; i < F_NB; i++) {
+        ret = CHECK_CU(s->cu->cuModuleGetFunction(&s->func[i], s->module, kernel_names[i]));
+        if (ret < 0)
+            return ret;
+    }
+
+    build_tables(&tab);
+    ret = alloc_dev(avctx, &tmp, sizeof(tab));
+    if (ret < 0)
+        return ret;
+    ret = CHECK_CU(s->cu->cuMemcpyHtoD(tmp, &tab, sizeof(tab)));
+    if (ret >= 0) {
+        void *args[] = { &tmp, &words };
+        ret = launch(avctx, F_INIT_TABLES, 32, 1, 256, 1, args);
+    }
+    if (ret >= 0)
+        ret = CHECK_CU(s->cu->cuStreamSynchronize(s->stream));
+    free_dev(s, &tmp);
+    return ret;
+}
+
+static av_cold int mpeg2_cuda_init(AVCodecContext *avctx)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    AVRational fr = avctx->framerate.num ? avctx->framerate : av_inv_q(avctx->time_base);
+    AVRational dar;
+    CUcontext dummy;
+    int n_mb, ret;
+
+    if (avctx->width > M2C_MAX_MB_W * 16 || avctx->height > 2800) {
+        av_log(avctx, AV_LOG_ERROR, "%dx%d is too large\n", avctx->width, avctx->height);
+        return AVERROR(EINVAL);
+    }
+
+    for (s->frame_rate_code = 1; s->frame_rate_code <= 8; s->frame_rate_code++)
+        if (!av_cmp_q(fr, ff_mpeg12_frame_rate_tab[s->frame_rate_code]))
+            break;
+    if (s->frame_rate_code > 8) {
+        av_log(avctx, AV_LOG_ERROR, "frame rate %d/%d is not an MPEG-2 frame rate\n",
+               fr.num, fr.den);
+        return AVERROR(EINVAL);
+    }
+
+    dar = av_mul_q(avctx->sample_aspect_ratio.num ? avctx->sample_aspect_ratio : (AVRational){ 1, 1 },
+                   (AVRational){ avctx->width, avctx->height });
+    if (fabs(av_q2d(dar) - 4.0 / 3) < 0.02)
+        s->aspect_code = 2;
+    else if (fabs(av_q2d(dar) - 16.0 / 9) < 0.02)
+        s->aspect_code = 3;
+    else if (fabs(av_q2d(dar) - 2.21) < 0.02)
+        s->aspect_code = 4;
+    else
+        s->aspect_code = 1;
+
+    if (avctx->gop_size <= 0)
+        avctx->gop_size = 15;
+    if (!avctx->rc_buffer_size)
+        avctx->rc_buffer_size = FFMIN(avctx->bit_rate / 2, 9781248);
+    s->vbv_size = FFMAX(1, FFMIN(avctx->rc_buffer_size / 16384, 0x3FFFF));
+
+    s->mb_w   = (avctx->width  + 15) >> 4;
+    s->mb_h   = (avctx->height + 15) >> 4;
+    s->pw     = s->mb_w * 16;
+    s->ph     = s->mb_h * 16;
+    s->py     = FFALIGN(s->pw, 256);
+    s->pc     = s->py / 2;
+    s->qw     = s->pw / 4;
+    s->qh     = s->ph / 4;
+    s->qpitch = FFALIGN(s->qw, 128);
+    s->row_words = s->mb_w * M2C_SLOT_WORDS + 4;
+    s->out_max   = (size_t)s->mb_h * s->row_words * 4;
+    n_mb = s->mb_w * s->mb_h;
+
+    if (avctx->hw_frames_ctx) {
+        AVHWFramesContext *fc = (AVHWFramesContext *)avctx->hw_frames_ctx->data;
+        if (fc->format != AV_PIX_FMT_CUDA ||
+            (fc->sw_format != AV_PIX_FMT_NV12 && fc->sw_format != AV_PIX_FMT_YUV420P)) {
+            av_log(avctx, AV_LOG_ERROR, "unsupported hw frames %s/%s\n",
+                   av_get_pix_fmt_name(fc->format), av_get_pix_fmt_name(fc->sw_format));
+            return AVERROR(EINVAL);
+        }
+        s->device_ref = av_buffer_ref(fc->device_ref);
+    } else if (avctx->hw_device_ctx) {
+        s->device_ref = av_buffer_ref(avctx->hw_device_ctx);
+    } else {
+        ret = av_hwdevice_ctx_create(&s->device_ref, AV_HWDEVICE_TYPE_CUDA, NULL, NULL, 0);
+        if (ret < 0)
+            return ret;
+    }
+    if (!s->device_ref)
+        return AVERROR(ENOMEM);
+    s->hwctx = ((AVHWDeviceContext *)s->device_ref->data)->hwctx;
+    s->cu    = s->hwctx->internal->cuda_dl;
+
+    s->host_out       = av_malloc(s->out_max);
+    s->host_row_bytes = av_malloc(s->mb_h * sizeof(int));
+    if (!s->host_out || !s->host_row_bytes)
+        return AVERROR(ENOMEM);
+
+    ret = CHECK_CU(s->cu->cuCtxPushCurrent(s->hwctx->cuda_ctx));
+    if (ret < 0)
+        return ret;
+
+    ret = CHECK_CU(s->cu->cuStreamCreate(&s->stream, CU_STREAM_DEFAULT));
+    if (ret >= 0)
+        ret = load_module(avctx);
+
+    for (int i = 0; i < 3 && ret >= 0; i++) {
+        size_t sz = i ? (size_t)s->pc * (s->ph / 2) : (size_t)s->py * s->ph;
+        /* one spare row so half-pel reads at the bottom edge stay in bounds */
+        sz += i ? s->pc : s->py;
+        if ((ret = alloc_dev(avctx, &s->src[i], sz)) < 0 ||
+            (ret = alloc_dev(avctx, &s->rec[0][i], sz)) < 0 ||
+            (ret = alloc_dev(avctx, &s->rec[1][i], sz)) < 0 ||
+            (ret = alloc_dev(avctx, &s->staging[i], (size_t)s->py * s->ph)) < 0)
+            break;
+    }
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->srcq, (size_t)s->qpitch * s->qh);
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->refq, (size_t)s->qpitch * s->qh);
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->coarse, n_mb * 4);
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->motion, n_mb * sizeof(M2CMotion));
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->mbinfo, n_mb * sizeof(M2CMBInfo));
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->levels, (size_t)n_mb * 384 * sizeof(int16_t));
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->slots, (size_t)n_mb * M2C_SLOT_WORDS * 4);
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->bitlen, n_mb * sizeof(int));
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->rows, s->out_max);
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->row_bytes, s->mb_h * sizeof(int));
+    if (ret >= 0)
+        ret = alloc_dev(avctx, &s->out, s->out_max);
+
+    CHECK_CU(s->cu->cuCtxPopCurrent(&dummy));
+    if (ret < 0)
+        return ret;
+
+    if (s->recon_file) {
+        s->recon_fp = fopen(s->recon_file, "wb");
+        if (!s->recon_fp)
+            return AVERROR(errno);
+    }
+
+    rc_init(avctx);
+    s->ref_idx = 0;
+    return 0;
+}
+
+#define OFFSET(x) offsetof(MPEG2CudaContext, x)
+#define VE AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_ENCODING_PARAM
+static const AVOption options[] = {
+    { "recon_file",      "write reconstructed pictures (yuv420p) to this file", OFFSET(recon_file),
+      AV_OPT_TYPE_STRING, { .str = NULL }, 0, 0, VE },
+    { "me_range",        "coarse search range, in units of 4 pels", OFFSET(me_range),
+      AV_OPT_TYPE_INT, { .i64 = 8 }, 1, 15, VE },
+    { "intra_cost_bias", "SAD margin before a P macroblock is coded intra", OFFSET(intra_cost_bias),
+      AV_OPT_TYPE_INT, { .i64 = 512 }, -65536, 65536, VE },
+    { "intra_qbias",     "intra quantiser rounding offset", OFFSET(intra_bias),
+      AV_OPT_TYPE_FLOAT, { .dbl = 0.375 }, 0, 0.5, VE },
+    { "inter_qbias",     "inter quantiser rounding offset", OFFSET(inter_bias),
+      AV_OPT_TYPE_FLOAT, { .dbl = 0.0 }, -0.5, 0.5, VE },
+    { NULL }
+};
+
+static const AVClass mpeg2_cuda_class = {
+    .class_name = "mpeg2_cuda",
+    .item_name  = av_default_item_name,
+    .option     = options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+static const FFCodecDefault mpeg2_cuda_defaults[] = {
+    { "b", "15M" },
+    { "g", "15" },
+    { NULL },
+};
+
+static const AVCodecHWConfigInternal *const mpeg2_cuda_hw_configs[] = {
+    HW_CONFIG_ENCODER_FRAMES(CUDA, CUDA),
+    HW_CONFIG_ENCODER_DEVICE(NONE, CUDA),
+    NULL,
+};
+
+const FFCodec ff_mpeg2_cuda_encoder = {
+    .p.name         = "mpeg2_cuda",
+    CODEC_LONG_NAME("MPEG-2 video (CUDA)"),
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_MPEG2VIDEO,
+    .p.capabilities = AV_CODEC_CAP_DR1 | AV_CODEC_CAP_HARDWARE,
+    .priv_data_size = sizeof(MPEG2CudaContext),
+    .p.priv_class   = &mpeg2_cuda_class,
+    .init           = mpeg2_cuda_init,
+    FF_CODEC_ENCODE_CB(mpeg2_cuda_encode),
+    .close          = mpeg2_cuda_close,
+    .defaults       = mpeg2_cuda_defaults,
+    .caps_internal  = FF_CODEC_CAP_NOT_INIT_THREADSAFE | FF_CODEC_CAP_INIT_CLEANUP,
+    CODEC_PIXFMTS(AV_PIX_FMT_CUDA, AV_PIX_FMT_NV12, AV_PIX_FMT_YUV420P),
+    .hw_configs     = mpeg2_cuda_hw_configs,
+};
