+#ifndef AVCODEC_MPEG2_CUDA_H
+#define AVCODEC_MPEG2_CUDA_H
+
+#include <stdint.h>
+
+#ifdef __CUDACC__
+#define M2C_PTR(type) type *
+#else
+#define M2C_PTR(type) uint64_t
+#endif
+
+/* worst case MB: every coefficient escape coded is ~9300 bits */
+#define M2C_SLOT_WORDS 320
+#define M2C_MAX_MB_W   128
+
+typedef struct M2CTables {
+    float    dct[8][8];          /* C(u)/2 * cos((2x+1)u pi/16) */
+    uint32_t ac[2][64][41];      /* [B.14/B.15][run][level] = len << 24 | code, 0 = escape */
+    uint32_t dc[2][12];          /* [luma/chroma][size] */
+    uint32_t addr[33];           /* macroblock_address_increment 1..33 */
+    uint32_t cbp[64];
+    uint32_t mv[17];
+    uint32_t eob[2];
+    uint8_t  iscan[64];          /* raster position -> scan position */
+    uint8_t  intra_matrix[64];   /* raster order */
+    uint8_t  inter_matrix[64];
+} M2CTables;
+
+typedef struct M2CMotion {
+    int16_t mvx, mvy;            /* half-pel, frame prediction */
+    int32_t intra;
+    int32_t sad;
+} M2CMotion;
+
+typedef struct M2CMBInfo {
+    int16_t mvx, mvy;
+    uint8_t intra, cbp, skip, pad;
+    int16_t dc[3];               /* last DC per component, for the next MB's predictor */
+    int8_t  last[6];             /* last nonzero scan position per block, -1 if none */
+} M2CMBInfo;
+
+typedef struct M2CEncodeParams {
+    M2C_PTR(const uint8_t) cur_y;
+    M2C_PTR(const uint8_t) cur_u;
+    M2C_PTR(const uint8_t) cur_v;
+    M2C_PTR(const uint8_t) ref_y;
+    M2C_PTR(const uint8_t) ref_u;
+    M2C_PTR(const uint8_t) ref_v;
+    M2C_PTR(uint8_t)       rec_y;
+    M2C_PTR(uint8_t)       rec_u;
+    M2C_PTR(uint8_t)       rec_v;
+    M2C_PTR(const M2CMotion) motion;
+    M2C_PTR(M2CMBInfo)     mbinfo;
+    M2C_PTR(int16_t)       levels;
+    int32_t py, pc;
+    int32_t mb_w, mb_h;
+    int32_t pict_type;           /* 1 = I, 2 = P */
+    int32_t qcode;
+    float   intra_bias, inter_bias;
+} M2CEncodeParams;
