From 3e3cedcc9f7e8dbedfff1f0777736203077c4eee Mon Sep 17 00:00:00 2001
From: nepeat <nepeat@gmail.com>
Date: Fri, 16 Oct 2026 16:25:27 -0700
Subject: [PATCH] mpeg2_cuda: pad k_encode_mb's shared transposes against bank
 conflicts

The four 8x8 blocks a warp handles were 64 elements apart, so the column
passes hit the same banks (s_f up to 8-way, s_s/s_lev 4-way, s_pred/s_rec
2-way). Block strides 72/74 and an s_f row stride of 9 make every access
pattern conflict-free. Layout only: output is bit-identical.
k_encode_mb ~77.7 -> ~72.1 us per picture (1080).
---
 libavcodec/mpeg2_cuda.cu | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/libavcodec/mpeg2_cuda.cu b/libavcodec/mpeg2_cuda.cu
index 10b6eee..936bcf2 100644
--- a/libavcodec/mpeg2_cuda.cu
+++ b/libavcodec/mpeg2_cuda.cu
@@ -775,12 +775,15 @@ static __device__ __forceinline__ int idct_out(const unsigned a[4], const unsign
 extern "C" __global__ void __launch_bounds__(96)
 k_encode_mb(M2CEncodeParams p)
 {
-    __shared__ float   s_f[3][4][64];
-    __shared__ short   s_s[3][4][64];
-    __shared__ __align__(8) uint8_t s_pred[3][4][64];
-    __shared__ __align__(8) uint8_t s_rec[3][4][64];
+    /* block strides padded so the four blocks a warp works on sit in
+     * different banks (s_f rows also padded, to 9): the transposes, IDCT
+     * passes and level reads are free of bank conflicts */
+    __shared__ float   s_f[3][4][72];
+    __shared__ short   s_s[3][4][74];
+    __shared__ __align__(8) uint8_t s_pred[3][4][72];
+    __shared__ __align__(8) uint8_t s_rec[3][4][72];
     __shared__ int     s_last[2][6], s_dc[2][6], s_dct[2];
-    __shared__ short   s_lev[3][4][64];
+    __shared__ short   s_lev[3][4][74];
     __shared__ uint32_t s_bits[3][4][M2C_BLK_WORDS + 2];
 
     const int w    = threadIdx.x >> 5;
@@ -916,7 +919,7 @@ k_encode_mb(M2CEncodeParams p)
         float acc = 0.0f;
         for (int k = 0; k < 8; k++)
             acc += r[k] * c_dct[u][k];
-        s_f[w][bi][j * 8 + u] = acc;
+        s_f[w][bi][j * 9 + u] = acc;
     }
     __syncwarp();
 
@@ -927,7 +930,7 @@ k_encode_mb(M2CEncodeParams p)
     for (int v = 0; v < 8; v++) {
         float acc = 0.0f;
         for (int k = 0; k < 8; k++)
-            acc += s_f[w][bc][k * 8 + u] * c_dct[v][k];
+            acc += s_f[w][bc][k * 9 + u] * c_dct[v][k];
         F[v] = acc;
     }
 
-- 
