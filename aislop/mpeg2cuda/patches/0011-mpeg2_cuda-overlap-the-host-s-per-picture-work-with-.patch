From 251534cec9339d22cea536fc65cb91818dd5f192 Mon Sep 17 00:00:00 2001
From: nepeat <nepeat@gmail.com>
Date: Fri, 16 Oct 2026 16:25:27 -0700
Subject: [PATCH] mpeg2_cuda: overlap the host's per-picture work with the next
 motion search

Queue a picture's motion search before finishing the previous picture
(read-back, VBV re-code, headers, rate control), so the GPU no longer idles
while the host waits on each picture. Read-backs run on a second stream
behind an event. A pending picture keeps everything a re-code needs in its
job: references, motion buffers (B pictures alternate two sets), and its
source slot (bf + 3 slots). The search lambda comes from the last
quantiser of the picture type, as the picture's own q is set after the
previous picture finishes; with a fixed quantiser it is unchanged and
output is identical.

hw frames produced on a non-default stream are now ordered both ways
against the load kernel.

GPU idle time per picture 148 -> 64 us (B pictures fully hidden, I pictures
keep a ~70 us bubble); touchdown 1080, bf 2, single stream 2555 -> 2946 fps.
---
 libavcodec/mpeg2_cuda.c | 328 ++++++++++++++++++++++++++++------------
 1 file changed, 234 insertions(+), 94 deletions(-)

diff --git a/libavcodec/mpeg2_cuda.c b/libavcodec/mpeg2_cuda.c
index ded7323..36c2968 100644
--- a/libavcodec/mpeg2_cuda.c
+++ b/libavcodec/mpeg2_cuda.c
@@ -25,6 +25,12 @@
  * per macroblock row. With B pictures the encoder buffers max_b_frames
  * source pictures on the GPU, codes the next anchor first and then the B
  * pictures in between (open GOPs).
+ *
+ * The host keeps the GPU busy across pictures: a picture's motion search is
+ * queued before the previous picture is finished (read back, re-coded if the
+ * VBV needs it, packetised), so that work overlaps the search. Read-backs
+ * run on a second stream behind an event; everything a pending picture may
+ * need for a re-code is captured in its job.
  */
 
 #include <math.h>
@@ -58,6 +64,9 @@
 
 #define MAX_BF  3
 #define OUT_Q   (MAX_BF + 3)
+/* source slots: the buffered B candidates, the new anchor, and the slots the
+ * next group's pictures are loaded into while the last picture is pending */
+#define SRC_SLOTS (MAX_BF + 3)
 
 enum { F_INIT_TABLES, F_LOAD, F_DOWN4, F_ME_COARSE, F_ME_REFINE, F_ME_FIELD,
        F_SCALE_MOTION, F_ME_BIDIR, F_ENCODE_MB, F_VLC, F_PACK, F_CONCAT, F_NB };
@@ -74,6 +83,9 @@ typedef struct MPEG2CudaContext {
     AVCUDADeviceContext *hwctx;
     CudaFunctions       *cu;
     CUstream             stream;
+    CUstream             copy_stream;    /* read-backs, beside the next search */
+    CUevent              coded_ev;       /* a picture's kernels are done */
+    CUevent              hw_ev;          /* ordering with hwctx->stream */
     CUmodule             module;
     CUfunction           func[F_NB];
 
@@ -81,12 +93,15 @@ typedef struct MPEG2CudaContext {
     int qw, qh, qpitch;
     int row_words;
 
-    CUdeviceptr src[MAX_BF + 1][3];  /* source pictures waiting to be coded */
+    CUdeviceptr src[SRC_SLOTS][3];   /* source pictures waiting to be coded */
     CUdeviceptr rec[3][3];           /* two anchors + the B picture */
     CUdeviceptr staging[3];
     CUdeviceptr srcq, refq, refq2;
     CUdeviceptr coarse, motion, motion_prev, mbinfo, blkbits, blklen, slots, bitlen;
     CUdeviceptr motion_bf, motion_bb, pred_f, pred_b, bdir;
+    /* second set for B pictures: a pending B keeps its vectors while the
+     * next B is searched */
+    CUdeviceptr motion_bf_alt, motion_bb_alt, bdir_alt;
     CUdeviceptr rows, row_bytes, out;
     CUdeviceptr mv_need;
     int         pic_fcode;           /* f_code chosen for the picture just coded */
@@ -116,6 +131,15 @@ typedef struct MPEG2CudaContext {
     int     eof;
     int     weave_half;          /* field weave: top field loaded, waiting for the bottom */
 
+    /* the picture launched but not finished yet */
+    struct M2CJob {
+        int         active;
+        int         pict_type, slot, cur, ref, ref2, qcode;
+        int64_t     n;
+        CUdeviceptr motion, motion2, bdir;
+    } job;
+    double  me_q[4];             /* quantiser of the last picture per type, for ME lambda */
+
     int64_t pts[256];            /* input pts by display number (ring) */
     int64_t dur;
     AVFrame *frame;
@@ -503,13 +527,26 @@ static int upload_frame(AVCodecContext *avctx, const AVFrame *frame, int slot, i
         pitch_y = pitch_uv = s->py;
     }
 
+    /* hw frames written on a stream of their own: load after the producer,
+     * and let the producer reuse the surface only after the load (the load
+     * may sit behind a whole picture's kernels on our stream). The legacy
+     * default stream (NULL) orders itself against ours already. */
     {
+        CUstream hs = s->hwctx->stream;
+        int other = frame->format == AV_PIX_FMT_CUDA && hs && hs != s->stream;
         int w = avctx->width, h = avctx->height;
         void *args[] = { &y, &pitch_y, &u, &v, &pitch_uv, &nv12, &w, &h,
                          &s->src[slot][0], &s->src[slot][1], &s->src[slot][2],
                          &s->py, &s->pc, &s->pw, &s->ph, &bottom_only };
-        return launch(avctx, F_LOAD, FFALIGN(s->pw / 8, 32) / 32, FFALIGN(s->ph, 8) / 8,
-                      32, 8, args);
+        if (other && ((ret = CHECK_CU(s->cu->cuEventRecord(s->hw_ev, hs))) < 0 ||
+                      (ret = CHECK_CU(s->cu->cuStreamWaitEvent(s->stream, s->hw_ev, 0))) < 0))
+            return ret;
+        ret = launch(avctx, F_LOAD, FFALIGN(s->pw / 8, 32) / 32, FFALIGN(s->ph, 8) / 8,
+                     32, 8, args);
+        if (ret >= 0 && other &&
+            (ret = CHECK_CU(s->cu->cuEventRecord(s->hw_ev, s->stream))) >= 0)
+            ret = CHECK_CU(s->cu->cuStreamWaitEvent(hs, s->hw_ev, 0));
+        return ret;
     }
 }
 
@@ -554,7 +591,7 @@ static int scale_motion(AVCodecContext *avctx, CUdeviceptr src, CUdeviceptr dst,
     return launch(avctx, F_SCALE_MOTION, (n_mb + 127) / 128, 1, 128, 1, args);
 }
 
