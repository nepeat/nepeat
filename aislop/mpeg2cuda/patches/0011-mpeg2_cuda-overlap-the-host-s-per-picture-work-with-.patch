+/* code one picture (source in src[slot], display number n) into rec[cur].
+ * Order: queue its motion search, finish the previous picture while that
+ * runs (its rate control result sets this picture's q), queue the coding. */
+static int code_one(AVCodecContext *avctx, int pict_type, int slot, int cur, int64_t n)
+{
+    MPEG2CudaContext *s = avctx->priv_data;
+    struct M2CJob j = { .active = 1, .pict_type = pict_type, .slot = slot, .cur = cur, .n = n };
+    int prog = s->pic_flags[n & 255] & 1;
+    int ret = 0;
+    double q;
+
+    /* captured now: the anchors move on before the picture is finished */
+    j.ref  = pict_type == 3 ? s->anchor_past : FFMAX(s->anchor_fut, 0);
+    j.ref2 = pict_type == 3 ? s->anchor_fut : j.ref;
+    if (pict_type == 3) {
+        FFSWAP(CUdeviceptr, s->motion_bf, s->motion_bf_alt);
+        FFSWAP(CUdeviceptr, s->motion_bb, s->motion_bb_alt);
+        FFSWAP(CUdeviceptr, s->bdir,      s->bdir_alt);
+    }
+    j.motion  = pict_type == 3 ? s->motion_bf : s->motion;
+    j.motion2 = s->motion_bb;
+    j.bdir    = s->bdir;
+
+    if (pict_type == 2)
+        ret = motion_search_p(avctx, slot, prog, FFMAX(1, (int)(me_q(avctx, 2) / 2)));
+    else if (pict_type == 3)
+        ret = motion_search_b(avctx, slot, n, prog, FFMAX(1, (int)(me_q(avctx, 3) / 2)));
+    if (ret >= 0)
+        ret = finish_picture(avctx);
+    if (ret < 0)
+        return ret;
+
+    s->pic_prog = prog;
+    s->pic_tff  = !!(s->pic_flags[n & 255] & 2);
+    if (pict_type == 1) {
+        /* B pictures still buffered are displayed before this I: they
