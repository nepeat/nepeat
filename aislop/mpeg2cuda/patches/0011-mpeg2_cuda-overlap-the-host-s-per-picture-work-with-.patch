+            bits < 0.5 * FFMIN(3.0 * avctx->bit_rate / av_q2d(ff_mpeg12_frame_rate_tab[s->frame_rate_code]),
+                               0.5 * s->rc_cap) &&
+            qscale_of(s, j->qcode) > 1) {
             double share = FFMIN(3.0 * avctx->bit_rate / av_q2d(ff_mpeg12_frame_rate_tab[s->frame_rate_code]),
                                  0.5 * s->rc_cap);
-            if (bits < 0.5 * share && qscale_of(s, qcode) > 1) {
-                q = FFMAX(1, qscale_of(s, qcode) * bits / share);
+            q = FFMAX(1, qscale_of(s, j->qcode) * bits / share);
