+    ret = read_back(avctx, &size);
+    for (int attempt = 0; ret >= 0 && !(avctx->flags & AV_CODEC_FLAG_QSCALE); attempt++) {
+        double bits = size * 8.0 + HDR_MAX * 8, room;
         /* the very first picture has no history to size it: if it came out
