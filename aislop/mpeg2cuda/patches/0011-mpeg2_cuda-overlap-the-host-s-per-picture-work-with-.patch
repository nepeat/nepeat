-static int code_one(AVCodecContext *avctx, int pict_type, int slot, int cur, int64_t n)
+/* quantiser to derive the motion search lambda from. The picture's own q is
+ * not known when its search is queued (the previous picture is not finished
+ * yet): use the last picture of the same type, or derive it from P/I. */
+static double me_q(AVCodecContext *avctx, int t)
 {
     MPEG2CudaContext *s = avctx->priv_data;
+    double qp;
+
+    if (avctx->flags & AV_CODEC_FLAG_QSCALE)
+        return rc_get_qscale(avctx, t);      /* fixed q: no rate control state */
+    if (s->me_q[t] > 0)
+        return s->me_q[t];
+    qp = s->me_q[2] > 0 ? s->me_q[2] : s->me_q[1] * s->ip_ratio;
+    return qp > 0 ? qp * rc_k(s, t) : 8;
+}
+
