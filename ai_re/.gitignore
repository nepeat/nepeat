# nix/direnv local caches — not source
.direnv/
result
result-*

# scratch / working dumps kept out of git by default; commit real artifacts explicitly
*.tmp

# APC investigation — keep local for now
/devices/apc-general/

# firmware noise
extracted/
extract/
*.jpg_original
*.bin

# local secrets sourced by .envrc (direnv source_env_if_exists)
.envrc.local

# Ghidra projects embed the analysed binary's bytes (vendor firmware); the
# monorepo is public. Never commit them. Scripts live in tools/, not here.
devices/*/ghidra/
*.gpr
*.rep/
*.rep
*.lock~
