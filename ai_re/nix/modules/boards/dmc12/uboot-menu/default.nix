# DMC-12 U-Boot bootmenu — the on-disk loader for the dmc12 hardware
# profile. Imported by modules/hardware/dmc12/default.nix.
#
# Why this exists (and not boot.loader.generic-extlinux-compatible):
#   U-Boot 2015.07 on this board ships with CONFIG_CMD_EXT2,
#   CONFIG_CMD_FAT, and CONFIG_CMD_FS_GENERIC all OFF, so its `sysboot`
#   parser can't dispatch through any filesystem and the NixOS extlinux
#   flow doesn't even reach its menu code. Same binary HOWEVER does
#   ship CONFIG_CMD_BOOTMENU + CONFIG_CMD_ENV_IMPORT + CONFIG_CMD_SOURCE
#   (confirmed via serial probe + flash-dump strings analysis — see
#   recon/mtd0-uboot.img). The factory `kernel_select` env already
#   invokes `bootmenu` for its A/B kernel select, so we know it works.
#
# What we do:
#   * On every nixos-rebuild switch/boot, ./builder.sh walks
#     /nix/var/nix/profiles/system-*-link, stages each generation's
#     kernel + initrd + DTB into /boot/nixos/, and writes
#     /boot/u-boot.menu — a text file of the form
#         bootmenu_delay=5
#         bootmenu_0=NixOS - Default (...)=ext4load … ; setenv bootargs … ; bootm …
#         bootmenu_1=NixOS - Gen 42 (...)=…
#         …
#     parseable by U-Boot's `env import -t`.
#   * A static /boot/boot.scr (built once per kernel/module change)
#     does `ext4load /boot/u-boot.menu` + `env import -t` + `bootmenu`.
#
# Boot chain (single hop, no loader Linux):
#
#   U-Boot bootcmd: `scsi reset; ext4load /boot.scr; source ${addr}`
#                                                        │
#                                                        └─ /boot.scr:
#       ext4load /boot/u-boot.menu                    (loads menu file)
#       env import -t ${loadaddr} ${filesize}         (defines bootmenu_N)
#       bootmenu                                       (renders ANSI menu)
#                       │
#                       └─ user picks (or autoboot fires after delay) →
#                          ext4load Image + initrd + DTB; setenv bootargs;
#                          bootm                       (real NixOS boots)
#
# This module sets system.build.installBootLoader so NixOS calls our
# builder.sh during activation. We do NOT set system.boot.loader.id as
# load-bearing — the activation machinery only requires installBootLoader.
{ config, lib, pkgs, modulesPath, ... }:

let
  # "both": this layout in /boot/nixos-uboot next to nixpkgs' extlinux in /boot/nixos (bootloader.nix).
  both = config.hardware.dmc12.bootLoader == "both";
  timeout = 5;            # seconds; passed to bootmenu_delay
  numGenerations = if both then 1 else 20;   # past gens in the menu (both: /boot holds two layouts)
  kernelsDir = if both then "nixos-uboot" else "nixos";

  # Static U-Boot script. mkimage-wrapped, ~200 bytes. Only changes if
  # we edit this file; never per-generation.
  # NOTE on paths: U-Boot reads the raw sda1 filesystem, where the files
  # live at "/u-boot.menu" and "/nixos/<…>". Those same files appear as
  # "/boot/u-boot.menu" and "/boot/nixos/<…>" to NixOS userspace because
  # sda1 is mounted at /boot. builder.sh writes via NixOS-side paths;
  # boot.scr reads via U-Boot-side paths. Don't confuse them.
  bootCmd = pkgs.writeText "dmc12-boot-cmd" ''
    # /boot.scr — DMC-12 NixOS U-Boot bootmenu launcher.
    # Generated by modules/hardware/dmc12/uboot-menu/default.nix.
    #
    # `scsi init` (not `scsi reset`!) — the outer bootcmd has likely
    # already init'd, but if a human sources us standalone we need to
    # bring the AHCI controller up. `scsi reset` requires a previously-
    # init'd controller and errors with "Invalid port number" on cold
    # entry.
    echo "== DMC-12 NixOS bootmenu =="
    # The factory preamble, as the stock bootcmd runs it before Linux: SATA
    # SerDes fix on DN0 boxes, CPLD WDT flag clear, fans 70%, LED, uplink PHY
    # sync, and `bootp` (autoload=n). bootp is what makes the factory U-Boot
    # write the al_eth board-info + MAC scratch registers; without a network
    # command Linux al_eth fails to probe (uboot-vendor-commands.md).
    run dmc12_boot_preamble
    scsi init
    if ext4load scsi 0:1 0x07000000 /u-boot.menu; then
      env import -t 0x07000000 ''${filesize}
      bootmenu
    else
      echo "[boot.scr] /u-boot.menu missing on sda1 -- dropping to U-Boot console"
    fi
  '';

  bootScr = pkgs.runCommand "dmc12-boot-scr" {
    nativeBuildInputs = [ pkgs.buildPackages.ubootTools ];
  } ''
    mkimage -A arm64 -O linux -T script -C none -a 0 -e 0 \
      -n "DMC-12 NixOS bootmenu launcher" \
      -d ${bootCmd} $out
  '';

  # p = pkgs (runs on the box at activation) or pkgs.buildPackages (runs on
  # the build host when the disk image stages /boot).
  mkBuilder = p: p.replaceVarsWith {
    src = ./builder.sh;
    isExecutable = true;
    replacements = {
      bash = p.bash;
      # Tools the builder shell script invokes. Keep this list tight.
      path = lib.makeBinPath [
        p.coreutils    # stat, basename, cat, cp, mv, install, ls, mkdir, rm, chmod, date
        p.gnused       # sed
        p.gzip         # gzip the raw Image before mkimage-wrapping
        p.ubootTools   # mkimage: wraps Image as a U-Boot legacy kernel uImage
      ];
      timeout = toString timeout;
      numGenerations = toString numGenerations;
      dtbName = config.hardware.deviceTree.name;
      inherit kernelsDir;
      bootScr = "${bootScr}";
    };
  };
  builder = mkBuilder pkgs;

  # "both": nixpkgs' extlinux builder (as generic-extlinux-compatible calls it) for our U-Boot's
  # standard boot, current + 1 previous generation, in /boot/nixos.
  extlinuxBuilder = import (modulesPath + "/system/boot/loader/generic-extlinux-compatible/extlinux-conf-builder.nix") { inherit lib pkgs; };
  extlinuxArgs = "-g 1 -t 3 -n ${config.hardware.deviceTree.name}";
  # Order matters: our builder first (stages /boot/nixos-uboot, then swaps in u-boot.menu), then
  # extlinux, whose clean-up removes /boot/nixos files it doesn't own (e.g. a previous uboot-menu
  # layout) only once the new menu no longer points at them.
  bothInstaller = pkgs.writeScript "install-dmc12-both.sh" ''
    #!${pkgs.runtimeShell}
    set -e
    ${builder} "$1"
    ${extlinuxBuilder} ${extlinuxArgs} -d /boot -c "$1"
    ${import ../compress-kernels.nix { inherit pkgs; }} /boot
  '';
in {
  config = lib.mkIf (config.hardware.dmc12.bootLoader == "uboot-menu" || both) {
    # NixOS's activation calls this with the new toplevel as $1.
    # mkForce so we win over any default (extlinux-compat etc.) that
    # might also bind to system.build.installBootLoader.
    system.build.installBootLoader = lib.mkForce (if both then bothInstaller else builder);
    # Same builder for the build host: disk.nix runs it with -d to stage /boot.
    system.build.dmc12BootBuilderNative = mkBuilder pkgs.buildPackages;

    # Quietens NixOS's "no bootloader configured" warning. The id is
    # cosmetic — only system.build.installBootLoader is load-bearing.
    system.boot.loader.id = lib.mkForce (if both then "dmc12-both" else "dmc12-uboot-menu");

    # Inspectable handle:
    #   nix build .#nixosConfigurations.<host>.config.system.build.dmc12UbootMenu
    # produces result/{install,boot.cmd,boot.scr}. Lets us check the
    # mkimage header + the static script source without doing a full
    # activation.
    system.build.dmc12UbootMenu = pkgs.runCommand "dmc12-uboot-menu" { } ''
      mkdir -p $out
      install -m 0755 ${builder} $out/install
      install -m 0644 ${bootCmd} $out/boot.cmd
      install -m 0644 ${bootScr} $out/boot.scr
    '';

    # Ensure that other bootloaders are force disabled if we are importing this.
    boot.loader.grub.enable = lib.mkForce false;
    boot.loader.systemd-boot.enable = lib.mkForce false;
  };
}
