// SPDX-License-Identifier: GPL-2.0
/*
 * Edge-Core DMC-12-48R-AS0 — 48-port serial console server
 * Annapurna Labs Alpine V2 K2C-AB (4× Cortex-A57)
 *
 * This board file is a thin overlay on the mainline alpine-v2.dtsi. The only
 * real fixup is on the &msix node: in mainline 7.x, drivers/of/irq.c's
 * of_irq_init() walks the IRQCHIP_DECLARE table but only invokes the matched
 * init function (drivers/irqchip/irq-alpine-msi.c:alpine_msix_init) for nodes
 * that ALSO have the "interrupt-controller" property. The mainline
 * alpine-v2.dtsi declares the msix node with msi-controller only, so the
 * alpine-msix irqchip never initializes, pci_enable_msix_exact() falls back to
 * an invalid IRQ vector, and al_eth's request_irq() returns -EINVAL. Adding
 * interrupt-controller + #interrupt-cells satisfies the of_irq_init filter
 * without changing semantics for downstream consumers (al_eth reaches the
 * controller via msi-parent on the PCIe host bridge, not interrupt-parent).
 *
 * Console: ttyS0 = uart0 @ 0xfd883000, 115200 8N1.
 * Other hardware (M.2 SSD via PCI 1c36:0031 AHCI, al_eth via PCI 1c36:0001) is
 * PCI-enumerated and binds by ID — no extra DT entries needed for those.
 *
 * Deferred until we need them: the external PCIe controller node
 * (amazon,al-alpine-v2-pcie at 0xfd800000 / ECAM 0xfb600000) that fans out
 * USB + 48× cp210x; the board I2C MCU at addr 0x68 used for fan/LED control.
 */

#include "alpine-v2.dtsi"

/ {
	model = "Edge-Core DMC-12-48R-AS0";
	compatible = "edgecore,dmc-12-48r-as0", "al,alpine-v2";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&uart0 { status = "okay"; };

/*
 * Make of_irq_init() actually call alpine_msix_init() for this node.
 * msi-controller is already set in the SoC dtsi; PCIe host bridges reach
 * the controller via msi-parent.
 */
&msix {
	interrupt-controller;
	#interrupt-cells = <1>;
};

/*
 * I2C bus tree, transplanted from the factory FDT (annapurna-labs DTB
 * at /root/dmc12/dmc12_original.fdt). The mainline alpine-v2.dtsi exposes
 * no labels for io-bus@fc000000, so we anchor by path. Addresses are
 * io-bus-relative — uart0 lives at 0x1883000 (absolute 0xfd883000) so
 * 0x1880000 here resolves to 0xfd880000.
 *
 * Linux bus numbering, matching the factory's `i2c dev 4 = CPLD path`:
 *   designware root         -> i2c-0
 *   pca9548 ch0..ch7        -> i2c-1..i2c-8   (channel N -> bus N+1)
 *   pca9546 ch0..ch3        -> i2c-9..i2c-12  (under pca9548 ch3 = i2c-4)
 *
 * /dev/i2c-4 is what dmc12-fancontrol.service waits on: the board CPLD at
 * 0x68 lives there (no DT child for it -- accessed raw via SMBus(4) +
 * i2c-dev). The lm75/tmp75 children below give /sys/class/hwmon entries
 * for `sensors`.
 */

/*
 * Dedicated input clock for the I2C controllers. The mainline alpine-v2.dtsi
 * only declares sbclk @ 1 MHz (for the sp804 timer). Plugging sbclk into the
 * DesignWare I2C controller makes its master driver derive HCNT/LCNT counts
 * of 0 (clk_rate * 4 µs - 3 - 1 = 0 at 1 MHz) -> every transaction loses
 * arbitration on the very first SCL high pulse. The factory FDT worked
 * around this with non-standard `i2c-ss-scl-{hcnt,lcnt}-raw` properties
 * (HCNT 0x855 + LCNT 0xb0b at SCL 100 kHz -> ~4960 input ticks per SCL
 * period -> ~496 MHz input clock). Declare that explicitly here as 500 MHz
 * so mainline's standard count derivation hits the same window.
 */
/ {
	i2cclk: i2cclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <500000000>;
	};
};

/*
 * External PCIe controller — required for the off-SoC USB stack that fans
 * out to the 48× CP210x USB-serial converters. Mainline alpine-v2.dtsi
 * declares the internal pci-host-ecam-generic at 0xfbc00000 but says
 * nothing about the external port; the QNAP TS-x32x fork (delroth/
 * linux-qnap-tsx32x) pulled it in via a fork-local alpine-v2.dtsi patch,
 * we just paste the same node into our board overlay so mainline 7.0's
 * drivers/pci/controller/dwc/pcie-al.c (CONFIG_PCIE_AL=y) binds.
 *
 * Address layout (verified against factory FDT and QNAP fork):
 *   ECAM     : 0xfb600000 + 0x100000 (full PCIe domain 1)
 *   ctrl regs: 0xfd800000 + 0x10000  (the AL-specific glue)
 *   DBI      : 0xfd810000 + 0x1000   (DesignWare config)
 * Bus MMIO window 0xc0010000..0xc8000000 (~127 MB) matches the factory
 * boot log's `pci_bus 0001:00: root bus resource [mem 0xc0010000-0xc7ffffff]`.
 * Main IRQ GIC_SPI 49; legacy INTA on the bridge -> SPI 41.
 *
 * Once this binds, /dev/ttyUSB0..47 should enumerate as the kernel walks
 * the bridge tree (0001:00:00 -> 01:00 -> 02:03 -> 03:00.{0,1,2} = EHCI
 * + OHCIs -> 3 USB hubs -> 48× CP210x).
 */
/ {
	pcie_external0: pcie@fb600000 {
		compatible = "amazon,al-alpine-v2-pcie";
		device_type = "pci";
		#size-cells = <2>;
		#address-cells = <3>;
		#interrupt-cells = <1>;
		reg = <0x0 0xfb600000 0x0 0x00100000
		       0x0 0xfd800000 0x0 0x00010000
		       0x0 0xfd810000 0x0 0x00001000>;
		reg-names = "config", "controller", "dbi";
		bus-range = <0x00 0xff>;
		interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-map-mask = <0x00 0 0 7>;
		/*
		 * The Pericom 12d8:400c bridge tree fans out the off-SoC USB
		 * stack into a 3-function PCI device — OHCI@.0 lands on INTB,
		 * OHCI@.1 on INTC, EHCI@.2 on INTD after the standard bridge
		 * swizzle. The pcie-al controller has a single shared INTx
		 * line so all four pins route to GIC SPI 41. Mapping only INTA
		 * (as the QNAP TS-x32x fork does — they have no multi-function
		 * children behind their bridge) silently 'Found HC with no IRQ'
		 * for the other two host controllers, leaving the device with
		 * 16 of 48 cp210x ttyUSB ports.
		 */
		interrupt-map = <0x0000 0 0 1 &gic GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,
				<0x0000 0 0 2 &gic GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,
				<0x0000 0 0 3 &gic GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,
				<0x0000 0 0 4 &gic GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
		ranges = <0x02000000 0x0 0xc0010000 0x0 0xc0010000 0x0 0x07ff0000>;
		msi-parent = <&msix>;
	};
};

&{/soc/io-bus@fc000000} {
	i2c0: i2c@1880000 {
		compatible = "snps,designware-i2c";
		reg = <0x1880000 0x1000>;
		interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&i2cclk>;
		clock-frequency = <100000>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* Board ID EEPROM on the root bus. */
		eeprom@57 {
			compatible = "atmel,24c64";
			reg = <0x57>;
		};

		/* 8-channel mux. The pca9548 driver enumerates each enabled
		 * child as its own Linux i2c bus. */
		i2c-mux@70 {
			compatible = "nxp,pca9548";
			reg = <0x70>;
			#address-cells = <1>;
			#size-cells = <0>;

			/* Channel 1 -> i2c-2 in Linux: real-time clock. */
			i2c@1 {
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				rtc@68 {
					compatible = "dallas,ds1339";
					reg = <0x68>;
					trickle-resistor-ohms = <2000>;
				};
			};

			/* Channel 2 -> i2c-3: Infineon TPM. */
			i2c@2 {
				reg = <2>;
				#address-cells = <1>;
				#size-cells = <0>;
				tpm@20 {
					compatible = "infineon,slb9645tt";
					reg = <0x20>;
				};
			};

			/* Channel 3 -> i2c-4: the bus the factory calls
			 * "U-Boot dev 4". Board CPLD at 0x68 lives here
			 * (no DT child needed; userspace pokes it via
			 * /dev/i2c-4). The pca9546 nested mux is also here. */
			i2c@3 {
				reg = <3>;
				#address-cells = <1>;
				#size-cells = <0>;

				i2c-mux@71 {
					compatible = "nxp,pca9546";
					reg = <0x71>;
					#address-cells = <1>;
					#size-cells = <0>;

					/* pca9546 ch0 -> i2c-9: lm75 thermal. */
					i2c@0 {
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;
						temp-sensor@4a {
							compatible = "nxp,lm75";
							reg = <0x4a>;
						};
					};

					/* pca9546 ch2 -> i2c-11: two tmp75s + EEPROM. */
					i2c@2 {
						reg = <2>;
						#address-cells = <1>;
						#size-cells = <0>;
						eeprom@51 {
							compatible = "atmel,24c02";
							reg = <0x51>;
						};
						temp-sensor@48 {
							compatible = "ti,tmp75";
							reg = <0x48>;
						};
						temp-sensor@49 {
							compatible = "ti,tmp75";
							reg = <0x49>;
						};
					};
				};
			};
		};
	};
};
