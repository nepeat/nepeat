#!/usr/bin/env bash
# DMC-12 uplink-PHY speed/media manager — port of factory /usr/bin/setphyspeed.
#
# The DMC-12's uplink is a dual-PHY (copper RJ45 + SFP cage) sitting behind a
# CPLD-managed MDIO bus. The CPLD reports the actual auto-negotiated state in
# reg 0x18; whenever the two PHYs disagree (e.g. lower is 100M copper but upper
# came up at 1G), the script writes through an i2c-routed MDIO bridge to force
# the upper PHY to match. Writes the result to /run/dmc12/uplink.env so
# `show uplink` can report it.
#
# Behaviour:
#   reg 0x18 = 0x11  ->  lower 100M copper, upper 1G  -> force upper to 100M
#   reg 0x18 = 0x0a  ->  lower 1G copper, upper 100M  -> force upper to 1G
#   reg 0x18 = 0x0e  ->  lower 1G fiber,  upper 100M  -> force upper to 1G
#   reg 0x18 = 0x09  ->  already 100M copper, no change
#   reg 0x18 = 0x16  ->  already 1G fiber, no change
#   reg 0x18 = 0x10|0x12 -> already 1G copper, no change
#
# Quiet mode: `setphyspeed -q` suppresses "no change required" output but still
# writes the uplink.env file. Suitable for a boot-time oneshot.

set -u

ENVFILE=/run/dmc12/uplink.env

require_root() {
  if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo "** setphyspeed must run as root (CPLD i2c access)." >&2
    exit 1
  fi
}

write_env() {
  local speed="$1" media="$2"
  mkdir -p "$(dirname "$ENVFILE")"
  cat > "$ENVFILE" <<EOF
UPLINKSPEED=$speed
UPLINKMEDIA=$media
EOF
}

setphy_100m() {
  i2cset -f -y 4 0x70 0x08
  i2cset -f -y 4 0x71 0x08
  i2cset -f -y 4 0x40 0x16 0x0000 w
  i2cset -f -y 4 0x40 0x09 0x000c w
  i2cset -f -y 4 0x40 0x00 0x4091 w
  echo "Upper PHY: set to 100Mbps."
  logger -t setphyspeed "Forced upper PHY to 100Mbps."
}

setphy_1g() {
  i2cset -f -y 4 0x70 0x08
  i2cset -f -y 4 0x71 0x08
  i2cset -f -y 4 0x40 0x16 0x0000 w
  i2cset -f -y 4 0x40 0x09 0x000f w
  i2cset -f -y 4 0x40 0x00 0x4091 w
  echo "Upper PHY: set to 1Gbps."
  logger -t setphyspeed "Forced upper PHY to 1Gbps."
}

require_root
quiet=0
[ "${1:-}" = "-q" ] || [ "${1:-}" = "quiet" ] && quiet=1

phystate=$(i2cget -f -y 4 0x68 0x18 2>/dev/null || true)
if [ -z "$phystate" ]; then
  echo "ERROR: could not read CPLD reg 0x18 (PHY state)" >&2
  logger -t setphyspeed "Could not read CPLD reg 0x18."
  write_env ERROR ERROR
  exit 102
fi

case "$phystate" in
  0x11)            setphy_100m;       write_env 100Mbps Copper ;;
  0x0a)            setphy_1g;         write_env 1Gbps   Copper ;;
  0x0e)            setphy_1g;         write_env 1Gbps   Fiber  ;;
  0x09)            [ "$quiet" = 0 ] && echo "PHYs match: 100Mbps copper, no change."
                                       write_env 100Mbps Copper ;;
  0x16)            [ "$quiet" = 0 ] && echo "PHYs match: 1Gbps fiber, no change."
                                       write_env 1Gbps   Fiber  ;;
  0x10|0x12)       [ "$quiet" = 0 ] && echo "PHYs match: 1Gbps copper, no change."
                                       write_env 1Gbps   Copper ;;
  *)
    echo "ERROR: unexpected CPLD reg 0x18 = $phystate" >&2
    logger -t setphyspeed "Unexpected PHY state $phystate."
    write_env ERROR ERROR
    exit 101
    ;;
esac
