# AS7772-32X: the external PHY table for the SAI
# (format: rust/sai crate phy-seq, `ext-phy 1`; sai.profile SAI_OPENBCM_EXT_PHY_FILE).
# Every cage sits behind a BCM82391 "Evora" MAC-PHY; the ASIC port's own link
# ends at the PHY's system side and is up whenever the port is admin up. Per
# cage this gives the SAI:
#   link        the PHY's line-side PCS live status (0xc161 bits 1:0 = 3):
#               the port is up only while the cable side is;
#   admin-down  line-side receiver and transmitter powered down, per lane
#               (0xd0e1 bit 7, 0xd139 bit 0), so the far end sees the link
#               drop (the PHY alone keeps idling towards the cable when the
#               ASIC port is disabled);
#   admin-up    both powered up again (what the vendor's "extphy power" does).
# Registers, the message format and what was measured on the switch:
# devices/edge-core-as7772-32x/extphy.md ("Line-side link and power").
#
# The PHY's internal blocks are reached through a firmware message on clause
# 45 device 1 (nothing here is a vendor file; the layout was read off the
# bus): the message bytes go to 1.a000.. as little-endian words, 1.8222
# starts it (0x1111 read, 0x1101 write), 1.8221 reads 0x11e3 once when it is
# done (clear on read), a read's data is then at 1.a101 with 1.a100 = 2.
#   read : 06 00 | side 01 | reg lo, hi | lane 00          side: 1 = line
#   write: 09 00 | side 00 | 01 reg lo | reg hi, lane | 00 data lo | data hi 00
# One 100G port per cage (break-out needs per-lane entries and another PHY
# mode: the board module asserts there is none).
{ lib, cages }:
let
  inherit (lib) concatMap concatStringsSep genList imap0 toLower toHexString mod;
  x = lib.fromHexString;
  hex = n: toLower (toHexString n);
  # Cage n -> PHY id (MDIO address word): bus b holds addresses 4b..4b+3 and
  # the buses follow the cages in order (factory port_map-100G.csv).
  phyIds = concatMap (base: genList (i: base + i) 4) (map x [ "0" "24" "48" "6c" "110" "134" "158" "17c" ]);
  # Up to 100 reads 100 us apart for the firmware's answer (it is there on the first read in practice).
  ack = p: "P ${p} 1 8221 11e3 ffff 100 100";
  msgRead = p: reg: lane: [
    "R ${p} 1 8221" "W ${p} 1 a000 6" "W ${p} 1 a001 101" "W ${p} 1 a002 ${hex reg}" "W ${p} 1 a003 ${hex lane}"
    "W ${p} 1 8222 1111" (ack p) "E ${p} 1 a100 2"
  ];
  msgWrite = p: reg: lane: val: [
    "R ${p} 1 8221" "W ${p} 1 a000 9" "W ${p} 1 a001 1" "W ${p} 1 a002 ${hex ((mod reg 256) * 256 + 1)}"
    "W ${p} 1 a003 ${hex (lane * 256 + reg / 256)}" "W ${p} 1 a004 ${hex ((mod val 256) * 256)}"
    "W ${p} 1 a005 ${hex (val / 256)}" "W ${p} 1 8222 1101" (ack p)
  ];
  # Read reg, require (value & mask) == want (anything else: stop, write nothing), write val.
  set = p: reg: lane: want: mask: val: msgRead p reg lane ++ [ "E ${p} 1 a101 ${hex want} ${hex mask}" ] ++ msgWrite p reg lane val;
  lanes = genList (l: l) 4;
  cage = i: cageLanes: let p = hex (builtins.elemAt phyIds i); in
    [ "# cage ${toString (i + 1)}, PHY 0x${p}" "port ${toString (builtins.head cageLanes)}" "link" ]
    ++ msgRead p (x "c161") 0 ++ [ "C ${p} 1 a101 3 3" ]
    ++ [ "admin-down" ]
    ++ concatMap (l: set p (x "d0e1") l (x "a008") (x "ff7f") (x "a088") ++ set p (x "d139") l (x "350") (x "fffe") (x "351")) lanes
    ++ [ "admin-up" ]
    ++ concatMap (l: set p (x "d0e1") l (x "a008") (x "ff7f") (x "a008") ++ set p (x "d139") l (x "350") (x "fffe") (x "350")
           # as the vendor's power-on: the register at 0xc010 (index 6) is written back as read
           ++ set p (x "c010") 6 3 (x "ffff") 3) lanes;
in
assert builtins.length cages == builtins.length phyIds;
concatStringsSep "\n" ([
  "ext-phy 1"
  "# generated by nix/modules/boards/as7772/ext-phy.nix"
  "poll-ms 500"
  "up-polls 2"
  "holdoff-ms 3000"
] ++ lib.concatLists (imap0 cage cages)) + "\n"
