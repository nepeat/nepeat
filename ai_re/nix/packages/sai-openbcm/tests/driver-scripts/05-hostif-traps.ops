# Host interfaces (KNET netdevs), trap groups, traps (programmed and kept-only), the wildcard
# table entry orchagent creates.
switch
create hostif h0 TYPE=NETDEV OBJ_ID=port0 NAME=Ethernet0
create hostif hdup TYPE=NETDEV OBJ_ID=port0 NAME=Ethernet0
create hostif hcpu TYPE=NETDEV OBJ_ID=cpu NAME=cpu
set hostif h0 OPER_STATUS=true
set hostif h0 VLAN_TAG=KEEP
get hostif h0 NAME TYPE OBJ_ID OPER_STATUS VLAN_TAG
create hostif_trap_group grp QUEUE=4
create hostif_trap t_arp TRAP_TYPE=ARP_REQUEST PACKET_ACTION=COPY TRAP_GROUP=grp
create hostif_trap t_arp2 TRAP_TYPE=ARP_REQUEST PACKET_ACTION=COPY TRAP_GROUP=grp
create hostif_trap t_bgp TRAP_TYPE=BGP PACKET_ACTION=TRAP TRAP_GROUP=grp
create hostif_trap t_lacp TRAP_TYPE=LACP PACKET_ACTION=TRAP
create hostif_trap t_lldp TRAP_TYPE=LLDP PACKET_ACTION=TRAP
remove hostif_trap_group grp
set hostif_trap t_arp PACKET_ACTION=DROP
get hostif_trap t_arp TRAP_TYPE PACKET_ACTION TRAP_GROUP
create hostif_table_entry te TYPE=WILDCARD CHANNEL_TYPE=NETDEV_PHYSICAL_PORT
remove hostif_table_entry te
remove hostif_trap t_arp
remove hostif_trap t_bgp
remove hostif_trap t_lacp
remove hostif_trap t_lldp
remove hostif_trap_group grp
remove hostif_trap_group trapgroup0
remove hostif h0
remove hostif h0
remove_switch
