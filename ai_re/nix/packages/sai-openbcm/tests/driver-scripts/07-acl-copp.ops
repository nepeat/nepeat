# Policers, CoPP (a policed trap group; its traps become field entries), ACL tables / counters /
# entries, table groups bound to ports, entry changes, teardown.
switch
create policer pol METER_TYPE=PACKETS MODE=SR_TCM CIR=600 CBS=600 RED_PACKET_ACTION=DROP
get policer pol CIR RED_PACKET_ACTION COLOR_SOURCE
set policer pol CIR=1000
create hostif_trap_group grp QUEUE=4 POLICER=pol
create hostif_trap t_arp TRAP_TYPE=ARP_REQUEST PACKET_ACTION=COPY TRAP_GROUP=grp
create hostif_trap t_lacp TRAP_TYPE=LACP PACKET_ACTION=TRAP TRAP_GROUP=grp
create hostif_trap t_bgp TRAP_TYPE=BGP PACKET_ACTION=TRAP TRAP_GROUP=grp
create hostif_trap t_ip2me TRAP_TYPE=IP2ME PACKET_ACTION=TRAP TRAP_GROUP=grp
set policer pol RED_PACKET_ACTION=FORWARD
set hostif_trap t_lacp PACKET_ACTION=DROP
set hostif_trap_group grp POLICER=null
remove hostif_trap t_arp
remove hostif_trap t_lacp
remove hostif_trap t_bgp
remove hostif_trap t_ip2me
remove hostif_trap_group grp
create acl_table t ACL_STAGE=INGRESS ACL_BIND_POINT_TYPE_LIST=[PORT,LAG] FIELD_ETHER_TYPE=true FIELD_DST_IP=true FIELD_L4_DST_PORT=true FIELD_ACL_RANGE_TYPE=[L4_SRC_PORT_RANGE,L4_DST_PORT_RANGE]
create acl_counter k TABLE_ID=t ENABLE_PACKET_COUNT=true ENABLE_BYTE_COUNT=true
create acl_entry e TABLE_ID=t PRIORITY=9000 ADMIN_STATE=true ACTION_COUNTER=k FIELD_DST_IP=10.0.0.1/255.255.255.255 ACTION_PACKET_ACTION=DROP
create acl_table_group g ACL_STAGE=INGRESS ACL_BIND_POINT_TYPE_LIST=[PORT] TYPE=PARALLEL
set port port2 INGRESS_ACL=g
create acl_table_group_member gm ACL_TABLE_GROUP_ID=g ACL_TABLE_ID=t PRIORITY=100
set port port3 INGRESS_ACL=g
get acl_counter k PACKETS BYTES
set acl_entry e ACTION_PACKET_ACTION=FORWARD
set acl_entry e ADMIN_STATE=false
set acl_entry e ADMIN_STATE=true
get acl_entry e PRIORITY FIELD_DST_IP ACTION_PACKET_ACTION
remove acl_table t
remove acl_entry e
remove acl_counter k
remove acl_table_group_member gm
set port port2 INGRESS_ACL=null
set port port3 INGRESS_ACL=null
remove acl_table_group g
remove acl_table t
remove policer pol
remove_switch
