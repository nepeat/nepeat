   "prefix": "10.20.0.0/16",
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$nh2"
    ]
   ]
  },
  {
   "op": "sleep",
   "ms": 12000
  },
  {
   "op": "get",
   "obj": "$ports[0]",
   "desc": "oper Ethernet0",
   "attr": [
    "OPER_STATUS",
    "s32"
   ]
  },
  {
   "op": "exec",
   "cmd": "$ORACLE/bin/l3-frames tx=Ethernet120 rx=Ethernet0,Ethernet120 dmac=02:00:00:00:01:0a smac=02:00:00:00:0a:02 src=10.1.0.2 dst=10.20.1.1 count=100 pps=1000"
  },
  {
   "op": "stats",
   "obj": "$rifA",
   "desc": "RIF A",
   "ids": [
    "IN_PACKETS",
    "OUT_PACKETS"
   ],
   "may_fail": true
  },
  {
   "op": "remove_switch"
  },
  {
   "op": "sleep",
   "ms": 1,
   "desc": "==== round 2"
  },
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
