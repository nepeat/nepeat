     "s32",
     "IP"
    ],
    [
     "IP",
     "ip",
     "10.1.0.2"
    ],
    [
     "ROUTER_INTERFACE_ID",
     "oid",
     "$rifA"
    ]
   ]
  },
  {
   "op": "create",
   "type": "NEXT_HOP",
   "as": "nh2",
   "desc": "10.2.0.2",
   "attrs": [
    [
     "TYPE",
     "s32",
     "IP"
    ],
    [
     "IP",
     "ip",
     "10.2.0.2"
    ],
    [
     "ROUTER_INTERFACE_ID",
     "oid",
     "$rifB"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "10.20.0.0/16 -> nh2",
