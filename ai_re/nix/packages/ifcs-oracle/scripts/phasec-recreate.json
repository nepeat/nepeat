{
 "name": "phasec-recreate: create_switch, L3 + traffic, remove_switch, twice in one process",
 "steps": [
  {
   "op": "sleep",
   "ms": 1,
   "desc": "==== round 1"
  },
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ],
    [
     "PORT_STATE_CHANGE_NOTIFY",
     "ptr",
     "port_state"
    ],
    [
     "SWITCH_SHUTDOWN_REQUEST_NOTIFY",
     "ptr",
     "shutdown"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "CPU_PORT",
    "oid"
   ],
   "as": "cpu"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VIRTUAL_ROUTER_ID",
    "oid"
   ],
   "as": "vr"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VLAN_ID",
    "oid"
   ],
   "as": "vlan1"
  },
  {
   "op": "get",
   "obj": "$vlan1",
   "desc": "VLAN 1 members",
   "attr": [
    "MEMBER_LIST",
    "oidlist",
    64
   ],
   "as": "vmembers"
  },
  {
   "op": "foreach",
   "list": "vmembers",
   "as": "m",
   "steps": [
    {
     "op": "remove",
     "obj": "$m",
     "desc": "VLAN 1 member"
    }
   ]
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "desc": "mtu",
   "attr": [
    "MTU",
    "u32",
    9100
   ]
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "desc": "fec rs",
   "attr": [
    "FEC_MODE",
    "s32",
    "RS"
   ]
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "desc": "admin up",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "set",
   "obj": "$ports[15]",
   "desc": "mtu",
   "attr": [
    "MTU",
    "u32",
    9100
   ]
  },
  {
   "op": "set",
   "obj": "$ports[15]",
   "desc": "fec rs",
   "attr": [
    "FEC_MODE",
    "s32",
    "RS"
   ]
  },
  {
   "op": "set",
   "obj": "$ports[15]",
   "desc": "admin up",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF",
   "as": "hif0",
   "desc": "Ethernet0",
   "attrs": [
    [
     "TYPE",
     "s32",
     "NETDEV"
    ],
    [
     "OBJ_ID",
     "oid",
     "$ports[0]"
    ],
    [
     "NAME",
     "chardata",
     "Ethernet0"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF",
   "as": "hif1",
   "desc": "Ethernet120",
   "attrs": [
    [
     "TYPE",
     "s32",
     "NETDEV"
    ],
    [
     "OBJ_ID",
     "oid",
     "$ports[15]"
    ],
    [
     "NAME",
     "chardata",
     "Ethernet120"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP_GROUP",
   "as": "g_q4",
   "desc": "queue 4",
   "attrs": [
    [
     "QUEUE",
     "u32",
     4
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP_GROUP",
   "as": "g_q1",
   "desc": "queue 1",
   "attrs": [
    [
     "QUEUE",
     "u32",
     1
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_arpq",
   "desc": "ARP_REQUEST",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "ARP_REQUEST"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "COPY"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q4"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_arpr",
   "desc": "ARP_RESPONSE",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "ARP_RESPONSE"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "COPY"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q4"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_nd",
   "desc": "IPV6_NEIGHBOR_DISCOVERY",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "IPV6_NEIGHBOR_DISCOVERY"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "COPY"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q4"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_ip2me",
   "desc": "IP2ME",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "IP2ME"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q1"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_ttl",
   "desc": "TTL_ERROR",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "TTL_ERROR"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q1"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_mtu",
   "desc": "L3_MTU_ERROR",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "L3_MTU_ERROR"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q1"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "default v4 DROP",
   "vr": "$vr",
   "prefix": "0.0.0.0/0",
   "attrs": [
    [
     "PACKET_ACTION",
     "s32",
     "DROP"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "default v6 DROP",
   "vr": "$vr",
   "prefix": "::/0",
   "attrs": [
    [
     "PACKET_ACTION",
     "s32",
     "DROP"
    ]
   ]
  },
  {
   "op": "create",
   "type": "ROUTER_INTERFACE",
   "as": "rifA",
   "desc": "RIF A on Ethernet0 (cage 1)",
   "attrs": [
    [
     "VIRTUAL_ROUTER_ID",
     "oid",
     "$vr"
    ],
    [
     "TYPE",
     "s32",
     "PORT"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[0]"
    ],
    [
     "SRC_MAC_ADDRESS",
     "mac",
     "02:00:00:00:01:0a"
    ],
    [
     "MTU",
     "u32",
     9100
    ]
   ]
  },
  {
   "op": "create",
   "type": "ROUTER_INTERFACE",
   "as": "rifB",
   "desc": "RIF B on Ethernet120 (cage 16)",
   "attrs": [
    [
     "VIRTUAL_ROUTER_ID",
     "oid",
     "$vr"
    ],
    [
     "TYPE",
     "s32",
     "PORT"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[15]"
    ],
    [
     "SRC_MAC_ADDRESS",
     "mac",
     "02:00:00:00:01:0b"
    ],
    [
     "MTU",
     "u32",
     9100
    ]
   ]
  },
  {
   "op": "create",
   "type": "ACL_TABLE",
   "as": "obs",
   "desc": "loop observer: frames to the far hosts' MACs (02:00:00:00:0a/0b:xx) to the CPU",
   "attrs": [
    [
     "ACL_STAGE",
     "s32",
     "INGRESS"
    ],
    [
     "ACL_BIND_POINT_TYPE_LIST",
     "s32list",
     [
      "PORT"
     ]
    ],
    [
     "FIELD_DST_MAC",
     "bool",
     true
    ],
    [
     "ACL_ACTION_TYPE_LIST",
     "s32list",
     [
      "PACKET_ACTION"
     ]
    ]
   ]
  },
  {
   "op": "create",
   "type": "ACL_TABLE_GROUP",
   "as": "obs_g0",
   "desc": "observer group Ethernet0",
   "attrs": [
    [
     "ACL_STAGE",
     "s32",
     "INGRESS"
    ],
    [
     "ACL_BIND_POINT_TYPE_LIST",
     "s32list",
     [
      "PORT"
     ]
    ],
    [
     "TYPE",
     "s32",
     "PARALLEL"
    ]
   ]
  },
  {
   "op": "create",
   "type": "ACL_TABLE_GROUP",
   "as": "obs_g15",
   "desc": "observer group Ethernet120",
   "attrs": [
    [
     "ACL_STAGE",
     "s32",
     "INGRESS"
    ],
    [
     "ACL_BIND_POINT_TYPE_LIST",
     "s32list",
     [
      "PORT"
     ]
    ],
    [
     "TYPE",
     "s32",
     "PARALLEL"
    ]
   ]
  },
  {
   "op": "create",
   "type": "ACL_TABLE_GROUP_MEMBER",
   "as": "obs_m0",
   "attrs": [
    [
     "ACL_TABLE_GROUP_ID",
     "oid",
     "$obs_g0"
    ],
    [
     "ACL_TABLE_ID",
     "oid",
     "$obs"
    ],
    [
     "PRIORITY",
     "u32",
     100
    ]
   ]
  },
  {
   "op": "create",
   "type": "ACL_TABLE_GROUP_MEMBER",
   "as": "obs_m15",
   "attrs": [
    [
     "ACL_TABLE_GROUP_ID",
     "oid",
     "$obs_g15"
    ],
    [
     "ACL_TABLE_ID",
     "oid",
     "$obs"
    ],
    [
     "PRIORITY",
     "u32",
     100
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "desc": "Ethernet0 INGRESS_ACL observer",
   "attr": [
    "INGRESS_ACL",
    "oid",
    "$obs_g0"
   ]
  },
  {
   "op": "set",
   "obj": "$ports[15]",
   "desc": "Ethernet120 INGRESS_ACL observer",
   "attr": [
    "INGRESS_ACL",
    "oid",
    "$obs_g15"
   ]
  },
  {
   "op": "create",
   "type": "ACL_ENTRY",
   "as": "obs_e",
   "desc": "DST_MAC 02:00:00:00:0a:00/ff:ff:ff:ff:fe:00 TRAP",
   "attrs": [
    [
     "TABLE_ID",
     "oid",
     "$obs"
    ],
    [
     "PRIORITY",
     "u32",
     10
    ],
    [
     "FIELD_DST_MAC",
     "aclfield",
     {
      "mac": "02:00:00:00:0a:00",
      "mask": "ff:ff:ff:ff:fe:00"
     }
    ],
    [
     "ACTION_PACKET_ACTION",
     "aclaction",
     {
      "s32": "TRAP"
     }
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "ip2me 10.1.0.1",
   "vr": "$vr",
   "prefix": "10.1.0.1/32",
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$cpu"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "ip2me 10.2.0.1",
   "vr": "$vr",
   "prefix": "10.2.0.1/32",
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$cpu"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "connected 10.1.0.0/24 (glean)",
   "vr": "$vr",
   "prefix": "10.1.0.0/24",
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$rifA"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "connected 10.2.0.0/24 (glean)",
   "vr": "$vr",
   "prefix": "10.2.0.0/24",
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$rifB"
    ]
   ]
  },
  {
   "op": "create_neighbor",
   "desc": "10.1.0.2 H1",
   "rif": "$rifA",
   "ip": "10.1.0.2",
   "attrs": [
    [
     "DST_MAC_ADDRESS",
     "mac",
     "02:00:00:00:0a:02"
    ]
   ]
  },
  {
   "op": "create_neighbor",
   "desc": "10.2.0.2 H2",
   "rif": "$rifB",
   "ip": "10.2.0.2",
   "attrs": [
    [
     "DST_MAC_ADDRESS",
     "mac",
     "02:00:00:00:0b:02"
    ]
   ]
  },
  {
   "op": "create",
   "type": "NEXT_HOP",
   "as": "nh1",
   "desc": "10.1.0.2",
   "attrs": [
