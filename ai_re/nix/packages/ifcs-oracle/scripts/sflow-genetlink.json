{
 "name": "sflow-genetlink: samplepacket + genetlink hostif psample + SAMPLEPACKET trap table entry (isai behaviour)",
 "steps": [
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ],
    [
     "PORT_STATE_CHANGE_NOTIFY",
     "ptr",
     "port_state"
    ],
    [
     "SWITCH_SHUTDOWN_REQUEST_NOTIFY",
     "ptr",
     "shutdown"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF",
   "desc": "genetlink psample",
   "as": "gnl",
   "attrs": [
    [
     "TYPE",
     "s32",
     2
    ],
    [
     "NAME",
     "chardata",
     "psample"
    ],
    [
     "GENETLINK_MCGRP_NAME",
     "chardata",
     "packets"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP_GROUP",
   "desc": "sflow group queue 2",
   "as": "tg",
   "attrs": [
    [
     "QUEUE",
     "u32",
     2
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "desc": "SAMPLEPACKET",
   "as": "trap",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "SAMPLEPACKET"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$tg"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "create",
   "type": "HOSTIF_TABLE_ENTRY",
   "desc": "trap -> genetlink",
   "as": "te",
   "attrs": [
    [
     "TYPE",
     "s32",
     "TRAP_ID"
    ],
    [
     "TRAP_ID",
     "oid",
     "$trap"
    ],
    [
     "CHANNEL_TYPE",
     "s32",
     5
    ],
    [
     "HOST_IF",
     "oid",
     "$gnl"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "create",
   "type": "SAMPLEPACKET",
   "desc": "1 in 1000",
   "as": "sp",
   "attrs": [
    [
     "SAMPLE_RATE",
     "u32",
     1000
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "INGRESS_SAMPLEPACKET_ENABLE",
    "oid",
    "$sp"
   ],
   "may_fail": true
  },
  {
   "op": "exec",
   "cmd": "ip -d link show type genl 2>/dev/null; cat /proc/net/netlink | head -3; genl ctrl list 2>/dev/null | grep -A2 -i -E 'psample|inno' ; ls /sys/class/net | head -50 | tr '\\n' ' '",
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "INGRESS_SAMPLEPACKET_ENABLE",
    "oid",
    "null"
   ],
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$sp",
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$te",
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$trap",
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$tg",
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$gnl",
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "ADMIN_STATE",
    "bool",
    false
   ]
  },
  {
   "op": "remove_switch"
  }
 ]
}