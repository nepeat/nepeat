diff --git a/drivers/pci/Kconfig b/drivers/pci/Kconfig
index 2b2ccdf4..deb6f299 100644
--- a/drivers/pci/Kconfig
+++ b/drivers/pci/Kconfig
@@ -111,6 +111,23 @@ config PCI_SCAN_SHOW
 	bool "Show PCI devices during startup"
 	depends on PCIE_IMX
 
+config PCIE_ALPINE_V2
+	bool "Annapurna Labs Alpine V2 external PCIe root complex"
+	depends on ARM64
+	help
+	  Root complex driver for the external PCIe ports of Annapurna Labs
+	  (Amazon) Alpine V2 SoCs ("amazon,al-alpine-v2-pcie"), on Annapurna's
+	  PCIe HAL. A link that firmware already trained is kept; otherwise the
+	  port is brought up as an RC with the factory U-Boot's parameters
+	  (DT amazon,link-gen and amazon,link-lanes).
+
+config CMD_ALPINE_V2_PCIE
+	bool "alpcie command"
+	depends on PCIE_ALPINE_V2
+	help
+	  "alpcie status" shows the port, link and unit registers; "alpcie
+	  reinit" tears the port down and runs the full RC init again.
+
 config PCIE_ECAM_GENERIC
 	bool "Generic ECAM-based PCI host controller support"
 	help
