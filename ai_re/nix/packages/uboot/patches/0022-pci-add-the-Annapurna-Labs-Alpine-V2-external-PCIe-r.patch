+ */
+#define AL_ADAPTER_GENERIC_CONTROL_0_VF_UDMA_RST_MASK(vf)	AL_BIT(3 + (vf))
+/* When set, all transactions through the PCI conf & mem BARs get timeout */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ADAPTER_DIS	0x40
+/* Mask PF UDMA from FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_PF_RST_MASK	AL_BIT(8)
+/* Mask VF UDMAs from FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_VF_RST_MASK(vf)	AL_BIT(9 + vf)
+#define AL_ADAPTER_GENERIC_CONTROL_0_APP_RST		AL_BIT(16)
+#define AL_ADAPTER_GENERIC_CONTROL_0_APP_REGS_RST	AL_BIT(17)
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_RESET_1GMAC	AL_BIT(18)
+#define AL_ADAPTER_GENERIC_CONTROL_0_APP_RST_ON_FLR		AL_BIT(24)
+#define AL_ADAPTER_GENERIC_CONTROL_0_APP_REGS_RST_ON_FLR	AL_BIT(25)
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_RESET_1GMAC_ON_FLR	AL_BIT(26)
+
+/**
+ * bit mapping of the AL_ADAPTER_GENERIC_CONTROL_0 register in eth v4 adv unit :
+ * [0]	clock disable enable
+ * [1]	PF status is enabled
+ * [2]	parity protect disabled
+ * ############# Following bits logic operates when they are set to '0'
+ * ## ** vf_flr_trig is the FLR bit according to PCIE spec
+ * ##    (bit 15 in control & status reg of VF config space)
+ * ##    They are not auto cleared, but if vf_presetn_int[func] = 0 the bit is reset.
+ * ##    hence, if bits[15:13] in these register (below) are set to 0 we achieve auto-clear.
+ * ## ** see adp2func[i] effect below at bits[11:8]
+ * [3]	vf_flr_trig => flr_per_func[1] == 1 && adp2func_flr[1] == 1
+ * [4]	vf_flr_trig => flr_per_func[2] == 1 && adp2func_flr[2] == 1
+ * [5]	vf_flr_trig => flr_per_func[3] == 1 && adp2func_flr[3] == 1
+ * ##
+ * [6]	pci_conf_dev_not exists, can be override from common
+ * ## (*) preset_int = 0 resets the pcie cfg space registers (connected to adapter regblock reset n)
+ * ##     by masking this bit an FLR wont reset the pcie config space registers
+ * ##     and so FLR must be issued as a pulse over the FLR bit.
+ * ## (*) pf_flr_trig activated by the FLR bit ([15] at pcie ctrl & status reg of the PR)
+ * ##     this relation can change in use_all_adapter flags is unit during al_eth_common_init(...)
+ * [7]	pf_flr_trig => presetn_int == 0
+ * ## adp2func_flr[i] will cause :
+ * ##   (*) reset of UDMA func [i]
+ * ##   (*) reset of applications according to bits[29:24]
+ * [8]	pf_flr_trig => flr_per_func[0] == 1 && adp2func_flr[0] == 1
+ * [9]	pf_flr_trig => flr_per_func[1] == 1 && adp2func_flr[1] == 1
+ * [10]	pf_flr_trig => flr_per_func[2] == 1 && adp2func_flr[2] == 1
+ * [11] pf_flr_trig => flr_per_func[3] == 1 && adp2func_flr[3] == 1
+ * [12]	pf_flr_trig =>  presetn_int_out == 0. reset_n inside adpt_axi_arb
+ * ## See vf_flr_trig above at bits[5:3]
+ * ## vf_preset_int[func] will only reset the following :
+ * ## (*) VF BME bit
+ * ## (*) VF FLR bit ([15] at pcie ctrl & status)
+ * ## (*) VF func mask
+ * ## (*) VF msix XX en
+ * [13]	pf_flr_trig || vf_flr_trig[0]  =>  vf_presetn_int[0] == 0
+ * [14]	pf_flr_trig || vf_flr_trig[0]  =>  vf_presetn_int[0] == 0
+ * [15]	pf_flr_trig || vf_flr_trig[0]  =>  vf_presetn_int[0] == 0
+ * ############# Following bits logic operates when they are set to '1'
+ * ## bits [21:16] resets the application without relation to the PCIE FLR, each adapter resets
+ * ## its own app, there is NO auto clear
+ * [16]	app_reset (EC)
+ * [17]	app_reset (EC regs)
+ * [18]	app_reset (MAC)
+ * [19]	RESERVED
+ * [20]	app_reset (shared_cache_reset)
+ * [21]	app_reset (shared_resource_reset)
+ * [22]	RESERVED
+ * [23]	RESERVED
+ * ## use of the following bits makes sense only if we perform PCIE FLR, bit[8] is set to 0
+ * ## and we must make sure that the FLR bit be cleared
+ * [24]	adp2func_flr_mux_out[i] -> app_reset[i]
+ * [25]	adp2func_flr_mux_out[i] -> app_reg_reset[i]
+ * [26]	adp2func_flr_mux_out[i] -> mac_reset[i]
+ * [27]	RESERVED
+ * [28]	adp2func_flr_mux_out[0] -> shared_cache_reset
+ * [29]	adp2func_flr_mux_out[0] -> shared_resource_reset
+ * [30]	RESERVED
+ * [31]	RESERVED
+ */
+/* Make sure this bit is at "0" for auto-clear of FLR bit */
+#define AL_ADAPTER_GENERIC_CONTROL_0_CFG_REGS_RESET_MASK		AL_BIT(7)
+#define AL_ADAPTER_GENERIC_CONTROL_0_AXI_ARB_RESET_MASK			AL_BIT(12)
+#define AL_ADAPTER_GENERIC_CONTROL_0_VF_PCIE_CFG_RST_MASK(i)		AL_BIT(13 + (i))
+
+/* This is the reset value of this reg in the HW */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_HW_RESET_VAL		0xFF000000
+
+/* EC(0-3) reset to respective UDMA (0-3) */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_EC_RST_EN_SELF		AL_BIT(16)
+/* EC reg(0-3) reset to respective UDMA (0-3) FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_EC_REG_RST_EN_SELF		AL_BIT(17)
+/* MAC(0-3) FLR to respective UDMA (0-3) */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_MAC_RST_EN_SELF		AL_BIT(18)
+/* eth_shared_cache reset */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_SCACHE_RST_EN_SELF		AL_BIT(20)
+/* eth_shared_resource reset */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_SRESOURCE_RST_EN_SELF	AL_BIT(21)
+/* couple EC(0-3) FLR to respective UDMA (0-3) FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_EC_RST_EN		AL_BIT(24)
+/* Couple EC reg(0-3) FLR to respective UDMA (0-3) FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_EC_REG_RST_EN	AL_BIT(25)
+/* Couple MAC(0-3) FLR to respective UDMA (0-3) FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_MAC_RST_EN		AL_BIT(26)
+/* Couple eth_shared_cache FLR to UDMA 0 FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_SCACHE_RST_EN	AL_BIT(28)
+/* Couple eth_shared_resource FLR to UDMA 0 FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_SRESOURCE_RST_EN	AL_BIT(29)
+
+/*
+ * SATA registers only
+ */
+/* Select 125MHz free running clock from IOFAB main PLL as SATA OOB clock
+ * instead of using power management ref clock
+ */
+#define AL_ADAPTER_GENERIC_CONTROL_10_SATA_OOB_CLK_SEL	AL_BIT(26)
+/* AXUSER selection and value per bit (1 = address, 0 = register) */
+/* Rx */
+#define AL_ADPTR_GEN_CTL_12_SATA_AWUSER_VAL_MASK	AL_FIELD_MASK(15, 0)
+#define AL_ADPTR_GEN_CTL_12_SATA_AWUSER_VAL_SHIFT	0
+#define AL_ADPTR_GEN_CTL_12_SATA_AWUSER_SEL_MASK	AL_FIELD_MASK(31, 16)
+#define AL_ADPTR_GEN_CTL_12_SATA_AWUSER_SEL_SHIFT	16
+/* Tx */
+#define AL_ADPTR_GEN_CTL_13_SATA_ARUSER_VAL_MASK	AL_FIELD_MASK(15, 0)
+#define AL_ADPTR_GEN_CTL_13_SATA_ARUSER_VAL_SHIFT	0
+#define AL_ADPTR_GEN_CTL_13_SATA_ARUSER_SEL_MASK	AL_FIELD_MASK(31, 16)
+#define AL_ADPTR_GEN_CTL_13_SATA_ARUSER_SEL_SHIFT	16
+/* Central Target-ID enabler. If set, then each entry will be used as programmed */
+#define AL_ADPTR_GEN_CTL_14_SATA_MSIX_TGTID_SEL		AL_BIT(0)
+/* Allow access to store Target-ID values per entry */
+#define AL_ADPTR_GEN_CTL_14_SATA_MSIX_TGTID_ACCESS_EN	AL_BIT(1)
+/* Target-ID Address select */
+/* Tx */
+#define AL_ADPTR_GEN_CTL_14_SATA_VM_ARADDR_SEL_MASK	AL_FIELD_MASK(13, 8)
+#define AL_ADPTR_GEN_CTL_14_SATA_VM_ARADDR_SEL_SHIFT	8
+/* Rx */
+#define AL_ADPTR_GEN_CTL_14_SATA_VM_AWADDR_SEL_MASK	AL_FIELD_MASK(21, 16)
+#define AL_ADPTR_GEN_CTL_14_SATA_VM_AWADDR_SEL_SHIFT	16
+/* Address Value */
+/* Rx */
+#define AL_ADPTR_GEN_CTL_15_SATA_VM_AWDDR_HI	AL_FIELD_MASK(31, 0)
+/* Tx */
+#define AL_ADPTR_GEN_CTL_16_SATA_VM_ARDDR_HI	AL_FIELD_MASK(31, 0)
+
+/*
+ * ROB registers
+ */
+/* Read ROB Enable, when disabled the read ROB is bypassed */
+#define AL_ADPTR_GEN_CTL_19_READ_ROB_EN			AL_BIT(0)
+/* Read force in-order of every read transaction */
+#define AL_ADPTR_GEN_CTL_19_READ_ROB_FORCE_INORDER	AL_BIT(1)
+/* Read software reset */
+#define AL_ADPTR_GEN_CTL_19_READ_ROB_SW_RESET		AL_BIT(15)
+/* Write ROB Enable, when disabled the Write ROB is bypassed */
+#define AL_ADPTR_GEN_CTL_19_WRITE_ROB_EN		AL_BIT(16)
+/* Write force in-order of every write transaction */
+#define AL_ADPTR_GEN_CTL_19_WRITE_ROB_FORCE_INORDER	AL_BIT(17)
+/* Write software reset */
+#define AL_ADPTR_GEN_CTL_19_WRITE_ROB_SW_RESET		AL_BIT(31)
+
+#define AL_ADPTR_VF_BASE(vf_num)			(0x1000 + ((vf_num) * 0x1000))
+#define AL_ADPTR_VF_CTRL_STATUS(vf_num)			(AL_ADPTR_VF_BASE(vf_num) + 0x48)
+#define AL_ADPTR_VF_CTRL_STATUS_FLR			AL_BIT(15)
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/drivers/pci/al_pcie/al_init_pcie_rc.c b/drivers/pci/al_pcie/al_init_pcie_rc.c
new file mode 100644
index 00000000..95b6444c
--- /dev/null
+++ b/drivers/pci/al_pcie/al_init_pcie_rc.c
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Root-complex bring-up of one Alpine V2 external PCIe port.
+ *
+ * The order of the HAL calls is the vendor's al_init_pcie() (HAL 3.4,
+ * services/pcie/al_init_pcie.c) for mode RC with reinit_link set: no
+ * SerDes groups (the factory passes none for the external ports, so it
+ * never runs the iCal either), no IB/OB reads override, no PFs, no
+ * extended params. The port parameters are the ones the factory U-Boot
+ * 2.60.4 hands to al_pcie_port_config() (its static al_init_pcie_params
+ * template at 0x011b3180, port params at 0x011b3598, Gen3 params at
+ * 0x011b3220; devices/dmc-12-48r-as0/u-boot-port.md has the derivation):
+ *
+ *   link: max speed = board gen, max payload = default
+ *   AXI snoop on, RAM/AXI parity interrupts off
+ *   no latency/replay timers, no Gen2 params, no SRIS, no relaxed ordering
+ *   Gen3: perform EQ, no EQ interrupt, 16 lane EQ entries of
+ *         {DS TX preset 5, DS RX hint 0, US TX preset 9, US RX hint 0},
+ *         LF 6, FS 27, preset request vector 0x200 (RC and EP), FB mode FOM
+ *   fast link mode off, AXI slave error response on
+ */
+
+#include "al_init_pcie_rc.h"
+#include "al_hal_pbs_utils.h"
+
+int al_pcie_hal_failed;
+
+#define LINK_FINAL_WAIT_US	(48 * 1000)	/* al_init_pcie LINK_FINAL_WAIT_MS */
+#define FACTORY_EQ_ELEMS	16
+
+void al_init_pcie_rc_port_params(const struct al_init_pcie_rc_cfg *cfg,
+				 struct al_pcie_port_config_params *params,
+				 struct al_pcie_link_params *link,
+				 struct al_pcie_gen3_params *gen3,
+				 struct al_pcie_gen3_lane_eq_params *eq,
+				 unsigned int eq_elems)
+{
+	unsigned int i;
+
+	al_memset(params, 0, sizeof(*params));
+	al_memset(link, 0, sizeof(*link));
+	al_memset(gen3, 0, sizeof(*gen3));
+
+	link->max_speed = (enum al_pcie_link_speed)cfg->gen;
+	link->max_payload_size = AL_PCIE_MPS_DEFAULT;
+
+	for (i = 0; i < eq_elems; i++) {
+		eq[i].downstream_port_transmitter_preset = 5;
+		eq[i].downstream_port_receiver_preset_hint = 0;
+		eq[i].upstream_port_transmitter_preset = 9;
+		eq[i].upstream_port_receiver_preset_hint = 0;
+	}
+	gen3->perform_eq = AL_TRUE;
+	gen3->interrupt_enable_on_link_eq_request = AL_FALSE;
+	gen3->eq_params = eq;
+	gen3->eq_params_elements = eq_elems;
+	gen3->eq_disable = AL_FALSE;
+	gen3->eq_phase2_3_disable = AL_FALSE;
+	gen3->eq_redo_bypass = AL_FALSE;
+	gen3->local_lf = 6;
+	gen3->local_fs = 27;
+	gen3->pset_req_vec_rc = 0x200;
+	gen3->pset_req_vec_ep = 0x200;
+	gen3->fb_mode = AL_PCIE_GEN3_FB_MODE_FOM;
+	gen3->fmdc = NULL;
+
+	params->link_params = link;
+	params->enable_axi_snoop = AL_TRUE;
+	params->enable_ram_parity_int = AL_FALSE;
+	params->enable_axi_parity_int = AL_FALSE;
+	params->lat_rply_timers = NULL;
+	params->gen2_params = NULL;
+	params->gen3_params = gen3;
+	params->fast_link_mode = AL_FALSE;
+	params->enable_axi_slave_err_resp = AL_TRUE;
+	params->sris_params = NULL;
+	params->relaxed_ordering_params = NULL;
+}
+
+/* al_init_pcie PORT_DIS_EN_WAIT_US: Alpine V1/V2 need 500 us. */
+static unsigned int port_wait_us(const struct al_init_pcie_rc_cfg *cfg)
+{
+	return al_pbs_dev_id_get(cfg->pbs_reg_base) <= PBS_UNIT_CHIP_ID_DEV_ID_ALPINE_V2 ?
+		500 : 20;
+}
+
+#define STEP(name, call)					\
+	do {							\
+		al_pcie_hal_failed = 0;				\
+		rc = (call);					\
+		if (!rc && al_pcie_hal_failed)			\
+			rc = -EINVAL;				\
+		if (rc) {					\
+			res->step = name;			\
+			goto fail;				\
+		}						\
+	} while (0)
+
+int al_init_pcie_rc(struct al_pcie_port *pcie_port,
+		    const struct al_init_pcie_rc_cfg *cfg,
+		    struct al_init_pcie_rc_result *res)
+{
+	struct al_pcie_port_config_params params;
+	struct al_pcie_link_params link;
+	struct al_pcie_gen3_params gen3;
+	struct al_pcie_gen3_lane_eq_params eq[FACTORY_EQ_ELEMS];
+	unsigned int us = port_wait_us(cfg);
+	unsigned int i;
+	int rc;
+
+	al_memset(res, 0, sizeof(*res));
+	al_init_pcie_rc_port_params(cfg, &params, &link, &gen3, eq, FACTORY_EQ_ELEMS);
+
+	al_pcie_hal_failed = 0;
+	rc = al_pcie_port_handle_init(pcie_port, cfg->pcie_reg_base,
+				      cfg->pbs_reg_base, cfg->port_id);
+	if (rc || al_pcie_hal_failed) {
+		res->rc = rc ? rc : -EINVAL;
+		res->step = "port handle init";
+		return res->rc;		/* nothing touched yet */
+	}
+
+	al_pcie_link_status(pcie_port, &res->status);
+	if (res->status.ltssm_state || al_pcie_port_is_enabled(pcie_port)) {
+		/* reinit_link: stop what runs, then start from a disabled port */
+		res->torn_down = AL_TRUE;
+		if (al_pcie_is_link_started(pcie_port))
+			al_pcie_link_stop(pcie_port);
+		if (al_pcie_port_is_enabled(pcie_port)) {
+			al_data_memory_barrier();
+			al_pcie_port_memory_shutdown_set(pcie_port, AL_TRUE);
+			al_data_memory_barrier();
+			al_pcie_port_disable(pcie_port);
+		}
+		al_udelay(us);
+	}
+
+	STEP("port enable (before shutdown)", al_pcie_port_enable(pcie_port));
+	al_udelay(us);
+
+	al_data_memory_barrier();
+	STEP("memory shutdown off", al_pcie_port_memory_shutdown_set(pcie_port, AL_FALSE));
+	al_data_memory_barrier();
+
+	al_pcie_port_disable(pcie_port);
+
+	STEP("operating mode RC",
+	     al_pcie_port_operating_mode_config(pcie_port, AL_PCIE_OPERATING_MODE_RC));
+	STEP("max lanes", al_pcie_port_max_lanes_set(pcie_port, cfg->lanes));
+	STEP("max PFs", al_pcie_port_max_num_of_pfs_set(pcie_port, 1));
+
+	STEP("port enable", al_pcie_port_enable(pcie_port));
+	al_udelay(us);			/* more than 2000 core clocks */
+
+	STEP("port config", al_pcie_port_config(pcie_port, &params));
+
+	STEP("link start", al_pcie_link_start(pcie_port));
+	STEP("link up wait",
+	     al_pcie_link_up_wait_ex(pcie_port, cfg->wait_for_link_ms, AL_FALSE));
+
+	/* As al_init_pcie: give the link up to 48 ms to reach the max speed. */
+	for (i = 0; i < LINK_FINAL_WAIT_US / 50; i++) {
+		STEP("link status", al_pcie_link_status(pcie_port, &res->status));
+		if (res->status.speed == link.max_speed)
+			break;
+		al_udelay(50);
+	}
+	if (!res->status.link_up) {
+		rc = -EINVAL;
+		res->step = "link up";
+		goto fail;
+	}
+	return 0;
+
+fail:
+	/* the vendor teardown: stop the link, shut the memories, disable */
+	res->rc = rc;
+	if (al_pcie_port_is_enabled(pcie_port)) {
+		if (al_pcie_is_link_started(pcie_port))
+			al_pcie_link_stop(pcie_port);
+		al_pcie_port_memory_shutdown_set(pcie_port, AL_TRUE);
+		al_pcie_port_disable(pcie_port);
+	}
+	al_pcie_link_status(pcie_port, &res->status);
+	return rc;
+}
diff --git a/drivers/pci/al_pcie/al_init_pcie_rc.h b/drivers/pci/al_pcie/al_init_pcie_rc.h
new file mode 100644
index 00000000..40cc748d
--- /dev/null
+++ b/drivers/pci/al_pcie/al_init_pcie_rc.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Root-complex bring-up of one Alpine V2 external PCIe port on the
+ * Annapurna HAL: the RC path of the vendor's al_init_pcie() service
+ * (HAL services/pcie/al_init_pcie.c, not copied: it pulls in the SerDes,
+ * address-map and system-fabric services), with the parameters the
+ * factory U-Boot (alpine_db 2.60.4, pci_init_board_external) passes.
+ *
+ * No U-Boot API in here, so the same file builds on a host against a
+ * register model (nix/packages/uboot/alpine-v2/pcie-test).
+ */
+#ifndef __AL_INIT_PCIE_RC_H__
+#define __AL_INIT_PCIE_RC_H__
+
+#include "al_hal_pcie.h"
+
+struct al_init_pcie_rc_cfg {
+	unsigned int port_id;
+	void __iomem *pcie_reg_base;	/* the port's unit ("controller") */
+	void __iomem *pbs_reg_base;	/* PBS register file */
+	unsigned int gen;		/* max link speed, 1..3 */
+	unsigned int lanes;		/* max lanes, 1/2/4/8 */
+	unsigned int wait_for_link_ms;
+};
+
+struct al_init_pcie_rc_result {
+	int rc;
+	const char *step;		/* what failed, if rc != 0 */
+	al_bool torn_down;		/* a running link/port was stopped first */
+	struct al_pcie_link_status status;
+};
+
+/*
+ * Bring the port up as an RC and train the link. A port that is already
+ * enabled or has a link (any LTSSM state) is first stopped, its memories
+ * shut down and the port disabled, as al_init_pcie() does with
+ * reinit_link. On failure the port is left stopped and disabled, as the
+ * vendor teardown does.
+ */
+int al_init_pcie_rc(struct al_pcie_port *pcie_port,
+		    const struct al_init_pcie_rc_cfg *cfg,
+		    struct al_init_pcie_rc_result *res);
+
+/* What the factory port_config gets for these settings (exported for tests). */
+void al_init_pcie_rc_port_params(const struct al_init_pcie_rc_cfg *cfg,
+				 struct al_pcie_port_config_params *params,
+				 struct al_pcie_link_params *link,
+				 struct al_pcie_gen3_params *gen3,
+				 struct al_pcie_gen3_lane_eq_params *eq,
+				 unsigned int eq_elems);
+
+extern int al_pcie_hal_failed;
+
+#endif
diff --git a/drivers/pci/pcie_alpine_v2.c b/drivers/pci/pcie_alpine_v2.c
new file mode 100644
index 00000000..731c539b
--- /dev/null
+++ b/drivers/pci/pcie_alpine_v2.c
@@ -0,0 +1,411 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Annapurna Labs Alpine V2 external PCIe root complex ("amazon,al-alpine-v2-pcie",
+ * the node mainline Linux pcie-al binds to).
+ *
+ * The port is brought up with Annapurna's PCIe HAL (al_pcie/, verbatim)
+ * in the order and with the parameters of the factory U-Boot
+ * (al_pcie/al_init_pcie_rc.c). Probe policy:
+ *  - link already up (the factory U-Boot trained it before chainloading
+ *    us): keep it, touch nothing but the config-bus registers;
+ *  - otherwise (started straight from al-boot stage3): full RC init;
+ *  - "alpcie reinit": tear the port down and run the full init now, so a
+ *    RAM test after the factory init proves our init, not the factory's.
+ *
+ * Config space: the root port's own header is the DesignWare core ("dbi"),
+ * everything behind it goes through the 1 MiB "config" window with the
+ * target bus in the unit's cfg_target_bus register (as pcie-al does).
+ * Downstream accesses that fail raise an SError on this SoC; it is drained
+ * (pcie_alpine_v2_serror.S) and the read returns all ones, or, for a
+ * vendor ID read, is retried while the device answers CRS.
+ */
+
+#include <command.h>
+#include <console.h>
+#include <dm.h>
+#include <dm/device-internal.h>
+#include <log.h>
+#include <pci.h>
+#include <time.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <linux/ioport.h>
+
+#include "al_pcie/al_init_pcie_rc.h"
+
+#define AL_PBS_REGFILE_BASE	0xfd8a8000	/* Alpine V2 iomap */
+#define AL_PCIE_UNIT_STRIDE	0x20000
+#define AL_PCIE_UNIT0		0xfd800000
+#define AL_PCIE_UNIT3		0xfd900000
+
+/* DesignWare port logic, relative to the dbi base */
+#define DW_AMBA_ERR_RESP	0x8d0
+#define DW_ATU_VIEWPORT		0x900
+#define DW_ATU_CR1		0x904
+#define DW_ATU_CR2		0x908
+#define DW_ATU_LOWER_BASE	0x90c
+#define DW_ATU_UPPER_BASE	0x910
+#define DW_ATU_LIMIT		0x914
+#define DW_ATU_LOWER_TARGET	0x918
+#define DW_ATU_UPPER_TARGET	0x91c
+#define DW_ATU_ENABLE		BIT(31)
+
+#define CRS_TIMEOUT_MS		30000	/* board-cfg/pcie crs-timeout */
+
+int alpine_v2_serror_drain(void);
+
+struct alpine_pcie_priv {
+	void __iomem *ecam;
+	void __iomem *regs;
+	void __iomem *dbi;
+	void __iomem *pbs;
+	struct al_pcie_port port;
+	unsigned int port_id;
+	unsigned int gen, lanes;
+	int target_bus;			/* cached cfg_target_bus, -1 = unknown */
+	bool ok;			/* HAL port handle valid */
+	bool link_up;
+	const char *how;		/* "firmware", "ours", "down" */
+	unsigned int serrors;		/* SErrors drained since probe */
+	ulong mem_base, mem_size;
+};
+
+/* "alpcie reinit" sets this, probe consumes it */
+static bool alpine_pcie_force_init;
+
+static int alpine_pcie_drain(struct alpine_pcie_priv *priv)
+{
+	int r = alpine_v2_serror_drain();
+
+	if (r == 1)
+		priv->serrors++;
+	return r;
+}
+
+static int alpine_pcie_addr(const struct udevice *bus, pci_dev_t bdf,
+			    uint offset, void **paddr)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(bus);
+	int busn = PCI_BUS(bdf) - dev_seq(bus);
+
+	if (!priv->ok)
+		return -ENODEV;
+	if (busn == 0) {
+		/* the root port itself; nothing else on the root bus */
+		if (PCI_DEV(bdf) || PCI_FUNC(bdf) ||
+		    !al_pcie_port_is_enabled(&priv->port))
+			return -ENODEV;
+		*paddr = priv->dbi + offset;
+		return 0;
+	}
+	if (!priv->link_up || busn > 0xff)
+		return -ENODEV;
+	/* a PCIe link has one device: no aliases of it at dev 1..31 */
+	if (busn == 1 && PCI_DEV(bdf))
+		return -ENODEV;
+	if (priv->target_bus != busn) {
+		al_pcie_target_bus_set(&priv->port, busn, 0xff);
+		priv->target_bus = busn;
+	}
+	*paddr = priv->ecam + PCIE_ECAM_OFFSET(0, PCI_DEV(bdf), PCI_FUNC(bdf), offset);
+	return 0;
+}
+
+static int alpine_pcie_read_config(const struct udevice *bus, pci_dev_t bdf,
+				   uint offset, ulong *valuep,
+				   enum pci_size_t size)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(bus);
+	bool downstream = PCI_BUS(bdf) != dev_seq(bus);
+	ulong start = get_timer(0);
+	bool told = false;
+	int ret;
+
+	for (;;) {
+		ret = pci_generic_mmap_read_config(bus, alpine_pcie_addr, bdf,
+						   offset, valuep, size);
+		if (ret || !downstream || alpine_pcie_drain(priv) != 1)
+			return ret;
+		/* error completion: all ones, except a vendor ID read under CRS */
+		*valuep = pci_get_ff(size);
+		if (offset != PCI_VENDOR_ID)
+			return 0;
+		if (!told) {
+			printf("PCIe %d: %02x.%02x.%x answers CRS, waiting [ctrl-c to skip]\n",
+			       priv->port_id, PCI_BUS(bdf), PCI_DEV(bdf), PCI_FUNC(bdf));
+			told = true;
+		}
+		if (ctrlc() || get_timer(start) > CRS_TIMEOUT_MS) {
+			printf("PCIe %d: %02x.%02x.%x: no answer, skipped\n", priv->port_id,
+			       PCI_BUS(bdf), PCI_DEV(bdf), PCI_FUNC(bdf));
+			return 0;
+		}
+		mdelay(1);
+	}
+}
+
+static int alpine_pcie_write_config(struct udevice *bus, pci_dev_t bdf,
+				    uint offset, ulong value,
+				    enum pci_size_t size)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(bus);
+	int ret;
+
+	ret = pci_generic_mmap_write_config(bus, alpine_pcie_addr, bdf, offset,
+					    value, size);
+	if (!ret && PCI_BUS(bdf) != dev_seq(bus) && alpine_pcie_drain(priv) == 1)
+		debug("PCIe %d: config write %x@%x: error response\n",
+		      priv->port_id, bdf, offset);
+	return ret;
+}
+
+/* Outbound iATU region 0: the memory window, identity, as Linux dwc does. */
+static void alpine_pcie_iatu(struct udevice *dev, struct alpine_pcie_priv *priv)
+{
+	u64 base = priv->mem_base, limit = priv->mem_base + priv->mem_size - 1;
+
+	if (!priv->mem_size)
+		return;
+	if (readl(priv->dbi + DW_ATU_VIEWPORT) == 0xffffffff) {
+		printf("PCIe %d: no iATU viewport, memory window left untranslated\n",
+		       priv->port_id);
+		return;
+	}
+	writel(0, priv->dbi + DW_ATU_VIEWPORT);		/* outbound, region 0 */
+	writel(lower_32_bits(base), priv->dbi + DW_ATU_LOWER_BASE);
+	writel(upper_32_bits(base), priv->dbi + DW_ATU_UPPER_BASE);
+	writel(lower_32_bits(limit), priv->dbi + DW_ATU_LIMIT);
+	writel(lower_32_bits(base), priv->dbi + DW_ATU_LOWER_TARGET);
+	writel(upper_32_bits(base), priv->dbi + DW_ATU_UPPER_TARGET);
+	writel(0, priv->dbi + DW_ATU_CR1);			/* MEM */
+	writel(DW_ATU_ENABLE, priv->dbi + DW_ATU_CR2);
+	if (!(readl(priv->dbi + DW_ATU_CR2) & DW_ATU_ENABLE))
+		printf("PCIe %d: iATU region 0 did not enable\n", priv->port_id);
+}
+
+static const char *speed_name(unsigned int s)
+{
+	return s == 1 ? "2.5GT/s" : s == 2 ? "5GT/s" : s == 3 ? "8GT/s" : "?";
+}
+
+static int alpine_pcie_bringup(struct udevice *dev, struct alpine_pcie_priv *priv)
+{
+	struct al_init_pcie_rc_cfg cfg = {
+		.port_id = priv->port_id,
+		.pcie_reg_base = priv->regs,
+		.pbs_reg_base = priv->pbs,
+		.gen = priv->gen,
+		.lanes = priv->lanes,
+		.wait_for_link_ms = 1000,
+	};
+	struct al_init_pcie_rc_result res;
+	int try, rc = -EINVAL;
+
+	for (try = 1; try <= 3; try++) {
+		rc = al_init_pcie_rc(&priv->port, &cfg, &res);
+		if (!rc)
+			break;
+		printf("PCIe %d: init failed at '%s' (%d)%s\n", priv->port_id,
+		       res.step, rc, try < 3 ? ", retrying" : "");
+	}
+	if (rc)
+		return rc;
+	printf("PCIe %d: link up %s x%d (our init%s, LTSSM %#x)\n", priv->port_id,
+	       speed_name(res.status.speed), res.status.lanes,
+	       res.torn_down ? " after teardown" : "", res.status.ltssm_state);
+	/* PCIe: 100 ms from link up before config requests to the device */
+	mdelay(100);
+	return 0;
+}
+
+static int alpine_pcie_probe(struct udevice *dev)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(dev);
+	struct pci_controller *hose = dev_get_uclass_priv(dev);
+	struct al_pcie_link_status st;
+	bool force = alpine_pcie_force_init;
+	ulong unit;
+	int i, rc;
+
+	alpine_pcie_force_init = false;
+	priv->ecam = dev_remap_addr_name(dev, "config");
+	priv->regs = dev_remap_addr_name(dev, "controller");
+	priv->dbi = dev_remap_addr_name(dev, "dbi");
+	if (!priv->ecam || !priv->regs || !priv->dbi)
+		return -EINVAL;
+	priv->pbs = (void __iomem *)(uintptr_t)dev_read_u32_default(dev, "amazon,pbs",
+								    AL_PBS_REGFILE_BASE);
+	unit = (ulong)priv->regs;
+	priv->port_id = dev_read_u32_default(dev, "amazon,port-id",
+		unit == AL_PCIE_UNIT3 ? 3 : (unit - AL_PCIE_UNIT0) / AL_PCIE_UNIT_STRIDE);
+	priv->gen = dev_read_u32_default(dev, "amazon,link-gen", 0);
+	priv->lanes = dev_read_u32_default(dev, "amazon,link-lanes", 0);
+	priv->target_bus = -1;
+
+	for (i = 0; i < hose->region_count; i++) {
+		if (hose->regions[i].flags == PCI_REGION_MEM) {
+			priv->mem_base = hose->regions[i].phys_start;
+			priv->mem_size = hose->regions[i].size;
+		}
+	}
+
+	al_pcie_hal_failed = 0;
+	rc = al_pcie_port_handle_init(&priv->port, priv->regs, priv->pbs, priv->port_id);
+	if (rc || al_pcie_hal_failed) {
+		printf("PCIe %d: unknown controller revision, not used\n", priv->port_id);
+		priv->how = "unsupported";
+		return 0;
+	}
+	priv->ok = true;
+	al_pcie_link_status(&priv->port, &st);
+
+	if (st.link_up && !force) {
+		priv->how = "firmware";
+		printf("PCIe %d: link up %s x%d (firmware init, kept)\n", priv->port_id,
+		       speed_name(st.speed), st.lanes);
+	} else if (!priv->gen || !priv->lanes) {
+		priv->how = "down";
+		printf("PCIe %d: link down, no amazon,link-gen/-lanes: not initialised\n",
+		       priv->port_id);
+	} else if (priv->port.rev_id != AL_PCIE_REV_ID_3) {
+		priv->how = "down";
+		printf("PCIe %d: rev %d: init only tested on rev 3, not initialised\n",
+		       priv->port_id, priv->port.rev_id);
+	} else {
+		priv->how = alpine_pcie_bringup(dev, priv) ? "down" : "ours";
+	}
+
+	al_pcie_link_status(&priv->port, &st);
+	priv->link_up = st.link_up;
+	if (priv->link_up) {
+		/* as pcie-al: bus 1 is the link, every bus number goes out on it */
+		al_pcie_secondary_bus_set(&priv->port, 1);
+		al_pcie_subordinary_bus_set(&priv->port, 0xff);
+		alpine_pcie_iatu(dev, priv);
+	}
+	return 0;
+}
+
+static const struct dm_pci_ops alpine_pcie_ops = {
+	.read_config	= alpine_pcie_read_config,
+	.write_config	= alpine_pcie_write_config,
+};
+
+static const struct udevice_id alpine_pcie_ids[] = {
+	{ .compatible = "amazon,al-alpine-v2-pcie" },
+	{ }
+};
+
+U_BOOT_DRIVER(pcie_alpine_v2) = {
+	.name		= "pcie_alpine_v2",
+	.id		= UCLASS_PCI,
+	.of_match	= alpine_pcie_ids,
+	.ops		= &alpine_pcie_ops,
+	.probe		= alpine_pcie_probe,
+	.priv_auto	= sizeof(struct alpine_pcie_priv),
+};
+
+#if IS_ENABLED(CONFIG_CMD_ALPINE_V2_PCIE)
+static struct udevice *alpine_pcie_find(int port)
+{
+	struct udevice *dev;
+	struct uclass *uc;
+
+	if (uclass_get(UCLASS_PCI, &uc))
+		return NULL;
+	uclass_foreach_dev(dev, uc) {
+		struct alpine_pcie_priv *priv;
+
+		if (dev->driver != DM_DRIVER_GET(pcie_alpine_v2))
+			continue;
+		if (device_probe(dev))
+			continue;
+		priv = dev_get_priv(dev);
+		if (port < 0 || priv->port_id == port)
+			return dev;
+	}
+	return NULL;
+}
+
+static void alpine_pcie_show(struct udevice *dev)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(dev);
+	void __iomem *r = priv->regs;
+	struct al_pcie_link_status st;
+	ulong id = 0xffffffff;
+	bool en;
+
+	if (!priv->ok) {
+		printf("PCIe %d: %s: %s\n", priv->port_id, dev->name, priv->how);
+		return;
+	}
+	en = al_pcie_port_is_enabled(&priv->port);
+	al_pcie_link_status(&priv->port, &st);
+	printf("PCIe %d: %s, rev %d, root bus %d, init: %s, SErrors drained: %u\n",
+	       priv->port_id, dev->name, priv->port.rev_id, dev_seq(dev), priv->how,
+	       priv->serrors);
+	printf("  port %s, link %s %s x%d, LTSSM %#x\n", en ? "enabled" : "disabled",
+	       st.link_up ? "up" : "down", st.link_up ? speed_name(st.speed) : "-",
+	       st.lanes, st.ltssm_state);
+	printf("  PBS +0xe4 %08x  AXI +0x00 %08x +0x14 %08x +0x18 %08x +0x20 %08x\n",
+	       readl(priv->pbs + 0xe4), readl(r), readl(r + 0x14), readl(r + 0x18),
+	       readl(r + 0x20));
+	printf("  AXI +0x30 %08x +0x34 %08x +0xc8 %08x +0xe0 %08x +0xe8 %08x +0xec %08x\n",
+	       readl(r + 0x30), readl(r + 0x34), readl(r + 0xc8), readl(r + 0xe0),
+	       readl(r + 0xe8), readl(r + 0xec));
+	if (en) {
+		printf("  RC %08x, class %08x, AMBA err %08x, iATU viewport %08x\n",
+		       readl(priv->dbi), readl(priv->dbi + 8),
+		       readl(priv->dbi + DW_AMBA_ERR_RESP), readl(priv->dbi + DW_ATU_VIEWPORT));
+	}
+	if (st.link_up) {
+		pci_bus_read_config(dev, PCI_BDF(dev_seq(dev) + 1, 0, 0), PCI_VENDOR_ID,
+				    &id, PCI_SIZE_32);
+		printf("  link partner (bus %d): %04lx:%04lx\n", dev_seq(dev) + 1,
+		       id & 0xffff, id >> 16);
+	}
+}
+
+static int do_alpcie(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	int port = argc > 2 ? dectoul(argv[2], NULL) : -1;
+	const char *op = argc > 1 ? argv[1] : "status";
+	struct udevice *dev;
+	int ret;
+
+	dev = alpine_pcie_find(port);
+	if (!dev) {
+		printf("no Alpine external PCIe port%s\n", port < 0 ? "" : " with that id");
+		return CMD_RET_FAILURE;
+	}
+	if (!strcmp(op, "status")) {
+		alpine_pcie_show(dev);
+		return 0;
+	}
+	if (!strcmp(op, "reinit")) {
+		/* drop the enumeration below us, init from scratch, enumerate again */
+		ret = device_remove(dev, DM_REMOVE_NORMAL);
+		if (ret) {
+			printf("remove failed: %d\n", ret);
+			return CMD_RET_FAILURE;
+		}
+		alpine_pcie_force_init = true;
+		ret = device_probe(dev);
+		alpine_pcie_force_init = false;
+		if (ret) {
+			printf("probe failed: %d\n", ret);
+			return CMD_RET_FAILURE;
+		}
+		alpine_pcie_show(dev);
+		return strcmp(((struct alpine_pcie_priv *)dev_get_priv(dev))->how, "ours") ?
+			CMD_RET_FAILURE : 0;
+	}
+	return CMD_RET_USAGE;
+}
+
+U_BOOT_CMD(alpcie, 3, 0, do_alpcie,
+	   "Alpine V2 external PCIe root complex",
+	   "status [port]  - port, link and unit registers (read-only)\n"
+	   "alpcie reinit [port]  - stop the link, disable the port, run the full\n"
+	   "                        RC init and enumerate the bus again");
+#endif
diff --git a/drivers/pci/pcie_alpine_v2_serror.S b/drivers/pci/pcie_alpine_v2_serror.S
new file mode 100644
index 00000000..ac98ba94
--- /dev/null
+++ b/drivers/pci/pcie_alpine_v2_serror.S
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Alpine V2 external PCIe: with the AXI slave error response on (as the
+ * factory configures the port), a config read that ends in an error
+ * completion (CRS while the device is not ready, UR) is answered with
+ * SLVERR, which this core reports as an asynchronous SError. U-Boot runs
+ * with SErrors masked, so it would stay pending and hit the OS as soon as
+ * that unmasks them.
+ *
+ * alpine_v2_serror_drain() does what the factory U-Boot does after every
+ * external config read (0x0110cef8 / 0x011058ec there): if ISR_EL1.A shows
+ * a pending SError, route it to EL2 (HCR_EL2.AMO), unmask it with a vector
+ * table whose SError entry just returns, wait until it has been taken,
+ * then put HCR_EL2, VBAR_EL2 and PSTATE.A back. Returns 1 if an SError was
+ * drained, 0 if none was pending. EL2 only (returns 2 elsewhere, without
+ * touching anything).
+ */
+
+#include <linux/linkage.h>
+
+#define HCR_AMO		(1 << 5)
+#define ISR_A		(1 << 8)
+
+ENTRY(alpine_v2_serror_drain)
+	dsb	sy
+	isb
+	mrs	x0, isr_el1
+	tst	x0, #ISR_A
+	b.ne	1f
+	mov	x0, #0
+	ret
+1:	mrs	x0, CurrentEL
+	cmp	x0, #0x8
+	b.eq	2f
+	mov	x0, #2
+	ret
+2:	mrs	x1, vbar_el2
+	mrs	x2, hcr_el2
+	mrs	x3, daif
+	adr	x4, alpine_v2_serror_vectors
+	msr	vbar_el2, x4
+	orr	x5, x2, #HCR_AMO
+	msr	hcr_el2, x5
+	isb
+	msr	daifclr, #4			/* unmask SError: it is taken now */
+	isb
+	mov	x6, #0x100000			/* bounded wait */
+3:	mrs	x5, isr_el1
+	tst	x5, #ISR_A
+	b.eq	4f
+	subs	x6, x6, #1
+	b.ne	3b
+4:	msr	daif, x3
+	msr	hcr_el2, x2
+	msr	vbar_el2, x1
+	isb
+	mov	x0, #1
+	ret
+ENDPROC(alpine_v2_serror_drain)
+
+/*
+ * Only the SError entries matter; everything else goes to U-Boot's own
+ * vectors at the same offset, so an unexpected exception still reports.
+ */
+	.macro	pass, off
+	.align	7
+	b	vectors + \off
+	.endm
+
+	.align	11
+alpine_v2_serror_vectors:
+	pass	0x000
+	pass	0x080
+	pass	0x100
+	.align	7
+	eret				/* current EL, SP_EL0: SError */
+	pass	0x200
+	pass	0x280
+	pass	0x300
+	.align	7
+	eret				/* current EL, SP_ELx: SError */
+	pass	0x400
+	pass	0x480
+	pass	0x500
+	pass	0x580
+	pass	0x600
+	pass	0x680
+	pass	0x700
+	pass	0x780
