+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * U-Boot platform services for the Annapurna Labs PCIe HAL (replaces the
+ * vendor al_hal_plat_services.h).
+ *
+ * al_assert() does not stop the board: it prints the failed condition and
+ * latches al_pcie_hal_failed, which the init code checks after each HAL
+ * call and turns into an error. A reset in the middle of a link bring-up
+ * would hide the cause.
+ */
+#ifndef __PLAT_SERVICES_H__
+#define __PLAT_SERVICES_H__
+
+#include <log.h>
+#include <stdio.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <asm/byteorder.h>
+#include <asm/io.h>
+
+extern int al_pcie_hal_failed;
+
+#define al_reg_read8(l)		readb(l)
+#define al_reg_read16(l)	readw(l)
+#define al_reg_read32(l)	readl(l)
+#define al_reg_read64(l)	readq(l)
+
+#define al_reg_write8(l, v)	writeb(v, l)
+#define al_reg_write16(l, v)	writew(v, l)
+#define al_reg_write32(l, v)	writel(v, l)
+#define al_reg_write64(l, v)	writeq(v, l)
+
+#define al_reg_read32_relaxed(l)	readl(l)
+#define al_reg_write32_relaxed(l, v)	writel(v, l)
+
+#define al_print(fmt, ...)	printf(fmt, ##__VA_ARGS__)
+#define al_err(fmt, ...)	printf(fmt, ##__VA_ARGS__)
+#define al_warn(fmt, ...)	printf(fmt, ##__VA_ARGS__)
+#define al_info(fmt, ...)	debug(fmt, ##__VA_ARGS__)
+#define al_dbg(fmt, ...)	debug(fmt, ##__VA_ARGS__)
+#define al_sprintf(...)		sprintf(__VA_ARGS__)
+
+#define al_assert(COND)							\
+	do {								\
+		if (unlikely(!(COND))) {				\
+			printf("al_pcie HAL: assertion '%s' failed at %s:%d\n", \
+			       #COND, __func__, __LINE__);		\
+			al_pcie_hal_failed = 1;				\
+		}							\
+	} while (0)
+
+#define al_assert_msg(COND, ...)					\
+	do {								\
+		if (unlikely(!(COND))) {				\
+			printf(__VA_ARGS__);				\
+			al_assert(COND);				\
+		}							\
+	} while (0)
+
+static inline void al_data_memory_barrier(void)
+{
+	dsb();
+}
+
+static inline void al_local_data_memory_barrier(void)
+{
+	dsb();
+}
+
+static inline void al_smp_data_memory_barrier(void)
+{
+	dsb();
+}
+
+static inline void al_smp_write_data_memory_barrier(void)
+{
+	dsb();
+}
+
+#define al_udelay(u)		udelay(u)
+#define al_msleep(m)		mdelay(m)
+
+#define swap16_to_le(x)		cpu_to_le16(x)
+#define swap32_to_le(x)		cpu_to_le32(x)
+#define swap64_to_le(x)		cpu_to_le64(x)
+#define swap16_from_le(x)	le16_to_cpu(x)
+#define swap32_from_le(x)	le32_to_cpu(x)
+#define swap64_from_le(x)	le64_to_cpu(x)
+#define swap16_to_be(x)		cpu_to_be16(x)
+#define swap32_to_be(x)		cpu_to_be32(x)
+#define swap64_to_be(x)		cpu_to_be64(x)
+#define swap16_from_be(x)	be16_to_cpu(x)
+#define swap32_from_be(x)	be32_to_cpu(x)
+#define swap64_from_be(x)	be64_to_cpu(x)
+
+#define al_memset(p, val, cnt)	memset(p, val, cnt)
+#define al_memcpy(d, s, cnt)	memcpy(d, s, cnt)
+#define al_memcmp(p1, p2, cnt)	memcmp(p1, p2, cnt)
+#define al_strcmp(s1, s2)	strcmp(s1, s2)
+
+#define al_get_cpu_id()		0
+#define al_get_cluster_id()	0
+
+#endif
