diff --git a/drivers/pci/al_pcie/Makefile b/drivers/pci/al_pcie/Makefile
new file mode 100644
index 00000000..533be688
--- /dev/null
+++ b/drivers/pci/al_pcie/Makefile
@@ -0,0 +1,19 @@
+# SPDX-License-Identifier: GPL-2.0+
+#
+# al_hal_*.c/h: Annapurna Labs' PCIe HAL 3.4, copied unmodified from the
+# MikroTik GPL Linux 5.6.3 source drop (drivers/soc/alpine/HAL; the
+# Annapurna files are triple-licensed, used here under GPL-2.0; the
+# Amazon 2017 files carry no licence of their own and are distributed as
+# part of that GPL kernel source). al_hal_plat_services.h and
+# al_hal_plat_types.h are U-Boot shims; al_init_pcie_rc.c is ours.
+
+obj-y += al_init_pcie_rc.o al_hal_pcie.o al_hal_pbs_utils.o
+obj-y += al_hal_pcie_reg_ptr_set_rev2.o al_hal_pcie_reg_ptr_set_rev3.o
+
+ccflags-y += -I$(src) -DAL_DEV_ID_ALPINE_V1=0 -DAL_DEV_ID_ALPINE_V2=1 \
+	     -DAL_DEV_ID_ALPINE_V3=2 -DAL_DEV_ID_ALPINE_V4=3 \
+	     -DAL_DEV_ID=AL_DEV_ID_ALPINE_V2
+
+# Vendor code: keep it verbatim rather than warning-clean.
+CFLAGS_al_hal_pcie.o += -Wno-unused-function -Wno-unused-variable \
+			-Wno-unused-but-set-variable
