From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ai_re <ai_re@localhost>
Date: Sun, 15 Nov 2026 06:06:09 -0800
Subject: [PATCH 19/19] board: dmc12: describe al_eth port 1 for the board
 params handoff

PCI 00:01.0 is integrated Ethernet port 1, the only port the vendor
board-cfg enables: RGMII, autoneg off, 1000 full, to the uplink PHY pair
the CPLD manages; no MDIO PHY, no SerDes. As a DT node under the internal
ECAM bus: phy-mode = "rgmii" + fixed-link 1000 full-duplex, which encodes
to board params 60000001 00000004 00000000. The MAC comes from the board
EEPROM (24c02 at i2c-7 / 0x51 behind the 0x70 ch3 -> 0x71 ch2 muxes), whose
ONIE base MAC is the factory env's eth1addr; I2C_EEPROM (+MISC) to read it.

Scope: dmc12.
---
 arch/arm/dts/alpine-v2-dmc12-u-boot.dtsi | 20 ++++++++++++++++++++
 configs/alpine_v2_dmc12_defconfig        |  2 ++
 2 files changed, 22 insertions(+)

diff --git a/arch/arm/dts/alpine-v2-dmc12-u-boot.dtsi b/arch/arm/dts/alpine-v2-dmc12-u-boot.dtsi
index 59c332cf..2a1cf1c9 100644
--- a/arch/arm/dts/alpine-v2-dmc12-u-boot.dtsi
+++ b/arch/arm/dts/alpine-v2-dmc12-u-boot.dtsi
@@ -51,6 +51,26 @@
 	};
 };
 
+/*
+ * Integrated Ethernet port 1 (PCI 00:01.0, the only one enabled in the
+ * vendor board-cfg): RGMII at a fixed 1000/full to the uplink PHY pair the
+ * CPLD manages; no MDIO PHY, no SerDes. Describes the al_eth "board
+ * params" for when the firmware left none. The MAC is the ONIE EEPROM's
+ * base address (TLV 0x24), the factory env's eth1addr.
+ */
+&{/soc/pci@fbc00000} {
+	ethernet@1,0 {
+		reg = <0x0800 0 0 0 0>;
+		phy-mode = "rgmii";
+		amazon,mac-eeprom = <&{/soc/io-bus@fc000000/i2c@1880000/i2c-mux@70/i2c@3/i2c-mux@71/i2c@2/eeprom@51}>;
+
+		fixed-link {
+			speed = <1000>;
+			full-duplex;
+		};
+	};
+};
+
 /* Board CPLD (i2c-4 / 0x68): whole-board reset, tried before the sp805. */
 &mux70_3 {
 	cpld@68 {
diff --git a/configs/alpine_v2_dmc12_defconfig b/configs/alpine_v2_dmc12_defconfig
index d2faec69..e4c537f8 100644
--- a/configs/alpine_v2_dmc12_defconfig
+++ b/configs/alpine_v2_dmc12_defconfig
@@ -45,6 +45,8 @@ CONFIG_DM_I2C=y
 CONFIG_SYS_I2C_DW=y
 CONFIG_I2C_MUX=y
 CONFIG_I2C_MUX_PCA954x=y
+CONFIG_MISC=y
+CONFIG_I2C_EEPROM=y
 CONFIG_PCI=y
 CONFIG_PCIE_ECAM_GENERIC=y
 CONFIG_DEBUG_UART_SHIFT=2
