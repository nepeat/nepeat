From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ai_re <ai_re@localhost>
Date: Sun, 15 Nov 2026 04:30:00 +0000
Subject: [PATCH 15/16] sysreset: add the Edgecore DMC-12 board CPLD reset

The DMC-12-48R-AS0 resets the whole board when its I2C CPLD gets 1 in
register 0x29 and then 0x28 (the vendor kernel's al-dmc12-reboot
driver). The Alpine firmware's PSCI v0.1 has no SYSTEM_RESET. If the
board is still alive 1 s later, return -ETIMEDOUT so the next sysreset
device (the SoC sp805 via wdt-reboot) runs.

Scope: dmc12.
---
 drivers/sysreset/Kconfig               |  8 ++++
 drivers/sysreset/Makefile              |  1 +
 drivers/sysreset/sysreset_dmc12_cpld.c | 54 ++++++++++++++++++++++++++
 3 files changed, 63 insertions(+)
 create mode 100644 drivers/sysreset/sysreset_dmc12_cpld.c

diff --git a/drivers/sysreset/Kconfig b/drivers/sysreset/Kconfig
index 16ef434a..0df80c51 100644
--- a/drivers/sysreset/Kconfig
+++ b/drivers/sysreset/Kconfig
@@ -124,6 +124,14 @@ config VPL_SYSRESET_GPIO
 	  for example on Microblaze where reset logic can be controlled via
 	  GPIO pin which triggers cpu reset.
 
+config SYSRESET_DMC12_CPLD
+	bool "Edgecore DMC-12 board CPLD reset"
+	depends on DM_I2C
+	help
+	  Reset the whole Edgecore DMC-12-48R-AS0 board through its I2C CPLD
+	  (registers 0x29 and 0x28), as the vendor kernel does. Falls through
+	  to the next sysreset device if the board is still running after 1 s.
+
 config SYSRESET_MAX77663
 	bool "Enable support for MAX77663 PMIC System Reset"
 	depends on DM_PMIC_MAX77663
diff --git a/drivers/sysreset/Makefile b/drivers/sysreset/Makefile
index d18a5d52..b5e3d334 100644
--- a/drivers/sysreset/Makefile
+++ b/drivers/sysreset/Makefile
@@ -10,6 +10,7 @@ obj-$(CONFIG_SANDBOX) += sysreset_sandbox.o
 obj-$(CONFIG_SYSRESET_CV1800B) += sysreset_cv1800b.o
 obj-$(CONFIG_$(PHASE_)POWEROFF_GPIO) += poweroff_gpio.o
 obj-$(CONFIG_$(PHASE_)SYSRESET_GPIO) += sysreset_gpio.o
+obj-$(CONFIG_SYSRESET_DMC12_CPLD) += sysreset_dmc12_cpld.o
 obj-$(CONFIG_$(PHASE_)SYSRESET_MAX77663) += sysreset_max77663.o
 obj-$(CONFIG_$(PHASE_)SYSRESET_MAX8907) += sysreset_max8907.o
 obj-$(CONFIG_SYSRESET_MPC83XX) += sysreset_mpc83xx.o
diff --git a/drivers/sysreset/sysreset_dmc12_cpld.c b/drivers/sysreset/sysreset_dmc12_cpld.c
new file mode 100644
index 00000000..178ceccf
--- /dev/null
+++ b/drivers/sysreset/sysreset_dmc12_cpld.c
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Edgecore DMC-12-48R-AS0: whole-board reset through the board CPLD
+ * (Lattice MachXO3 at I2C 0x68, behind the pca9548 at 0x70, channel 3).
+ *
+ * Same sequence as the vendor kernel's al-dmc12-reboot driver: write 1 to
+ * register 0x29, then 1 to 0x28. The board is back in the boot ROM well
+ * under a second later. If it is not, return an error so the next sysreset
+ * device (the SoC sp805 via wdt-reboot) gets its turn.
+ */
+
+#include <dm.h>
+#include <i2c.h>
+#include <sysreset.h>
+#include <linux/delay.h>
+
+#define DMC12_CPLD_RESET_ARM	0x29
+#define DMC12_CPLD_RESET_GO	0x28
+
+static int dmc12_cpld_request(struct udevice *dev, enum sysreset_t type)
+{
+	int ret;
+
+	if (type != SYSRESET_WARM && type != SYSRESET_COLD)
+		return -EPROTONOSUPPORT;
+
+	ret = dm_i2c_reg_write(dev, DMC12_CPLD_RESET_ARM, 1);
+	if (!ret)
+		ret = dm_i2c_reg_write(dev, DMC12_CPLD_RESET_GO, 1);
+	if (ret) {
+		printf("DMC-12 CPLD reset: I2C write failed (%d)\n", ret);
+		return ret;
+	}
+	mdelay(1000);
+	printf("DMC-12 CPLD reset: still running after 1 s\n");
+
+	return -ETIMEDOUT;
+}
+
+static struct sysreset_ops dmc12_cpld_ops = {
+	.request = dmc12_cpld_request,
+};
+
+static const struct udevice_id dmc12_cpld_ids[] = {
+	{ .compatible = "edgecore,dmc12-cpld" },
+	{ }
+};
+
+U_BOOT_DRIVER(sysreset_dmc12_cpld) = {
+	.name = "sysreset_dmc12_cpld",
+	.id = UCLASS_SYSRESET,
+	.of_match = dmc12_cpld_ids,
+	.ops = &dmc12_cpld_ops,
+};
