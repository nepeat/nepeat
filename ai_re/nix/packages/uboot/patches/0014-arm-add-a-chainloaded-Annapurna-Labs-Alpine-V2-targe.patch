diff --git a/board/amazon/alpine-v2/alpine-v2.c b/board/amazon/alpine-v2/alpine-v2.c
new file mode 100644
index 0000000..115d437
--- /dev/null
+++ b/board/amazon/alpine-v2/alpine-v2.c
@@ -0,0 +1,213 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Annapurna Labs Alpine V2, started by the vendor U-Boot.
+ *
+ * al-boot (stage2/stage3) has trained DRAM, initialised SerDes and the
+ * PCIe unit adapters and installed a PSCI v0.1 monitor (cpu_on/cpu_off
+ * only: no SYSTEM_RESET). This board therefore does no low-level init:
+ * DRAM banks come from /memory, firmware-owned ranges from
+ * /reserved-memory, and both are handed on to the OS.
+ */
+
+#include <config.h>
+#include <cpu_func.h>
+#include <env.h>
+#include <fdt_support.h>
+#include <fdtdec.h>
+#include <init.h>
+#include <asm/armv8/mmu.h>
+#include <asm/global_data.h>
+#include <asm/sections.h>
+#include <asm/system.h>
+#include <dm/ofnode.h>
+#include <linux/kernel.h>
+#include <linux/libfdt.h>
+#include <linux/sizes.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* Filled by save_boot_params (lowlevel.S) before relocation. */
+struct {
+	u64 x0;
+	u64 sctlr;
+} alpine_v2_entry __section(".data");
+
+/*
+ * DRAM banks are Normal memory; every hole below 4 GiB is the SoC's I/O
+ * space (on Alpine V2: PCIe windows at 0xc0000000, GIC, ECAM, the I/O
+ * fabric at 0xfc000000). Nothing else is mapped. Built from gd->dram in
+ * enable_caches(), i.e. after relocation; lives in .data so the pre-
+ * relocation BSS (which overlaps the appended DTB) is never touched.
+ */
+static struct mm_region alpine_v2_mem_map[2 * CONFIG_NR_DRAM_BANKS + 2]
+	__section(".data");
+struct mm_region *mem_map = alpine_v2_mem_map;
+
+static void alpine_v2_build_mem_map(void)
+{
+	struct mm_region *r = alpine_v2_mem_map;
+	u64 hole = 0;
+	int i;
+
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS && gd->dram[i].size; i++) {
+		u64 start = gd->dram[i].start;
+		u64 end = start + gd->dram[i].size;
+
+		if (hole < start && hole < SZ_4G) {
+			r->virt = r->phys = hole;
+			r->size = min_t(u64, start, SZ_4G) - hole;
+			r->attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+				   PTE_BLOCK_NON_SHARE |
+				   PTE_BLOCK_PXN | PTE_BLOCK_UXN;
+			r++;
+		}
+		r->virt = r->phys = start;
+		r->size = gd->dram[i].size;
+		r->attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE;
+		r++;
+		hole = max(hole, end);
+	}
+	if (hole < SZ_4G) {
+		r->virt = r->phys = hole;
+		r->size = SZ_4G - hole;
+		r->attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+			   PTE_BLOCK_NON_SHARE | PTE_BLOCK_PXN | PTE_BLOCK_UXN;
+		r++;
+	}
+	r->size = 0;
+}
+
+void enable_caches(void)
+{
+	alpine_v2_build_mem_map();
+	icache_enable();
+	dcache_enable();
+}
+
+/* Sized before mem_map exists; a handful of 1 GiB / 2 MiB blocks. */
+u64 get_page_table_size(void)
+{
+	return SZ_256K;
+}
+
+int dram_init(void)
+{
+	return fdtdec_setup_mem_size_base();
+}
+
+int dram_init_banksize(void)
+{
+	return fdtdec_setup_memory_banksize();
+}
+
+static bool alpine_v2_rsv(ofnode node, u64 *base, u64 *size)
+{
+	fdt_size_t sz;
+	fdt_addr_t addr = ofnode_get_addr_size_index(node, 0, &sz);
+
+	if (addr == FDT_ADDR_T_NONE || !sz || !ofnode_is_enabled(node))
+		return false;
+	*base = addr;
+	*size = sz;
+	return true;
+}
+
+/*
+ * U-Boot relocates to the top of the first bank. Move that top below any
+ * firmware range that would overlap U-Boot's own footprint (code, malloc,
+ * stack, FDT copy: well under 128 MiB).
+ */
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	ofnode parent = ofnode_path("/reserved-memory");
+	phys_addr_t top = gd->ram_top;
+	bool moved;
+	ofnode node;
+
+	if (!ofnode_valid(parent))
+		return top;
+	do {
+		moved = false;
+		ofnode_for_each_subnode(node, parent) {
+			u64 base, size;
+
+			if (!alpine_v2_rsv(node, &base, &size))
+				continue;
+			if (base < top &&
+			    base + size > (top > SZ_128M ? top - SZ_128M : 0)) {
+				top = base;
+				moved = true;
+			}
+		}
+	} while (moved);
+
+	return top;
+}
+
+#if IS_ENABLED(CONFIG_OF_BOARD_SETUP)
+/*
+ * The OS DTB (extlinux FDT/FDTDIR) normally comes from the kernel tree and
+ * knows nothing about al-boot. Copy every /reserved-memory range of our
+ * control DT into its memory reserve map, as the vendor loader does.
+ */
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	ofnode parent = ofnode_path("/reserved-memory");
+	ofnode node;
+
+	if (!ofnode_valid(parent))
+		return 0;
+	ofnode_for_each_subnode(node, parent) {
+		u64 base, size, b, s;
+		int i, n, ret;
+		bool dup = false;
+
+		if (!alpine_v2_rsv(node, &base, &size))
+			continue;
+		n = fdt_num_mem_rsv(blob);
+		for (i = 0; i < n && !dup; i++)
+			dup = !fdt_get_mem_rsv(blob, i, &b, &s) &&
+			      b == base && s == size;
+		if (dup)
+			continue;
+		ret = fdt_add_mem_rsv(blob, base, size);
+		if (ret) {
+			printf("memreserve %#llx+%#llx: %s\n", base, size,
+			       fdt_strerror(ret));
+			return -ENOSPC;
+		}
+	}
+
+	return 0;
+}
+#endif
+
+int checkboard(void)
+{
+	printf("Entry: EL%d, MMU+caches were %s, x0=%#llx\n", current_el(),
+	       alpine_v2_entry.sctlr & 1 ? "on (go)" : "off (bootm)",
+	       alpine_v2_entry.x0);
+	return 0;
+}
+
+int board_late_init(void)
+{
+	if (!env_get("fdtfile") && CONFIG_DEFAULT_FDT_FILE[0])
+		env_set("fdtfile", CONFIG_DEFAULT_FDT_FILE);
+	return 0;
+}
+
+int print_cpuinfo(void)
+{
+	u64 midr;
+
+	asm volatile("mrs %0, midr_el1" : "=r" (midr));
+	printf("CPU:   MIDR %#llx%s\n", midr,
+	       (midr & 0xff0ffff0) == 0x410fd070 ? " (Cortex-A57)" : "");
+	return 0;
+}
+
+int board_init(void)
+{
+	return 0;
+}
diff --git a/board/amazon/alpine-v2/alpine-v2.env b/board/amazon/alpine-v2/alpine-v2.env
new file mode 100644
index 0000000..62b9b7f
--- /dev/null
+++ b/board/amazon/alpine-v2/alpine-v2.env
@@ -0,0 +1,26 @@
+/*
+ * Load addresses for bootstd/extlinux/booti. All sit in the first 3 GiB
+ * bank, clear of the firmware ranges in /reserved-memory (0x0 and
+ * 0x02000000 on the DMC-12) and of the vendor loader's staging area,
+ * so the same layout works whichever U-Boot started us.
+ *   0x08000000  this image (vendor "loadaddr"; dead after relocation)
+ *   0x0f000000  fdt (+ overlays, scripts, pxe files above it)
+ *   0x10000000  kernel Image (2 MiB aligned, up to 256 MiB)
+ *   0x20000000  compressed kernel scratch (Image.gz etc.), 64 MiB
+ *   0x30000000  initrd
+ * fdtfile is set from CONFIG_DEFAULT_FDT_FILE in board_late_init().
+ */
+fdt_addr_r=0x0f000000
+fdtoverlay_addr_r=0x0f100000
+scriptaddr=0x0f200000
+pxefile_addr_r=0x0f300000
+kernel_addr_r=0x10000000
+kernel_comp_addr_r=0x20000000
+kernel_comp_size=0x4000000
+ramdisk_addr_r=0x30000000
+/*
+ * Use the initrd and FDT where they were loaded (all ones, 64-bit:
+ * 0xffffffff would be a 4 GiB limit, not "don't relocate").
+ */
+fdt_high=0xffffffffffffffff
+initrd_high=0xffffffffffffffff
diff --git a/board/amazon/alpine-v2/lowlevel.S b/board/amazon/alpine-v2/lowlevel.S
new file mode 100644
index 0000000..f45f901
--- /dev/null
+++ b/board/amazon/alpine-v2/lowlevel.S
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Entry from the vendor U-Boot (2015.07, al-boot 2.60).
+ *
+ * "bootm" of a kernel-type uImage arrives like Linux: MMU and D-cache off,
+ * x0 = the vendor's DTB. "go" arrives with the vendor's identity-mapped
+ * MMU and caches still on, x0 = argc. start.S assumes the former, so in
+ * the second case write the D-cache back by set/way and switch MMU and
+ * caches off before PIE fixups, stack or BSS touch memory.
+ *
+ * Runs before the PIE fixup: only PC-relative addressing (adrp, so the
+ * image must sit on a 4 KiB boundary, as start.S requires anyway), no stack.
+ */
+
+#include <linux/linkage.h>
+#include <asm/macro.h>
+
+#define SCTLR_M		(1 << 0)
+#define SCTLR_C		(1 << 2)
+#define SCTLR_I		(1 << 12)
+
+ENTRY(save_boot_params)
+	adrp	x9, alpine_v2_entry
+	add	x9, x9, :lo12:alpine_v2_entry
+	str	x0, [x9]			/* entry x0: DTB (bootm) or argc (go) */
+	switch_el x10, 3f, 2f, 1f
+3:	mrs	x11, sctlr_el3
+	b	0f
+2:	mrs	x11, sctlr_el2
+	b	0f
+1:	mrs	x11, sctlr_el1
+0:	str	x11, [x9, #8]			/* entry SCTLR, for the banner */
+	tst	x11, #SCTLR_M
+	b.eq	save_boot_params_ret		/* MMU already off: nothing to do */
+
+	bl	__asm_flush_dcache_all		/* clean+invalidate, all levels; x0-x16 */
+
+	switch_el x10, 3f, 2f, 1f
+3:	mrs	x11, sctlr_el3
+	bic	x11, x11, #SCTLR_M
+	bic	x11, x11, #SCTLR_C
+	bic	x11, x11, #SCTLR_I
+	msr	sctlr_el3, x11
+	isb
+	tlbi	alle3
+	b	0f
+2:	mrs	x11, sctlr_el2
+	bic	x11, x11, #SCTLR_M
+	bic	x11, x11, #SCTLR_C
+	bic	x11, x11, #SCTLR_I
+	msr	sctlr_el2, x11
+	isb
+	tlbi	alle2
+	b	0f
+1:	mrs	x11, sctlr_el1
+	bic	x11, x11, #SCTLR_M
+	bic	x11, x11, #SCTLR_C
+	bic	x11, x11, #SCTLR_I
+	msr	sctlr_el1, x11
+	isb
+	tlbi	vmalle1
+0:	ic	iallu
+	dsb	sy
+	isb
+	b	save_boot_params_ret
+ENDPROC(save_boot_params)
diff --git a/include/configs/alpine-v2.h b/include/configs/alpine-v2.h
new file mode 100644
index 0000000..39192df
--- /dev/null
+++ b/include/configs/alpine-v2.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Annapurna Labs Alpine V2, chainloaded. Everything board-specific comes
+ * from the device tree; see board/amazon/alpine-v2/alpine-v2.c. No
+ * CFG_SYS_SDRAM_BASE on purpose: it would override the /memory base that
+ * dram_init() reads.
+ */
+#ifndef __ALPINE_V2_H
+#define __ALPINE_V2_H
+
+#endif
