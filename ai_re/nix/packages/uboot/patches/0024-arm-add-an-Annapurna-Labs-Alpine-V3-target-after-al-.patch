diff --git a/board/amazon/alpine-v3/alpine-v3.c b/board/amazon/alpine-v3/alpine-v3.c
new file mode 100644
index 00000000..69cb7d5a
--- /dev/null
+++ b/board/amazon/alpine-v3/alpine-v3.c
@@ -0,0 +1,237 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Annapurna Labs Alpine V3 (16x Cortex-A72), after al-boot.
+ *
+ * al-boot stage2/stage3 have trained DRAM, downloaded the SerDes firmware,
+ * set up the lanes and installed the PSCI v0.2 monitor at EL3 (in the
+ * secmon range at 0). This board does no low-level init: DRAM banks come
+ * from /memory, firmware-owned ranges from /reserved-memory, and both are
+ * handed on to the OS.
+ */
+
+#include <config.h>
+#include <cpu_func.h>
+#include <env.h>
+#include <fdt_support.h>
+#include <fdtdec.h>
+#include <init.h>
+#include <asm/armv8/mmu.h>
+#include <asm/global_data.h>
+#include <asm/sections.h>
+#include <asm/system.h>
+#include <dm/ofnode.h>
+#include <linux/kernel.h>
+#include <linux/libfdt.h>
+#include <linux/sizes.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* Filled by save_boot_params (lowlevel.S) before relocation. */
+struct {
+	u64 x0;
+	u64 sctlr;
+} alpine_v3_entry __section(".data");
+
+/*
+ * DRAM banks are Normal memory; every hole below 4 GiB is the SoC's I/O
+ * space (on Alpine V3: external PCIe windows from 0xc0000000, GIC, the
+ * internal PCIe ECAM, the I/O fabric at 0xfc000000). Nothing else is
+ * mapped. Built from gd->dram in enable_caches(), i.e. after relocation;
+ * lives in .data so the pre-relocation BSS (which overlaps the appended
+ * DTB) is never touched.
+ */
+static struct mm_region alpine_v3_mem_map[2 * CONFIG_NR_DRAM_BANKS + 2]
+	__section(".data");
+struct mm_region *mem_map = alpine_v3_mem_map;
+
+static void alpine_v3_build_mem_map(void)
+{
+	struct mm_region *r = alpine_v3_mem_map;
+	u64 hole = 0;
+	int i;
+
+	for (i = 0; i < CONFIG_NR_DRAM_BANKS && gd->dram[i].size; i++) {
+		u64 start = gd->dram[i].start;
+		u64 end = start + gd->dram[i].size;
+
+		if (hole < start && hole < SZ_4G) {
+			r->virt = r->phys = hole;
+			r->size = min_t(u64, start, SZ_4G) - hole;
+			r->attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+				   PTE_BLOCK_NON_SHARE |
+				   PTE_BLOCK_PXN | PTE_BLOCK_UXN;
+			r++;
+		}
+		r->virt = r->phys = start;
+		r->size = gd->dram[i].size;
+		r->attrs = PTE_BLOCK_MEMTYPE(MT_NORMAL) | PTE_BLOCK_INNER_SHARE;
+		r++;
+		hole = max(hole, end);
+	}
+	if (hole < SZ_4G) {
+		r->virt = r->phys = hole;
+		r->size = SZ_4G - hole;
+		r->attrs = PTE_BLOCK_MEMTYPE(MT_DEVICE_NGNRNE) |
+			   PTE_BLOCK_NON_SHARE | PTE_BLOCK_PXN | PTE_BLOCK_UXN;
+		r++;
+	}
+	r->size = 0;
+}
+
+void enable_caches(void)
+{
+	alpine_v3_build_mem_map();
+	icache_enable();
+	dcache_enable();
+}
+
+/* Sized before mem_map exists; a handful of 1 GiB / 2 MiB blocks. */
+u64 get_page_table_size(void)
+{
+	return SZ_256K;
+}
+
+int dram_init(void)
+{
+	return fdtdec_setup_mem_size_base();
+}
+
+int dram_init_banksize(void)
+{
+	return fdtdec_setup_memory_banksize();
+}
+
+static bool alpine_v3_rsv(ofnode node, u64 *base, u64 *size)
+{
+	fdt_size_t sz;
+	fdt_addr_t addr = ofnode_get_addr_size_index(node, 0, &sz);
+
+	if (addr == FDT_ADDR_T_NONE || !sz || !ofnode_is_enabled(node))
+		return false;
+	*base = addr;
+	*size = sz;
+	return true;
+}
+
+/*
+ * U-Boot relocates to the top of the first bank. Move that top below any
+ * firmware range that would overlap U-Boot's own footprint (code, malloc,
+ * stack, FDT copy: well under 128 MiB).
+ */
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	ofnode parent = ofnode_path("/reserved-memory");
+	phys_addr_t top = gd->ram_top;
+	bool moved;
+	ofnode node;
+
+	if (!ofnode_valid(parent))
+		return top;
+	do {
+		moved = false;
+		ofnode_for_each_subnode(node, parent) {
+			u64 base, size;
+
+			if (!alpine_v3_rsv(node, &base, &size))
+				continue;
+			if (base < top &&
+			    base + size > (top > SZ_128M ? top - SZ_128M : 0)) {
+				top = base;
+				moved = true;
+			}
+		}
+	} while (moved);
+
+	return top;
+}
+
+#if IS_ENABLED(CONFIG_OF_BOARD_SETUP)
+/* Does the OS DTB already describe [base, base + size) in /reserved-memory? */
+static bool alpine_v3_os_has_rsv(void *blob, u64 base, u64 size)
+{
+	int parent = fdt_path_offset(blob, "/reserved-memory");
+	int node;
+
+	if (parent < 0)
+		return false;
+	fdt_for_each_subnode(node, blob, parent) {
+		fdt_size_t s;
+		fdt_addr_t a = fdtdec_get_addr_size_auto_parent(blob, parent,
+								node, "reg", 0,
+								&s, false);
+
+		if (a == base && s == size)
+			return true;
+	}
+	return false;
+}
+
+/*
+ * The OS DTB normally comes from the kernel tree. Copy every
+ * /reserved-memory range of our control DT that it does not describe
+ * itself into its memory reserve map, so Linux stays clear of firmware
+ * memory whichever DTB it gets.
+ */
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	ofnode parent = ofnode_path("/reserved-memory");
+	ofnode node;
+
+	if (!ofnode_valid(parent))
+		return 0;
+	ofnode_for_each_subnode(node, parent) {
+		u64 base, size, b, s;
+		int i, n, ret;
+		bool dup = false;
+
+		if (!alpine_v3_rsv(node, &base, &size))
+			continue;
+		if (alpine_v3_os_has_rsv(blob, base, size))
+			continue;
+		n = fdt_num_mem_rsv(blob);
+		for (i = 0; i < n && !dup; i++)
+			dup = !fdt_get_mem_rsv(blob, i, &b, &s) &&
+			      b == base && s == size;
+		if (dup)
+			continue;
+		ret = fdt_add_mem_rsv(blob, base, size);
+		if (ret) {
+			printf("memreserve %#llx+%#llx: %s\n", base, size,
+			       fdt_strerror(ret));
+			return -ENOSPC;
+		}
+	}
+
+	return 0;
+}
+#endif
+
+int checkboard(void)
+{
+	printf("Entry: EL%d, MMU+caches were %s, x0=%#llx\n", current_el(),
+	       alpine_v3_entry.sctlr & 1 ? "on (go)" : "off (booti/bootm/stage3)",
+	       alpine_v3_entry.x0);
+	return 0;
+}
+
+int board_late_init(void)
+{
+	if (!env_get("fdtfile") && CONFIG_DEFAULT_FDT_FILE[0])
+		env_set("fdtfile", CONFIG_DEFAULT_FDT_FILE);
+	return 0;
+}
+
+int print_cpuinfo(void)
+{
+	u64 midr;
+
+	asm volatile("mrs %0, midr_el1" : "=r" (midr));
+	printf("CPU:   MIDR %#llx%s\n", midr,
+	       (midr & 0xff0ffff0) == 0x410fd080 ? " (Cortex-A72)" : "");
+	return 0;
+}
+
+int board_init(void)
+{
+	return 0;
+}
diff --git a/board/amazon/alpine-v3/alpine-v3.env b/board/amazon/alpine-v3/alpine-v3.env
new file mode 100644
index 00000000..dc695dec
--- /dev/null
+++ b/board/amazon/alpine-v3/alpine-v3.env
@@ -0,0 +1,29 @@
+/*
+ * Load addresses for bootstd/extlinux/boot.scr/booti. All sit in the first
+ * 2 GiB bank, clear of the firmware ranges in /reserved-memory and of
+ * U-Boot itself, which relocates to the top of that bank. They match what
+ * the CS8210 NixOS bootmenu (its boot.scr) loads to, so one layout serves
+ * the vendor U-Boot and this one:
+ *   0x07000000  scripts (boot.scr), 0x07100000 the bootmenu env,
+ *               0x07200000 pxe/extlinux files
+ *   0x08000000  kernel Image (booted in place; ~75 MiB) -- also where this
+ *               image is loaded, dead after relocation
+ *   0x10000000  fdt (+ overlays above it)
+ *   0x20000000  initrd (up to 512 MiB)
+ *   0x40000000  compressed kernel scratch (Image.gz etc.), 128 MiB
+ * fdtfile is set from CONFIG_DEFAULT_FDT_FILE in board_late_init().
+ */
+scriptaddr=0x07000000
+pxefile_addr_r=0x07200000
+kernel_addr_r=0x08000000
+fdt_addr_r=0x10000000
+fdtoverlay_addr_r=0x10100000
+ramdisk_addr_r=0x20000000
+kernel_comp_addr_r=0x40000000
+kernel_comp_size=0x8000000
+/*
+ * Use the initrd where it was loaded (all ones, 64-bit: 0xffffffff would be
+ * a 4 GiB limit, not "don't relocate"). The FDT is copied below U-Boot
+ * (fdt_high unset: upstream warns about ~0 there).
+ */
+initrd_high=0xffffffffffffffff
diff --git a/board/amazon/alpine-v3/lowlevel.S b/board/amazon/alpine-v3/lowlevel.S
new file mode 100644
index 00000000..06727202
--- /dev/null
+++ b/board/amazon/alpine-v3/lowlevel.S
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Entry on Alpine V3: from al-boot stage3 (its AArch64 agent ERETs to the
+ * application at EL2, MMU off), or from the vendor U-Boot 2018.05.
+ *
+ * "booti"/"bootm" arrive like Linux: MMU and D-cache off, x0 = a DTB.
+ * "go" arrives with the vendor's identity-mapped MMU and caches still on,
+ * x0 = argc. start.S assumes the former, so in the second case write the
+ * D-cache back by set/way and switch MMU and caches off before PIE fixups,
+ * stack or BSS touch memory.
+ *
+ * Runs before the PIE fixup: only PC-relative addressing (adrp, so the
+ * image must sit on a 4 KiB boundary, as start.S requires anyway), no stack.
+ */
+
+#include <linux/linkage.h>
+#include <asm/macro.h>
+
+#define SCTLR_M		(1 << 0)
+#define SCTLR_C		(1 << 2)
+#define SCTLR_I		(1 << 12)
+
+ENTRY(save_boot_params)
+	adrp	x9, alpine_v3_entry
+	add	x9, x9, :lo12:alpine_v3_entry
+	str	x0, [x9]			/* entry x0: DTB (booti/bootm) or argc (go) */
+	switch_el x10, 3f, 2f, 1f
+3:	mrs	x11, sctlr_el3
+	b	0f
+2:	mrs	x11, sctlr_el2
+	b	0f
+1:	mrs	x11, sctlr_el1
+0:	str	x11, [x9, #8]			/* entry SCTLR, for the banner */
+	tst	x11, #SCTLR_M
+	b.eq	save_boot_params_ret		/* MMU already off: nothing to do */
+
+	bl	__asm_flush_dcache_all		/* clean+invalidate, all levels; x0-x16 */
+
+	switch_el x10, 3f, 2f, 1f
+3:	mrs	x11, sctlr_el3
+	bic	x11, x11, #SCTLR_M
+	bic	x11, x11, #SCTLR_C
+	bic	x11, x11, #SCTLR_I
+	msr	sctlr_el3, x11
+	isb
+	tlbi	alle3
+	b	0f
+2:	mrs	x11, sctlr_el2
+	bic	x11, x11, #SCTLR_M
+	bic	x11, x11, #SCTLR_C
+	bic	x11, x11, #SCTLR_I
+	msr	sctlr_el2, x11
+	isb
+	tlbi	alle2
+	b	0f
+1:	mrs	x11, sctlr_el1
+	bic	x11, x11, #SCTLR_M
+	bic	x11, x11, #SCTLR_C
+	bic	x11, x11, #SCTLR_I
+	msr	sctlr_el1, x11
+	isb
+	tlbi	vmalle1
+0:	ic	iallu
+	dsb	sy
+	isb
+	b	save_boot_params_ret
+ENDPROC(save_boot_params)
diff --git a/include/configs/alpine-v3.h b/include/configs/alpine-v3.h
new file mode 100644
index 00000000..a4a97d43
--- /dev/null
+++ b/include/configs/alpine-v3.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Annapurna Labs Alpine V3. Everything board-specific comes from the
+ * device tree; see board/amazon/alpine-v3/alpine-v3.c. No
+ * CFG_SYS_SDRAM_BASE on purpose: it would override the /memory base that
+ * dram_init() reads.
+ */
+#ifndef __ALPINE_V3_H
+#define __ALPINE_V3_H
+
+#endif
