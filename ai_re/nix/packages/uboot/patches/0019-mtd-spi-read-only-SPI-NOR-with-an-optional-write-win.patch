From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ai_re <ai_re@localhost>
Date: Sun, 15 Nov 2026 04:30:00 +0000
Subject: [PATCH] mtd: spi: read-only SPI NOR with an optional write window

For a board whose boot flash must be readable but never writable from
U-Boot, except (optionally) one small range such as the environment.

SPI_FLASH_READ_ONLY (needs SPI_FLASH_LOCK and SPI_FLASH_UNLOCK_ALL off):
- the spi-nor MTD write and erase hooks return -EROFS and MTD_WRITEABLE is
  cleared; probe writes no status register (no unlock-all, no quad enable);
  a failed EN4B is fatal at probe instead of ignored;
- "sf" offers probe and read only (write, erase, update, protect and test
  are gone, with their help text);
- it selects SPI_MEM_READ_ONLY: spi_mem_exec_op() passes only the reads this
  build sends (0x03, 0x0b, 0x9f, 0x05) and refuses everything else with
  -EROFS, below every flash driver and command. (0x35 is not a read on
  Macronix: MX25U12835F datasheet Rev 1.8 p.15, EQIO, enter QPI.)

SPI_FLASH_WRITE_WINDOW (_BUS, _CS, _START, _SIZE, and the chip it is set for:
_JEDEC, _CHIP_SIZE, 3-byte addressing): that range of that chip may be erased
and programmed. Two independent checks, both on include/spi_flash_window.h
(pure, host-tested):
- spi-nor: the MTD erase/write hooks run the real erase/program code only
  when the chip is the pinned one and the request lies entirely inside the
  window; anything else prints "outside the write window, refused" and
  returns -EROFS before a command is sent. (A garbled RDID matching a
  >16 MiB part would otherwise give a 4-byte address width, and
  "02 00 f9 00 00" would program 0x00f900 on the real 3-byte chip.)
- spi-mem: besides the reads, the window's chip may get WREN/WRDI, page
  program entirely inside the window and 4K/32K/64K erase whose aligned
  block lies inside it, with the address width tied to the opcode (3 bytes
  for 0x02/0x20/0x52/0xd8, 4 for 0x12/0x21/0x5c/0xdc), no dummy bytes and no
  data on erases. Status/config register writes, chip erase, reset, lock,
  OTP, 4-byte mode and every other command stay refused, on every chip.
"sf" stays probe + read only, so writes come only from code paths such as
the SPI-flash environment. IS_ENABLED(CONFIG_...) (no SPL_ variants).

Scope: alpine-v2 (generic code).
---
 cmd/sf.c                       | 15 +++++-
 drivers/mtd/spi/Kconfig        | 55 ++++++++++++++++++++++
 drivers/mtd/spi/spi-nor-core.c | 76 ++++++++++++++++++++++++++++---
 drivers/spi/Kconfig            | 11 +++++
 drivers/spi/spi-mem.c          | 61 +++++++++++++++++++++++++
 include/spi_flash_window.h     | 83 ++++++++++++++++++++++++++++++++++
 6 files changed, 292 insertions(+), 9 deletions(-)
 create mode 100644 include/spi_flash_window.h

diff --git a/cmd/sf.c b/cmd/sf.c
index b5b7f67..a516880 100644
--- a/cmd/sf.c
+++ b/cmd/sf.c
@@ -311,7 +311,8 @@ static int do_spi_flash_read_write(int argc, char *const argv[])
 		return CMD_RET_FAILURE;
 	}
 
-	if (strcmp(argv[0], "update") == 0) {
+	if (!IS_ENABLED(CONFIG_SPI_FLASH_READ_ONLY) &&
+	    strcmp(argv[0], "update") == 0) {
 		ret = spi_flash_update(flash, offset, len, buf);
 	} else if (strncmp(argv[0], "read", 4) == 0 ||
 			strncmp(argv[0], "write", 5) == 0) {
@@ -327,7 +328,7 @@ static int do_spi_flash_read_write(int argc, char *const argv[])
 		read = strncmp(argv[0], "read", 4) == 0;
 		if (read)
 			ret = spi_flash_read(flash, offset, len, buf);
-		else
+		else if (!IS_ENABLED(CONFIG_SPI_FLASH_READ_ONLY))
 			ret = spi_flash_write(flash, offset, len, buf);
 
 		printf("SF: %zu bytes @ %#x %s: ", (size_t)len, (u32)offset,
@@ -607,6 +608,12 @@ static int do_spi_flash(struct cmd_tbl *cmdtp, int flag, int argc,
 		return CMD_RET_FAILURE;
 	}
 
+	if (IS_ENABLED(CONFIG_SPI_FLASH_READ_ONLY)) {
+		if (strcmp(cmd, "read"))
+			return CMD_RET_USAGE;
+		return do_spi_flash_read_write(argc, argv);
+	}
+
 	if (strcmp(cmd, "read") == 0 || strcmp(cmd, "write") == 0 ||
 	    strcmp(cmd, "update") == 0)
 		ret = do_spi_flash_read_write(argc, argv);
@@ -628,6 +635,9 @@ U_BOOT_LONGHELP(sf,
 	"sf read addr offset|partition len	- read `len' bytes starting at\n"
 	"				          `offset' or from start of mtd\n"
 	"					  `partition'to memory at `addr'\n"
+#if IS_ENABLED(CONFIG_SPI_FLASH_READ_ONLY)
+	"(read-only build: no write, erase, update or protect)"
+#else
 	"sf write addr offset|partition len	- write `len' bytes from memory\n"
 	"				          at `addr' to flash at `offset'\n"
 	"					  or to start of mtd `partition'\n"
@@ -643,6 +653,7 @@ U_BOOT_LONGHELP(sf,
 #endif
 #ifdef CONFIG_CMD_SF_TEST
 	"\nsf test offset len		- run a very basic destructive test"
+#endif
 #endif
 	);
 
diff --git a/drivers/mtd/spi/Kconfig b/drivers/mtd/spi/Kconfig
index 4ff5838..7a8f316 100644
--- a/drivers/mtd/spi/Kconfig
+++ b/drivers/mtd/spi/Kconfig
@@ -142,6 +142,61 @@ config SPI_FLASH_LOCK
 	  Enable the SPI flash lock support. By default this is set to y.
 	  If you intend not to use the lock support you should say n here.
 
+config SPI_FLASH_READ_ONLY
+	bool "Read-only SPI NOR: no write, erase or lock support"
+	depends on DM_SPI_FLASH && !SPI_FLASH_LOCK && !SPI_FLASH_UNLOCK_ALL
+	select SPI_MEM_READ_ONLY
+	help
+	  Probe and read only. The MTD write/erase hooks return -EROFS (the
+	  program/erase code is not linked), no status register is written at
+	  probe (no unlock, no quad enable), "sf" offers only probe and read,
+	  and the SPI memory layer refuses every non-read command
+	  (SPI_MEM_READ_ONLY). For proving a boot flash's contents from
+	  U-Boot without any way to change them.
+
+config SPI_FLASH_WRITE_WINDOW
+	bool "Allow erase and program in one window of one read-only SPI NOR"
+	depends on SPI_FLASH_READ_ONLY
+	help
+	  A read-only build that still needs to store something (e.g. the
+	  environment): erase and program requests on the chip at
+	  SPI_FLASH_WRITE_WINDOW_BUS/_CS are carried out only if the whole range
+	  lies in [_START, _START + _SIZE), anything else fails with -EROFS
+	  before a command is sent. The SPI memory layer checks every write
+	  enable, page program and erase command against the same window. No
+	  status/config register write, lock, quad enable or chip erase exists
+	  in either path, and "sf" stays read-only.
+
+config SPI_FLASH_WRITE_WINDOW_BUS
+	int "Write window: SPI bus"
+	depends on SPI_FLASH_WRITE_WINDOW
+	default 0
+
+config SPI_FLASH_WRITE_WINDOW_CS
+	int "Write window: chip select"
+	depends on SPI_FLASH_WRITE_WINDOW
+	default 0
+
+config SPI_FLASH_WRITE_WINDOW_JEDEC
+	hex "Write window: JEDEC ID of the chip (manufacturer, type, capacity)"
+	depends on SPI_FLASH_WRITE_WINDOW
+	help
+	  Erase/program are refused unless the probed chip has this ID, the
+	  size below and 3-byte addressing: a garbled ID read that matches a
+	  different (e.g. 4-byte) part must not move where writes land.
+
+config SPI_FLASH_WRITE_WINDOW_CHIP_SIZE
+	hex "Write window: size of the chip in bytes"
+	depends on SPI_FLASH_WRITE_WINDOW
+
+config SPI_FLASH_WRITE_WINDOW_START
+	hex "Write window: first byte"
+	depends on SPI_FLASH_WRITE_WINDOW
+
+config SPI_FLASH_WRITE_WINDOW_SIZE
+	hex "Write window: size in bytes"
+	depends on SPI_FLASH_WRITE_WINDOW
+
 config SPI_FLASH_UNLOCK_ALL
 	bool "Unlock the entire SPI flash on u-boot startup"
 	default y
diff --git a/drivers/mtd/spi/spi-nor-core.c b/drivers/mtd/spi/spi-nor-core.c
index 937d79a..cf076e5 100644
--- a/drivers/mtd/spi/spi-nor-core.c
+++ b/drivers/mtd/spi/spi-nor-core.c
@@ -29,6 +29,7 @@
 #include <linux/mtd/spi-nor.h>
 #include <mtd/cfi_flash.h>
 #include <spi-mem.h>
+#include <spi_flash_window.h>
 #include <spi.h>
 
 #include "sf_internal.h"
@@ -3151,8 +3152,9 @@ static int spi_nor_init_params(struct spi_nor *nor,
 					SPINOR_OP_PP_1_1_4, SNOR_PROTO_1_1_4);
 	}
 
-	/* Select the procedure to set the Quad Enable bit. */
-	if (params->hwcaps.mask & (SNOR_HWCAPS_READ_QUAD |
+	/* Select the procedure to set the Quad Enable bit (none if read-only). */
+	if (!IS_ENABLED(CONFIG_SPI_FLASH_READ_ONLY) &&
+	    params->hwcaps.mask & (SNOR_HWCAPS_READ_QUAD |
 				   SNOR_HWCAPS_PP_QUAD)) {
 		switch (JEDEC_MFR(info)) {
 #if defined(CONFIG_SPI_FLASH_MACRONIX) || defined(CONFIG_SPI_FLASH_ISSI)
@@ -3659,7 +3661,8 @@ static int spi_nor_default_setup(struct spi_nor *nor,
 	/* Enable Quad I/O if needed. */
 	enable_quad_io = (spi_nor_get_protocol_width(nor->read_proto) == 4 ||
 			  spi_nor_get_protocol_width(nor->write_proto) == 4);
-	if (enable_quad_io && params->quad_enable)
+	if (enable_quad_io && params->quad_enable &&
+	    !IS_ENABLED(CONFIG_SPI_FLASH_READ_ONLY))
 		nor->quad_enable = params->quad_enable;
 	else
 		nor->quad_enable = NULL;
@@ -4380,6 +4383,7 @@ static int spi_nor_init(struct spi_nor *nor)
 	 * with the software protection bits set
 	 */
 	if (IS_ENABLED(CONFIG_SPI_FLASH_UNLOCK_ALL) &&
+	    !IS_ENABLED(CONFIG_SPI_FLASH_READ_ONLY) &&
 	    (JEDEC_MFR(nor->info) == SNOR_MFR_ATMEL ||
 	     JEDEC_MFR(nor->info) == SNOR_MFR_INTEL ||
 	     JEDEC_MFR(nor->info) == SNOR_MFR_SST ||
@@ -4431,7 +4435,10 @@ static int spi_nor_init(struct spi_nor *nor)
 		 */
 		if (nor->flags & SNOR_F_BROKEN_RESET)
 			debug("enabling reset hack; may not recover from unexpected reboots\n");
-		set_4byte(nor, nor->info, 1);
+		err = set_4byte(nor, nor->info, 1);
+		/* read-only builds refuse EN4B: never carry on with a 3/4-byte mismatch */
+		if (err && IS_ENABLED(CONFIG_SPI_FLASH_READ_ONLY))
+			return err;
 	}
 
 	return 0;
@@ -4567,6 +4574,52 @@ void spi_nor_set_fixups(struct spi_nor *nor)
 #endif /* SPI_FLASH_WINBOND */
 }
 
+#if IS_ENABLED(CONFIG_SPI_FLASH_WRITE_WINDOW)
+/* Is this request on the window's chip and entirely inside the window? */
+static bool spi_nor_in_window(struct spi_nor *nor, loff_t start, u64 len)
+{
+	struct udevice *dev = nor->spi->dev;
+
+	const u8 *id = nor->info->id;
+	u32 jedec = id[0] << 16 | id[1] << 8 | id[2];
+
+	/* the chip is the one the window was set for, used with 3-byte addresses */
+	return dev_seq(dev->parent) == CONFIG_SPI_FLASH_WRITE_WINDOW_BUS &&
+	       spi_chip_select(dev) == CONFIG_SPI_FLASH_WRITE_WINDOW_CS &&
+	       jedec == CONFIG_SPI_FLASH_WRITE_WINDOW_JEDEC &&
+	       nor->mtd.size == CONFIG_SPI_FLASH_WRITE_WINDOW_CHIP_SIZE &&
+	       nor->addr_width == 3 && start >= 0 &&
+	       spi_flash_window_covers(start, len, CONFIG_SPI_FLASH_WRITE_WINDOW_START,
+				       CONFIG_SPI_FLASH_WRITE_WINDOW_SIZE);
+}
+#endif
+
+static int __maybe_unused spi_nor_ro_erase(struct mtd_info *mtd,
+					  struct erase_info *instr)
+{
+#if IS_ENABLED(CONFIG_SPI_FLASH_WRITE_WINDOW)
+	if (spi_nor_in_window(mtd_to_spi_nor(mtd), instr->addr, instr->len))
+		return spi_nor_erase(mtd, instr);
+	printf("SF: erase %#llx+%#llx outside the write window, refused\n",
+	       (unsigned long long)instr->addr, (unsigned long long)instr->len);
+#endif
+	return -EROFS;
+}
+
+static int __maybe_unused spi_nor_ro_write(struct mtd_info *mtd, loff_t to,
+					  size_t len, size_t *retlen,
+					  const u_char *buf)
+{
+	*retlen = 0;
+#if IS_ENABLED(CONFIG_SPI_FLASH_WRITE_WINDOW)
+	if (spi_nor_in_window(mtd_to_spi_nor(mtd), to, len))
+		return spi_nor_write(mtd, to, len, retlen, buf);
+	printf("SF: write %#llx+%#zx outside the write window, refused\n",
+	       (unsigned long long)to, len);
+#endif
+	return -EROFS;
+}
+
 int spi_nor_scan(struct spi_nor *nor)
 {
 	struct spi_nor_flash_parameter params;
@@ -4586,7 +4639,8 @@ int spi_nor_scan(struct spi_nor *nor)
 	nor->read_proto = SNOR_PROTO_1_1_1;
 	nor->write_proto = SNOR_PROTO_1_1_1;
 	nor->read = spi_nor_read_data;
-	nor->write = spi_nor_write_data;
+	nor->write = IS_ENABLED(CONFIG_SPI_FLASH_READ_ONLY) &&
+		     !IS_ENABLED(CONFIG_SPI_FLASH_WRITE_WINDOW) ? NULL : spi_nor_write_data;
 	nor->read_reg = spi_nor_read_reg;
 	nor->write_reg = spi_nor_write_reg;
 
@@ -4643,9 +4697,17 @@ int spi_nor_scan(struct spi_nor *nor)
 	mtd->writesize = params.writesize;
 	mtd->flags = MTD_CAP_NORFLASH;
 	mtd->size = params.size;
-	mtd->_erase = spi_nor_erase;
 	mtd->_read = spi_nor_read;
-	mtd->_write = spi_nor_write;
+	if (IS_ENABLED(CONFIG_SPI_FLASH_READ_ONLY)) {
+		/* no lock code; erase/write only inside the write window, if any */
+		if (!IS_ENABLED(CONFIG_SPI_FLASH_WRITE_WINDOW))
+			mtd->flags &= ~MTD_WRITEABLE;
+		mtd->_erase = spi_nor_ro_erase;
+		mtd->_write = spi_nor_ro_write;
+	} else {
+		mtd->_erase = spi_nor_erase;
+		mtd->_write = spi_nor_write;
+	}
 
 #if defined(CONFIG_SPI_FLASH_LOCK)
 #if defined(CONFIG_SPI_FLASH_STMICRO) || defined(CONFIG_SPI_FLASH_SST)
diff --git a/drivers/spi/Kconfig b/drivers/spi/Kconfig
index 007ad5e..181a5a5 100644
--- a/drivers/spi/Kconfig
+++ b/drivers/spi/Kconfig
@@ -41,6 +41,17 @@ config SPI_MEM
 	  This extension is meant to simplify interaction with SPI memories
 	  by providing an high-level interface to send memory-like commands.
 
+config SPI_MEM_READ_ONLY
+	bool "Refuse every SPI memory operation that is not a read"
+	depends on SPI_MEM
+	help
+	  Only read (0x03), fast read (0x0b), read ID (0x9f) and read
+	  status (0x05) with a data-in phase are passed to the controller; write enable, register writes,
+	  program, erase, reset and anything unknown fail with -EROFS. For
+	  boards whose boot flash must never be written from U-Boot. With
+	  SPI_FLASH_WRITE_WINDOW, the window's chip also gets write enable,
+	  page program and sector erase inside the window.
+
 config SPI_DIRMAP
 	bool "SPI direct mapping"
 	select SPI_MEM
diff --git a/drivers/spi/spi-mem.c b/drivers/spi/spi-mem.c
index 3fd2353..56ad987 100644
--- a/drivers/spi/spi-mem.c
+++ b/drivers/spi/spi-mem.c
@@ -248,6 +248,60 @@ EXPORT_SYMBOL_GPL(spi_mem_supports_op);
  *
  * Return: 0 in case of success, a negative error code otherwise.
  */
+#if IS_ENABLED(CONFIG_SPI_MEM_READ_ONLY)
+#include <spi_flash_window.h>
+
+/*
+ * Read-only build: only the read commands this build sends (single-lane,
+ * 3-byte address, no SFDP) with a data-in phase reach the wire. Not 0x35:
+ * on Macronix that is EQIO (enter QPI mode), not a register read. Write
+ * enable, status/config writes, program, erase, reset, lock and everything
+ * unknown are refused here, below every flash driver and command.
+ */
+static bool spi_mem_ro_allowed(const struct spi_mem_op *op)
+{
+	static const u8 reads[] = {
+		0x03, 0x0b,				/* read, fast read */
+		0x9f,					/* read ID */
+		0x05,					/* read status register */
+	};
+	int i;
+
+	if (op->cmd.nbytes != 1 || op->data.dir != SPI_MEM_DATA_IN ||
+	    !op->data.nbytes)
+		return false;
+	for (i = 0; i < ARRAY_SIZE(reads); i++)
+		if (op->cmd.opcode == reads[i])
+			return true;
+	return false;
+}
+
+/*
+ * SPI_FLASH_WRITE_WINDOW: on the one chip that has the window, also pass
+ * write enable/disable, page program and sector/block erase that stay
+ * inside it (spi_flash_window_op_ok). Independent of the spi-nor check.
+ */
+static bool spi_mem_window_allowed(struct spi_slave *slave,
+				   const struct spi_mem_op *op)
+{
+#if IS_ENABLED(CONFIG_SPI_FLASH_WRITE_WINDOW)
+	enum spi_flash_window_dir dir = !op->data.nbytes ? SFW_NONE :
+		op->data.dir == SPI_MEM_DATA_OUT ? SFW_OUT : SFW_IN;
+
+	if (dev_seq(slave->dev->parent) != CONFIG_SPI_FLASH_WRITE_WINDOW_BUS ||
+	    spi_chip_select(slave->dev) != CONFIG_SPI_FLASH_WRITE_WINDOW_CS ||
+	    op->cmd.nbytes != 1)
+		return false;
+	return spi_flash_window_op_ok(op->cmd.opcode, op->addr.nbytes, op->addr.val,
+				      op->dummy.nbytes, dir, op->data.nbytes,
+				      CONFIG_SPI_FLASH_WRITE_WINDOW_START,
+				      CONFIG_SPI_FLASH_WRITE_WINDOW_SIZE);
+#else
+	return false;
+#endif
+}
+#endif
+
 int spi_mem_exec_op(struct spi_slave *slave, const struct spi_mem_op *op)
 {
 	struct udevice *bus = slave->dev->parent;
@@ -260,6 +314,13 @@ int spi_mem_exec_op(struct spi_slave *slave, const struct spi_mem_op *op)
 	int ret;
 	int i;
 
+#if IS_ENABLED(CONFIG_SPI_MEM_READ_ONLY)
+	if (!spi_mem_ro_allowed(op) && !spi_mem_window_allowed(slave, op)) {
+		printf("spi-mem: read-only build, opcode %02x refused\n",
+		       op->cmd.opcode);
+		return -EROFS;
+	}
+#endif
 	if (!spi_mem_supports_op(slave, op))
 		return -ENOTSUPP;
 
diff --git a/include/spi_flash_window.h b/include/spi_flash_window.h
new file mode 100644
index 0000000..6149bf5
--- /dev/null
+++ b/include/spi_flash_window.h
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * SPI NOR write window (SPI_FLASH_WRITE_WINDOW): the only flash range a
+ * read-only build may erase or program. Two independent checks use the
+ * helpers below: the spi-nor MTD erase/write hooks (whole request) and the
+ * spi-mem op filter (each command on the wire). Pure functions, so a host
+ * test can drive them (nix/packages/uboot/alpine-v2/window-test).
+ */
+#ifndef __SPI_FLASH_WINDOW_H
+#define __SPI_FLASH_WINDOW_H
+
+/* [start, start + len) lies inside [wstart, wstart + wsize), no overflow. */
+static inline int spi_flash_window_covers(unsigned long long start,
+					  unsigned long long len,
+					  unsigned long long wstart,
+					  unsigned long long wsize)
+{
+	return len && start >= wstart && start - wstart < wsize &&
+	       len <= wsize - (start - wstart);
+}
+
+/* Bytes a NOR erase opcode clears (its aligned block), 0 if not an erase. */
+static inline unsigned int spi_flash_window_erase_size(unsigned char op)
+{
+	switch (op) {
+	case 0x20: case 0x21:		/* 4 KiB sector, 3-/4-byte address */
+		return 0x1000;
+	case 0x52: case 0x5c:		/* 32 KiB block */
+		return 0x8000;
+	case 0xd8: case 0xdc:		/* 64 KiB block */
+		return 0x10000;
+	}
+	return 0;
+}
+
+/* Address bytes an opcode carries: 4 for the 4-byte-address variants. */
+static inline unsigned int spi_flash_window_addr_width(unsigned char op)
+{
+	switch (op) {
+	case 0x12: case 0x21: case 0x5c: case 0xdc:
+		return 4;
+	}
+	return 3;
+}
+
+enum spi_flash_window_dir { SFW_NONE, SFW_IN, SFW_OUT };
+
+/*
+ * May this command go to the window's chip? Plain reads are not decided
+ * here. Allowed: write enable/disable (no address, dummy or data), page
+ * program (0x02 with a 3-byte, 0x12 with a 4-byte address) entirely inside
+ * the window, and sector/block erase (0x20/0x52/0xd8 3-byte, 0x21/0x5c/0xdc
+ * 4-byte) whose aligned block lies inside it, without dummy bytes. A
+ * program or erase whose address width does not match its opcode is
+ * refused: a 4-byte address sent with a 3-byte opcode would land elsewhere
+ * on a 3-byte chip. Everything else (status/config register writes, chip
+ * erase, reset, lock, suspend, OTP, 4-byte mode, ...) is refused.
+ */
+static inline int spi_flash_window_op_ok(unsigned char op, unsigned int addr_nbytes,
+					 unsigned long long addr,
+					 unsigned int dummy_nbytes,
+					 enum spi_flash_window_dir dir,
+					 unsigned long long data_nbytes,
+					 unsigned long long wstart,
+					 unsigned long long wsize)
+{
+	unsigned int esz = spi_flash_window_erase_size(op);
+
+	if (op == 0x06 || op == 0x04)		/* WREN, WRDI */
+		return !addr_nbytes && !dummy_nbytes && dir == SFW_NONE;
+	if (op != 0x02 && op != 0x12 && !esz)
+		return 0;
+	if (addr_nbytes != spi_flash_window_addr_width(op) || dummy_nbytes)
+		return 0;
+	if (op == 0x02 || op == 0x12)		/* page program */
+		return dir == SFW_OUT &&
+		       spi_flash_window_covers(addr, data_nbytes, wstart, wsize);
+	return dir == SFW_NONE && !data_nbytes &&
+	       spi_flash_window_covers(addr & ~(unsigned long long)(esz - 1),
+				       esz, wstart, wsize);
+}
+
+#endif
