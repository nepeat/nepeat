+/********************** Parity Errors ************/
+
+struct al_pcie_core_parity_stats {
+	unsigned int num_of_errors;
+
+	/* PCIe SRAM's parity errors */
+	al_bool u0_ram2p;
+	al_bool u1_ram2p;
+	al_bool u7_ram2p;
+	al_bool u8_ram2p;
+	al_bool u11_ram2p;
+	/*
+	 * PCIe x4 SRAM's parity errors
+	 * Relevant only in Rev1/2
+	 */
+	al_bool u_ram_1p_sotbuf;
+	al_bool u0_ram_radm_qbuffer;
+	al_bool u3_qbuffer_0;
+	al_bool u3_qbuffer_1;
+	al_bool u9_decomp;
+	al_bool u6_ram2p;
+	al_bool u0_rbuf;
+	al_bool u3_qbuffer_2;
+	/*
+	 * PCIe x8 SRAM's parity errors
+	 * Relevant only in Rev3
+	 */
+	al_bool ram_1p_rbuf;
+	al_bool ram_2p_sotbuf;
+	al_bool u0_ram_radm_qbuffer_hdr;
+	al_bool u3_ram_radm_qbuffer_data_0;
+	al_bool u3_ram_radm_qbuffer_data_1;
+	al_bool u10_ram2p_0;
+	al_bool u10_ram2p_1;
+	al_bool u6_ram;
+};
+
+struct al_pcie_axi_parity_stats {
+	unsigned int num_of_errors;
+
+	/* PCIe SRAM's parity errors */
+	al_bool u5_ram2p;
+	al_bool u4_ram2p;
+	al_bool u3_ram2p;
+	al_bool u2_ram2p;
+
+	/*
+	 * PCIe x4 SRAM's parity errors
+	 * Relevant only in Rev1/2
+	 */
