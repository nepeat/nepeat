+	addr = al_reg_read32(pcie_port->regs->axi.wr_cmpl.wr_cmpl_log_low);
+	addr |= ((uint64_t)al_reg_read32(pcie_port->regs->axi.wr_cmpl.wr_cmpl_log_high)) << 32;
+
