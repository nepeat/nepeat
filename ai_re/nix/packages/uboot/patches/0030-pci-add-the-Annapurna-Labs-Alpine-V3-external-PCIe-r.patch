+/* The minimal delay for Making sure 'progress' bit is asserted [uSec] */
+#define CORE_INT_PROG_ASSERTION_DELAY		1
+
+#define CORE_INT_TIMEOUT			100000	/* [uSec] */
+
+#ifndef AL_SERDES_ERR_ONLY
