+#define AL_ADAPTER_GENERIC_CONTROL_9			0x218
+/* Control 10 */
+#define AL_ADAPTER_GENERIC_CONTROL_10			0x21C
+/* Control 11 */
+#define AL_ADAPTER_GENERIC_CONTROL_11			0x220
+/* Control 12 */
+#define AL_ADAPTER_GENERIC_CONTROL_12			0x224
+/* Control 13 */
+#define AL_ADAPTER_GENERIC_CONTROL_13			0x228
+/* Control 14 */
+#define AL_ADAPTER_GENERIC_CONTROL_14			0x22C
+/* Control 15 */
+#define AL_ADAPTER_GENERIC_CONTROL_15			0x230
+/* Control 16 */
+#define AL_ADAPTER_GENERIC_CONTROL_16			0x234
+/* Control 17 */
+#define AL_ADAPTER_GENERIC_CONTROL_17			0x238
+/* Control 18 */
+#define AL_ADAPTER_GENERIC_CONTROL_18			0x23C
+/* Control 19 */
+#define AL_ADAPTER_GENERIC_CONTROL_19			0x240
+
+/* Enable clock gating */
+#define AL_ADAPTER_GENERIC_CONTROL_0_CLK_GATE_EN	0x01
+/*
+ * Mask the VF FLR to the UDMA engien due to VF_FLR bit[6]
+ * When bit is set, all transactions through pci conf bar and mem bar will get timeout
+ */
+#define AL_ADAPTER_GENERIC_CONTROL_0_VF_UDMA_RST_MASK(vf)	AL_BIT(3 + (vf))
+/* When set, all transactions through the PCI conf & mem BARs get timeout */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ADAPTER_DIS	0x40
+/* Mask PF UDMA from FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_PF_RST_MASK	AL_BIT(8)
+/* Mask VF UDMAs from FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_VF_RST_MASK(vf)	AL_BIT(9 + vf)
+#define AL_ADAPTER_GENERIC_CONTROL_0_APP_RST		AL_BIT(16)
+#define AL_ADAPTER_GENERIC_CONTROL_0_APP_REGS_RST	AL_BIT(17)
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_RESET_1GMAC	AL_BIT(18)
+#define AL_ADAPTER_GENERIC_CONTROL_0_APP_RST_ON_FLR		AL_BIT(24)
+#define AL_ADAPTER_GENERIC_CONTROL_0_APP_REGS_RST_ON_FLR	AL_BIT(25)
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_RESET_1GMAC_ON_FLR	AL_BIT(26)
+
+/**
+ * bit mapping of the AL_ADAPTER_GENERIC_CONTROL_0 register in eth v4 adv unit :
+ * [0]	clock disable enable
+ * [1]	PF status is enabled
+ * [2]	parity protect disabled
+ * ############# Following bits logic operates when they are set to '0'
+ * ## ** vf_flr_trig is the FLR bit according to PCIE spec
+ * ##    (bit 15 in control & status reg of VF config space)
+ * ##    They are not auto cleared, but if vf_presetn_int[func] = 0 the bit is reset.
+ * ##    hence, if bits[15:13] in these register (below) are set to 0 we achieve auto-clear.
+ * ## ** see adp2func[i] effect below at bits[11:8]
+ * [3]	vf_flr_trig => flr_per_func[1] == 1 && adp2func_flr[1] == 1
+ * [4]	vf_flr_trig => flr_per_func[2] == 1 && adp2func_flr[2] == 1
+ * [5]	vf_flr_trig => flr_per_func[3] == 1 && adp2func_flr[3] == 1
+ * ##
+ * [6]	pci_conf_dev_not exists, can be override from common
+ * ## (*) preset_int = 0 resets the pcie cfg space registers (connected to adapter regblock reset n)
+ * ##     by masking this bit an FLR wont reset the pcie config space registers
+ * ##     and so FLR must be issued as a pulse over the FLR bit.
+ * ## (*) pf_flr_trig activated by the FLR bit ([15] at pcie ctrl & status reg of the PR)
+ * ##     this relation can change in use_all_adapter flags is unit during al_eth_common_init(...)
+ * [7]	pf_flr_trig => presetn_int == 0
+ * ## adp2func_flr[i] will cause :
+ * ##   (*) reset of UDMA func [i]
+ * ##   (*) reset of applications according to bits[29:24]
+ * [8]	pf_flr_trig => flr_per_func[0] == 1 && adp2func_flr[0] == 1
+ * [9]	pf_flr_trig => flr_per_func[1] == 1 && adp2func_flr[1] == 1
+ * [10]	pf_flr_trig => flr_per_func[2] == 1 && adp2func_flr[2] == 1
+ * [11] pf_flr_trig => flr_per_func[3] == 1 && adp2func_flr[3] == 1
+ * [12]	pf_flr_trig =>  presetn_int_out == 0. reset_n inside adpt_axi_arb
+ * ## See vf_flr_trig above at bits[5:3]
+ * ## vf_preset_int[func] will only reset the following :
+ * ## (*) VF BME bit
+ * ## (*) VF FLR bit ([15] at pcie ctrl & status)
+ * ## (*) VF func mask
+ * ## (*) VF msix XX en
+ * [13]	pf_flr_trig || vf_flr_trig[0]  =>  vf_presetn_int[0] == 0
+ * [14]	pf_flr_trig || vf_flr_trig[0]  =>  vf_presetn_int[0] == 0
+ * [15]	pf_flr_trig || vf_flr_trig[0]  =>  vf_presetn_int[0] == 0
+ * ############# Following bits logic operates when they are set to '1'
+ * ## bits [21:16] resets the application without relation to the PCIE FLR, each adapter resets
+ * ## its own app, there is NO auto clear
+ * [16]	app_reset (EC)
+ * [17]	app_reset (EC regs)
+ * [18]	app_reset (MAC)
+ * [19]	RESERVED
+ * [20]	app_reset (shared_cache_reset)
+ * [21]	app_reset (shared_resource_reset)
+ * [22]	RESERVED
+ * [23]	RESERVED
+ * ## use of the following bits makes sense only if we perform PCIE FLR, bit[8] is set to 0
+ * ## and we must make sure that the FLR bit be cleared
+ * [24]	adp2func_flr_mux_out[i] -> app_reset[i]
+ * [25]	adp2func_flr_mux_out[i] -> app_reg_reset[i]
+ * [26]	adp2func_flr_mux_out[i] -> mac_reset[i]
+ * [27]	RESERVED
+ * [28]	adp2func_flr_mux_out[0] -> shared_cache_reset
+ * [29]	adp2func_flr_mux_out[0] -> shared_resource_reset
+ * [30]	RESERVED
+ * [31]	RESERVED
+ */
+/* Make sure this bit is at "0" for auto-clear of FLR bit */
+#define AL_ADAPTER_GENERIC_CONTROL_0_CFG_REGS_RESET_MASK		AL_BIT(7)
+#define AL_ADAPTER_GENERIC_CONTROL_0_AXI_ARB_RESET_MASK			AL_BIT(12)
+#define AL_ADAPTER_GENERIC_CONTROL_0_VF_PCIE_CFG_RST_MASK(i)		AL_BIT(13 + (i))
+
+/* This is the reset value of this reg in the HW */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_HW_RESET_VAL		0xFF000000
+
+/* EC(0-3) reset to respective UDMA (0-3) */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_EC_RST_EN_SELF		AL_BIT(16)
+/* EC reg(0-3) reset to respective UDMA (0-3) FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_EC_REG_RST_EN_SELF		AL_BIT(17)
+/* MAC(0-3) FLR to respective UDMA (0-3) */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_MAC_RST_EN_SELF		AL_BIT(18)
+/* eth_shared_cache reset */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_SCACHE_RST_EN_SELF		AL_BIT(20)
+/* eth_shared_resource reset */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_SRESOURCE_RST_EN_SELF	AL_BIT(21)
+/* couple EC(0-3) FLR to respective UDMA (0-3) FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_EC_RST_EN		AL_BIT(24)
+/* Couple EC reg(0-3) FLR to respective UDMA (0-3) FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_EC_REG_RST_EN	AL_BIT(25)
+/* Couple MAC(0-3) FLR to respective UDMA (0-3) FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_MAC_RST_EN		AL_BIT(26)
+/* Couple eth_shared_cache FLR to UDMA 0 FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_SCACHE_RST_EN	AL_BIT(28)
+/* Couple eth_shared_resource FLR to UDMA 0 FLR */
+#define AL_ADAPTER_GENERIC_CONTROL_0_ETH_V4_SRESOURCE_RST_EN	AL_BIT(29)
+
+/*
+ * SATA registers only
+ */
+/* Select 125MHz free running clock from IOFAB main PLL as SATA OOB clock
+ * instead of using power management ref clock
+ */
+#define AL_ADAPTER_GENERIC_CONTROL_10_SATA_OOB_CLK_SEL	AL_BIT(26)
+/* AXUSER selection and value per bit (1 = address, 0 = register) */
+/* Rx */
+#define AL_ADPTR_GEN_CTL_12_SATA_AWUSER_VAL_MASK	AL_FIELD_MASK(15, 0)
+#define AL_ADPTR_GEN_CTL_12_SATA_AWUSER_VAL_SHIFT	0
+#define AL_ADPTR_GEN_CTL_12_SATA_AWUSER_SEL_MASK	AL_FIELD_MASK(31, 16)
+#define AL_ADPTR_GEN_CTL_12_SATA_AWUSER_SEL_SHIFT	16
+/* Tx */
+#define AL_ADPTR_GEN_CTL_13_SATA_ARUSER_VAL_MASK	AL_FIELD_MASK(15, 0)
+#define AL_ADPTR_GEN_CTL_13_SATA_ARUSER_VAL_SHIFT	0
+#define AL_ADPTR_GEN_CTL_13_SATA_ARUSER_SEL_MASK	AL_FIELD_MASK(31, 16)
+#define AL_ADPTR_GEN_CTL_13_SATA_ARUSER_SEL_SHIFT	16
+/* Central Target-ID enabler. If set, then each entry will be used as programmed */
+#define AL_ADPTR_GEN_CTL_14_SATA_MSIX_TGTID_SEL		AL_BIT(0)
+/* Allow access to store Target-ID values per entry */
+#define AL_ADPTR_GEN_CTL_14_SATA_MSIX_TGTID_ACCESS_EN	AL_BIT(1)
+/* Target-ID Address select */
+/* Tx */
+#define AL_ADPTR_GEN_CTL_14_SATA_VM_ARADDR_SEL_MASK	AL_FIELD_MASK(13, 8)
+#define AL_ADPTR_GEN_CTL_14_SATA_VM_ARADDR_SEL_SHIFT	8
+/* Rx */
+#define AL_ADPTR_GEN_CTL_14_SATA_VM_AWADDR_SEL_MASK	AL_FIELD_MASK(21, 16)
+#define AL_ADPTR_GEN_CTL_14_SATA_VM_AWADDR_SEL_SHIFT	16
+/* Address Value */
+/* Rx */
+#define AL_ADPTR_GEN_CTL_15_SATA_VM_AWDDR_HI	AL_FIELD_MASK(31, 0)
+/* Tx */
+#define AL_ADPTR_GEN_CTL_16_SATA_VM_ARDDR_HI	AL_FIELD_MASK(31, 0)
+
+/*
+ * ROB registers
+ */
+/* Read ROB Enable, when disabled the read ROB is bypassed */
+#define AL_ADPTR_GEN_CTL_19_READ_ROB_EN			AL_BIT(0)
+/* Read force in-order of every read transaction */
+#define AL_ADPTR_GEN_CTL_19_READ_ROB_FORCE_INORDER	AL_BIT(1)
+/* Read software reset */
+#define AL_ADPTR_GEN_CTL_19_READ_ROB_SW_RESET		AL_BIT(15)
+/* Write ROB Enable, when disabled the Write ROB is bypassed */
+#define AL_ADPTR_GEN_CTL_19_WRITE_ROB_EN		AL_BIT(16)
+/* Write force in-order of every write transaction */
+#define AL_ADPTR_GEN_CTL_19_WRITE_ROB_FORCE_INORDER	AL_BIT(17)
+/* Write software reset */
+#define AL_ADPTR_GEN_CTL_19_WRITE_ROB_SW_RESET		AL_BIT(31)
+
+#define AL_ADPTR_VF_BASE(vf_num)			(0x1000 + ((vf_num) * 0x1000))
+#define AL_ADPTR_VF_CTRL_STATUS(vf_num)			(AL_ADPTR_VF_BASE(vf_num) + 0x48)
+#define AL_ADPTR_VF_CTRL_STATUS_FLR			AL_BIT(15)
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/drivers/pci/al_pcie_v3/al_init_pcie_v3_rc.c b/drivers/pci/al_pcie_v3/al_init_pcie_v3_rc.c
new file mode 100644
index 00000000..bee517f1
--- /dev/null
+++ b/drivers/pci/al_pcie_v3/al_init_pcie_v3_rc.c
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Root-complex bring-up of one Alpine V3 external PCIe port.
+ *
+ * The order of the HAL calls is the vendor's al_init_pcie() (services/pcie/
+ * al_init_pcie.c) for mode RC. The parameters are the HAL's Alpine V3
+ * default_init_pcie_params (services/pcie/al_init_pcie_params.h with
+ * AL_DEV_ID = ALPINE_V3) as al_pcie_init_adv() adjusts them for an RC port:
+ * the vendor U-Boot 2018.05-alpine_db-v3.65.1 carries exactly that template
+ * (its gen3 lane EQ table at 0x011cd1f0, gen3 params at 0x011cd230):
+ *
+ *   link: max speed = board gen, max payload = default
+ *   AXI snoop on, RAM/AXI parity interrupts off, AXI slave error response on
+ *   no latency/replay timers, no Gen2 params, no SRIS, no relaxed ordering
+ *   Gen3: perform EQ, no EQ interrupt, 16 lane EQ entries of
+ *         {DS TX preset 5, DS RX hint 0, US TX preset 5, US RX hint 0},
+ *         LF 6, FS 27, preset request vector 0x10 (RC and EP), FB mode FOM
+ *   one PF, no IB/OB reads override, no CRS deferral, fast link mode off
+ *   SerDes: the port's lanes (serdes_grp_objs_num = max lanes), iCal on
+ */
+
+#include "al_init_pcie_v3_rc.h"
+#include "al_hal_pbs_utils.h"
+
+int al_pcie_hal_failed;
+
+#define LINK_FINAL_WAIT_US	(48 * 1000)	/* al_init_pcie LINK_FINAL_WAIT_MS */
+#define V3_EQ_ELEMS		16		/* MAX_NUM_OF_LANES */
+
+void al_init_pcie_v3_rc_port_params(const struct al_init_pcie_v3_rc_cfg *cfg,
+				    struct al_pcie_port_config_params *params,
+				    struct al_pcie_link_params *link,
+				    struct al_pcie_gen3_params *gen3,
+				    struct al_pcie_gen3_lane_eq_params *eq,
+				    unsigned int eq_elems)
+{
+	unsigned int i;
+
+	al_memset(params, 0, sizeof(*params));
+	al_memset(link, 0, sizeof(*link));
+	al_memset(gen3, 0, sizeof(*gen3));
+
+	link->max_speed = (enum al_pcie_link_speed)cfg->gen;
+	link->max_payload_size = AL_PCIE_MPS_DEFAULT;
+
+	for (i = 0; i < eq_elems; i++) {
+		eq[i].downstream_port_transmitter_preset = 5;
+		eq[i].downstream_port_receiver_preset_hint = 0;
+		eq[i].upstream_port_transmitter_preset = 5;
+		eq[i].upstream_port_receiver_preset_hint = 0;
+	}
+	gen3->perform_eq = AL_TRUE;
+	gen3->interrupt_enable_on_link_eq_request = AL_FALSE;
+	gen3->eq_params = eq;
+	gen3->eq_params_elements = eq_elems;
+	gen3->eq_disable = AL_FALSE;
+	gen3->eq_phase2_3_disable = AL_FALSE;
+	gen3->eq_redo_bypass = AL_FALSE;
+	gen3->local_lf = 6;
+	gen3->local_fs = 27;
+	gen3->pset_req_vec_rc = AL_BIT(4);
+	gen3->pset_req_vec_ep = AL_BIT(4);
+	gen3->fb_mode = AL_PCIE_GEN3_FB_MODE_FOM;
+	gen3->fmdc = NULL;
+
+	params->link_params = link;
+	params->enable_axi_snoop = AL_TRUE;
+	params->enable_ram_parity_int = AL_FALSE;
+	params->enable_axi_parity_int = AL_FALSE;
+	params->lat_rply_timers = NULL;
+	params->gen2_params = NULL;
+	params->gen3_params = gen3;
+	params->fast_link_mode = AL_FALSE;
+	params->enable_axi_slave_err_resp = AL_TRUE;
+	params->sris_params = NULL;
+	params->relaxed_ordering_params = NULL;
+}
+
+/* al_init_pcie PORT_DIS_EN_WAIT_US: 20 us on Alpine V3 (500 us on V1/V2). */
+static unsigned int port_wait_us(const struct al_init_pcie_v3_rc_cfg *cfg)
+{
+	return al_pbs_dev_id_get(cfg->pbs_reg_base) <= PBS_UNIT_CHIP_ID_DEV_ID_ALPINE_V2 ?
+		500 : 20;
+}
+
+#define STEP(name, call)					\
+	do {							\
+		al_pcie_hal_failed = 0;				\
+		rc = (call);					\
+		if (!rc && al_pcie_hal_failed)			\
+			rc = -EINVAL;				\
+		if (rc) {					\
+			res->step = name;			\
+			goto fail;				\
+		}						\
+	} while (0)
+
+int al_init_pcie_v3_rc(struct al_pcie_port *pcie_port,
+		       const struct al_init_pcie_v3_rc_cfg *cfg,
+		       struct al_init_pcie_v3_rc_result *res)
+{
+	struct al_pcie_port_config_params params;
+	struct al_pcie_link_params link;
+	struct al_pcie_gen3_params gen3;
+	struct al_pcie_gen3_lane_eq_params eq[V3_EQ_ELEMS];
+	unsigned int us = port_wait_us(cfg);
+	unsigned int i, nsrd;
+	int rc;
+
+	al_memset(res, 0, sizeof(*res));
+	al_init_pcie_v3_rc_port_params(cfg, &params, &link, &gen3, eq, V3_EQ_ELEMS);
+	/* al_pcie_init_adv: serdes_grp_objs_num = max_lanes */
+	nsrd = cfg->serdes ? cfg->lanes : 0;
+	if (nsrd > cfg->serdes_num) {
+		res->rc = -EINVAL;
+		res->step = "SerDes lanes (fewer than link lanes)";
+		return res->rc;
+	}
+
+	al_pcie_hal_failed = 0;
+	rc = al_pcie_port_handle_init(pcie_port, cfg->pcie_reg_base,
+				      cfg->pbs_reg_base, cfg->port_id);
+	if (rc || al_pcie_hal_failed) {
+		res->rc = rc ? rc : -EINVAL;
+		res->step = "port handle init";
+		return res->rc;		/* nothing touched yet */
+	}
+
+	al_pcie_link_status(pcie_port, &res->status);
+	if (res->status.ltssm_state) {
+		if (!cfg->reinit) {
+			/* al_init_pcie without reinit_link: "link already started" */
+			res->rc = -EINVAL;
+			res->step = "link already started";
+			return res->rc;
+		}
+		/* reinit_link: stop what runs, then start from a disabled port */
+		res->torn_down = AL_TRUE;
+		al_pcie_link_stop(pcie_port);
+		al_data_memory_barrier();
+		al_pcie_port_memory_shutdown_set(pcie_port, AL_TRUE);
+		al_data_memory_barrier();
+		al_pcie_port_disable(pcie_port);
+		al_udelay(us);
+	}
+
+	STEP("port enable (before shutdown)", al_pcie_port_enable(pcie_port));
+	al_udelay(us);
+
+	al_data_memory_barrier();
+	STEP("memory shutdown off", al_pcie_port_memory_shutdown_set(pcie_port, AL_FALSE));
+	al_data_memory_barrier();
+
+	al_pcie_port_disable(pcie_port);
+
+	STEP("operating mode RC",
+	     al_pcie_port_operating_mode_config(pcie_port, AL_PCIE_OPERATING_MODE_RC));
+	STEP("max lanes", al_pcie_port_max_lanes_set(pcie_port, cfg->lanes));
+	STEP("max PFs", al_pcie_port_max_num_of_pfs_set(pcie_port, 1));
+
+	STEP("port enable", al_pcie_port_enable(pcie_port));
+	al_udelay(us);			/* more than 2000 core clocks */
+
+	/* SerDes: firmware status, iCal configuration, PCS interrupts on */
+	if (nsrd) {
+		al_bool ical = !cfg->skip_serdes_ical;
+
+		al_pcie_hal_failed = 0;
+		for (i = 0; i < nsrd; i++) {
+			cfg->serdes[i]->fw_init_status_get(cfg->serdes[i], NULL);
+			if (ical)
+				cfg->serdes[i]->pcie_ical_config_begin(cfg->serdes[i]);
+		}
+		while (ical) {
+			ical = AL_FALSE;
+			for (i = 0; i < nsrd; i++)
+				if (cfg->serdes[i]->pcie_ical_config_iterate(cfg->serdes[i]))
+					ical = AL_TRUE;
+		}
+		for (i = 0; i < nsrd; i++)
+			cfg->serdes[i]->pcs_interrupt_enable_set(cfg->serdes[i], AL_TRUE);
+		/* al_init_pcie has no error path here: only a HAL assertion counts */
+		if (al_pcie_hal_failed) {
+			rc = -EIO;
+			res->step = "SerDes iCal configuration";
+			goto fail;
+		}
+	}
+
+	STEP("port config", al_pcie_port_config(pcie_port, &params));
+
+	STEP("link start", al_pcie_link_start(pcie_port));
+	STEP("link up wait",
+	     al_pcie_link_up_wait_ex(pcie_port, cfg->wait_for_link_ms, AL_FALSE));
+
+	/* As al_init_pcie: give the link up to 48 ms to reach the max speed. */
+	for (i = 0; i < LINK_FINAL_WAIT_US / 50; i++) {
+		STEP("link status", al_pcie_link_status(pcie_port, &res->status));
+		if (res->status.speed == link.max_speed)
+			break;
+		al_udelay(50);
+	}
+	if (!res->status.link_up) {
+		rc = -EINVAL;
+		res->step = "link up";
+		goto fail;
+	}
+	return 0;
+
+fail:
+	/* the vendor teardown (skip_teardown off): stop the link, shut the memories, disable */
+	res->rc = rc;
+	if (al_pcie_is_link_started(pcie_port))
+		al_pcie_link_stop(pcie_port);
+	if (al_pcie_port_is_enabled(pcie_port)) {
+		al_pcie_port_memory_shutdown_set(pcie_port, AL_TRUE);
+		al_pcie_port_disable(pcie_port);
+	}
+	al_pcie_link_status(pcie_port, &res->status);
+	return rc;
+}
diff --git a/drivers/pci/al_pcie_v3/al_init_pcie_v3_rc.h b/drivers/pci/al_pcie_v3/al_init_pcie_v3_rc.h
new file mode 100644
index 00000000..d8bc6277
--- /dev/null
+++ b/drivers/pci/al_pcie_v3/al_init_pcie_v3_rc.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Root-complex bring-up of one Alpine V3 external PCIe port on the
+ * Annapurna HAL: the RC path of the vendor's al_init_pcie() service (HAL
+ * services/pcie/al_init_pcie.c, not copied: it pulls in the system-fabric
+ * and address-map services for its EP mode), with the parameters the
+ * vendor U-Boot 2018.05-alpine_db-v3.65.1 hands to it from
+ * pci_init_board_external() through al_pcie_init_adv().
+ *
+ * No U-Boot API in here, so the same file builds on a host against a
+ * register model.
+ */
+#ifndef __AL_INIT_PCIE_V3_RC_H__
+#define __AL_INIT_PCIE_V3_RC_H__
+
+#include "al_hal_pcie.h"
+#include "al_hal_serdes_avg.h"
+
+#define AL_INIT_PCIE_V3_MAX_LANES	16
+
+struct al_init_pcie_v3_rc_cfg {
+	unsigned int port_id;
+	void __iomem *pcie_reg_base;	/* the port's unit ("controller") */
+	void __iomem *pbs_reg_base;	/* PBS register file */
+	unsigned int gen;		/* max link speed, 1..3 */
+	unsigned int lanes;		/* max lanes, 1/2/4/8 */
+	unsigned int wait_for_link_ms;
+	/* the AVG SerDes lane objects of this port, lane 0 first (>= lanes) */
+	struct al_serdes_grp_obj **serdes;
+	unsigned int serdes_num;
+	al_bool skip_serdes_ical;
+	/* a started link / enabled port is stopped first (al_init_pcie reinit_link) */
+	al_bool reinit;
+};
+
+struct al_init_pcie_v3_rc_result {
+	int rc;
+	const char *step;		/* what failed, if rc != 0 */
+	al_bool torn_down;		/* a running link/port was stopped first */
+	struct al_pcie_link_status status;
+};
+
+/*
+ * Bring the port up as an RC and train the link, in al_init_pcie()'s order:
+ * port enable, memory shutdown off, disable, mode RC, max lanes, one PF,
+ * enable; then per SerDes lane the firmware status and (unless skipped)
+ * the PCIe iCal configuration sequence and PCS interrupts on; port config;
+ * link start; link-up wait; up to 48 ms for the max speed. On failure the
+ * vendor teardown (link stop, memory shutdown, port disable).
+ */
+int al_init_pcie_v3_rc(struct al_pcie_port *pcie_port,
+		       const struct al_init_pcie_v3_rc_cfg *cfg,
+		       struct al_init_pcie_v3_rc_result *res);
+
+/* What al_pcie_port_config() gets (exported for tests). */
+void al_init_pcie_v3_rc_port_params(const struct al_init_pcie_v3_rc_cfg *cfg,
+				    struct al_pcie_port_config_params *params,
+				    struct al_pcie_link_params *link,
+				    struct al_pcie_gen3_params *gen3,
+				    struct al_pcie_gen3_lane_eq_params *eq,
+				    unsigned int eq_elems);
+
+extern int al_pcie_hal_failed;
+
+#endif
diff --git a/drivers/pci/al_pcie_v3/al_sbus_shim.c b/drivers/pci/al_pcie_v3/al_sbus_shim.c
new file mode 100644
index 00000000..d68713d5
--- /dev/null
+++ b/drivers/pci/al_pcie_v3/al_sbus_shim.c
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * The one SBus HAL call this build needs: al_serdes_avg_complex_handle_init()
+ * records the SBus master's registers. The PCIe iCal sequence talks to the
+ * SerDes through each lane's core-interrupt registers, never over SBus, so
+ * al_hal_sbus.c (which carries the SBus master firmware image) is not built.
+ */
+#include "al_hal_common.h"
+#include "al_hal_sbus.h"
+
+void al_sbus_handle_init(struct al_sbus_obj *obj, void __iomem *regs)
+{
+	al_assert(obj);
+	al_assert(regs);
+	obj->regs = (struct al_sbm_regs __iomem *)regs;
+}
diff --git a/drivers/pci/pcie_alpine_v3.c b/drivers/pci/pcie_alpine_v3.c
new file mode 100644
index 00000000..426648d5
--- /dev/null
+++ b/drivers/pci/pcie_alpine_v3.c
@@ -0,0 +1,615 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Annapurna Labs Alpine V3 external PCIe root complex ("amazon,al-alpine-v3-pcie",
+ * the node mainline Linux pcie-al uses: config = ECAM window, controller = the
+ * unit, dbi = controller + 0x10000).
+ *
+ * The port is brought up with Annapurna's HAL (al_pcie_v3/, verbatim, built
+ * for Alpine V3) in the order and with the parameters of the vendor U-Boot
+ * 2018.05-alpine_db-v3.65.1 (al_pcie_v3/al_init_pcie_v3_rc.c), including the
+ * AVG SerDes lanes of the port (stage3 has downloaded their firmware): the
+ * firmware status check, the PCIe iCal configuration sequence and the PCS
+ * interrupts, per lane, before the port config. Probe policy:
+ *  - link already up (the vendor U-Boot trained it before chainloading us):
+ *    keep it, touch nothing but the config-bus registers;
+ *  - otherwise (al-boot stage3 started us): full RC init with the vendor's
+ *    fallback (pci_init_board_external with teardown on, link retry off):
+ *    a failed init is retried with half the lanes down to x1, then at Gen1;
+ *    a link that comes up slower or narrower is kept as it is;
+ *  - "alpcie reinit": tear the port down and run the full init now, so a RAM
+ *    test after the vendor init proves this init.
+ * Before the first port init of a boot: amazon,link-pre-delay-ms (the
+ * vendor rc-link-pre-delay, 100 ms).
+ *
+ * Config space: the root port's own header is the DesignWare core ("dbi"),
+ * everything behind it goes through the 1 MiB "config" window with the
+ * target bus in the unit's cfg_target_bus register (as pcie-al does).
+ * Downstream accesses that fail raise an SError on this SoC; they run with
+ * SErrors masked, a pending one is drained (pcie_alpine_v3_serror.S) and the
+ * read returns all ones, or, for a vendor ID read, is retried while the
+ * device answers CRS (amazon,crs-timeout-ms, the vendor's 30 s).
+ *
+ * OS handoff (DM_FLAG_OS_PREPARE): with amazon,endpoint-decode-off, the
+ * COMMAND register of the functions on the link bus is cleared, as the
+ * vendor U-Boot leaves the CS8210 FPGAs (Linux enables decode itself).
+ */
+
+#include <command.h>
+#include <console.h>
+#include <dm.h>
+#include <dm/device-internal.h>
+#include <log.h>
+#include <pci.h>
+#include <time.h>
+#include <asm/io.h>
+#include <mapmem.h>
+#include <linux/delay.h>
+#include <linux/ioport.h>
+
+#include "al_pcie_v3/al_init_pcie_v3_rc.h"
+#include "al_pcie_v3/al_hal_iomap.h"
+#include "al_pcie_v3/al_hal_pbs_utils.h"
+
+#define AL_PCIE_UNIT0		0xfd800000UL	/* AL_SB_PCIE_BASE(0) */
+#define AL_PCIE_UNIT_STRIDE	0x20000
+#define AL_SRD_MAIN_LANES	16
+
+/* DesignWare port logic, relative to the dbi base */
+#define DW_AMBA_ERR_RESP	0x8d0
+#define DW_ATU_VIEWPORT		0x900
+#define DW_ATU_CR1		0x904
+#define DW_ATU_CR2		0x908
+#define DW_ATU_LOWER_BASE	0x90c
+#define DW_ATU_UPPER_BASE	0x910
+#define DW_ATU_LIMIT		0x914
+#define DW_ATU_LOWER_TARGET	0x918
+#define DW_ATU_UPPER_TARGET	0x91c
+#define DW_ATU_ENABLE		BIT(31)
+
+#define CRS_TIMEOUT_MS		30000	/* board-cfg/pcie crs-timeout */
+#define LINK_UP_TIMEOUT_MS	100	/* rc-link-up-timeout default */
+#define LINK_PRE_DELAY_MS	100	/* rc-link-pre-delay default */
+
+int alpine_v3_serror_drain(void);
+
+struct alpine_pcie_priv {
+	void __iomem *ecam;
+	void __iomem *regs;
+	void __iomem *dbi;
+	void __iomem *pbs;
+	struct al_pcie_port port;
+	unsigned int port_id;
+	unsigned int gen, lanes;		/* from the DT */
+	unsigned int srd[AL_INIT_PCIE_V3_MAX_LANES];	/* main complex lane numbers */
+	unsigned int nsrd;
+	unsigned int crs_ms, link_ms;
+	bool decode_off;
+	int target_bus;			/* cached cfg_target_bus, -1 = unknown */
+	bool ok;			/* HAL port handle valid */
+	bool link_up;
+	const char *how;		/* "firmware", "ours", "down", ... */
+	unsigned int serrors;		/* SErrors drained since probe */
+	ulong mem_base, mem_size;
+};
+
+/* "alpcie reinit" sets this, probe consumes it */
+static bool alpine_pcie_force_init;
+/* the vendor rc-link-pre-delay, once per boot before the first port init */
+static bool alpine_pcie_pre_delay_done;
+
+/* The main AVG SerDes complex and its lanes (HAL objects), set up on first use. */
+static struct al_serdes_complex_obj srd_main;
+static struct al_serdes_grp_obj srd_lane[AL_SRD_MAIN_LANES];
+static bool srd_main_ok, srd_lane_ok[AL_SRD_MAIN_LANES];
+
+static struct al_serdes_grp_obj *srd_get(void __iomem *pbs, unsigned int lane)
+{
+	if (lane >= AL_SRD_MAIN_LANES)
+		return NULL;
+	if (!srd_main_ok) {
+		/* production Alpine V3: TR main complex (the TC is a test chip) */
+		u32 rev = al_pbs_dev_rev_id_get(pbs);
+
+		al_serdes_avg_complex_handle_init(
+			map_sysmem(AL_SB_SRD_CMPLX_MAIN_BASE, 0x10000),
+			map_sysmem(AL_SRD_CMPLX_MAIN_SBUS_MASTER_BASE, 0x1000),
+			rev == PBS_UNIT_CHIP_ID_DEV_REV_ID_ALPINE_V3_TC ?
+				AL_SRDS_COMPLEX_TYPE_TR_TC_MAIN : AL_SRDS_COMPLEX_TYPE_TR_MAIN,
+			NULL, NULL, &srd_main);
+		srd_main_ok = true;
+	}
+	if (!srd_lane_ok[lane]) {
+		al_serdes_avg_handle_init(map_sysmem(AL_SRD_CMPLX_MAIN_LANE_BASE(lane), 0x400),
+					  &srd_main, lane, &srd_lane[lane]);
+		srd_lane_ok[lane] = true;
+	}
+	return &srd_lane[lane];
+}
+
+static int alpine_pcie_drain(struct alpine_pcie_priv *priv)
+{
+	int r = alpine_v3_serror_drain();
+
+	if (r == 1)
+		priv->serrors++;
+	return r;
+}
+
+/*
+ * U-Boot's start.S routes SErrors to EL2 (HCR_EL2.AMO) and unmasks them,
+ * so an error response would be taken at once (and end in panic). Mask
+ * PSTATE.A around each downstream access; alpine_pcie_drain() then takes a
+ * pending one with its own vector, and the caller's mask is restored.
+ */
+static inline ulong serror_mask(void)
+{
+	ulong daif;
+
+	asm volatile("mrs %0, daif\n\tmsr daifset, #4\n\tisb" : "=r" (daif) : : "memory");
+	return daif;
+}
+
+static inline void serror_restore(ulong daif)
+{
+	asm volatile("msr daif, %0\n\tisb" : : "r" (daif) : "memory");
+}
+
+static int alpine_pcie_addr(const struct udevice *bus, pci_dev_t bdf,
+			    uint offset, void **paddr)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(bus);
+	int busn = PCI_BUS(bdf) - dev_seq(bus);
+
+	if (!priv->ok)
+		return -ENODEV;
+	if (busn == 0) {
+		/* the root port itself; nothing else on the root bus */
+		if (PCI_DEV(bdf) || PCI_FUNC(bdf) ||
+		    !al_pcie_port_is_enabled(&priv->port))
+			return -ENODEV;
+		*paddr = priv->dbi + offset;
+		return 0;
+	}
+	if (!priv->link_up || busn > 0xff)
+		return -ENODEV;
+	/* a PCIe link has one device: no aliases of it at dev 1..31 */
+	if (busn == 1 && PCI_DEV(bdf))
+		return -ENODEV;
+	if (priv->target_bus != busn) {
+		al_pcie_target_bus_set(&priv->port, busn, 0xff);
+		priv->target_bus = busn;
+	}
+	*paddr = priv->ecam + PCIE_ECAM_OFFSET(0, PCI_DEV(bdf), PCI_FUNC(bdf), offset);
+	return 0;
+}
+
+static int alpine_pcie_read_config(const struct udevice *bus, pci_dev_t bdf,
+				   uint offset, ulong *valuep,
+				   enum pci_size_t size)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(bus);
+	bool downstream = PCI_BUS(bdf) != dev_seq(bus);
+	ulong start = get_timer(0);
+	bool told = false;
+	int ret;
+
+	for (;;) {
+		ulong daif;
+		int err;
+
+		if (!downstream)
+			return pci_generic_mmap_read_config(bus, alpine_pcie_addr, bdf,
+							    offset, valuep, size);
+		daif = serror_mask();
+		ret = pci_generic_mmap_read_config(bus, alpine_pcie_addr, bdf,
+						   offset, valuep, size);
+		err = alpine_pcie_drain(priv);
+		serror_restore(daif);
+		if (ret || err != 1)
+			return ret;
+		/* error completion: all ones, except a vendor ID read under CRS */
+		*valuep = pci_get_ff(size);
+		if (offset != PCI_VENDOR_ID)
+			return 0;
+		if (!told) {
+			printf("PCIe %d: %02x.%02x.%x answers CRS, waiting [ctrl-c to skip]\n",
+			       priv->port_id, PCI_BUS(bdf), PCI_DEV(bdf), PCI_FUNC(bdf));
+			told = true;
+		}
+		if (ctrlc() || get_timer(start) > priv->crs_ms) {
+			printf("PCIe %d: %02x.%02x.%x: no answer, skipped\n", priv->port_id,
+			       PCI_BUS(bdf), PCI_DEV(bdf), PCI_FUNC(bdf));
+			return 0;
+		}
+		mdelay(1);
+	}
+}
+
+static int alpine_pcie_write_config(struct udevice *bus, pci_dev_t bdf,
+				    uint offset, ulong value,
+				    enum pci_size_t size)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(bus);
+	ulong daif;
+	int ret;
+
+	if (PCI_BUS(bdf) == dev_seq(bus))
+		return pci_generic_mmap_write_config(bus, alpine_pcie_addr, bdf,
+						     offset, value, size);
+	daif = serror_mask();
+	ret = pci_generic_mmap_write_config(bus, alpine_pcie_addr, bdf, offset,
+					    value, size);
+	if (alpine_pcie_drain(priv) == 1)
+		debug("PCIe %d: config write %x@%x: error response\n",
+		      priv->port_id, bdf, offset);
+	serror_restore(daif);
+	return ret;
+}
+
+/* Outbound iATU region 0: the memory window, identity, as Linux dwc does. */
+static void alpine_pcie_iatu(struct alpine_pcie_priv *priv)
+{
+	u64 base = priv->mem_base, limit = priv->mem_base + priv->mem_size - 1;
+
+	if (!priv->mem_size)
+		return;
+	if (readl(priv->dbi + DW_ATU_VIEWPORT) == 0xffffffff) {
+		printf("PCIe %d: no iATU viewport, memory window left untranslated\n",
+		       priv->port_id);
+		return;
+	}
+	writel(0, priv->dbi + DW_ATU_VIEWPORT);		/* outbound, region 0 */
+	writel(lower_32_bits(base), priv->dbi + DW_ATU_LOWER_BASE);
+	writel(upper_32_bits(base), priv->dbi + DW_ATU_UPPER_BASE);
+	writel(lower_32_bits(limit), priv->dbi + DW_ATU_LIMIT);
+	writel(lower_32_bits(base), priv->dbi + DW_ATU_LOWER_TARGET);
+	writel(upper_32_bits(base), priv->dbi + DW_ATU_UPPER_TARGET);
+	writel(0, priv->dbi + DW_ATU_CR1);			/* MEM */
+	writel(DW_ATU_ENABLE, priv->dbi + DW_ATU_CR2);
+	if (!(readl(priv->dbi + DW_ATU_CR2) & DW_ATU_ENABLE))
+		printf("PCIe %d: iATU region 0 did not enable\n", priv->port_id);
+}
+
+static const char *speed_name(unsigned int s)
+{
+	return s == 1 ? "2.5GT/s" : s == 2 ? "5GT/s" : s == 3 ? "8GT/s" : "?";
+}
+
+static int alpine_pcie_init_once(struct alpine_pcie_priv *priv, unsigned int gen,
+				 unsigned int lanes, bool reinit,
+				 struct al_init_pcie_v3_rc_result *res)
+{
+	struct al_serdes_grp_obj *srd[AL_INIT_PCIE_V3_MAX_LANES];
+	struct al_init_pcie_v3_rc_cfg cfg = {
+		.port_id = priv->port_id,
+		.pcie_reg_base = priv->regs,
+		.pbs_reg_base = priv->pbs,
+		.gen = gen,
+		.lanes = lanes,
+		.wait_for_link_ms = priv->link_ms,
+		.serdes = priv->nsrd ? srd : NULL,
+		.serdes_num = priv->nsrd,
+		.reinit = reinit,
+	};
+	unsigned int i;
+
+	for (i = 0; i < priv->nsrd; i++) {
+		srd[i] = srd_get(priv->pbs, priv->srd[i]);
+		if (!srd[i])
+			return -EINVAL;
+	}
+	return al_init_pcie_v3_rc(&priv->port, &cfg, res);
+}
+
+/*
+ * The vendor's pci_init_board_external() for one RC port: one init at the
+ * board gen/width; on failure (the port is torn down then) half the lanes
+ * until x1, then Gen1 x1. A link that trains below the target is kept.
+ */
+static int alpine_pcie_bringup(struct alpine_pcie_priv *priv, bool force)
+{
+	struct al_init_pcie_v3_rc_result res;
+	unsigned int gen = priv->gen, lanes = priv->lanes;
+	int rc;
+
+	rc = alpine_pcie_init_once(priv, gen, lanes, force, &res);
+	while (rc && (lanes > 1 || gen > 1)) {
+		printf("PCIe %d: Gen%u x%u: no link (%s, %d)", priv->port_id, gen, lanes,
+		       res.step ? res.step : "?", rc);
+		if (lanes > 1)
+			lanes >>= 1;
+		else
+			gen = 1;
+		printf(", trying Gen%u x%u\n", gen, lanes);
+		rc = alpine_pcie_init_once(priv, gen, lanes, false, &res);
+	}
+	if (rc) {
+		printf("PCIe %d: no link (%s, %d)\n", priv->port_id,
+		       res.step ? res.step : "?", rc);
+		return rc;
+	}
+	printf("PCIe %d: link up %s x%d (our init%s, LTSSM %#x)%s\n", priv->port_id,
+	       speed_name(res.status.speed), res.status.lanes,
+	       res.torn_down ? " after teardown" : "", res.status.ltssm_state,
+	       res.status.speed != priv->gen || res.status.lanes != priv->lanes ?
+	       ", BELOW the DT's" : "");
+	/* PCIe: 100 ms from link up before config requests to the device */
+	mdelay(100);
+	return 0;
+}
+
+static unsigned int alpine_pcie_port_from_unit(ulong unit)
+{
+	/* AL_SB_PCIE_OFFSET: ports 0-2 at slots 0-2, 3-6 at 8-11, 7 at 16 */
+	unsigned int slot = (unit - AL_PCIE_UNIT0) / AL_PCIE_UNIT_STRIDE;
+
+	return slot < 3 ? slot : slot < 12 ? slot - 5 : slot - 9;
+}
+
+static int alpine_pcie_probe(struct udevice *dev)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(dev);
+	struct pci_controller *hose = dev_get_uclass_priv(dev);
+	struct al_pcie_link_status st;
+	/* PCIE_ALPINE_V3_FORCE_INIT (RAM rehearsals): the stage3 path behind the vendor U-Boot */
+	bool force = alpine_pcie_force_init || IS_ENABLED(CONFIG_PCIE_ALPINE_V3_FORCE_INIT);
+	u32 pbs, pre;
+	int i, n, rc;
+
+	alpine_pcie_force_init = false;
+	priv->ecam = dev_remap_addr_name(dev, "config");
+	priv->regs = dev_remap_addr_name(dev, "controller");
+	priv->dbi = dev_remap_addr_name(dev, "dbi");
+	if (!priv->ecam || !priv->regs || !priv->dbi)
+		return -EINVAL;
+	/* u32, not dev_read_u32_default(): see the Alpine V2 driver (sign extension) */
+	pbs = AL_PBS_REGFILE_BASE;
+	dev_read_u32(dev, "amazon,pbs", &pbs);
+	priv->pbs = map_sysmem(pbs, 0x1000);
+	priv->port_id = dev_read_u32_default(dev, "amazon,port-id",
+		alpine_pcie_port_from_unit((ulong)priv->regs));
+	priv->gen = dev_read_u32_default(dev, "amazon,link-gen", 0);
+	priv->lanes = dev_read_u32_default(dev, "amazon,link-lanes", 0);
+	priv->crs_ms = dev_read_u32_default(dev, "amazon,crs-timeout-ms", CRS_TIMEOUT_MS);
+	priv->link_ms = dev_read_u32_default(dev, "amazon,link-up-timeout-ms",
+					     LINK_UP_TIMEOUT_MS);
+	priv->decode_off = dev_read_bool(dev, "amazon,endpoint-decode-off");
+	n = dev_read_size(dev, "amazon,serdes-lanes");
+	priv->nsrd = n > 0 ? n / 4 : 0;
+	if (priv->nsrd > AL_INIT_PCIE_V3_MAX_LANES ||
+	    (priv->nsrd && dev_read_u32_array(dev, "amazon,serdes-lanes", priv->srd,
+					      priv->nsrd)))
+		return -EINVAL;
+	priv->target_bus = -1;
+
+	for (i = 0; i < hose->region_count; i++) {
+		if (hose->regions[i].flags == PCI_REGION_MEM) {
+			priv->mem_base = hose->regions[i].phys_start;
+			priv->mem_size = hose->regions[i].size;
+		}
+	}
+
+	al_pcie_hal_failed = 0;
+	rc = al_pcie_port_handle_init(&priv->port, priv->regs, priv->pbs, priv->port_id);
+	if (rc || al_pcie_hal_failed) {
+		printf("PCIe %d: unknown controller revision, not used\n", priv->port_id);
+		priv->how = "unsupported";
+		return 0;
+	}
+	priv->ok = true;
+	al_pcie_link_status(&priv->port, &st);
+
+	if (st.link_up && !force) {
+		priv->how = "firmware";
+		printf("PCIe %d: link up %s x%d (firmware init, kept)\n", priv->port_id,
+		       speed_name(st.speed), st.lanes);
+	} else if (!priv->gen || !priv->lanes) {
+		priv->how = "down";
+		printf("PCIe %d: link down, no amazon,link-gen/-lanes: not initialised\n",
+		       priv->port_id);
+	} else if (priv->port.rev_id != AL_PCIE_REV_ID_4) {
+		priv->how = "down";
+		printf("PCIe %d: rev %d: this init is for rev 4 (Alpine V3), not initialised\n",
+		       priv->port_id, priv->port.rev_id);
+	} else if (priv->nsrd < priv->lanes) {
+		priv->how = "down";
+		printf("PCIe %d: %u SerDes lanes in the DT for x%u: not initialised\n",
+		       priv->port_id, priv->nsrd, priv->lanes);
+	} else {
+		if (!alpine_pcie_pre_delay_done) {
+			pre = LINK_PRE_DELAY_MS;
+			dev_read_u32(dev, "amazon,link-pre-delay-ms", &pre);
+			mdelay(pre);
+			alpine_pcie_pre_delay_done = true;
+		}
+		priv->how = alpine_pcie_bringup(priv, force) ? "down" : "ours";
+	}
+
+	al_pcie_link_status(&priv->port, &st);
+	priv->link_up = st.link_up;
+	if (priv->link_up) {
+		/* as pcie-al: bus 1 is the link, every bus number goes out on it */
+		al_pcie_secondary_bus_set(&priv->port, 1);
+		al_pcie_subordinary_bus_set(&priv->port, 0xff);
+		alpine_pcie_iatu(priv);
+	}
+	return 0;
+}
+
+/*
+ * Before the OS (and "alpcie reinit"): clear COMMAND on the functions of the
+ * link partner, as the vendor U-Boot leaves the FPGAs; Linux enables
+ * decode itself (pci_enable_device).
+ */
+static int alpine_pcie_remove(struct udevice *dev)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(dev);
+	int f;
+
+	if (!priv->ok || !priv->link_up || !priv->decode_off)
+		return 0;
+	for (f = 0; f < 8; f++) {
+		pci_dev_t bdf = PCI_BDF(dev_seq(dev) + 1, 0, f);
+		ulong id, hdr;
+
+		if (pci_bus_read_config(dev, bdf, PCI_VENDOR_ID, &id, PCI_SIZE_16) ||
+		    id == 0xffff || !id) {
+			if (!f)
+				break;
+			continue;
+		}
+		pci_bus_write_config(dev, bdf, PCI_COMMAND, 0, PCI_SIZE_16);
+		if (!f && !pci_bus_read_config(dev, bdf, PCI_HEADER_TYPE, &hdr, PCI_SIZE_8) &&
+		    !(hdr & 0x80))
+			break;
+	}
+	return 0;
+}
+
+static const struct dm_pci_ops alpine_pcie_ops = {
+	.read_config	= alpine_pcie_read_config,
+	.write_config	= alpine_pcie_write_config,
+};
+
+static const struct udevice_id alpine_pcie_ids[] = {
+	{ .compatible = "amazon,al-alpine-v3-pcie" },
+	{ }
+};
+
+U_BOOT_DRIVER(pcie_alpine_v3) = {
+	.name		= "pcie_alpine_v3",
+	.id		= UCLASS_PCI,
+	.of_match	= alpine_pcie_ids,
+	.ops		= &alpine_pcie_ops,
+	.probe		= alpine_pcie_probe,
+	.remove		= alpine_pcie_remove,
+	.flags		= DM_FLAG_OS_PREPARE,
+	.priv_auto	= sizeof(struct alpine_pcie_priv),
+};
+
+#if IS_ENABLED(CONFIG_CMD_ALPINE_V3_PCIE)
+static struct udevice *alpine_pcie_find(int port, struct udevice *after)
+{
+	struct udevice *dev;
+	struct uclass *uc;
+	bool past = !after;
+
+	if (uclass_get(UCLASS_PCI, &uc))
+		return NULL;
+	uclass_foreach_dev(dev, uc) {
+		struct alpine_pcie_priv *priv;
+
+		if (dev->driver != DM_DRIVER_GET(pcie_alpine_v3))
+			continue;
+		if (!past) {
+			past = dev == after;
+			continue;
+		}
+		if (device_probe(dev))
+			continue;
+		priv = dev_get_priv(dev);
+		if (port < 0 || priv->port_id == port)
+			return dev;
+	}
+	return NULL;
+}
+
+static void alpine_pcie_show(struct udevice *dev)
+{
+	struct alpine_pcie_priv *priv = dev_get_priv(dev);
+	void __iomem *r = priv->regs;
+	struct al_pcie_link_status st;
+	ulong id = 0xffffffff, cmd = 0xffff;
+	unsigned int i;
+	bool en;
+
+	if (!priv->ok) {
+		printf("PCIe %d: %s: %s\n", priv->port_id, dev->name, priv->how);
+		return;
+	}
+	en = al_pcie_port_is_enabled(&priv->port);
+	al_pcie_link_status(&priv->port, &st);
+	printf("PCIe %d: %s, rev %d, root bus %d, init: %s, SErrors drained: %u\n",
+	       priv->port_id, dev->name, priv->port.rev_id, dev_seq(dev), priv->how,
+	       priv->serrors);
+	printf("  DT Gen%u x%u, SerDes main lanes", priv->gen, priv->lanes);
+	for (i = 0; i < priv->nsrd; i++)
+		printf(" %u", priv->srd[i]);
+	printf("; port %s, link %s %s x%d, LTSSM %#x\n", en ? "enabled" : "disabled",
+	       st.link_up ? "up" : "down", st.link_up ? speed_name(st.speed) : "-",
+	       st.lanes, st.ltssm_state);
+	printf("  AXI +0x00 %08x +0x14 %08x +0x18 %08x +0x20 %08x +0x30 %08x +0x34 %08x\n",
+	       readl(r), readl(r + 0x14), readl(r + 0x18), readl(r + 0x20),
+	       readl(r + 0x30), readl(r + 0x34));
+	if (en) {
+		printf("  RC %08x, class %08x, bus %06x, AMBA err %08x, iATU viewport %08x\n",
+		       readl(priv->dbi), readl(priv->dbi + 8),
+		       readl(priv->dbi + 0x18) & 0xffffff,
+		       readl(priv->dbi + DW_AMBA_ERR_RESP), readl(priv->dbi + DW_ATU_VIEWPORT));
+	}
+	if (st.link_up) {
+		pci_dev_t bdf = PCI_BDF(dev_seq(dev) + 1, 0, 0);
+
+		pci_bus_read_config(dev, bdf, PCI_VENDOR_ID, &id, PCI_SIZE_32);
+		pci_bus_read_config(dev, bdf, PCI_COMMAND, &cmd, PCI_SIZE_16);
+		printf("  link partner (bus %d): %04lx:%04lx, command %04lx\n", dev_seq(dev) + 1,
+		       id & 0xffff, id >> 16, cmd);
+	}
+}
+
+static int do_alpcie(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	int port = argc > 2 ? dectoul(argv[2], NULL) : -1;
+	const char *op = argc > 1 ? argv[1] : "status";
+	struct udevice *dev;
+	int ret;
+
+	dev = alpine_pcie_find(port, NULL);
+	if (!dev) {
+		printf("no Alpine external PCIe port%s\n", port < 0 ? "" : " with that id");
+		return CMD_RET_FAILURE;
+	}
+	if (!strcmp(op, "status")) {
+		for (; dev; dev = port < 0 ? alpine_pcie_find(-1, dev) : NULL)
+			alpine_pcie_show(dev);
+		return 0;
+	}
+	if (!strcmp(op, "reinit")) {
+		if (port < 0)
+			return CMD_RET_USAGE;
+		/*
+		 * Drop the enumeration below us, init from scratch, enumerate
+		 * again. The child devices must be unbound too: pci_auto numbers a
+		 * bridge's secondary bus as the highest bound bus seq + 1. On any
+		 * port but the last probed one that is a new, higher seq, so the
+		 * root port's bus registers no longer read 1 (U-Boot writes them
+		 * relative to the controller): fine for U-Boot, not a state to hand
+		 * to Linux (reset first, or PCIE_ALPINE_V3_FORCE_INIT for a boot).
+		 */
+		ret = device_remove(dev, DM_REMOVE_NORMAL);
+		if (!ret)
+			ret = device_chld_unbind(dev, NULL);
+		if (ret) {
+			printf("remove failed: %d\n", ret);
+			return CMD_RET_FAILURE;
+		}
+		alpine_pcie_force_init = true;
+		ret = device_probe(dev);
+		alpine_pcie_force_init = false;
+		if (ret) {
+			printf("probe failed: %d\n", ret);
+			return CMD_RET_FAILURE;
+		}
+		alpine_pcie_show(dev);
+		return strcmp(((struct alpine_pcie_priv *)dev_get_priv(dev))->how, "ours") ?
+			CMD_RET_FAILURE : 0;
+	}
+	return CMD_RET_USAGE;
+}
+
+U_BOOT_CMD(alpcie, 3, 0, do_alpcie,
+	   "Alpine V3 external PCIe root complex",
+	   "status [port]  - port, link and unit registers (read-only)\n"
+	   "alpcie reinit <port>  - stop the link, disable the port, run the full\n"
+	   "                        RC init and enumerate the bus again");
+#endif
diff --git a/drivers/pci/pcie_alpine_v3_serror.S b/drivers/pci/pcie_alpine_v3_serror.S
new file mode 100644
index 00000000..8438c215
--- /dev/null
+++ b/drivers/pci/pcie_alpine_v3_serror.S
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Alpine V3 external PCIe (a copy of the Alpine V2 driver's drain): with the AXI slave error response on (as the
+ * factory configures the port), a config read that ends in an error
+ * completion (CRS while the device is not ready, UR) is answered with
+ * SLVERR, which this core reports as an asynchronous SError. U-Boot's
+ * start.S routes SErrors to EL2 and unmasks them, so the driver masks
+ * PSTATE.A around each downstream access and calls this before unmasking.
+ *
+ * alpine_v3_serror_drain() does what the factory U-Boot does after every
+ * external config read (V2 2015.07: 0x0110cef8 / 0x011058ec): if ISR_EL1.A shows
+ * a pending SError, route it to EL2 (HCR_EL2.AMO), unmask it with a vector
+ * table whose SError entry just returns, wait until it has been taken,
+ * then put HCR_EL2, VBAR_EL2 and PSTATE.A (the caller's, i.e. masked) back. Returns 1 if an SError was
+ * drained, 0 if none was pending. EL2 only (returns 2 elsewhere, without
+ * touching anything).
+ */
+
+#include <linux/linkage.h>
+
+#define HCR_AMO		(1 << 5)
+#define ISR_A		(1 << 8)
+
+ENTRY(alpine_v3_serror_drain)
+	dsb	sy
+	isb
+	mrs	x0, isr_el1
+	tst	x0, #ISR_A
+	b.ne	1f
+	mov	x0, #0
+	ret
+1:	mrs	x0, CurrentEL
+	cmp	x0, #0x8
+	b.eq	2f
+	mov	x0, #2
+	ret
+2:	mrs	x1, vbar_el2
+	mrs	x2, hcr_el2
+	mrs	x3, daif
+	adr	x4, alpine_v3_serror_vectors
+	msr	vbar_el2, x4
+	orr	x5, x2, #HCR_AMO
+	msr	hcr_el2, x5
+	isb
+	msr	daifclr, #4			/* unmask SError: it is taken now */
+	isb
+	mov	x6, #0x100000			/* bounded wait */
+3:	mrs	x5, isr_el1
+	tst	x5, #ISR_A
+	b.eq	4f
+	subs	x6, x6, #1
+	b.ne	3b
+4:	msr	daif, x3
+	msr	hcr_el2, x2
+	msr	vbar_el2, x1
+	isb
+	mov	x0, #1
+	ret
+ENDPROC(alpine_v3_serror_drain)
+
+/*
+ * Only the SError entries matter; everything else goes to U-Boot's own
+ * vectors at the same offset, so an unexpected exception still reports.
+ */
+	.macro	pass, off
+	.align	7
+	b	vectors + \off
+	.endm
+
+	.align	11
+alpine_v3_serror_vectors:
+	pass	0x000
+	pass	0x080
+	pass	0x100
+	.align	7
+	eret				/* current EL, SP_EL0: SError */
+	pass	0x200
+	pass	0x280
+	pass	0x300
+	.align	7
+	eret				/* current EL, SP_ELx: SError */
+	pass	0x400
+	pass	0x480
+	pass	0x500
+	pass	0x580
+	pass	0x600
+	pass	0x680
+	pass	0x700
+	pass	0x780
