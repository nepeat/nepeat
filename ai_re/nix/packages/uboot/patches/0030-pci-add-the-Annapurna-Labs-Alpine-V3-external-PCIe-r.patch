+ * @param pcie_port pcie port handle
+ * @param enable memory shutdown enable or disable
+ *
+ */
+int al_pcie_port_memory_shutdown_set(
+	struct al_pcie_port	*pcie_port,
+	al_bool			enable);
+
+/**
+ * Check if port enabled or not
