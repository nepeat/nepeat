+# SPDX-License-Identifier: GPL-2.0+
+#
+# al_hal_*.c/h: Annapurna Labs' HAL (PCIe, PBS utilities, AVG SerDes lanes,
+# IOFIC, the Alpine V3 iomap), copied unmodified from the MikroTik GPL
+# Linux 5.6.3 source drop (drivers/soc/alpine/HAL, file_list.mk 3.4.0) and
+# built for Alpine V3 (AL_DEV_ID = ALPINE_V3: PCIe unit rev 4 only). The
+# Annapurna files are triple-licensed and used here under GPL-2.0; the
+# Amazon 2017 files carry no licence of their own and are distributed as
+# part of that GPL kernel source. A copy of its own, apart from the Alpine
+# V2 one in drivers/pci/al_pcie: other AL_DEV_ID, other files, and the V2
+# builds stay byte-identical. al_hal_plat_services.h, al_hal_plat_types.h
+# and al_sbus_shim.c are U-Boot shims (no SBus master firmware image is
+# built); al_init_pcie_v3_rc.c is ours.
+
+obj-y += al_init_pcie_v3_rc.o al_hal_pcie.o al_hal_pcie_reg_ptr_set_rev4.o
+obj-y += al_hal_pbs_utils.o al_hal_serdes_avg.o al_hal_serdes_avg_utils.o
+obj-y += al_hal_iofic.o al_sbus_shim.o
+
+ccflags-y += -I$(src) -DAL_DEV_ID_ALPINE_V1=0 -DAL_DEV_ID_ALPINE_V2=1 \
+	     -DAL_DEV_ID_ALPINE_V3=2 -DAL_DEV_ID_ALPINE_V4=3 \
+	     -DAL_DEV_ID=AL_DEV_ID_ALPINE_V3
+
+# Vendor code: keep it verbatim rather than warning-clean.
+CFLAGS_al_hal_pcie.o += -Wno-unused-function -Wno-unused-variable \
+			-Wno-unused-but-set-variable
+CFLAGS_al_hal_serdes_avg.o += -Wno-unused-function -Wno-unused-variable \
+			      -Wno-unused-but-set-variable
+CFLAGS_al_hal_iofic.o += -Wno-unused-function -Wno-unused-variable
