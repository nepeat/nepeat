+/*
+ * Make sure function @pdev (1c36:0001) carries board params and a MAC
+ * address before an OS sees it. Params already present are kept (the
+ * firmware's are authoritative); missing ones are written from the PCI
+ * device's DT node (phy-mode + fixed-link). MAC: env "ethaddr" if set,
+ * else the one already in the EC, else the board EEPROM. Prints what it
+ * found and did. Returns 0 when both are in place afterwards.
+ */
+int alpine_v2_eth_handoff_one(struct udevice *pdev, bool verbose);
+
+/* alpine_v2_eth_handoff_one() for every 1c36:0001 function. */
+int alpine_v2_eth_handoff(bool verbose);
+
+/*
+ * MAC base address from the ONIE TlvInfo EEPROM that the device's DT node
+ * names in "amazon,mac-eeprom" (TLV 0x24, CRC checked). 0 or -errno.
+ */
+int alpine_v2_eth_eeprom_mac(struct udevice *pdev, unsigned char mac[6]);
+#endif
