+# SPDX-License-Identifier: GPL-2.0+
+#
+# al_eth.c is the U-Boot driver; al_hal_plat_services.h and al_hal_plat_types.h
+# are U-Boot shims. The other al_hal_*.c/h files are Annapurna Labs' HAL,
+# unmodified from the al_eth Linux driver (QNAP GPL drop; Annapurna's triple
+# licence, used here under the GPL-2.0 option). They are not in this patch:
+# the ai_re build copies them in from packages/al-eth/src (series.nix, vendor).
+
+obj-y += al_eth.o
+obj-y += al_hal_eth_main.o al_hal_udma_main.o al_hal_udma_config.o
+obj-y += al_hal_iofic.o al_hal_udma_iofic.o
+
+# Vendor code: keep it verbatim rather than warning-clean.
