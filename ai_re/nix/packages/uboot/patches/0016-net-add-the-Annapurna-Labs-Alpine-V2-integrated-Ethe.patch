+	reg &= ~UDMA_AXI_S2M_COMP_WR_CFG_2_AWQOS_MASK;
+	reg |= (s2m_sm->qos << UDMA_AXI_S2M_COMP_WR_CFG_2_AWQOS_SHIFT) &
