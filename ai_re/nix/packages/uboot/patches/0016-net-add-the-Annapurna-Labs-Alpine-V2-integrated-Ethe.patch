+/**** out_cfg register ****/
+/*
+ * Number of MetaData at the end of the packet
+ * 1 - One MetaData beat
+ * 2 - Two MetaData beats
+ * 0/3 - N/A
+ */
+#define EC_RFW_OUT_CFG_META_CNT_MASK     0x00000003
+#define EC_RFW_OUT_CFG_META_CNT_SHIFT    0
