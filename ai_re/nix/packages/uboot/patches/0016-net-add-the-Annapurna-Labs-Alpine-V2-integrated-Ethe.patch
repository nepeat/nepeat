+/**
+ * Configure crc_chksum_replace_cmd_table
+ *
+ * @param adapter pointer to the private structure
+ * @param entries pointer to the private replace cmd table
+ * @param num_entries number of the table entries
+ *
+ */
+int al_eth_tx_crc_chksum_replace_cmd_init_ex(struct al_hal_eth_adapter *adapter,
+			struct al_eth_tx_crc_chksum_replace_cmd_for_protocol_num_entry *entries,
+			unsigned int num_entries);
+
+/**
+ * Configure default tx_gcp_table and regs
+ *
+ * @param adapter pointer to the private structure
+ *
+ */
+int al_eth_tx_generic_crc_table_init(struct al_hal_eth_adapter *adapter);
+
+/**
+ * Configure user tx_gcp_table and regs
+ *
+ * @param adapter pointer to the private structure
+ * @param entries pointer to the tx gcp table
+ * @param num_entries number of the table entries
+ *
+ */
+int al_eth_tx_generic_crc_table_init_ex(struct al_hal_eth_adapter *adapter,
+					struct al_eth_tx_gcp_table_entry *entries,
+					unsigned int num_entries);
+
+/**
+ * Configure default rx_gpd_table and regs
+ *
+ * @param adapter pointer to the private structure
+ *
+ */
+int al_eth_rx_protocol_detect_table_init(struct al_hal_eth_adapter *adapter);
+
+/**
+ * Configure user rx_gpd_table and regs
+ *
+ * @param adapter pointer to the private structure
+ * @param entries pointer to the rx_gpd_table
+ * @param num_entries number of the table entries
+ *
+ */
+int al_eth_rx_protocol_detect_table_init_ex(struct al_hal_eth_adapter *adapter,
+					    struct al_eth_rx_gpd_cam_entry *entries,
+					    unsigned int num_entries);
+
+/**
+ * Configure default rx_gcp_table and regs
+ *
+ * @param adapter pointer to the private structure
+ *
+ */
+int al_eth_rx_generic_crc_table_init(struct al_hal_eth_adapter *adapter);
+
+/**
+ * Configure user rx_gcp_table and regs
+ *
+ * @param adapter pointer to the private structure
+ * @param entries pointer to the rx_gcp_table
+ * @param num_entries number of the table entries
+ *
+ */
+int al_eth_rx_generic_crc_table_init_ex(struct al_hal_eth_adapter *adapter,
+					struct al_eth_rx_gcp_table_entry *entries,
+					unsigned int num_entries);
+
+/**
+ * Enable/Disable rx_gcp_table
+ *
+ * @param adapter pointer to the private structure
+ * @param enable true to enable the table. false to disable the table.
+ *
+ */
+void al_eth_rx_generic_crc_table_enable(struct al_hal_eth_adapter *adapter, al_bool enable);
+
+/* Ethernet Unit info of register base address */
+struct al_eth_unit_regs_info {
+	/* UDMA register base address */
+	void __iomem *udma_regs_base;
+	/* MAC register base address */
+	void __iomem *mac_regs_base;
+	/* EC register base address */
+	void __iomem *ec_regs_base;
+};
+
+void al_eth_unit_regs_info_get(void *bars[6],
+			       unsigned int dev_id,
+			       unsigned int rev_id,
+			       struct al_eth_unit_regs_info *unit_info);
+
+/**
+ * Get EC error interrupts iofic masks
+ *
+ * @param eth_rev_id ethernet revision ID
+ * @param ec_a_mask pointer to EC group A mask
+ * @param ec_b_mask pointer to EC group B mask
+ * @param ec_c_mask pointer to EC group C mask
+ * @param ec_d_mask pointer to EC group D mask
+ *
+ */
+void al_eth_ec_error_ints_masks_get(unsigned int eth_rev_id,
+				    uint32_t *ec_a_mask,
+				    uint32_t *ec_b_mask,
+				    uint32_t *ec_c_mask,
+				    uint32_t *ec_d_mask);
+
+/**
+ * Get MAC error interrupts iofic masks
+ *
+ * @param eth_rev_id ethernet revision ID
+ * @param mac_a_mask pointer to MAC group A mask
+ * @param mac_b_mask pointer to MAC group B mask
+ * @param mac_c_mask pointer to MAC group C mask
+ * @param mac_d_mask pointer to MAC group D mask
+ *
+ */
+void al_eth_mac_error_ints_masks_get(unsigned int eth_rev_id,
+				     uint32_t *mac_a_mask,
+				     uint32_t *mac_b_mask,
+				     uint32_t *mac_c_mask,
+				     uint32_t *mac_d_mask);
+
+#ifdef __cplusplus
+}
+#endif
+/* *INDENT-ON* */
+#endif		/* __AL_HAL_ETH_H__ */
+/** @} end of Ethernet group */
