+#define AL_ETH_RX_FLAGS_TGTID_MASK	AL_FIELD_MASK(15, 0)
+#define AL_ETH_RX_FLAGS_NO_SNOOP	AL_M2S_DESC_NO_SNOOP_H
+#define AL_ETH_RX_FLAGS_INT		AL_M2S_DESC_INT_EN
