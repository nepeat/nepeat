+ *    0 - Select default
+ *    1 - Select hash output
+ */
+#define EC_RFW_FSM_TABLE_DATA_VAL_MASK   0x00000007
+#define EC_RFW_FSM_TABLE_DATA_VAL_SHIFT  0
