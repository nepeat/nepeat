+		/* RX_SECTION_EMPTY,  */
+		al_reg_write32(&adapter->mac_regs_base->mac_1g.rx_section_empty, 0x00000000);
+		/* RX_SECTION_FULL,  */
+		al_reg_write32(&adapter->mac_regs_base->mac_1g.rx_section_full, 0x0000000c); /* must be larger than almost empty */
