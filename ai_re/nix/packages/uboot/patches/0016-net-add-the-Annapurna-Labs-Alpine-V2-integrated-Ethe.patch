diff --git a/drivers/net/al_eth/al_eth.c b/drivers/net/al_eth/al_eth.c
new file mode 100644
index 00000000..a5e5d3db
--- /dev/null
+++ b/drivers/net/al_eth/al_eth.c
@@ -0,0 +1,688 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Annapurna Labs Alpine V2 integrated Ethernet (PCI 1c36:0001), U-Boot
+ * driver on the vendor HAL (al_hal_*.c next to this file, verbatim).
+ *
+ * Scope: one port in a 1G MAC mode with no MDIO PHY (RGMII or SGMII, a
+ * fixed link as the board params describe it): no SerDes, no link
+ * management, no interrupts. One TX and one RX queue on UDMA 0, polled.
+ *
+ * The sequence follows the Linux al_eth driver (the one proven on these
+ * boards): probe-time cleanup = MAC stop, all queues reset, UDMA disable,
+ * FLR with board params and MAC kept across it; then adapter init, MAC
+ * config + link config from the board params, queue config, RX
+ * forwarding (unicast to our MAC + broadcast, drop the rest), RX
+ * buffers, MAC start. stop() and remove() (before Linux) undo it the same
+ * way, so the OS finds an idle function that still has its board params
+ * and MAC (see include/alpine_v2_eth.h).
+ *
+ * DMA: descriptor rings and buffers are ordinary cached memory with
+ * explicit cache maintenance (whether the I/O fabric snoops is not
+ * assumed). TX completions come from the queue's completion head register
+ * (no TX completion ring), RX completions from a completion ring.
+ */
+
+#include <alpine_v2_eth.h>
+#include <cpu_func.h>
+#include <dm.h>
+#include <log.h>
+#include <malloc.h>
+#include <memalign.h>
+#include <net.h>
+#include <pci.h>
+#include <time.h>
+#include <asm/cache.h>
+#include <asm/io.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+
+#include "al_hal_eth.h"
+#include "al_hal_unit_adapter_regs.h"
+
+int al_eth_hal_failed;
+
+#define AL_ETH_TX_DESCS		32
+#define AL_ETH_RX_DESCS		64
+#define AL_ETH_RX_BUFS		(AL_ETH_RX_DESCS - 1)
+#define AL_ETH_BUF_LEN		1536	/* RX buffer and TX bounce buffer */
+#define AL_ETH_MAX_FRAME	1522	/* 1500 MTU + header + FCS + one VLAN tag */
+#define AL_ETH_TX_TIMEOUT_US	100000
+#define AL_ETH_MAC_DROP_IDX	(AL_ETH_FWD_MAC_NUM - 1)
+#define AL_ETH_MAC_BCAST_IDX	(AL_ETH_FWD_MAC_NUM - 2)
+#define AL_ETH_MAC_UCAST_IDX	0	/* also the MAC handed to Linux */
+
+struct al_eth_priv {
+	struct udevice *pdev;
+	void __iomem *udma_base;	/* BAR 0 */
+	void __iomem *mac_base;		/* BAR 2 */
+	void __iomem *ec_base;		/* BAR 4 */
+	u8 rev_id;
+	char name[16];
+
+	enum al_eth_mac_mode mac_mode;
+	al_bool force_1000_base_x;
+	al_bool autoneg;
+	unsigned int speed;
+	al_bool full_duplex;
+
+	struct al_hal_eth_adapter hal;
+	struct al_udma_q *txq, *rxq;
+	bool running;		/* queues configured, MAC started */
+	bool dirty;		/* function used since the last FLR */
+
+	union al_udma_desc *tx_ring;
+	union al_udma_desc *rx_ring;
+	u8 *rx_cring;
+	u8 *rx_bufs;		/* AL_ETH_RX_BUFS x AL_ETH_BUF_LEN */
+	u8 *tx_buf;
+	unsigned int rx_next;	/* buffer the next completion lands in */
+	bool rx_held;		/* recv() handed out rx_bufs[rx_next] */
+
+	unsigned int tx_timeouts, rx_errors, rx_multi;
+};
+
+#define RING_BYTES(n, sz)	ALIGN((n) * (sz), ARCH_DMA_MINALIGN)
+
+static void dma_flush(const void *p, size_t len)
+{
+	ulong s = (ulong)p & ~(ulong)(ARCH_DMA_MINALIGN - 1);
+
+	flush_dcache_range(s, ALIGN((ulong)p + len, ARCH_DMA_MINALIGN));
+}
+
+static void dma_inval(const void *p, size_t len)
+{
+	/* Only ever called on ARCH_DMA_MINALIGN-aligned, padded areas. */
+	invalidate_dcache_range((ulong)p, ALIGN((ulong)p + len, ARCH_DMA_MINALIGN));
+}
+
+static u8 *rx_buf(struct al_eth_priv *priv, unsigned int i)
+{
+	return priv->rx_bufs + i * AL_ETH_BUF_LEN;
+}
+
+static bool hal_ok(struct al_eth_priv *priv, const char *where)
+{
+	if (!al_eth_hal_failed)
+		return true;
+	printf("%s: HAL assertion during %s; refusing to touch the DMA until the next start\n",
+	       priv->name, where);
+	return false;
+}
+
+/* PCI config accessors for al_eth_flr_rmn() */
+static int cfg_read(void *handle, int where, u32 *val)
+{
+	return dm_pci_read_config32(handle, where, val);
+}
+
+static int cfg_write(void *handle, int where, u32 val)
+{
+	return dm_pci_write_config32(handle, where, val);
+}
+
+/*
+ * FLR as the Linux driver's al_eth_function_reset(): the reset clears the
+ * board params and MAC, so keep them across it, then re-enable decode.
+ */
+static int al_eth_function_reset(struct al_eth_priv *priv)
+{
+	u32 p1, p2, p3, lo, hi;
+	u16 cmd;
+	int ret;
+
+	p1 = readl(priv->mac_base + ALPINE_V2_ETH_PARAMS1);
+	p2 = readl(priv->mac_base + ALPINE_V2_ETH_PARAMS2);
+	p3 = readl(priv->mac_base + ALPINE_V2_ETH_PARAMS3);
+	lo = readl(priv->ec_base + ALPINE_V2_ETH_FWD_MAC0_L);
+	hi = readl(priv->ec_base + ALPINE_V2_ETH_FWD_MAC0_H);
+
+	ret = al_eth_flr_rmn(cfg_read, cfg_write, priv->pdev, priv->mac_base);
+
+	writel(p1, priv->mac_base + ALPINE_V2_ETH_PARAMS1);
+	writel(p2, priv->mac_base + ALPINE_V2_ETH_PARAMS2);
+	writel(p3, priv->mac_base + ALPINE_V2_ETH_PARAMS3);
+	writel(lo, priv->ec_base + ALPINE_V2_ETH_FWD_MAC0_L);
+	writel(hi, priv->ec_base + ALPINE_V2_ETH_FWD_MAC0_H);
+
+	dm_pci_read_config16(priv->pdev, PCI_COMMAND, &cmd);
+	dm_pci_write_config16(priv->pdev, PCI_COMMAND,
+			      cmd | PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER);
+
+	if (readl(priv->mac_base + ALPINE_V2_ETH_PARAMS1) != p1) {
+		printf("%s: board params lost across FLR\n", priv->name);
+		return -EIO;
+	}
+	priv->dirty = false;
+
+	return ret;
+}
+
+/*
+ * Quiesce whatever ran on the function before (the vendor U-Boot, or our
+ * own start()), as Linux does at probe and in al_eth_hw_stop(): MAC off,
+ * every queue of both UDMAs reset, UDMAs disabled, then FLR.
+ */
+static int al_eth_quiesce(struct al_eth_priv *priv)
+{
+	struct al_hal_eth_adapter *hal = &priv->hal;
+	struct al_udma_params up = { .udma_regs_base = priv->udma_base };
+	int i, ret;
+
+	memset(hal, 0, sizeof(*hal));
+	hal->name = priv->name;
+	hal->rev_id = priv->rev_id;
+	hal->udma_regs_base = priv->udma_base;
+	hal->ec_regs_base = priv->ec_base;
+	hal->mac_regs_base = priv->mac_base;
+	hal->unit_regs = priv->udma_base;
+	hal->mac_mode = priv->mac_mode;
+
+	up.type = UDMA_TX;
+	up.num_of_queues = AL_ETH_UDMA_TX_QUEUES;
+	up.name = "eth tx";
+	al_udma_init(&hal->tx_udma, &up);
+	up.type = UDMA_RX;
+	up.num_of_queues = AL_ETH_UDMA_RX_QUEUES;
+	up.name = "eth rx";
+	al_udma_init(&hal->rx_udma, &up);
+	for (i = 0; i < AL_ETH_UDMA_TX_QUEUES; i++) {
+		struct al_udma_q *q = &hal->tx_udma.udma_q[i];
+
+		q->q_regs = (union udma_q_regs __iomem *)&hal->tx_udma.udma_regs->m2s.m2s_q[i];
+		q->qid = i;
+		q->udma = &hal->tx_udma;
+	}
+	for (i = 0; i < AL_ETH_UDMA_RX_QUEUES; i++) {
+		struct al_udma_q *q = &hal->rx_udma.udma_q[i];
+
+		q->q_regs = (union udma_q_regs __iomem *)&hal->rx_udma.udma_regs->s2m.s2m_q[i];
+		q->qid = i;
+		q->udma = &hal->rx_udma;
+	}
+
+	al_eth_mac_stop(hal);
+	/* Let frames in the MAC FIFO (~10 KiB) drain into memory. */
+	udelay(100);
+	for (i = 0; i < AL_ETH_UDMA_TX_QUEUES; i++)
+		if (al_udma_q_reset(&hal->tx_udma.udma_q[i]))
+			printf("%s: TX queue %d reset timed out\n", priv->name, i);
+	for (i = 0; i < AL_ETH_UDMA_RX_QUEUES; i++)
+		if (al_udma_q_reset(&hal->rx_udma.udma_q[i]))
+			printf("%s: RX queue %d reset timed out\n", priv->name, i);
+	if (al_eth_adapter_stop(hal))
+		printf("%s: UDMA did not go idle\n", priv->name);
+	priv->running = false;
+
+	ret = al_eth_function_reset(priv);
+	al_eth_hal_failed = 0;
+
+	return ret;
+}
+
+static void al_eth_mac_entry(struct al_eth_priv *priv, int idx, const u8 *addr,
+			     const u8 *mask, u8 udma_mask, al_bool filter)
+{
+	struct al_eth_fwd_mac_table_entry e = {
+		.rx_valid = AL_TRUE,
+		.tx_valid = AL_FALSE,
+		.udma_mask = udma_mask,
+		.qid = 0,
+		.filter = filter,
+	};
+
+	memcpy(e.addr, addr, 6);
+	memcpy(e.mask, mask, 6);
+	al_eth_fwd_mac_table_set(&priv->hal, idx, &e);
+}
+
+/* As Linux al_eth_config_rx_fwd(), for one queue: */
+static void al_eth_rx_fwd_config(struct al_eth_priv *priv, const u8 *mac)
+{
+	static const u8 zero[6], ones[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	struct al_eth_fwd_ctrl_table_entry entry = {
+		.prio_sel = AL_ETH_CTRL_TABLE_PRIO_SEL_VAL_0,
+		.queue_sel_1 = AL_ETH_CTRL_TABLE_QUEUE_SEL_1_THASH_TABLE,
+		.queue_sel_2 = AL_ETH_CTRL_TABLE_QUEUE_SEL_2_NO_PRIO,
+		.udma_sel = AL_ETH_CTRL_TABLE_UDMA_SEL_MAC_TABLE,
+		.filter = AL_FALSE,
+	};
+
+	/* UDMA from the MAC table, queue from the THASH table (all queue 0). */
+	al_eth_ctrl_table_def_set(&priv->hal, AL_FALSE, &entry);
+	al_eth_mac_entry(priv, AL_ETH_MAC_UCAST_IDX, mac, ones, BIT(0), AL_FALSE);
+	al_eth_mac_entry(priv, AL_ETH_MAC_BCAST_IDX, ones, ones, BIT(0), AL_FALSE);
+	al_eth_mac_entry(priv, AL_ETH_MAC_DROP_IDX, zero, zero, 0, AL_TRUE);
+}
+
+static int al_eth_rx_post(struct al_eth_priv *priv, unsigned int i)
+{
+	struct al_buf buf = {
+		.addr = virt_to_phys(rx_buf(priv, i)),
+		.len = AL_ETH_BUF_LEN,
+	};
+	int ret;
+
+	/* No dirty line may land on top of what the DMA writes. */
+	dma_inval(rx_buf(priv, i), AL_ETH_BUF_LEN);
+	ret = al_eth_rx_buffer_add(priv->rxq, &buf, AL_ETH_RX_FLAGS_INT, NULL);
+	if (ret)
+		printf("%s: no free RX descriptor (%d)\n", priv->name, ret);
+
+	return ret;
+}
+
+static int al_eth_start(struct udevice *dev)
+{
+	struct al_eth_priv *priv = dev_get_priv(dev);
+	struct eth_pdata *pdata = dev_get_plat(dev);
+	struct al_eth_adapter_params ap = {
+		.rev_id = priv->rev_id,
+		.udma_id = 0,
+		.enable_rx_parser = 1,
+		.udma_regs_base = priv->udma_base,
+		.ec_regs_base = priv->ec_base,
+		.mac_regs_base = priv->mac_base,
+		.name = priv->name,
+	};
+	struct al_udma_q_params tq = {
+		.size = AL_ETH_TX_DESCS,
+		.desc_base = priv->tx_ring,
+		.desc_phy_base = virt_to_phys(priv->tx_ring),
+		.cdesc_base = NULL,	/* completions from the head register */
+		.cdesc_size = 8,
+	};
+	struct al_udma_q_params rq = {
+		.size = AL_ETH_RX_DESCS,
+		.desc_base = priv->rx_ring,
+		.desc_phy_base = virt_to_phys(priv->rx_ring),
+		.cdesc_base = priv->rx_cring,
+		.cdesc_phy_base = virt_to_phys(priv->rx_cring),
+		.cdesc_size = 16,
+	};
+	struct al_eth_link_status ls = { 0 };
+	unsigned int i;
+	int ret;
+
+	/* Always from a clean function: the last user may have left it running. */
+	ret = al_eth_quiesce(priv);
+	if (ret) {
+		printf("%s: function reset failed (%d)\n", priv->name, ret);
+		return ret;
+	}
+	priv->dirty = true;
+
+	memset(&priv->hal, 0, sizeof(priv->hal));
+	ret = al_eth_adapter_init(&priv->hal, &ap);
+	if (ret) {
+		printf("%s: adapter init failed (%d)\n", priv->name, ret);
+		goto fail;
+	}
+	ret = al_eth_mac_config(&priv->hal, priv->mac_mode);
+	if (ret) {
+		printf("%s: MAC config failed (%d)\n", priv->name, ret);
+		goto fail;
+	}
+	ret = al_eth_mac_link_config(&priv->hal, priv->force_1000_base_x,
+				     priv->autoneg, priv->speed, priv->full_duplex);
+	if (ret) {
+		printf("%s: link config %uM failed (%d)\n", priv->name, priv->speed, ret);
+		goto fail;
+	}
+
+	memset(priv->tx_ring, 0, RING_BYTES(AL_ETH_TX_DESCS, sizeof(union al_udma_desc)));
+	memset(priv->rx_ring, 0, RING_BYTES(AL_ETH_RX_DESCS, sizeof(union al_udma_desc)));
+	memset(priv->rx_cring, 0, RING_BYTES(AL_ETH_RX_DESCS, 16));
+	dma_flush(priv->tx_ring, RING_BYTES(AL_ETH_TX_DESCS, sizeof(union al_udma_desc)));
+	dma_flush(priv->rx_ring, RING_BYTES(AL_ETH_RX_DESCS, sizeof(union al_udma_desc)));
+	dma_flush(priv->rx_cring, RING_BYTES(AL_ETH_RX_DESCS, 16));
+
+	ret = al_eth_queue_config(&priv->hal, UDMA_TX, 0, &tq);
+	if (!ret)
+		ret = al_eth_queue_config(&priv->hal, UDMA_RX, 0, &rq);
+	if (ret) {
+		printf("%s: queue config failed (%d)\n", priv->name, ret);
+		goto fail;
+	}
+	al_udma_q_handle_get(&priv->hal.tx_udma, 0, &priv->txq);
+	al_udma_q_handle_get(&priv->hal.rx_udma, 0, &priv->rxq);
+
+	al_eth_rx_pkt_limit_config(&priv->hal, AL_ETH_MIN_FRAME_LEN, AL_ETH_MAX_FRAME);
+	al_eth_rx_fwd_config(priv, pdata->enetaddr);
+
+	for (i = 0; i < AL_ETH_RX_BUFS; i++) {
+		ret = al_eth_rx_post(priv, i);
+		if (ret)
+			goto fail;
+	}
+	dma_flush(priv->rx_ring, RING_BYTES(AL_ETH_RX_DESCS, sizeof(union al_udma_desc)));
+	al_eth_rx_buffer_action(priv->rxq, AL_ETH_RX_BUFS);
+	priv->rx_next = 0;
+	priv->rx_held = false;
+
+	if (!hal_ok(priv, "start")) {
+		ret = -EIO;
+		goto fail;
+	}
+	al_eth_mac_start(&priv->hal);
+	priv->running = true;
+
+	/*
+	 * Report the MAC's link bit, but do not gate on it: on a fixed link
+	 * whether it follows the far end is board-dependent (the Linux driver
+	 * just turns the carrier on for these ports).
+	 */
+	al_eth_link_status_get(&priv->hal, &ls);
+	printf("%s: %s %uM %s, link bit %s\n", priv->name,
+	       priv->mac_mode == AL_ETH_MAC_MODE_RGMII ? "RGMII" : "SGMII",
+	       priv->speed, priv->full_duplex ? "full" : "half",
+	       ls.link_up ? "up" : "down (not trusted on a fixed link)");
+
+	return 0;
+
+fail:
+	al_eth_quiesce(priv);
+	return ret ? ret : -EIO;
+}
+
+static int al_eth_send(struct udevice *dev, void *packet, int length)
+{
+	struct al_eth_priv *priv = dev_get_priv(dev);
+	struct al_eth_pkt pkt;
+	unsigned long start;
+	int descs, done = 0;
+
+	if (!priv->running || !hal_ok(priv, "send"))
+		return -ENETDOWN;
+	if (length > AL_ETH_BUF_LEN)
+		return -EMSGSIZE;
+
+	/* Bounce: any alignment in, zero-padded to the minimum frame out. */
+	memcpy(priv->tx_buf, packet, length);
+	if (length < AL_ETH_MIN_FRAME_LEN) {
+		memset(priv->tx_buf + length, 0, AL_ETH_MIN_FRAME_LEN - length);
+		length = AL_ETH_MIN_FRAME_LEN;
+	}
+	dma_flush(priv->tx_buf, length);
+
+	memset(&pkt, 0, sizeof(pkt));
+	pkt.num_of_bufs = 1;
+	pkt.bufs[0].addr = virt_to_phys(priv->tx_buf);
+	pkt.bufs[0].len = length;
+	descs = al_eth_tx_pkt_prepare(priv->txq, &pkt);
+	if (!descs) {
+		printf("%s: TX ring full\n", priv->name);
+		return -ENOBUFS;
+	}
+	dma_flush(priv->tx_ring, RING_BYTES(AL_ETH_TX_DESCS, sizeof(union al_udma_desc)));
+	al_eth_tx_dma_action(priv->txq, descs);
+
+	start = timer_get_us();
+	while (done < descs) {
+		done += al_eth_comp_tx_get(priv->txq);
+		if (done >= descs)
+			break;
+		if (timer_get_us() - start > AL_ETH_TX_TIMEOUT_US) {
+			/*
+			 * The queue's state is unknown now: stop using it
+			 * until the next start() resets the function.
+			 */
+			priv->tx_timeouts++;
+			priv->running = false;
+			printf("%s: TX timeout (%d of %d descriptors done); port stopped until the next network command\n",
+			       priv->name, done, descs);
+			return -ETIMEDOUT;
+		}
+		udelay(1);
+	}
+
+	return hal_ok(priv, "send") ? 0 : -EIO;
+}
+
+static int al_eth_recv(struct udevice *dev, int flags, uchar **packetp)
+{
+	struct al_eth_priv *priv = dev_get_priv(dev);
+	struct al_eth_pkt pkt;
+	unsigned int n, i, len;
+
+	if (!priv->running || priv->rx_held || !hal_ok(priv, "recv"))
+		return -EAGAIN;
+
+	dma_inval(priv->rx_cring, RING_BYTES(AL_ETH_RX_DESCS, 16));
+	memset(&pkt, 0, sizeof(pkt));
+	n = al_eth_pkt_rx(priv->rxq, &pkt);
+	if (!n)
+		return -EAGAIN;
+
+	/* As Linux al_eth: L2 error (FCS, length) or UDMA completion error. */
+	if (n != 1 || (pkt.flags & (AL_ETH_RX_ERROR | AL_UDMA_CDESC_ERROR)) ||
+	    !pkt.bufs[0].len ||
+	    pkt.bufs[0].len > AL_ETH_BUF_LEN) {
+		/* Drop: hand the buffers straight back, in ring order. */
+		if (n != 1)
+			priv->rx_multi++;
+		else
+			priv->rx_errors++;
+		debug("%s: drop rx (%u descs, flags %08x, len %u)\n", priv->name,
+		      n, pkt.flags, pkt.bufs[0].len);
+		for (i = 0; i < n; i++) {
+			al_eth_rx_post(priv, priv->rx_next);
+			priv->rx_next = (priv->rx_next + 1) % AL_ETH_RX_BUFS;
+		}
+		dma_flush(priv->rx_ring, RING_BYTES(AL_ETH_RX_DESCS, sizeof(union al_udma_desc)));
+		al_eth_rx_buffer_action(priv->rxq, n);
+		return -EAGAIN;
+	}
+
+	len = pkt.bufs[0].len;
+	dma_inval(rx_buf(priv, priv->rx_next), AL_ETH_BUF_LEN);
+	*packetp = rx_buf(priv, priv->rx_next);
+	priv->rx_held = true;
+
+	return len;
+}
+
+static int al_eth_free_pkt(struct udevice *dev, uchar *packet, int length)
+{
+	struct al_eth_priv *priv = dev_get_priv(dev);
+
+	if (!priv->running || !priv->rx_held)
+		return 0;
+	if (packet != rx_buf(priv, priv->rx_next))
+		printf("%s: free_pkt of an unexpected buffer\n", priv->name);
+
+	priv->rx_held = false;
+	if (al_eth_rx_post(priv, priv->rx_next))
+		return -EIO;
+	priv->rx_next = (priv->rx_next + 1) % AL_ETH_RX_BUFS;
+	dma_flush(priv->rx_ring, RING_BYTES(AL_ETH_RX_DESCS, sizeof(union al_udma_desc)));
+	al_eth_rx_buffer_action(priv->rxq, 1);
+
+	return 0;
+}
+
+static void al_eth_stop(struct udevice *dev)
+{
+	struct al_eth_priv *priv = dev_get_priv(dev);
+
+	if (!priv->dirty)
+		return;
+	al_eth_quiesce(priv);
+	if (priv->tx_timeouts || priv->rx_errors || priv->rx_multi)
+		printf("%s: stopped; %u TX timeouts, %u RX errors, %u multi-buffer RX dropped\n",
+		       priv->name, priv->tx_timeouts, priv->rx_errors, priv->rx_multi);
+}
+
+/* MAC entry 0: our RX filter and what Linux al_eth reads as its address. */
+static int al_eth_write_hwaddr(struct udevice *dev)
+{
+	struct al_eth_priv *priv = dev_get_priv(dev);
+	struct eth_pdata *pdata = dev_get_plat(dev);
+	unsigned int lo, hi;
+
+	alpine_v2_eth_mac_encode(pdata->enetaddr, &lo, &hi);
+	writel(lo, priv->ec_base + ALPINE_V2_ETH_FWD_MAC0_L);
+	writel(hi, priv->ec_base + ALPINE_V2_ETH_FWD_MAC0_H);
+
+	return 0;
+}
+
+/* "ROM" = what the handoff left in MAC entry 0 (firmware, env or EEPROM). */
+static int al_eth_read_rom_hwaddr(struct udevice *dev)
+{
+	struct al_eth_priv *priv = dev_get_priv(dev);
+	struct eth_pdata *pdata = dev_get_plat(dev);
+
+	alpine_v2_eth_mac_decode(readl(priv->ec_base + ALPINE_V2_ETH_FWD_MAC0_L),
+				 readl(priv->ec_base + ALPINE_V2_ETH_FWD_MAC0_H),
+				 pdata->enetaddr);
+
+	return is_valid_ethaddr(pdata->enetaddr) ? 0 : -ENOENT;
+}
+
+static void __iomem *al_eth_bar(struct udevice *dev, int bar, size_t len)
+{
+	u32 lo, hi = 0;
+
+	dm_pci_read_config32(dev, bar, &lo);
+	if ((lo & PCI_BASE_ADDRESS_MEM_TYPE_MASK) == PCI_BASE_ADDRESS_MEM_TYPE_64)
+		dm_pci_read_config32(dev, bar + 4, &hi);
+	if ((lo & PCI_BASE_ADDRESS_SPACE_IO) || hi || !(lo & PCI_BASE_ADDRESS_MEM_MASK)) {
+		printf("al_eth: BAR at %#x unusable (%08x %08x)\n", bar, hi, lo);
+		return NULL;
+	}
+
+	return dm_pci_map_bar(dev, bar, 0, len, PCI_REGION_TYPE, PCI_REGION_MEM);
+}
+
+/*
+ * Probe touches nothing that moves data: map, check the board params
+ * (handoff writes missing ones), allocate. The function is quiesced on
+ * first start(), so a fault in the data path never gets in the way of a
+ * disk boot.
+ */
+static int al_eth_probe(struct udevice *dev)
+{
+	struct al_eth_priv *priv = dev_get_priv(dev);
+	struct al_eth_board_params bp;
+	u16 vendor, device, cmd;
+	u8 rev;
+	int ret;
+
+	priv->pdev = dev;
+	snprintf(priv->name, sizeof(priv->name), "%s", dev->name);
+	dm_pci_read_config16(dev, PCI_VENDOR_ID, &vendor);
+	dm_pci_read_config16(dev, PCI_DEVICE_ID, &device);
+	dm_pci_read_config8(dev, PCI_REVISION_ID, &rev);
+	if (rev != AL_ETH_REV_ID_2) {
+		/* Alpine V2 "basic" Ethernet only: the one this was checked against. */
+		printf("%s: %04x:%04x revision %u not supported (want 2)\n",
+		       priv->name, vendor, device, rev);
+		return -ENODEV;
+	}
+	priv->rev_id = rev;
+
+	priv->udma_base = al_eth_bar(dev, PCI_BASE_ADDRESS_0, SZ_128K);
+	priv->mac_base = al_eth_bar(dev, PCI_BASE_ADDRESS_2, SZ_4K);
+	priv->ec_base = al_eth_bar(dev, PCI_BASE_ADDRESS_4, SZ_16K);
+	if (!priv->udma_base || !priv->mac_base || !priv->ec_base)
+		return -ENXIO;
+	dm_pci_read_config16(dev, PCI_COMMAND, &cmd);
+	dm_pci_write_config16(dev, PCI_COMMAND, cmd | PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER);
+
+	/* Board params + MAC as Linux will want them; then use the same. */
+	alpine_v2_eth_handoff_one(dev, false);
+	ret = al_eth_board_params_get(priv->mac_base, &bp);
+	if (ret) {
+		printf("%s: no board params: not usable (see the al_eth lines above)\n",
+		       priv->name);
+		return -ENODEV;
+	}
+	switch (bp.media_type) {
+	case AL_ETH_BOARD_MEDIA_TYPE_RGMII:
+		priv->mac_mode = bp.sfp_plus_module_exist ? AL_ETH_MAC_MODE_SGMII :
+							   AL_ETH_MAC_MODE_RGMII;
+		break;
+	case AL_ETH_BOARD_MEDIA_TYPE_SGMII:
+		priv->mac_mode = AL_ETH_MAC_MODE_SGMII;
+		break;
+	default:
+		printf("%s: board params media %u not supported (RGMII/SGMII only)\n",
+		       priv->name, bp.media_type);
+		return -ENODEV;
+	}
+	if (bp.phy_exist) {
+		printf("%s: board params say an MDIO PHY is fitted: not supported\n",
+		       priv->name);
+		return -ENODEV;
+	}
+	priv->speed = bp.speed == AL_ETH_BOARD_1G_SPEED_100M ? 100 :
+		      bp.speed == AL_ETH_BOARD_1G_SPEED_10M ? 10 : 1000;
+	priv->full_duplex = !bp.half_duplex;
+	/* As Linux for a port without a PHY: autoneg = !an_disable. */
+	priv->autoneg = !bp.an_disable;
+	priv->force_1000_base_x = bp.force_1000_base_x;
+
+	priv->tx_ring = memalign(ARCH_DMA_MINALIGN,
+				 RING_BYTES(AL_ETH_TX_DESCS, sizeof(union al_udma_desc)));
+	priv->rx_ring = memalign(ARCH_DMA_MINALIGN,
+				 RING_BYTES(AL_ETH_RX_DESCS, sizeof(union al_udma_desc)));
+	priv->rx_cring = memalign(ARCH_DMA_MINALIGN, RING_BYTES(AL_ETH_RX_DESCS, 16));
+	priv->rx_bufs = memalign(ARCH_DMA_MINALIGN, AL_ETH_RX_BUFS * AL_ETH_BUF_LEN);
+	priv->tx_buf = memalign(ARCH_DMA_MINALIGN, AL_ETH_BUF_LEN);
+	if (!priv->tx_ring || !priv->rx_ring || !priv->rx_cring || !priv->rx_bufs ||
+	    !priv->tx_buf)
+		return -ENOMEM;
+
+	return 0;
+}
+
+/* Before the OS: leave an idle function with params and MAC in place. */
+static int al_eth_remove(struct udevice *dev)
+{
+	struct al_eth_priv *priv = dev_get_priv(dev);
+
+	if (priv->dirty)
+		al_eth_quiesce(priv);
+
+	return 0;
+}
+
+/* Name it like the vendor U-Boot does: al_eth<port>, port = PCI device. */
+static int al_eth_bind(struct udevice *dev)
+{
+	char name[16];
+
+	snprintf(name, sizeof(name), "al_eth%u", PCI_DEV(dm_pci_get_bdf(dev)));
+
+	return device_set_name(dev, name);
+}
+
+static const struct eth_ops al_eth_ops = {
+	.start = al_eth_start,
+	.send = al_eth_send,
+	.recv = al_eth_recv,
+	.free_pkt = al_eth_free_pkt,
+	.stop = al_eth_stop,
+	.write_hwaddr = al_eth_write_hwaddr,
+	.read_rom_hwaddr = al_eth_read_rom_hwaddr,
+};
+
+U_BOOT_DRIVER(al_eth) = {
+	.name = "al_eth",
+	.id = UCLASS_ETH,
+	.bind = al_eth_bind,
+	.probe = al_eth_probe,
+	.remove = al_eth_remove,
+	.ops = &al_eth_ops,
+	.priv_auto = sizeof(struct al_eth_priv),
+	.plat_auto = sizeof(struct eth_pdata),
+	.flags = DM_FLAG_OS_PREPARE | DM_FLAG_ACTIVE_DMA,
+};
+
+static struct pci_device_id al_eth_supported[] = {
+	{ PCI_DEVICE(ALPINE_V2_ETH_VENDOR, ALPINE_V2_ETH_DEVICE) },
+	{ }
+};
+
+U_BOOT_PCI_DEVICE(al_eth, al_eth_supported);
diff --git a/drivers/net/al_eth/al_hal_plat_services.h b/drivers/net/al_eth/al_hal_plat_services.h
new file mode 100644
index 00000000..429fff61
--- /dev/null
+++ b/drivers/net/al_eth/al_hal_plat_services.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * U-Boot platform services for the Annapurna Labs HAL (replaces the vendor
+ * al_hal_plat_services.h).
+ *
+ * al_assert() does not stop the board: it reports the failed condition and
+ * latches al_eth_hal_failed, which the driver checks before and after HAL
+ * work and then refuses to touch the DMA until the next start (which resets
+ * the function). A silent hang or a reset mid-boot would hide the cause.
+ */
+#ifndef __PLAT_SERVICES_H__
+#define __PLAT_SERVICES_H__
+
+#include <log.h>
+#include <stdio.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <asm/byteorder.h>
+#include <asm/io.h>
+
+extern int al_eth_hal_failed;
+
+#define al_reg_read8(l)		readb(l)
+#define al_reg_read16(l)	readw(l)
+#define al_reg_read32(l)	readl(l)
+#define al_reg_read64(l)	readq(l)
+
+#define al_reg_write8(l, v)	writeb(v, l)
+#define al_reg_write16(l, v)	writew(v, l)
+#define al_reg_write32(l, v)	writel(v, l)
+#define al_reg_write64(l, v)	writeq(v, l)
+
+#define al_reg_read32_relaxed(l)	readl(l)
+#define al_reg_write32_relaxed(l, v)	writel(v, l)
+
+#define al_print(fmt, ...)	printf(fmt, ##__VA_ARGS__)
+#define al_err(fmt, ...)	printf("al_eth HAL: " fmt, ##__VA_ARGS__)
+#define al_warn(fmt, ...)	printf("al_eth HAL: " fmt, ##__VA_ARGS__)
+#define al_info(fmt, ...)	debug(fmt, ##__VA_ARGS__)
+#define al_dbg(fmt, ...)	debug(fmt, ##__VA_ARGS__)
+
+#define al_assert(COND)							\
+	do {								\
+		if (unlikely(!(COND))) {				\
+			printf("al_eth HAL: assertion '%s' failed at %s:%d\n", \
+			       #COND, __func__, __LINE__);		\
+			al_eth_hal_failed = 1;				\
+		}							\
+	} while (0)
+
+/* Descriptor writes visible to the DMA before the doorbell write. */
+static inline void al_data_memory_barrier(void)
+{
+	dsb();
+}
+
+static inline void al_smp_data_memory_barrier(void)
+{
+	dsb();
+}
+
+static inline void al_local_data_memory_barrier(void)
+{
+	dsb();
+}
+
+#define al_udelay(u)		udelay(u)
+#define al_msleep(m)		mdelay(m)
+
+#define swap16_to_le(x)		cpu_to_le16(x)
+#define swap32_to_le(x)		cpu_to_le32(x)
+#define swap64_to_le(x)		cpu_to_le64(x)
+#define swap16_from_le(x)	le16_to_cpu(x)
+#define swap32_from_le(x)	le32_to_cpu(x)
+#define swap64_from_le(x)	le64_to_cpu(x)
+
+#define al_memset(p, val, cnt)	memset(p, val, cnt)
+#define al_memcmp(p1, p2, cnt)	memcmp(p1, p2, cnt)
+#define al_memcpy(d, s, cnt)	memcpy(d, s, cnt)
+
+#define al_popcount(x)		hweight32(x)
+
+#endif
diff --git a/drivers/net/al_eth/al_hal_plat_types.h b/drivers/net/al_eth/al_hal_plat_types.h
new file mode 100644
index 00000000..8bc308ff
--- /dev/null
+++ b/drivers/net/al_eth/al_hal_plat_types.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * U-Boot platform types for the Annapurna Labs HAL (replaces the vendor
+ * al_hal_plat_types.h; the HAL files next to it are verbatim copies).
+ */
+#ifndef __PLAT_TYPES_H__
+#define __PLAT_TYPES_H__
+
+#include <linux/types.h>
+
+typedef int al_bool;
+#define AL_TRUE			1
+#define AL_FALSE		0
+
+/* U-Boot provides the fixed-width types. */
+#define AL_HAVE_TYPES
+
+typedef dma_addr_t al_phys_addr_t;
+
+#define PLAT_ARCH_IS_LITTLE()	AL_TRUE
+
+#define __STRINGIFY(a) #a
+#define __PRI32(x) __STRINGIFY(x)
+#define PRId32		__PRI32(d)
+#define PRIi32		__PRI32(i)
+#define PRIo32		__PRI32(o)
+#define PRIu32		__PRI32(u)
+#define PRIx32		__PRI32(x)
+#define PRIX32		__PRI32(X)
+#define __PRI64(x) __STRINGIFY(ll##x)
+#define PRId64		__PRI64(d)
+#define PRIi64		__PRI64(i)
+#define PRIo64		__PRI64(o)
+#define PRIu64		__PRI64(u)
+#define PRIx64		__PRI64(x)
+#define PRIX64		__PRI64(X)
+#define __PRIPTR(x) __STRINGIFY(l##x)
+#define PRIdPTR		__PRIPTR(d)
+#define PRIxPTR		__PRIPTR(x)
+
+#endif
