+/* configure the mac media type. */
+int al_eth_mac_config(struct al_hal_eth_adapter *adapter, enum al_eth_mac_mode mode)
+{
+	uint16_t pcs_reg;
+
+	switch(mode) {
+	case AL_ETH_MAC_MODE_RGMII:
+		al_reg_write32(&adapter->mac_regs_base->gen.clk_cfg, 0x40003210);
