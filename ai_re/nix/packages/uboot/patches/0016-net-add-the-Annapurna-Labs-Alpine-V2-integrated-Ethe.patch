+/** Configure UDMA AXI S2M configuration */
+int al_udma_s2m_axi_set(struct al_udma *udma,
+				struct al_udma_s2m_axi_conf *axi_s2m)
+{
+
+	uint32_t reg;
+
+	al_udma_s2m_axi_sm_set(&axi_s2m->data_write,
