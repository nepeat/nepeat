+#define EC_RFW_FILTER_DET_MAC            (1 << 1)
+/* Filter all tagged. */
+#define EC_RFW_FILTER_TAGGED             (1 << 2)
+/* Filter all untagged. */
+#define EC_RFW_FILTER_UNTAGGED           (1 << 3)
+/* Filter all broadcast. */
+#define EC_RFW_FILTER_BC                 (1 << 4)
+/* Filter all multicast. */
+#define EC_RFW_FILTER_MC                 (1 << 5)
