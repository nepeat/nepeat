+		 UDMA_S2M_WR_DATA_CFG_2_HINT_IF_NO_DESC |
+		 UDMA_S2M_WR_DATA_CFG_2_WAIT_FOR_PREF |
+		 UDMA_S2M_WR_DATA_CFG_2_FULL_LINE_MODE |
+		 UDMA_S2M_WR_DATA_CFG_2_DIRECT_HDR_USE_BUF1);
