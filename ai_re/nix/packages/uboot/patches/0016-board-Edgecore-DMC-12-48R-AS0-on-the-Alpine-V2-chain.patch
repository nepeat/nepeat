From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ai_re <ai_re@localhost>
Date: Sun, 15 Nov 2026 04:30:00 +0000
Subject: [PATCH 16/16] board: Edgecore DMC-12-48R-AS0 on the Alpine V2
 chainload target

U-Boot additions to the board's Linux DTS (arch/arm/dts/alpine-v2-dmc12.dts,
copied in at build time from the Linux board tree, not part of this
patch): 4 GiB /memory as the vendor loader reports it, the vendor
loader's firmware memreserves as /reserved-memory, the CPLD reset under
i2c-4 / 0x68 and an sp805 wdt-reboot fallback.

Defconfig: TEXT_BASE 0x08000000 (the vendor "loadaddr"), console on
UART0 (500 MHz, 32-bit registers) plus a debug UART that skips init,
standard boot (extlinux, scripts) over PCI ECAM -> AHCI -> SCSI with
ext4/FAT, booti, sysboot, I2C with the pca954x muxes; no network (no
al_eth driver), no SPI flash, no MMC, env nowhere and no saveenv, no
EFI, no PSCI reset, sp805 present but never auto-started.

Scope: dmc12.
---
 arch/arm/dts/alpine-v2-dmc12-u-boot.dtsi | 60 +++++++++++++++++++++++
 configs/alpine_v2_dmc12_defconfig        | 61 ++++++++++++++++++++++++
 2 files changed, 121 insertions(+)
 create mode 100644 arch/arm/dts/alpine-v2-dmc12-u-boot.dtsi
 create mode 100644 configs/alpine_v2_dmc12_defconfig

diff --git a/arch/arm/dts/alpine-v2-dmc12-u-boot.dtsi b/arch/arm/dts/alpine-v2-dmc12-u-boot.dtsi
new file mode 100644
index 00000000..59c332cf
--- /dev/null
+++ b/arch/arm/dts/alpine-v2-dmc12-u-boot.dtsi
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * U-Boot additions for the Edgecore DMC-12-48R-AS0. The board DTS itself
+ * (alpine-v2-dmc12.dts) is the Linux one, copied in at build time.
+ */
+
+#include "alpine-v2-u-boot.dtsi"
+
+/ {
+	/*
+	 * 4 GiB soldered DDR4 (al-boot stage2: "DRAM total size: 4GB"):
+	 * 3 GiB below the PCIe/I/O window, 1 GiB at 8 GiB. Same banks as the
+	 * vendor loader's /memory.
+	 */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x00000000 0x0 0xc0000000>,
+		      <0x2 0x00000000 0x0 0x40000000>;
+	};
+
+	/*
+	 * Firmware-owned ranges: the vendor loader's /memreserve/ list
+	 * (unit u01, al-boot 2.60.4), minus the entries that are only its own
+	 * DTB and initrd. What they hold (PSCI monitor, trace buffer, ...) is
+	 * not known; U-Boot stays clear of them and ft_board_setup() copies
+	 * them into the OS DTB's reserve map.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		al-boot@0 {
+			reg = <0x0 0x00000000 0x0 0x00100000>;
+		};
+		al-boot@2000000 {
+			reg = <0x0 0x02000000 0x0 0x00100000>;
+		};
+		al-boot@b0000000 {
+			reg = <0x0 0xb0000000 0x0 0x08000000>;
+		};
+		al-boot@b8000000 {
+			reg = <0x0 0xb8000000 0x0 0x08000000>;
+		};
+	};
+
+	/* Fallback reset: the SoC sp805 (the vendor's alpine-reboot does this). */
+	wdt-reboot {
+		compatible = "wdt-reboot";
+		wdt = <&{/soc/io-bus@fc000000/watchdog@188c000}>;
+	};
+};
+
+/* Board CPLD (i2c-4 / 0x68): whole-board reset, tried before the sp805. */
+&mux70_3 {
+	cpld@68 {
+		compatible = "edgecore,dmc12-cpld";
+		reg = <0x68>;
+	};
+};
diff --git a/configs/alpine_v2_dmc12_defconfig b/configs/alpine_v2_dmc12_defconfig
new file mode 100644
index 00000000..d2faec69
--- /dev/null
+++ b/configs/alpine_v2_dmc12_defconfig
@@ -0,0 +1,61 @@
