From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ai_re <ai_re@localhost>
Date: Sun, 15 Nov 2026 20:00:00 -0800
Subject: [PATCH 33/35] spi: designware: deselect before the controller init

0030 cleared SER in spi_hw_init(), after the per-variant init. Clear it
(with the SSI disabled) in probe before that init, and hand the value
found to the Alpine init, which reports it.

Scope: alpine-v2 (generic driver code).
---
 drivers/spi/designware_spi.c | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/drivers/spi/designware_spi.c b/drivers/spi/designware_spi.c
index 9d7d99a7..ddab21e0 100644
--- a/drivers/spi/designware_spi.c
+++ b/drivers/spi/designware_spi.c
@@ -138,6 +138,7 @@ struct dw_spi_priv {
 	void *rx;
 	void *rx_end;
 	u32 fifo_len;			/* depth of the FIFO buffer */
+	u32 ser_at_probe;		/* slave select found set at probe */
 	u32 max_xfer;			/* Maximum transfer size (in bits) */
 
 	int bits_per_word;
@@ -218,13 +219,13 @@ static int dw_spi_apb_k210_init(struct udevice *bus, struct dw_spi_priv *priv)
  */
 static int dw_spi_alpine_init(struct udevice *bus, struct dw_spi_priv *priv)
 {
-	u32 ser = dw_read(priv, DW_SPI_SER);
+	u32 ser = priv->ser_at_probe;
 	int ret;
 
 	/*
 	 * al-boot stage3 reads the boot flash through the SSI's memory-mapped
 	 * window (0xf8000000) and can start its application with SER still
-	 * set; spi_hw_init() clears it. Report it: a select left set made the
+	 * set; probe clears it. Report it: a select left set made the
 	 * first command after a cold stage3 boot read ff ff ff.
 	 */
 	if (ser)
@@ -408,6 +409,10 @@ static int dw_spi_probe(struct udevice *bus)
 
 	if (!init)
 		return -EINVAL;
+	/* Deselect every chip before anything else (see spi_hw_init). */
+	priv->ser_at_probe = dw_read(priv, DW_SPI_SER);
+	dw_write(priv, DW_SPI_SSIENR, 0);
+	dw_write(priv, DW_SPI_SER, 0);
 	ret = init(bus, priv);
 	if (ret)
 		return ret;
