# CONFIG_VIDEO_SANDBOX_SDL is not set
# CONFIG_SANDBOX_SDL is not set
# CONFIG_EFI_CAPSULE_AUTHENTICATE is not set
# CONFIG_EFI_CAPSULE_ON_DISK is not set
# CONFIG_EFI_CAPSULE_FIRMWARE_MANAGEMENT is not set
# CONFIG_LTO is not set
# The alarm watchdog kills sandbox while loadx waits for blocks (the board build has none)
# CONFIG_WATCHDOG_AUTOSTART is not set
CONFIG_SYS_PROMPT="cs8210-installer> "
CONFIG_BOOTDELAY=-1
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SPI_FLASH_USE_4K_SECTORS=y
CONFIG_SPI_FLASH_READ_ONLY=y
# CONFIG_SPI_FLASH_LOCK is not set
# CONFIG_SPI_FLASH_UNLOCK_ALL is not set
# CONFIG_SPI_FLASH_SFDP_SUPPORT is not set
# CONFIG_SPI_FLASH_SOFT_RESET is not set
# CONFIG_SPI_FLASH_BAR is not set
CONFIG_SPI_MEM_READ_ONLY_4B=y
# The installer's windows (patch 0028, alpine_v3_cs8210_installer_defconfig); tests.nix
# checks both builds carry the same values.
CONFIG_SPI_FLASH_WRITE_WINDOW=y
CONFIG_SPI_FLASH_WRITE_WINDOW_BUS=0
CONFIG_SPI_FLASH_WRITE_WINDOW_CS=0
CONFIG_SPI_FLASH_WRITE_WINDOW_JEDEC=0xc22539
CONFIG_SPI_FLASH_WRITE_WINDOW_CHIP_SIZE=0x2000000
CONFIG_SPI_FLASH_WRITE_WINDOW_ADDR_WIDTH=4
CONFIG_SPI_FLASH_WRITE_WINDOW_START=0x20000
CONFIG_SPI_FLASH_WRITE_WINDOW_SIZE=0x1000
CONFIG_SPI_FLASH_WRITE_WINDOW_START2=0x30000
CONFIG_SPI_FLASH_WRITE_WINDOW_SIZE2=0x1000
CONFIG_SPI_FLASH_WRITE_WINDOW_START3=0xf0000
CONFIG_SPI_FLASH_WRITE_WINDOW_SIZE3=0xa0000
CONFIG_SPI_FLASH_WRITE_WINDOW_START4=0x2f9000
CONFIG_SPI_FLASH_WRITE_WINDOW_SIZE4=0x67000
CONFIG_CMD_SF_WRITE_WINDOW=y
