+
+    // An MKA session keeps the MAC address its port had when it started. These
+    // tests give the manager a directory that stands in for /sys/class/net and
+    // a supplicant that is only counted.
+    class MACsecMgrCountingSupplicant : public MACsecMgr
+    {
+    public:
+        using MACsecMgr::MACsecMgr;
+        mutable std::vector<std::string> started;
+        mutable std::vector<pid_t> stopped;
+
+        pid_t startWPASupplicant(const std::string &sock) const override
+        {
+            started.push_back(sock);
+            return -1;      // "cannot start": enableMACsec asks for a retry, nothing is forked
+        }
+        bool stopWPASupplicant(pid_t pid) const override
+        {
+            stopped.push_back(pid);
+            return true;
+        }
+        Consumer *portConsumer()
+        {
+            return dynamic_cast<Consumer *>(getExecutor(CFG_PORT_TABLE_NAME));
+        }
+    };
+
+    class MACsecMgrAddressTest : public MACsecMgrTest
+    {
+    protected:
+        std::unique_ptr<MACsecMgrCountingSupplicant> m_fake;
+        std::string m_dir;
+
+        void SetUp() override
+        {
+            MACsecMgrTest::SetUp();
+            char tmpl[] = "/tmp/macsecmgr_ut_XXXXXX";
+            m_dir = std::string(mkdtemp(tmpl)) + "/";
+            std::vector<std::string> tables = { CFG_MACSEC_PROFILE_TABLE_NAME, CFG_PORT_TABLE_NAME };
+            m_fake.reset(new MACsecMgrCountingSupplicant(m_config_db.get(), m_app_db.get(), m_state_db.get(), tables));
+            m_fake->m_clearStaleTimeoutMs = 300;
+            m_fake->m_stopStaleTimeoutMs = 300;
+            m_fake->m_sockDir = m_dir;
+            m_fake->m_sysNetDir = m_dir + "net/";
+            mkdir(m_fake->m_sysNetDir.c_str(), 0700);
+            m_fake->m_profiles["profile"];
+            Table(m_state_db.get(), STATE_PORT_TABLE_NAME).set("Ethernet1",
+                { { "state", "ok" }, { "netdev_oper_status", "up" } });
+            Table(m_config_db.get(), CFG_PORT_TABLE_NAME).set("Ethernet1", { { "macsec", "profile" } });
+            mockCmdStdcout = "OK";
+            mockCmdReturn = 0;
+        }
+
+        void TearDown() override
+        {
+            // the destructor stops what is left with the real stopWPASupplicant
+            m_fake->m_macsec_ports.clear();
+            m_fake.reset();
+            netdev("Ethernet1", "");
+            rmdir((m_dir + "net").c_str());
+            rmdir(m_dir.c_str());
+            mockCmdStdcout = "";
+            mockCallArgs.clear();
+            MACsecMgrTest::TearDown();
+        }
+
+        // The netdev of a port with this address; "" removes the netdev.
+        void netdev(const std::string &port, const std::string &address)
+        {
+            const std::string dir = m_dir + "net/" + port;
+            if (address.empty())
+            {
+                unlink((dir + "/address").c_str());
+                rmdir(dir.c_str());
+                return;
+            }
+            mkdir(dir.c_str(), 0700);
+            std::ofstream(dir + "/address") << address << "\n";
+        }
+
+        void configured(const std::string &port, const std::string &address)
+        {
+            Table(m_config_db.get(), CFG_INTF_TABLE_NAME).set(port, { { "mac_addr", address } });
+        }
+
+        // A session as enableMACsec leaves it, without a process.
+        void session(const std::string &port, const std::string &address)
+        {
+            auto &s = m_fake->m_macsec_ports[port];
+            s.profile_name = "profile";
+            s.sock = m_dir + port;
+            s.wpa_supplicant_pid = 4242;
+            s.address = address;
+        }
+
+        size_t queued(const std::string &port)
+        {
+            return m_fake->portConsumer()->m_toSync.count(port);
+        }
+    };
+
+    TEST_F(MACsecMgrAddressTest, enable_noNetdevNoSession)
+    {
+        EXPECT_EQ(m_fake->enableMACsec("Ethernet1", { { "macsec", "profile" } }), task_need_retry);
+        EXPECT_TRUE(m_fake->started.empty());
+    }
+
+    TEST_F(MACsecMgrAddressTest, enable_noConfiguredAddressStartsWithTheNetdevAddress)
+    {
+        netdev("Ethernet1", "1c:ea:0b:38:2b:d5");
+        std::string address;
+        EXPECT_TRUE(m_fake->isPortAddressReady("Ethernet1", address));
+        EXPECT_EQ(address, "1c:ea:0b:38:2b:d5");
+
+        m_fake->enableMACsec("Ethernet1", { { "macsec", "profile" } });
+        EXPECT_EQ(m_fake->started.size(), 1u);
+    }
+
+    TEST_F(MACsecMgrAddressTest, enable_waitsUntilTheNetdevHasTheConfiguredAddress)
+    {
+        // What a stack start looks like: the netdev is created with the switch
+        // address, the port becomes ready, intfmgrd sets mac_addr later.
+        netdev("Ethernet1", "1c:ea:0b:38:2b:d5");
+        configured("Ethernet1", "1C:EA:0B:38:2B:D6");
+
+        EXPECT_EQ(m_fake->enableMACsec("Ethernet1", { { "macsec", "profile" } }), task_need_retry);
+        EXPECT_EQ(m_fake->enableMACsec("Ethernet1", { { "macsec", "profile" } }), task_need_retry);
+        EXPECT_TRUE(m_fake->started.empty());
+        EXPECT_EQ(m_fake->m_addressWaiting.count("Ethernet1"), 1u);
+
+        netdev("Ethernet1", "1c:ea:0b:38:2b:d6");
+        m_fake->enableMACsec("Ethernet1", { { "macsec", "profile" } });
+        EXPECT_EQ(m_fake->started.size(), 1u);
+        EXPECT_EQ(m_fake->m_addressWaiting.count("Ethernet1"), 0u);
+    }
+
+    TEST_F(MACsecMgrAddressTest, follow_sameAddressLeavesTheSessionAlone)
+    {
+        netdev("Ethernet1", "1c:ea:0b:38:2b:d6");
+        session("Ethernet1", "1c:ea:0b:38:2b:d6");
+
+        m_fake->followPortAddresses();
+
+        EXPECT_TRUE(m_fake->stopped.empty());
+        EXPECT_TRUE(m_fake->started.empty());
+        EXPECT_EQ(m_fake->m_macsec_ports.count("Ethernet1"), 1u);
+    }
+
+    TEST_F(MACsecMgrAddressTest, follow_changedAddressStopsTheSessionAndStartsItAgain)
+    {
+        netdev("Ethernet1", "1c:ea:0b:38:2b:d6");
+        netdev("Ethernet2", "1c:ea:0b:38:2b:d5");
+        session("Ethernet1", "1c:ea:0b:38:2b:d5");
+        session("Ethernet2", "1c:ea:0b:38:2b:d5");
+
+        m_fake->followPortAddresses();
+
+        // the old session of Ethernet1 is stopped through its own supplicant, a new one is tried at once
+        ASSERT_EQ(m_fake->stopped.size(), 1u);
+        EXPECT_EQ(m_fake->stopped[0], 4242);
+        ASSERT_EQ(m_fake->started.size(), 1u);
+        EXPECT_EQ(m_fake->started[0], m_dir + "Ethernet1");
+        // (the counting supplicant "cannot start": the port stays queued for a retry)
+        EXPECT_EQ(queued("Ethernet1"), 1u);
+        // the other port is not touched
+        EXPECT_EQ(m_fake->m_macsec_ports.count("Ethernet2"), 1u);
+        EXPECT_EQ(queued("Ethernet2"), 0u);
+        m_fake->m_macsec_ports.clear();
+        netdev("Ethernet2", "");
+    }
+
+    TEST_F(MACsecMgrAddressTest, follow_changedAwayFromTheConfiguredAddressWaits)
+    {
+        // The netdev was replaced (syncd restart) and has the switch address
+        // again: the session stops and no new one starts until mac_addr is back.
+        configured("Ethernet1", "1c:ea:0b:38:2b:d6");
+        netdev("Ethernet1", "1c:ea:0b:38:2b:d5");
+        session("Ethernet1", "1c:ea:0b:38:2b:d6");
+
+        m_fake->followPortAddresses();
+
+        EXPECT_EQ(m_fake->stopped.size(), 1u);
+        EXPECT_TRUE(m_fake->started.empty());
+        EXPECT_EQ(m_fake->m_macsec_ports.count("Ethernet1"), 0u);
+        EXPECT_EQ(queued("Ethernet1"), 1u);
+
+        netdev("Ethernet1", "1c:ea:0b:38:2b:d6");
+        m_fake->doTask(*m_fake->portConsumer());
+        EXPECT_EQ(m_fake->started.size(), 1u);
+    }
+
+    TEST_F(MACsecMgrAddressTest, follow_portWithoutMACsecConfigIsNotQueued)
+    {
+        Table(m_config_db.get(), CFG_PORT_TABLE_NAME).del("Ethernet1");
+        netdev("Ethernet1", "1c:ea:0b:38:2b:d6");
+        session("Ethernet1", "1c:ea:0b:38:2b:d5");
+
+        m_fake->followPortAddresses();
+
+        EXPECT_EQ(m_fake->stopped.size(), 1u);
+        EXPECT_TRUE(m_fake->started.empty());
+        EXPECT_EQ(queued("Ethernet1"), 0u);
+    }
 }
