     // APPL_DB MACsec tables, written by wpa_supplicant's macsec_sonic driver
     // and consumed by orchagent. macsecmgrd only touches them to remove what
@@ -95,8 +106,17 @@
     bool clearStaleMACsecState(const std::string & port_name);
