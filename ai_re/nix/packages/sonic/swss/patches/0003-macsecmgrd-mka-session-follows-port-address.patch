+// The MAC address the port's netdev has now (lower case); empty when there is
+// no such netdev.
+std::string MACsecMgr::getPortAddress(const std::string & port_name) const
+{
+    std::ifstream file(m_sysNetDir + port_name + "/address");
+    std::string address;
+    file >> address;
+    boost::algorithm::to_lower(address);
+    return address;
+}
+
+// wpa_supplicant reads the port's MAC address once, when the MKA session
+// starts: the KaY's SCI and its part in the key server election are built from
+// it for as long as the session lives. A port's CONFIG_DB INTERFACE mac_addr
+// is put on the netdev by intfmgrd some time after the port is ready (and
+// again on the new netdev after a syncd restart). A session started in between
+// would run with an address the port is about to lose, and the peer would see
+// SCIs that match no frame the port sends afterwards. So: the netdev exists
+// and, when an address is configured for the port, it has that address.
+bool MACsecMgr::isPortAddressReady(const std::string & port_name, std::string & address)
+{
+    SWSS_LOG_ENTER();
+
+    address = getPortAddress(port_name);
+    if (address.empty())
+    {
+        return false;
+    }
+    std::string configured;
+    if (m_cfgIntfTable.hget(port_name, "mac_addr", configured) && !configured.empty())
+    {
+        boost::algorithm::to_lower(configured);
+        return configured == address;
+    }
+    return true;
+}
+
+// The address of a netdev can change under a running session (a mac_addr set
+// or changed at run time, "ip link set address"). The session then has to be
+// started again: stop it and queue the port's CONFIG_DB entry as if it had
+// just been written, so that the usual conditions (port ready, address as
+// configured) and the usual retries apply.
+void MACsecMgr::followPortAddresses()
+{
+    SWSS_LOG_ENTER();
+
+    std::vector<std::pair<std::string, std::string>> changed;
+    for (const auto & port : m_macsec_ports)
+    {
+        const std::string address = getPortAddress(port.first);
+        if (address != port.second.address)
+        {
+            changed.emplace_back(port.first, address);
+        }
+    }
+    if (changed.empty())
+    {
+        return;
+    }
+    auto consumer = dynamic_cast<Consumer *>(getExecutor(CFG_PORT_TABLE_NAME));
+    for (const auto & port : changed)
+    {
+        const std::string & port_name = port.first;
+        SWSS_LOG_NOTICE(
+            "The address of the port '%s' changed from '%s' to '%s': its MKA session is started again",
+            port_name.c_str(),
+            m_macsec_ports[port_name].address.c_str(),
+            port.second.c_str());
+        disableMACsec(port_name, TaskArgs());
+        std::vector<FieldValueTuple> port_attr;
+        if (consumer != nullptr && m_cfgPortTable.get(port_name, port_attr))
+        {
+            consumer->addToSync(KeyOpFieldsValuesTuple(port_name, SET_COMMAND, port_attr));
+        }
+    }
+    if (consumer != nullptr)
+    {
+        doTask(*consumer);
+    }
+}
+
 pid_t MACsecMgr::startWPASupplicant(const std::string & sock) const
 {
     SWSS_LOG_ENTER();
