     sai_attribute_t ha_role_attr = {};
     ha_role_attr.id = SAI_HA_SCOPE_ATTR_DASH_HA_ROLE;
-    ha_role_attr.value.u16 = to_sai(entry.ha_role());
+    ha_role_attr.value.s32 = to_sai(entry.ha_role());
