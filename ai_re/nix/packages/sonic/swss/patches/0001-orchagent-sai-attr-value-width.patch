             attrList.push_back(attr);
         }
 
@@ -3074,37 +3074,37 @@ bool PortsOrch::setPortPvid(Port &port, sai_uint32_t pvid)
     {
         sai_attribute_t attr;
         attr.id = SAI_PORT_ATTR_PORT_VLAN_ID;
-        attr.value.u32 = pvid;
+        attr.value.u16 = static_cast<sai_uint16_t>(pvid);
 
         sai_status_t status = sai_port_api->set_port_attribute(port.m_port_id, &attr);
         if (status != SAI_STATUS_SUCCESS)
         {
-            SWSS_LOG_ERROR("Failed to set pvid %u to port: %s", attr.value.u32, port.m_alias.c_str());
+            SWSS_LOG_ERROR("Failed to set pvid %u to port: %s", attr.value.u16, port.m_alias.c_str());
             task_process_status handle_status = handleSaiSetStatus(SAI_API_PORT, status);
