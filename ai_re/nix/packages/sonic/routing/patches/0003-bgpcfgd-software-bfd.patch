+    def update_bfd(self, vrf, nbr, data):
+        """
+        sonic-nixos: apply a changed 'bfd' / 'bfd_check_ctrl_plane_failure' of an
+        existing peer (the add template renders them for new peers).
+        :return: True if a BFD setting changed
+        """
+        try:
+            old = self.directory.get(self.db_name, self.table_name, vrf + '|' + nbr)
+        except KeyError:
+            old = {}
+        on = lambda d, f: d.get(f, 'false') == 'true'
+        cmds = []
+        if on(old, 'bfd') != on(data, 'bfd'):
+            cmds.append(('' if on(data, 'bfd') else 'no ') + 'neighbor %s bfd' % nbr)
+        if on(data, 'bfd') and on(old, 'bfd_check_ctrl_plane_failure') != on(data, 'bfd_check_ctrl_plane_failure'):
+            cmds.append(('' if on(data, 'bfd_check_ctrl_plane_failure') else 'no ') + 'neighbor %s bfd check-control-plane-failure' % nbr)
+        if not cmds:
+            return False
+        self.apply_op("\n".join(" " + c for c in cmds), vrf)
+        log_info("Peer '(%s|%s)': %s" % (vrf, nbr, "; ".join(cmds)))
+        return True
+
