+    @staticmethod
+    def local_as_args(data):
+        """
+        sonic-nixos: "<asn>[ no-prepend[ replace-as]]" for BGP_NEIGHBOR local_asn,
+        local_as_no_prepend, local_as_replace_as (as the add template renders
+        them; FRR takes replace-as only after no-prepend), None without one.
+        """
+        try:
+            asn = int(data.get('local_asn', ''))
+        except (TypeError, ValueError):
+            return None
+        if asn <= 0:
+            return None
+        args = str(asn)
+        if data.get('local_as_no_prepend') == 'true':
+            args += ' no-prepend'
+            if data.get('local_as_replace_as') == 'true':
+                args += ' replace-as'
+        return args
+
+    def update_local_as(self, vrf, nbr, data):
+        """
+        sonic-nixos: apply a changed local_asn / local_as_no_prepend /
+        local_as_replace_as of an existing peer (the add template renders them
+        for new peers).
+        :return: True if the local AS of the peer changed
+        """
+        try:
+            old = self.directory.get(self.db_name, self.table_name, vrf + '|' + nbr)
+        except KeyError:
+            old = {}
+        before, after = self.local_as_args(old), self.local_as_args(data)
+        if before == after:
+            return False
+        cmd = ('neighbor %s local-as %s' % (nbr, after)) if after else ('no neighbor %s local-as' % nbr)
+        self.apply_op(" " + cmd, vrf)
+        log_info("Peer '(%s|%s)': %s" % (vrf, nbr, cmd))
+        return True
+
