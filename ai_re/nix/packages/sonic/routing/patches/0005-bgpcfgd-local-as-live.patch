         :return: True if this adding was successful, False otherwise
         """
-        bfd_changed = self.update_bfd(vrf, nbr, data)
+        changed = self.update_bfd(vrf, nbr, data)
+        changed = self.update_local_as(vrf, nbr, data) or changed
         if "admin_status" in data:
             self.change_admin_status(vrf, nbr, data)
