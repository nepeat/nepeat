 # Interface filtering functions
+import re
 
 SONIC_PORT_NAME_PREFIX = "Ethernet"
 SONIC_LAG_NAME_PREFIX = "PortChannel"
 SONIC_BACK_PORT_NAME_PREFIX = "Ethernet-BP"
 
+# Front-panel alias ranges (alias naming mode, aliases Ethernet<cage>/<sub>):
+# Ethernet1/1-4 = subports 1..4 of cage 1, Ethernet1/1-3/1 = every subport
+# from 1/1 to 3/1 in (cage, subport) order. Subports that do not exist are
+# gaps in the range, as for SONiC name ranges.
+ALIAS_RANGE_RE = re.compile(r"^Ethernet(\d+)/(\d+)-(?:(\d+)/)?(\d+)$")
+ALIAS_MAX_SUBPORTS = 8
+
+
+def expand_alias_range(intf_filter):
+    m = ALIAS_RANGE_RE.match(intf_filter)
+    if not m:
+        return None
+    c1, s1 = int(m.group(1)), int(m.group(2))
+    c2 = int(m.group(3)) if m.group(3) else c1
+    s2 = int(m.group(4))
+    if (c2, s2) < (c1, s1):
+        raise ValueError(
+            "Invalid interface range '{}'. The start of the range "
+            "must not be greater than the end.".format(intf_filter))
+    names = []
+    for c in range(c1, c2 + 1):
+        lo = s1 if c == c1 else 1
+        hi = s2 if c == c2 else ALIAS_MAX_SUBPORTS
+        names.extend("Ethernet{}/{}".format(c, s) for s in range(lo, hi + 1))
+    return names
+
 
 def expand_range(intf_filter, prefix):
     """Try to expand a prefixed interface filter as a numeric range.
