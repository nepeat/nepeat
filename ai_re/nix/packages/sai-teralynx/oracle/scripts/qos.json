{
 "name": "qos: QoS maps, schedulers + scheduler groups, WRED, buffer pools/profiles, PFC, queue/PG/pool counters on Ethernet0 (no traffic)",
 "steps": [
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ],
    [
     "PORT_STATE_CHANGE_NOTIFY",
     "ptr",
     "port_state"
    ],
    [
     "SWITCH_SHUTDOWN_REQUEST_NOTIFY",
     "ptr",
     "shutdown"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "set",
   "obj": "$ports[15]",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "sleep",
   "ms": 3000
  },
  {
   "op": "get",
   "obj": "$ports[0]",
   "attrs": [
    [
     "QOS_NUMBER_OF_QUEUES",
     "u32"
    ],
    [
     "NUMBER_OF_INGRESS_PRIORITY_GROUPS",
     "u32"
    ],
    [
     "QOS_NUMBER_OF_SCHEDULER_GROUPS",
     "u32"
    ]
   ],
   "desc": "counts"
  },
  {
   "op": "get",
   "obj": "$ports[0]",
   "attr": [
    "QOS_QUEUE_LIST",
    "oidlist",
    64
   ],
   "as": "q"
  },
  {
   "op": "get",
   "obj": "$ports[0]",
   "attr": [
    "INGRESS_PRIORITY_GROUP_LIST",
    "oidlist",
    64
   ],
   "as": "pg"
  },
  {
   "op": "get",
   "obj": "$ports[0]",
   "attr": [
    "QOS_SCHEDULER_GROUP_LIST",
    "oidlist",
    64
   ],
   "as": "sg"
  },
  {
   "op": "foreach",
   "list": "sg",
   "as": "g",
   "max": 24,
   "steps": [
    {
     "op": "get",
     "obj": "$g",
     "attrs": [
      [
       "CHILD_COUNT",
       "u32"
      ],
      [
       "LEVEL",
       "u8"
      ],
      [
       "MAX_CHILDS",
       "u8"
      ],
      [
       "PARENT_NODE",
       "oid"
      ],
      [
       "PORT_ID",
       "oid"
      ]
     ],
     "may_fail": true
    },
    {
     "op": "get",
     "obj": "$g",
     "attr": [
      "CHILD_LIST",
      "oidlist",
      64
     ],
     "may_fail": true
    }
   ]
  },
  {
   "op": "foreach",
   "list": "q",
   "as": "qq",
   "max": 24,
   "steps": [
    {
     "op": "get",
     "obj": "$qq",
     "attrs": [
      [
       "TYPE",
       "s32"
      ],
      [
       "INDEX",
       "u8"
      ],
      [
       "PARENT_SCHEDULER_NODE",
       "oid"
      ]
     ],
     "may_fail": true
    }
   ]
  },
  {
   "op": "foreach",
   "list": "pg",
   "as": "p",
   "max": 8,
