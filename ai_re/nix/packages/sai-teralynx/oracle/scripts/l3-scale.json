{
 "name": "l3-scale: fill the route table (v4 /24, v6 /64, v4 /32 hosts) until IFCS says full; time per 1000; remove",
 "steps": [
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VIRTUAL_ROUTER_ID",
    "oid"
   ],
   "as": "vr"
  },
  {
   "op": "create_route",
   "desc": "default v4 DROP",
   "vr": "$vr",
   "prefix": "0.0.0.0/0",
   "attrs": [
    [
     "PACKET_ACTION",
     "s32",
     "DROP"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "default v6 DROP",
   "vr": "$vr",
   "prefix": "::/0",
   "attrs": [
    [
     "PACKET_ACTION",
     "s32",
     "DROP"
    ]
   ]
  },
  {
   "op": "create",
   "type": "ROUTER_INTERFACE",
   "as": "rifB",
   "desc": "RIF B on Ethernet120 (no link needed)",
   "attrs": [
    [
     "VIRTUAL_ROUTER_ID",
     "oid",
     "$vr"
    ],
    [
     "TYPE",
     "s32",
     "PORT"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[15]"
    ],
    [
     "SRC_MAC_ADDRESS",
     "mac",
     "02:00:00:00:01:0b"
    ],
    [
     "MTU",
     "u32",
     9100
    ]
   ]
  },
  {
   "op": "create_neighbor",
   "desc": "10.2.0.2",
   "rif": "$rifB",
   "ip": "10.2.0.2",
   "attrs": [
    [
     "DST_MAC_ADDRESS",
     "mac",
     "02:00:00:00:0b:02"
    ]
   ]
  },
  {
   "op": "create_neighbor",
   "desc": "fc00:2::2",
   "rif": "$rifB",
   "ip": "fc00:2::2",
   "attrs": [
    [
     "DST_MAC_ADDRESS",
     "mac",
     "02:00:00:00:0b:02"
    ]
   ]
  },
  {
   "op": "create",
   "type": "NEXT_HOP",
   "as": "nh",
   "desc": "10.2.0.2",
   "attrs": [
    [
     "TYPE",
     "s32",
     "IP"
    ],
    [
     "IP",
     "ip",
     "10.2.0.2"
    ],
    [
     "ROUTER_INTERFACE_ID",
     "oid",
     "$rifB"
    ]
   ]
  },
  {
   "op": "create",
   "type": "NEXT_HOP",
   "as": "nh6",
   "desc": "fc00:2::2",
   "attrs": [
    [
     "TYPE",
     "s32",
     "IP"
    ],
    [
     "IP",
     "ip",
     "fc00:2::2"
    ],
    [
     "ROUTER_INTERFACE_ID",
     "oid",
     "$rifB"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "desc": "CRM before",
   "attrs": [
    [
     "AVAILABLE_IPV4_ROUTE_ENTRY",
     "u32"
    ],
    [
     "AVAILABLE_IPV6_ROUTE_ENTRY",
     "u32"
    ],
    [
     "AVAILABLE_IPV4_NEIGHBOR_ENTRY",
     "u32"
    ]
   ]
  },
  {
   "op": "route_fill",
   "desc": "v4 /24 until full",
   "vr": "$vr",
   "prefix": "20.0.0.0/24",
   "count": 120000,
   "report": 1000,
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$nh"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "get",
   "obj": "switch",
   "desc": "CRM after v4",
   "attrs": [
    [
     "AVAILABLE_IPV4_ROUTE_ENTRY",
     "u32"
    ],
    [
     "AVAILABLE_IPV6_ROUTE_ENTRY",
     "u32"
    ],
    [
     "AVAILABLE_IPV4_NEIGHBOR_ENTRY",
     "u32"
    ]
   ]
  },
  {
   "op": "route_fill",
   "desc": "v6 /64 with the v4 table full",
   "vr": "$vr",
   "prefix": "2001:db8:1::/64",
   "count": 40000,
   "report": 1000,
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$nh6"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "route_fill",
   "desc": "v4 /32 hosts with the prefix table full",
   "vr": "$vr",
   "prefix": "30.0.0.0/32",
   "count": 120000,
   "report": 5000,
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$nh"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "get",
   "obj": "switch",
   "desc": "CRM full",
   "attrs": [
    [
     "AVAILABLE_IPV4_ROUTE_ENTRY",
     "u32"
    ],
    [
     "AVAILABLE_IPV6_ROUTE_ENTRY",
     "u32"
    ],
    [
     "AVAILABLE_IPV4_NEIGHBOR_ENTRY",
     "u32"
    ]
   ]
  },
  {
   "op": "route_fill",
   "desc": "remove v4 /32",
   "vr": "$vr",
   "prefix": "30.0.0.0/32",
   "count": 120000,
   "report": 5000,
   "remove": true,
   "may_fail": true
  },
  {
   "op": "route_fill",
   "desc": "remove v6 /64",
   "vr": "$vr",
   "prefix": "2001:db8:1::/64",
   "count": 40000,
   "report": 1000,
   "remove": true,
   "may_fail": true
  },
  {
   "op": "route_fill",
   "desc": "remove v4 /24",
   "vr": "$vr",
   "prefix": "20.0.0.0/24",
   "count": 120000,
   "report": 1000,
   "remove": true,
   "may_fail": true
  },
  {
   "op": "route_fill",
   "desc": "v6 /64 alone until full",
   "vr": "$vr",
   "prefix": "2001:db8:1::/64",
   "count": 40000,
   "report": 1000,
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$nh6"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "route_fill",
   "desc": "remove v6 /64",
   "vr": "$vr",
   "prefix": "2001:db8:1::/64",
   "count": 40000,
   "report": 1000,
   "remove": true,
   "may_fail": true
  },
  {
   "op": "route_fill",
   "desc": "v4 /32 alone until full",
   "vr": "$vr",
   "prefix": "30.0.0.0/32",
   "count": 120000,
   "report": 5000,
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$nh"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "route_fill",
   "desc": "remove v4 /32",
   "vr": "$vr",
   "prefix": "30.0.0.0/32",
   "count": 120000,
   "report": 5000,
   "remove": true,
   "may_fail": true
  },
  {
   "op": "get",
   "obj": "switch",
   "desc": "CRM empty",
   "attrs": [
    [
     "AVAILABLE_IPV4_ROUTE_ENTRY",
     "u32"
    ],
    [
     "AVAILABLE_IPV6_ROUTE_ENTRY",
     "u32"
    ],
    [
     "AVAILABLE_IPV4_NEIGHBOR_ENTRY",
     "u32"
    ]
   ]
  },
  {
   "op": "remove",
   "obj": "$nh"
  },
  {
   "op": "remove",
   "obj": "$nh6"
  },
  {
   "op": "remove_neighbor",
   "rif": "$rifB",
   "ip": "10.2.0.2"
  },
  {
   "op": "remove_neighbor",
   "rif": "$rifB",
   "ip": "fc00:2::2"
  },
  {
   "op": "remove",
   "obj": "$rifB"
  },
  {
   "op": "remove_route",
   "vr": "$vr",
   "prefix": "0.0.0.0/0"
  },
  {
   "op": "remove_route",
   "vr": "$vr",
   "prefix": "::/0"
  },
  {
   "op": "remove_switch"
  }
 ]
}