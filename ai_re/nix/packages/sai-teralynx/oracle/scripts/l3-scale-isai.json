{
 "name": "l3-scale-isai: v4 /24 and v6 /64 until full on isai 6.2.0 (its own IFCS 0.16.2), untraced",
 "steps": [
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VIRTUAL_ROUTER_ID",
    "oid"
   ],
   "as": "vr"
  },
  {
   "op": "create_route",
   "desc": "default v4 DROP",
   "vr": "$vr",
   "prefix": "0.0.0.0/0",
   "attrs": [
    [
     "PACKET_ACTION",
     "s32",
     "DROP"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "default v6 DROP",
   "vr": "$vr",
   "prefix": "::/0",
   "attrs": [
    [
     "PACKET_ACTION",
     "s32",
     "DROP"
    ]
   ]
  },
  {
   "op": "create",
   "type": "ROUTER_INTERFACE",
   "as": "rifB",
   "desc": "RIF B",
   "attrs": [
    [
     "VIRTUAL_ROUTER_ID",
     "oid",
     "$vr"
    ],
    [
     "TYPE",
     "s32",
     "PORT"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[15]"
    ],
    [
     "SRC_MAC_ADDRESS",
     "mac",
     "02:00:00:00:01:0b"
    ],
    [
     "MTU",
     "u32",
     9100
    ]
   ]
  },
  {
   "op": "create_neighbor",
   "desc": "10.2.0.2",
   "rif": "$rifB",
   "ip": "10.2.0.2",
   "attrs": [
    [
     "DST_MAC_ADDRESS",
     "mac",
     "02:00:00:00:0b:02"
    ]
   ]
  },
  {
   "op": "create_neighbor",
   "desc": "fc00:2::2",
   "rif": "$rifB",
   "ip": "fc00:2::2",
   "attrs": [
    [
     "DST_MAC_ADDRESS",
     "mac",
     "02:00:00:00:0b:02"
    ]
   ]
  },
  {
   "op": "create",
   "type": "NEXT_HOP",
   "as": "nh",
   "desc": "10.2.0.2",
   "attrs": [
    [
     "TYPE",
     "s32",
     "IP"
    ],
    [
     "IP",
     "ip",
     "10.2.0.2"
    ],
    [
     "ROUTER_INTERFACE_ID",
     "oid",
     "$rifB"
    ]
   ]
  },
  {
   "op": "create",
   "type": "NEXT_HOP",
   "as": "nh6",
   "desc": "fc00:2::2",
   "attrs": [
    [
     "TYPE",
     "s32",
     "IP"
    ],
    [
     "IP",
     "ip",
     "fc00:2::2"
    ],
    [
     "ROUTER_INTERFACE_ID",
     "oid",
     "$rifB"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "desc": "CRM before",
   "attrs": [
    [
     "AVAILABLE_IPV4_ROUTE_ENTRY",
     "u32"
    ],
    [
     "AVAILABLE_IPV6_ROUTE_ENTRY",
     "u32"
    ]
   ]
  },
  {
   "op": "route_fill",
   "desc": "v4 /24 until full",
   "vr": "$vr",
   "prefix": "20.0.0.0/24",
   "count": 300000,
   "report": 5000,
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$nh"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "get",
   "obj": "switch",
   "desc": "CRM after v4",
   "attrs": [
    [
     "AVAILABLE_IPV4_ROUTE_ENTRY",
     "u32"
    ],
    [
     "AVAILABLE_IPV6_ROUTE_ENTRY",
     "u32"
    ]
   ]
  },
  {
   "op": "route_fill",
   "desc": "remove v4 /24",
   "vr": "$vr",
   "prefix": "20.0.0.0/24",
   "count": 300000,
   "report": 5000,
   "remove": true,
   "may_fail": true
  },
  {
   "op": "route_fill",
   "desc": "v6 /64 until full",
   "vr": "$vr",
   "prefix": "2001:db8:1::/64",
   "count": 150000,
   "report": 5000,
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$nh6"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "route_fill",
   "desc": "remove v6 /64",
   "vr": "$vr",
   "prefix": "2001:db8:1::/64",
   "count": 150000,
   "report": 5000,
   "remove": true,
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$nh"
  },
  {
   "op": "remove",
   "obj": "$nh6"
  },
  {
   "op": "remove_neighbor",
   "rif": "$rifB",
   "ip": "10.2.0.2"
  },
  {
   "op": "remove_neighbor",
   "rif": "$rifB",
   "ip": "fc00:2::2"
  },
  {
   "op": "remove",
   "obj": "$rifB"
  },
  {
   "op": "remove_route",
   "vr": "$vr",
   "prefix": "0.0.0.0/0"
  },
  {
   "op": "remove_route",
   "vr": "$vr",
   "prefix": "::/0"
  },
  {
   "op": "remove_switch"
  }
 ]
}