{
 "name": "lag-l2: LAG + members (egress/ingress disable), LAG bridge port in a VLAN, FDB on LAG/port, flush, learning, RIF on a LAG, hash fields/seeds (no traffic)",
 "steps": [
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ],
    [
     "PORT_STATE_CHANGE_NOTIFY",
     "ptr",
     "port_state"
    ],
    [
     "FDB_EVENT_NOTIFY",
     "ptr",
     "fdb"
    ],
    [
     "SWITCH_SHUTDOWN_REQUEST_NOTIFY",
     "ptr",
     "shutdown"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VIRTUAL_ROUTER_ID",
    "oid"
   ],
   "as": "vr"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_1Q_BRIDGE_ID",
    "oid"
   ],
   "as": "bridge"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VLAN_ID",
    "oid"
   ],
   "as": "vlan1"
  },
  {
   "op": "get",
   "obj": "$vlan1",
   "desc": "VLAN 1 members",
   "attr": [
    "MEMBER_LIST",
    "oidlist",
    64
   ],
   "as": "vmembers"
  },
  {
   "op": "foreach",
   "list": "vmembers",
   "as": "m",
   "steps": [
    {
     "op": "remove",
     "obj": "$m",
     "desc": "VLAN 1 member",
     "may_fail": true
    }
   ]
  },
  {
   "op": "get",
   "obj": "$bridge",
   "desc": "default bridge ports",
   "attr": [
    "PORT_LIST",
    "oidlist",
    128
   ],
   "as": "bports"
  },
  {
   "op": "foreach",
   "list": "bports",
   "as": "b",
   "steps": [
    {
     "op": "remove",
     "obj": "$b",
     "desc": "default bridge port",
     "may_fail": true
    }
   ]
  },
  {
   "op": "set",
   "obj": "switch",
   "desc": "aging 300",
   "attr": [
    "FDB_AGING_TIME",
    "u32",
    300
   ]
  },
  {
   "op": "create",
   "type": "LAG",
   "as": "lag1",
   "desc": "PortChannel1"
  },
  {
   "op": "create",
   "type": "LAG",
   "as": "lag2",
   "desc": "PortChannel2"
  },
  {
   "op": "create",
   "type": "LAG_MEMBER",
   "as": "lm1",
   "desc": "lag1 + Ethernet0",
   "attrs": [
    [
     "LAG_ID",
     "oid",
     "$lag1"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[0]"
    ]
   ]
  },
  {
   "op": "create",
   "type": "LAG_MEMBER",
   "as": "lm2",
   "desc": "lag2 + Ethernet120",
   "attrs": [
    [
     "LAG_ID",
     "oid",
     "$lag2"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[15]"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "$lag1",
   "attr": [
    "PORT_LIST",
    "oidlist",
    8
   ]
  },
  {
   "op": "set",
   "obj": "$lm1",
   "desc": "egress disable",
   "attr": [
    "EGRESS_DISABLE",
    "bool",
    true
   ]
  },
  {
   "op": "set",
   "obj": "$lm1",
   "desc": "ingress disable",
   "attr": [
    "INGRESS_DISABLE",
    "bool",
    true
   ]
  },
  {
   "op": "set",
   "obj": "$lm1",
   "desc": "egress enable",
   "attr": [
    "EGRESS_DISABLE",
    "bool",
    false
   ]
  },
  {
   "op": "set",
   "obj": "$lm1",
   "desc": "ingress enable",
   "attr": [
    "INGRESS_DISABLE",
    "bool",
    false
   ]
  },
  {
   "op": "create",
   "type": "LAG_MEMBER",
   "as": "lm_dis",
   "desc": "lag1 + Ethernet8 created disabled",
   "attrs": [
    [
     "LAG_ID",
     "oid",
     "$lag1"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[1]"
    ],
    [
     "EGRESS_DISABLE",
     "bool",
     true
    ],
    [
     "INGRESS_DISABLE",
     "bool",
     true
    ]
   ]
  },
  {
   "op": "remove",
   "obj": "$lm_dis",
   "desc": "Ethernet8 leaves lag1"
  },
  {
   "op": "create",
   "type": "BRIDGE_PORT",
   "as": "bp_lag1",
   "desc": "bridge port on lag1",
   "attrs": [
    [
     "TYPE",
     "s32",
     "PORT"
    ],
    [
     "PORT_ID",
     "oid",
     "$lag1"
    ],
    [
     "ADMIN_STATE",
     "bool",
     true
    ]
   ]
  },
  {
   "op": "create",
   "type": "VLAN",
   "as": "vlan100",
   "attrs": [
    [
     "VLAN_ID",
     "u16",
     100
    ]
   ]
  },
  {
   "op": "create",
   "type": "VLAN_MEMBER",
   "as": "vm_lag_t",
   "desc": "lag1 tagged in 100",
   "attrs": [
    [
     "VLAN_ID",
     "oid",
     "$vlan100"
    ],
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bp_lag1"
    ],
    [
     "VLAN_TAGGING_MODE",
     "s32",
     "TAGGED"
    ]
   ]
  },
  {
   "op": "remove",
   "obj": "$vm_lag_t",
   "desc": "tagged member"
  },
  {
   "op": "create",
   "type": "VLAN_MEMBER",
   "as": "vm_lag",
   "desc": "lag1 untagged in 100",
   "attrs": [
    [
     "VLAN_ID",
     "oid",
     "$vlan100"
    ],
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bp_lag1"
    ],
    [
     "VLAN_TAGGING_MODE",
     "s32",
     "UNTAGGED"
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$lag1",
   "desc": "lag1 pvid 100",
   "attr": [
    "PORT_VLAN_ID",
    "u16",
    100
   ]
  },
  {
   "op": "create",
   "type": "LAG_MEMBER",
   "as": "lm3",
   "desc": "Ethernet8 joins lag1 (in VLAN 100)",
   "attrs": [
    [
     "LAG_ID",
     "oid",
     "$lag1"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[1]"
    ]
   ]
  },
  {
   "op": "create_fdb",
   "desc": "static on lag1",
   "vlan": "$vlan100",
   "mac": "02:00:00:00:aa:01",
   "attrs": [
    [
     "TYPE",
     "s32",
     "STATIC"
    ],
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bp_lag1"
    ]
   ]
  },
  {
   "op": "create_fdb",
   "desc": "dynamic on lag1",
   "vlan": "$vlan100",
   "mac": "02:00:00:00:aa:02",
   "attrs": [
    [
     "TYPE",
     "s32",
     "DYNAMIC"
    ],
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bp_lag1"
    ]
   ]
  },
  {
   "op": "create_fdb",
   "desc": "drop on lag1",
   "vlan": "$vlan100",
   "mac": "02:00:00:00:aa:03",
   "attrs": [
    [
     "TYPE",
     "s32",
     "STATIC"
    ],
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bp_lag1"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "DROP"
    ]
   ]
  },
  {
   "op": "flush_fdb",
   "desc": "bp_lag1 dynamic",
   "attrs": [
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bp_lag1"
    ],
    [
     "ENTRY_TYPE",
     "s32",
     "DYNAMIC"
    ]
   ]
  },
  {
   "op": "flush_fdb",
   "desc": "vlan100 all",
   "attrs": [
    [
     "BV_ID",
     "oid",
     "$vlan100"
    ],
    [
     "ENTRY_TYPE",
     "s32",
     "ALL"
    ]
   ]
  },
  {
   "op": "create_fdb",
   "desc": "static on lag1 again",
   "vlan": "$vlan100",
   "mac": "02:00:00:00:aa:01",
   "attrs": [
    [
     "TYPE",
     "s32",
     "STATIC"
    ],
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bp_lag1"
    ]
   ]
  },
  {
   "op": "remove_fdb",
   "vlan": "$vlan100",
   "mac": "02:00:00:00:aa:01"
  },
  {
   "op": "remove",
   "obj": "$lm3",
   "desc": "Ethernet8 leaves lag1 (in VLAN 100)"
  },
  {
   "op": "set",
   "obj": "$bp_lag1",
   "desc": "learning off",
   "attr": [
    "FDB_LEARNING_MODE",
    "s32",
    "DISABLE"
   ]
  },
  {
   "op": "set",
   "obj": "$bp_lag1",
   "desc": "learning hw",
   "attr": [
    "FDB_LEARNING_MODE",
    "s32",
    "HW"
   ]
  },
  {
   "op": "remove",
   "obj": "$vm_lag"
  },
  {
   "op": "set",
   "obj": "$lag1",
   "desc": "lag1 pvid 1",
   "attr": [
    "PORT_VLAN_ID",
    "u16",
    1
   ]
  },
  {
   "op": "remove",
   "obj": "$bp_lag1"
  },
  {
   "op": "remove",
   "obj": "$vlan100"
  },
  {
   "op": "create",
   "type": "BRIDGE_PORT",
   "as": "bp_p1",
   "desc": "bridge port Ethernet8",
   "attrs": [
    [
     "TYPE",
     "s32",
     "PORT"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[1]"
    ],
    [
     "ADMIN_STATE",
     "bool",
     true
    ]
   ]
  },
  {
   "op": "create",
   "type": "VLAN",
   "as": "vlan200",
   "attrs": [
    [
     "VLAN_ID",
     "u16",
     200
    ]
   ]
  },
  {
   "op": "create",
   "type": "VLAN_MEMBER",
   "as": "vm_p1",
   "desc": "Ethernet8 untagged in 200",
   "attrs": [
    [
     "VLAN_ID",
     "oid",
     "$vlan200"
    ],
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bp_p1"
    ],
    [
     "VLAN_TAGGING_MODE",
     "s32",
     "UNTAGGED"
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[1]",
   "desc": "pvid 200",
   "attr": [
    "PORT_VLAN_ID",
    "u16",
    200
   ]
  },
  {
   "op": "create_fdb",
   "desc": "static on Ethernet8",
   "vlan": "$vlan200",
   "mac": "02:00:00:00:bb:01",
   "attrs": [
    [
     "TYPE",
     "s32",
     "STATIC"
    ],
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bp_p1"
    ]
   ]
  },
  {
   "op": "flush_fdb",
   "desc": "bp_p1 static",
   "attrs": [
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bp_p1"
    ],
    [
     "ENTRY_TYPE",
     "s32",
     "STATIC"
    ]
   ]
  },
  {
   "op": "remove",
   "obj": "$vm_p1"
  },
  {
   "op": "set",
   "obj": "$ports[1]",
   "desc": "pvid 1",
   "attr": [
    "PORT_VLAN_ID",
    "u16",
    1
   ]
  },
  {
   "op": "remove",
   "obj": "$bp_p1"
  },
  {
   "op": "remove",
   "obj": "$vlan200"
  },
  {
   "op": "create",
   "type": "ROUTER_INTERFACE",
   "as": "rif_lag2",
   "desc": "port RIF on lag2",
   "attrs": [
    [
     "VIRTUAL_ROUTER_ID",
     "oid",
     "$vr"
    ],
    [
     "TYPE",
     "s32",
     "PORT"
    ],
    [
     "PORT_ID",
     "oid",
     "$lag2"
    ],
    [
     "SRC_MAC_ADDRESS",
     "mac",
     "02:00:00:00:02:01"
    ]
   ]
  },
  {
   "op": "create_neighbor",
   "desc": "neighbor on lag2",
   "rif": "$rif_lag2",
   "ip": "10.98.0.2",
   "attrs": [
    [
     "DST_MAC_ADDRESS",
     "mac",
     "02:00:00:00:02:02"
    ]
   ]
  },
  {
   "op": "create",
   "type": "NEXT_HOP",
   "as": "nh",
   "desc": "nh on lag2",
   "attrs": [
    [
     "TYPE",
     "s32",
     "IP"
    ],
    [
     "IP",
     "ip",
     "10.98.0.2"
    ],
    [
     "ROUTER_INTERFACE_ID",
     "oid",
     "$rif_lag2"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "10.97.0.0/24 via lag2",
   "vr": "$vr",
   "prefix": "10.97.0.0/24",
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$nh"
    ]
   ]
  },
  {
   "op": "remove_route",
   "vr": "$vr",
   "prefix": "10.97.0.0/24"
  },
  {
   "op": "remove",
   "obj": "$nh"
  },
  {
   "op": "remove_neighbor",
   "rif": "$rif_lag2",
   "ip": "10.98.0.2"
  },
  {
   "op": "remove",
   "obj": "$rif_lag2"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "LAG_HASH",
    "oid"
   ],
   "as": "lag_hash",
   "may_fail": true
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "ECMP_HASH",
    "oid"
   ],
   "as": "ecmp_hash",
   "may_fail": true
  },
  {
   "op": "get",
   "obj": "$lag_hash",
   "desc": "lag hash fields",
   "attr": [
    "NATIVE_HASH_FIELD_LIST",
    "u32list",
    16
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$lag_hash",
   "desc": "lag hash 5-tuple",
   "attr": [
    "NATIVE_HASH_FIELD_LIST",
    "u32list",
    [
     "SRC_IP",
     "DST_IP",
     "IP_PROTOCOL",
     "L4_SRC_PORT",
     "L4_DST_PORT"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ecmp_hash",
   "desc": "ecmp hash 5-tuple + in port",
   "attr": [
    "NATIVE_HASH_FIELD_LIST",
    "u32list",
    [
     "SRC_IP",
     "DST_IP",
     "IP_PROTOCOL",
     "L4_SRC_PORT",
     "L4_DST_PORT",
     "IN_PORT"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$lag_hash",
   "desc": "lag hash L2",
   "attr": [
    "NATIVE_HASH_FIELD_LIST",
    "u32list",
    [
     "SRC_MAC",
     "DST_MAC",
     "ETHERTYPE",
     "VLAN_ID"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "switch",
   "desc": "lag seed",
   "attr": [
    "LAG_DEFAULT_HASH_SEED",
    "u32",
    10
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "switch",
   "desc": "ecmp seed",
   "attr": [
    "ECMP_DEFAULT_HASH_SEED",
    "u32",
    10
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "switch",
   "desc": "lag algo crc",
   "attr": [
    "LAG_DEFAULT_HASH_ALGORITHM",
    "s32",
    "CRC"
   ],
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$lm1"
  },
  {
   "op": "remove",
   "obj": "$lm2"
  },
  {
   "op": "remove",
   "obj": "$lag1"
  },
  {
   "op": "remove",
   "obj": "$lag2"
  },
  {
   "op": "remove_switch"
  }
 ]
}
