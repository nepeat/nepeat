{
 "name": "perf: link state, speed and counters on every port, right after init and 5 s later",
 "steps": [
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ],
    [
     "PORT_STATE_CHANGE_NOTIFY",
     "ptr",
     "port_state"
    ],
    [
     "SWITCH_SHUTDOWN_REQUEST_NOTIFY",
     "ptr",
     "shutdown"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "foreach",
   "list": "ports",
   "as": "p",
   "steps": [
    {
     "op": "get",
     "obj": "$p",
     "desc": "oper",
     "attr": [
      "OPER_STATUS",
      "s32"
     ]
    }
   ]
  },
  {
   "op": "foreach",
   "list": "ports",
   "as": "p",
   "steps": [
    {
     "op": "get",
     "obj": "$p",
     "desc": "speed",
     "attr": [
      "SPEED",
      "u32"
     ]
    }
   ]
  },
  {
   "op": "foreach",
   "list": "ports",
   "as": "p",
   "steps": [
    {
     "op": "stats",
     "obj": "$p",
     "desc": "stats x4",
     "ids": [
      "IF_IN_OCTETS",
      "IF_IN_UCAST_PKTS",
      "IF_OUT_OCTETS",
      "IF_OUT_UCAST_PKTS"
     ]
    }
   ]
  },
  {
   "op": "sleep",
   "ms": 5000
  },
  {
   "op": "foreach",
   "list": "ports",
   "as": "p",
   "steps": [
    {
     "op": "get",
     "obj": "$p",
     "desc": "oper (+5 s)",
     "attr": [
      "OPER_STATUS",
      "s32"
     ]
    }
   ]
  },
  {
   "op": "foreach",
   "list": "ports",
   "as": "p",
   "steps": [
    {
     "op": "get",
     "obj": "$p",
     "desc": "speed (+5 s)",
     "attr": [
      "SPEED",
      "u32"
     ]
    }
   ]
  },
  {
   "op": "foreach",
   "list": "ports",
   "as": "p",
   "steps": [
    {
     "op": "stats",
     "obj": "$p",
     "desc": "stats x4 (+5 s)",
     "ids": [
      "IF_IN_OCTETS",
      "IF_IN_UCAST_PKTS",
      "IF_OUT_OCTETS",
      "IF_OUT_UCAST_PKTS"
     ]
    }
   ]
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "get",
   "obj": "$ports[0]",
   "desc": "port0 after admin up",
   "attr": [
    "OPER_STATUS",
    "s32"
   ]
  },
  {
   "op": "get",
   "obj": "$ports[0]",
   "desc": "port0 again",
   "attr": [
    "OPER_STATUS",
    "s32"
   ]
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "ADMIN_STATE",
    "bool",
    false
   ]
  },
  {
   "op": "remove_switch"
  }
 ]
}
