{
 "name": "mirror: SPAN (local), ERSPAN (GRE), port ingress/egress mirror, samplepacket on a port, sFlow genetlink hostif + SAMPLEPACKET trap (no traffic)",
 "steps": [
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ],
    [
     "PORT_STATE_CHANGE_NOTIFY",
     "ptr",
     "port_state"
    ],
    [
     "SWITCH_SHUTDOWN_REQUEST_NOTIFY",
     "ptr",
     "shutdown"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "set",
   "obj": "$ports[15]",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "sleep",
   "ms": 2000
  },
  {
   "op": "create",
   "type": "MIRROR_SESSION",
   "desc": "SPAN to Ethernet120",
   "as": "span",
   "attrs": [
    [
     "TYPE",
     "s32",
     "LOCAL"
    ],
    [
     "MONITOR_PORT",
     "oid",
     "$ports[15]"
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "INGRESS_MIRROR_SESSION",
    "oids",
    [
     "$span"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "EGRESS_MIRROR_SESSION",
    "oids",
    [
     "$span"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "get",
   "obj": "$span",
   "attrs": [
    [
     "TYPE",
     "s32"
    ],
    [
     "MONITOR_PORT",
     "oid"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$span",
   "desc": "monitor -> Ethernet8",
   "attr": [
    "MONITOR_PORT",
    "oid",
    "$ports[1]"
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "INGRESS_MIRROR_SESSION",
    "oids",
    []
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "EGRESS_MIRROR_SESSION",
    "oids",
    []
   ],
   "may_fail": true
  },
  {
   "op": "create",
   "type": "MIRROR_SESSION",
   "desc": "SPAN truncate 128",
   "as": "span_t",
   "attrs": [
    [
     "TYPE",
     "s32",
     "LOCAL"
    ],
    [
     "MONITOR_PORT",
     "oid",
     "$ports[15]"
    ],
    [
     "TRUNCATE_SIZE",
     "u16",
     128
    ]
   ],
   "may_fail": true
  },
  {
   "op": "create",
   "type": "MIRROR_SESSION",
   "desc": "ERSPAN GRE",
   "as": "erspan",
   "attrs": [
    [
     "TYPE",
     "s32",
     "ENHANCED_REMOTE"
    ],
    [
     "MONITOR_PORT",
     "oid",
     "$ports[15]"
    ],
    [
     "ERSPAN_ENCAPSULATION_TYPE",
     "s32",
     "MIRROR_L3_GRE_TUNNEL"
    ],
    [
     "IPHDR_VERSION",
     "u8",
     4
    ],
    [
     "TOS",
     "u8",
     32
    ],
    [
     "TTL",
     "u8",
     64
    ],
    [
     "SRC_IP_ADDRESS",
     "ip",
     "10.99.1.1"
    ],
    [
     "DST_IP_ADDRESS",
     "ip",
     "10.99.1.2"
    ],
    [
     "SRC_MAC_ADDRESS",
     "mac",
     "02:00:00:00:01:20"
    ],
    [
     "DST_MAC_ADDRESS",
     "mac",
     "02:00:00:00:01:21"
    ],
    [
     "GRE_PROTOCOL_TYPE",
     "u16",
     35006
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "INGRESS_MIRROR_SESSION",
    "oids",
    [
     "$erspan"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$erspan",
   "desc": "dst ip",
   "attr": [
    "DST_IP_ADDRESS",
    "ip",
    "10.99.1.3"
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$erspan",
   "desc": "dst mac",
   "attr": [
    "DST_MAC_ADDRESS",
    "mac",
    "02:00:00:00:01:22"
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "INGRESS_MIRROR_SESSION",
    "oids",
    []
   ],
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$erspan",
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$span_t",
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$span",
   "may_fail": true
  },
  {
   "op": "create",
   "type": "SAMPLEPACKET",
   "desc": "1 in 1000",
   "as": "sp",
   "attrs": [
    [
     "SAMPLE_RATE",
     "u32",
     1000
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "INGRESS_SAMPLEPACKET_ENABLE",
    "oid",
    "$sp"
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$sp",
   "desc": "1 in 500",
   "attr": [
    "SAMPLE_RATE",
    "u32",
    500
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "EGRESS_SAMPLEPACKET_ENABLE",
    "oid",
    "$sp"
   ],
   "may_fail": true
  },
  {
   "op": "create",
   "type": "HOSTIF",
   "desc": "genetlink psample",
   "as": "gnl",
   "attrs": [
    [
     "TYPE",
     "s32",
     "GENETLINK"
    ],
    [
     "NAME",
     "chardata",
     "psample"
    ],
    [
     "GENETLINK_MCGRP_NAME",
     "chardata",
     "packets"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP_GROUP",
   "desc": "sflow group queue 2",
   "as": "tg",
   "attrs": [
    [
     "QUEUE",
     "u32",
     2
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "desc": "SAMPLEPACKET",
   "as": "trap",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "SAMPLEPACKET"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$tg"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "create",
   "type": "HOSTIF_TABLE_ENTRY",
   "desc": "trap -> genetlink",
   "as": "te",
   "attrs": [
    [
     "TYPE",
     "s32",
     "TRAP_ID"
    ],
    [
     "TRAP_ID",
     "oid",
     "$trap"
    ],
    [
     "CHANNEL_TYPE",
     "s32",
     "GENETLINK"
    ],
    [
     "HOST_IF",
     "oid",
     "$gnl"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "sleep",
   "ms": 500
  },
  {
   "op": "remove",
   "obj": "$te",
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$trap",
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$tg",
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$gnl",
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "EGRESS_SAMPLEPACKET_ENABLE",
    "oid",
    "null"
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[0]",
   "attr": [
    "INGRESS_SAMPLEPACKET_ENABLE",
    "oid",
    "null"
   ],
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$sp",
   "may_fail": true
  },
  {
   "op": "remove_switch"
  }
 ]
}