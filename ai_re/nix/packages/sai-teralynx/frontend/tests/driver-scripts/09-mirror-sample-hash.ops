# Mirror sessions (SPAN, ERSPAN) and port mirroring, SAMPLEPACKET on a port, the switch's LAG /
# ECMP hash objects, storm control and VLAN flood control (optional backend groups on).
switch
feature mirror on
create mirror_session span TYPE=LOCAL MONITOR_PORT=port2
set port port1 INGRESS_MIRROR_SESSION=[span]
set port port1 EGRESS_MIRROR_SESSION=[span]
get port port1 INGRESS_MIRROR_SESSION
set mirror_session span MONITOR_PORT=port3
create mirror_session er TYPE=ENHANCED_REMOTE MONITOR_PORT=port2 ERSPAN_ENCAPSULATION_TYPE=MIRROR_L3_GRE_TUNNEL IPHDR_VERSION=4 TOS=32 TTL=64 SRC_IP_ADDRESS=10.99.1.1 DST_IP_ADDRESS=10.99.1.2 SRC_MAC_ADDRESS=10:11:12:13:14:15 DST_MAC_ADDRESS=20:21:22:23:24:25 GRE_PROTOCOL_TYPE=0x88be
set mirror_session er DST_IP_ADDRESS=10.99.1.3
set port port1 INGRESS_MIRROR_SESSION=[]
set port port1 EGRESS_MIRROR_SESSION=[]
remove mirror_session er
remove mirror_session span
create samplepacket smp SAMPLE_RATE=1000
set port port1 INGRESS_SAMPLEPACKET_ENABLE=smp
set samplepacket smp SAMPLE_RATE=500
remove samplepacket smp
set port port1 INGRESS_SAMPLEPACKET_ENABLE=null
remove samplepacket smp
feature mirror off
get switch switch LAG_HASH
feature l2 on
get switch switch LAG_HASH ECMP_HASH
set hash hash#2 NATIVE_HASH_FIELD_LIST=[SRC_IP,DST_IP,L4_SRC_PORT]
get hash hash#2 NATIVE_HASH_FIELD_LIST
set switch switch LAG_DEFAULT_HASH_SEED=77
create policer sp METER_TYPE=PACKETS MODE=SR_TCM CIR=1000 CBS=1000
set port port1 FLOOD_STORM_CONTROL_POLICER_ID=sp
create vlan v300 VLAN_ID=300
set vlan v300 BROADCAST_FLOOD_CONTROL_TYPE=NONE
set vlan v300 BROADCAST_FLOOD_CONTROL_TYPE=ALL
set port port1 FLOOD_STORM_CONTROL_POLICER_ID=null
remove policer sp
remove vlan v300
feature l2 off
remove_switch
