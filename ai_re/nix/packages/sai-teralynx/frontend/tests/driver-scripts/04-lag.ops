# LAG: members (created disabled, then collecting / distributing), PVID, a bridge port and a
# VLAN on the LAG applied to every member, a member joining later, FDB on the trunk, a router
# interface on the LAG, teardown.
switch
get vlan vlan1 MEMBER_LIST
remove vlan_member vlan_member#5
remove bridge_port bport4
remove vlan_member vlan_member#6
remove bridge_port bport5
remove vlan_member vlan_member#7
remove bridge_port bport6
create lag lag1
get lag lag1 PORT_VLAN_ID TPID PORT_LIST
create lag_member lm4 LAG_ID=lag1 PORT_ID=port4 EGRESS_DISABLE=true INGRESS_DISABLE=true
set lag_member lm4 INGRESS_DISABLE=false
set lag_member lm4 EGRESS_DISABLE=false
create lag_member lm5 LAG_ID=lag1 PORT_ID=port5
create lag_member lmx LAG_ID=lag1 PORT_ID=port7
get lag lag1 PORT_LIST
set lag lag1 PORT_VLAN_ID=300
create bridge_port lbp TYPE=PORT PORT_ID=lag1 FDB_LEARNING_MODE=DISABLE
set bridge_port lbp FDB_LEARNING_MODE=HW
create vlan v300 VLAN_ID=300
create vlan_member vm VLAN_ID=v300 BRIDGE_PORT_ID=lbp VLAN_TAGGING_MODE=TAGGED
set vlan_member vm VLAN_TAGGING_MODE=UNTAGGED
create lag_member lm6 LAG_ID=lag1 PORT_ID=port6
remove lag_member lm6
create fdb_entry 00:11:22:33:44:91@v300 TYPE=STATIC BRIDGE_PORT_ID=lbp
inject fdb learned 00:aa:bb:cc:dd:92 300 lag1
flush BRIDGE_PORT_ID=lbp ENTRY_TYPE=DYNAMIC
remove fdb_entry 00:11:22:33:44:91@v300
remove vlan_member vm
remove vlan v300
remove bridge_port lbp
create router_interface lrif VIRTUAL_ROUTER_ID=vr0 TYPE=PORT PORT_ID=lag1
get lag lag1 PORT_VLAN_ID
create neighbor_entry 10.1.0.2@lrif DST_MAC_ADDRESS=00:00:5e:00:53:07
remove lag lag1
remove neighbor_entry 10.1.0.2@lrif
remove router_interface lrif
remove lag_member lm4
remove lag_member lm5
remove lag lag1
remove_switch
