# QoS on a backend with the QoS group on: maps (complete tables, port binding, update),
# default TC, PFC, schedulers on scheduler groups / queues / the port, WRED, buffer pools and
# profiles on queues and PGs; first the same objects with the group off (kept, not programmed).
switch
create qos_map m0 TYPE=DSCP_TO_TC MAP_TO_VALUE_LIST=[dscp:46=tc:5]
set port port1 QOS_DSCP_TO_TC_MAP=m0
set port port1 QOS_DSCP_TO_TC_MAP=null
remove qos_map m0
feature qos on
get port port1 QOS_NUMBER_OF_SCHEDULER_GROUPS QOS_SCHEDULER_GROUP_LIST QOS_QUEUE_LIST
create qos_map m1 TYPE=DSCP_TO_TC MAP_TO_VALUE_LIST=[dscp:46=tc:5,dscp:8=tc:1]
set port port1 QOS_DSCP_TO_TC_MAP=m1
create qos_map md TYPE=DOT1P_TO_TC MAP_TO_VALUE_LIST=[dot1p:5=tc:3]
set port port1 QOS_DSCP_TO_TC_MAP=md
set qos_map m1 MAP_TO_VALUE_LIST=[dscp:46=tc:7]
get qos_map md TYPE MAP_TO_VALUE_LIST
set port port1 QOS_DEFAULT_TC=3
set port port1 PRIORITY_FLOW_CONTROL=0x18
create scheduler sd SCHEDULING_TYPE=DWRR SCHEDULING_WEIGHT=20
create scheduler sh SCHEDULING_TYPE=DWRR SCHEDULING_WEIGHT=1 MAX_BANDWIDTH_RATE=125000000 MAX_BANDWIDTH_BURST_RATE=65536
set scheduler_group scheduler_group#4 SCHEDULER_PROFILE_ID=sd
set scheduler sd SCHEDULING_WEIGHT=50
set port port1 QOS_SCHEDULER_PROFILE_ID=sh
create wred w GREEN_ENABLE=true GREEN_MIN_THRESHOLD=100000 GREEN_MAX_THRESHOLD=2000000 GREEN_DROP_PROBABILITY=5 ECN_MARK_MODE=GREEN
set queue queue#4 WRED_PROFILE_ID=w
create buffer_pool pin TYPE=INGRESS SIZE=20000000 THRESHOLD_MODE=DYNAMIC
create buffer_pool peg TYPE=EGRESS SIZE=10000000 THRESHOLD_MODE=DYNAMIC
create buffer_profile bq POOL_ID=peg RESERVED_BUFFER_SIZE=1518 SHARED_DYNAMIC_TH=3
set queue queue#1 BUFFER_PROFILE_ID=bq
stats queue queue#4 PACKETS BYTES
set queue queue#1 BUFFER_PROFILE_ID=null
set queue queue#4 WRED_PROFILE_ID=null
set port port1 QOS_SCHEDULER_PROFILE_ID=null
set scheduler_group scheduler_group#4 SCHEDULER_PROFILE_ID=null
set port port1 QOS_DSCP_TO_TC_MAP=null
remove buffer_profile bq
remove buffer_pool pin
remove buffer_pool peg
remove wred w
remove scheduler sd
remove scheduler sh
remove qos_map m1
remove qos_map md
feature qos off
remove_switch
