      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"$job\",mode=\"idle\"}[$__rate_interval])))",
