    {
      "id": 9,
      "type": "stat",
      "title": "NIC traffic (up links)",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(node_network_receive_bytes_total{job=\"$job\",exported_device!~\"lo|veth.*|docker.*|br-.*|virbr.*|podman.*\"}[$__rate_interval]) * 8 and on (exported_device) (node_network_up{job=\"$job\"} == 1))",
          "legendFormat": "rx",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(node_network_transmit_bytes_total{job=\"$job\",exported_device!~\"lo|veth.*|docker.*|br-.*|virbr.*|podman.*\"}[$__rate_interval]) * 8 and on (exported_device) (node_network_up{job=\"$job\"} == 1))",
          "legendFormat": "tx",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "B"
        }
      ],
      "description": "Sum over interfaces that are up, except loopback and virtual bridges; on the switch that is the management port (eth0). Per interface: Node details.",
