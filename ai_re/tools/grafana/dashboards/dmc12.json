      "id": 10,
      "type": "stat",
      "title": "Power inputs",
      "description": "CPLD 0x11. A unit with one PSU cabled shows the other absent (u01: PSU2 only).",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (psu) (dmc12_psu_present{job=\"$job\",instance=~\"$instance\"})",
