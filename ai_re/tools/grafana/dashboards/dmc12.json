      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(dmc12_cpld_alarm{job=\"$job\",instance=~\"$instance\"} > bool dmc12_cpld_alarm_masked{job=\"$job\",instance=~\"$instance\"})",
