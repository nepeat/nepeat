    {
      "id": 11,
      "type": "stat",
      "title": "Unmasked alarms",
      "description": "CPLD interrupt bits asserted (0x20, active low) and not masked by dmc12-interruptmon (0x21). It masks a handled alarm for 60 s, then re-checks.",
