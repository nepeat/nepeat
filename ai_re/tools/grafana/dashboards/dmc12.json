{
  "uid": "ai-re-dmc12",
  "title": "DMC-12 console server",
  "description": "Edgecore DMC-12-48R-AS0: CPLD fans, PSUs and alarms, board temperatures, serial ports (dmc12_* from dmc12-metrics).",
  "tags": [
    "ai_re"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
