      "type": "timeseries",
      "title": "RX power per lane",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "10 * log10(switch_optic_rx_power_watts{job=\"$job\",device=~\"$device\",instance=~\"$instance\"} * 1000)",
          "legendFormat": "port {{port}} lane {{lane}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "description": "10 * log10(switch_optic_rx_power_watts * 1000). Dashed: -9 dBm (orange) and -12 dBm (red).",
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
