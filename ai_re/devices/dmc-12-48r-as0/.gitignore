# Private to this unit: raw console captures can hold the U-Boot env, keys.
*-private.txt
serial-*.txt
# Disk/flash images (raw and .zst) and build outputs stay local.
# Per unit: dumps/<unit>/; only the manifest and hash list are tracked.
dumps/**
!dumps/*/
!dumps/*/manifest.jsonl
!dumps/*/SHA256SUMS
nixos-build/
__pycache__/
