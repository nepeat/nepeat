init all
vlan remove 1 pbm=ce,xe
port ce,xe en=0
vlan create 101 pbm=ce0 ubm=ce0
vlan create 102 pbm=ce1 ubm=ce1
pvlan set ce0 101
pvlan set ce1 102
port ce0,ce1 an=off if=CAUI sp=100000 en=1
m CLMAC_TX_CTRL.ce0 AVERAGE_IPG=16
m CLMAC_TX_CTRL.ce1 AVERAGE_IPG=16
sleep 5
echo == PS
ps ce0,ce1
phy info
clear c
tx 1000 pbm=ce0 vlan=101 length=256
sleep 2
tx 500 pbm=ce1 vlan=102 length=1024
sleep 2
echo == COUNTERS
show c ce0,ce1
echo == PS2
ps ce0,ce1
port ce0,ce1 en=0
exit
