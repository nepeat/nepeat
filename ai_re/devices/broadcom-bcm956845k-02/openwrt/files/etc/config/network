config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'management'
	option device 'eth0'
	option proto 'dhcp'

# Native bridge/VLAN configuration is reconciled into the ASIC.
config device 'switch_bridge'
	option name 'br-switch'
	option type 'bridge'
	option vlan_filtering '1'
	option igmp_snooping '0'
	option macaddr '02:10:18:56:ff:00'
	list ports 'swp1'
	list ports 'swp2'
	list ports 'swp3'
	list ports 'swp4'
	list ports 'swp5'
	list ports 'swp6'
	list ports 'swp7'
	list ports 'swp8'
	list ports 'swp9'
	list ports 'swp10'
	list ports 'swp11'
	list ports 'swp12'
	list ports 'swp13'
	list ports 'swp14'
	list ports 'swp15'
	list ports 'swp16'

config bridge-vlan 'switch_vlan1'
	option device 'br-switch'
	option vlan '1'
	list ports 'swp1:u*'
	list ports 'swp2:u*'
	list ports 'swp3:u*'
	list ports 'swp4:u*'
	list ports 'swp5:u*'
	list ports 'swp6:u*'
	list ports 'swp7:u*'
	list ports 'swp8:u*'
	list ports 'swp9:u*'
	list ports 'swp10:u*'
	list ports 'swp11:u*'
	list ports 'swp12:u*'
	list ports 'swp13:u*'
	list ports 'swp14:u*'
	list ports 'swp15:u*'
	list ports 'swp16:u*'

config interface 'switch'
	option proto 'none'
	option device 'br-switch.1'
