/* RAM-only isolated L3 proof; cleanup with l3-cleanup.cint. */
int offload_egr = -1;
int offload_capture_group = -1;
int offload_capture_entry = -1;
int offload_previous_mode = 0;
int offload_configure() {
    int rv;
    int i;
    bcm_l3_intf_t in_rif;
    bcm_l3_intf_t out_rif;
    bcm_l3_egress_t next_hop;
    bcm_l3_route_t route;
    bcm_l2_addr_t capture;
    bcm_field_qset_t capture_qset;
    bcm_mac_t ingress_mac = {0x02,0x10,0x18,0xaa,0x01,0x01};
    bcm_mac_t egress_mac = {0x02,0x10,0x18,0xaa,0x02,0x01};
    bcm_mac_t peer_mac = {0x02,0x10,0x18,0xbb,0x02,0x02};
    rv = bcm_switch_control_get(0, bcmSwitchL3EgressMode, &offload_previous_mode);
    printf("old egress mode: %d, status %d\n",offload_previous_mode,rv);
    if(rv<0) return rv;
    rv = bcm_switch_control_set(0,bcmSwitchL3EgressMode,1);
    printf("egress mode: %d\n",rv);
    if(rv<0) return rv;
    bcm_l3_intf_t_init(&in_rif);
    in_rif.l3a_intf_id=4001;
    in_rif.l3a_vid=4001;
    in_rif.l3a_mtu=1500;
    in_rif.l3a_flags=BCM_L3_WITH_ID|BCM_L3_ADD_TO_ARL;
    for(i=0;i<6;i++) in_rif.l3a_mac_addr[i]=ingress_mac[i];
    rv=bcm_l3_intf_create(0,&in_rif);
    printf("ingress RIF: %d\n",rv);
    if(rv<0) return rv;
    bcm_l3_intf_t_init(&out_rif);
    out_rif.l3a_intf_id=4002;
    out_rif.l3a_vid=4002;
    out_rif.l3a_mtu=1500;
    out_rif.l3a_flags=BCM_L3_WITH_ID|BCM_L3_ADD_TO_ARL;
    for(i=0;i<6;i++) out_rif.l3a_mac_addr[i]=egress_mac[i];
    rv=bcm_l3_intf_create(0,&out_rif);
    printf("egress RIF: %d\n",rv);
    if(rv<0) return rv;
    bcm_l3_egress_t_init(&next_hop);
    next_hop.intf=4002;
    next_hop.vlan=4002;
    next_hop.port=16;
    for(i=0;i<6;i++) next_hop.mac_addr[i]=peer_mac[i];
    rv=bcm_l3_egress_create(0,0,&next_hop,&offload_egr);
    printf("next hop: %d, id %d\n",rv,offload_egr);
    if(rv<0) return rv;
    bcm_l3_route_t_init(&route);
    route.l3a_subnet=0xc6130200;
    route.l3a_ip_mask=0xffffff00;
    route.l3a_intf=offload_egr;
    rv=bcm_l3_route_add(0,&route);
    printf("route: %d\n",rv);
    if(rv<0) return rv;
    /* Capture only after physical egress MAC loopback, not at ingress. */
    bcm_l2_addr_t_init(&capture,peer_mac,4002);
    capture.flags=BCM_L2_STATIC;
    capture.port=0;
    rv=bcm_l2_addr_add(0,&capture);
    printf("egress capture entry: %d\n",rv);
    if(rv<0) return rv;
    /* Instrumentation: capture only after the egress MAC loopback, then
       drop to prevent recirculation or source-station learning effects. */
    BCM_FIELD_QSET_INIT(capture_qset);
    BCM_FIELD_QSET_ADD(capture_qset,bcmFieldQualifyInPort);
    rv=bcm_field_group_create(0,capture_qset,1000,&offload_capture_group);
    printf("capture field group: %d\n",rv);
    if(rv<0) return rv;
    rv=bcm_field_entry_create(0,offload_capture_group,&offload_capture_entry);
    printf("capture field entry: %d\n",rv);
    if(rv<0) return rv;
    rv=bcm_field_qualify_InPort(0,offload_capture_entry,16,0xff);
    printf("capture ingress-port qualifier: %d\n",rv);
    if(rv<0) return rv;
    rv=bcm_field_action_add(0,offload_capture_entry,bcmFieldActionCopyToCpu,0,0);
    printf("capture CPU action: %d\n",rv);
    if(rv<0) return rv;
    rv=bcm_field_action_add(0,offload_capture_entry,bcmFieldActionDrop,0,0);
    printf("capture drop action: %d\n",rv);
    if(rv<0) return rv;
    rv=bcm_field_entry_install(0,offload_capture_entry);
    printf("capture install: %d\n",rv);
    if(rv<0) return rv;
    printf("OFFLOAD_SETUP_OK\n");
    return 0;
}
print offload_configure();
