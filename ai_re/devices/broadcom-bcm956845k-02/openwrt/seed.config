CONFIG_TARGET_mpc85xx=y
CONFIG_TARGET_mpc85xx_bcm98548=y
CONFIG_TARGET_mpc85xx_bcm98548_DEVICE_broadcom_bcm98548xmc=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_PACKAGE_mtd is not set
# CONFIG_PACKAGE_uboot-envtools is not set
# CONFIG_PACKAGE_swconfig is not set
# CONFIG_PACKAGE_kmod-ath9k is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-crypto-hw-talitos is not set
# CONFIG_PACKAGE_kmod-input-core is not set
# CONFIG_PACKAGE_kmod-input-gpio-keys is not set
# CONFIG_PACKAGE_kmod-button-hotplug is not set
# CONFIG_PACKAGE_kmod-leds-gpio is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_px5g-mbedtls=y
CONFIG_PACKAGE_libustream-mbedtls=y
# CONFIG_PACKAGE_luci-app-firewall is not set
# CONFIG_PACKAGE_firewall is not set
CONFIG_PACKAGE_kmod-bcm-bde-compat=y
CONFIG_PACKAGE_bcm-sdk-control=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="OpenWrt"
CONFIG_VERSION_NUMBER="25.12.1"
CONFIG_VERSION_CODE="(emma’s version)"
# CONFIG_VERSION_CODE_FILENAMES is not set
CONFIG_VERSION_MANUFACTURER="emma"
CONFIG_VERSION_PRODUCT="BCM98548XMC RAM netboot prototype"
CONFIG_KERNEL_PRINTK_TIME=y

CONFIG_PACKAGE_kmod-tun=y

CONFIG_PACKAGE_ip-bridge=y
