#!/bin/sh
case "$1" in
    list) echo '{"status":{},"apply":{}}';;
    call)
        read -r request || :
        case "$2" in
            status) exec /usr/libexec/bcm-switch status;;
            apply) exec /usr/libexec/bcm-switch reconcile;;
            *) echo '{"ok":false,"message":"unknown method"}';;
        esac;;
esac
