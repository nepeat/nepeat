#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/bcm-network-watch
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
reload_service() {
    /usr/libexec/bcm-switch apply >/dev/null 2>&1 || true
}
service_triggers() {
    procd_add_reload_trigger network
}
