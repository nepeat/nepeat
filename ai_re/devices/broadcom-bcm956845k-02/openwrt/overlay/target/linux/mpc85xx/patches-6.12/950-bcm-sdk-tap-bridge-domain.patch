+/* The SDK controller owns hardware objects. These hooks identify a shared
+ * ingress forwarding domain so bridge CPU copies are not flooded twice.
+ * No TX forwarding offload is advertised: CPU-originated frames use each TAP.
+ */
+static int tun_bcm_parent_id(struct net_device *dev, struct netdev_phys_item_id *id)
+{
+    struct tun_struct *tun = netdev_priv(dev);
+    if (!tun->bcm_offload)
+        return -EOPNOTSUPP;
+    memcpy(id->id, "bcm56845", 8);
+    id->id_len = 8;
+    return 0;
+}
+
+static int tun_bcm_replay(struct notifier_block *nb, unsigned long event, void *ptr)
+{
+    /* Actual objects are reconciled from Linux state by the SDK controller. */
+    return NOTIFY_DONE;
+}
+
+static struct notifier_block tun_bcm_replay_nb = {
+    .notifier_call = tun_bcm_replay,
+};
