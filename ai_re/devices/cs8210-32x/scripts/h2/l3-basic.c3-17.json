    "OUT_OCTETS"
   ],
   "may_fail": true
  },
  {
   "op": "exec",
   "desc": "control: to RIF A MAC, host route 10.2.0.2 (expect Ethernet16, dmac H2, ttl 63)",
   "cmd": "$ORACLE/bin/l3-frames tx=Ethernet128 rx=Ethernet16,Ethernet128 dmac=02:00:00:00:01:0a smac=02:00:00:00:0a:02 src=10.1.0.2 dst=10.2.0.2 count=100 pps=1000",
   "may_fail": true
  },
  {
   "op": "exec",
   "desc": "route /16 via nh1 from RIF B (expect Ethernet128, dmac H1)",
   "cmd": "$ORACLE/bin/l3-frames tx=Ethernet16 rx=Ethernet16,Ethernet128 dmac=02:00:00:00:01:0b smac=02:00:00:00:0b:02 src=10.2.0.2 dst=10.10.0.5 count=100 pps=1000",
   "may_fail": true
  },
  {
   "op": "exec",
   "desc": "route /16 via nh2 (expect Ethernet16)",
   "cmd": "$ORACLE/bin/l3-frames tx=Ethernet128 rx=Ethernet16,Ethernet128 dmac=02:00:00:00:01:0a smac=02:00:00:00:0a:02 src=10.1.0.2 dst=10.20.1.1 count=100 pps=1000",
