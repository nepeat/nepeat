   "cmd": "$ORACLE/bin/l3-frames tx=Ethernet128 rx=Ethernet16,Ethernet128 dmac=02:00:00:00:01:0a smac=02:00:00:00:0a:02 src=fc00:1::2 dst=fc00:2::2 count=100 pps=1000",
   "may_fail": true
  },
  {
   "op": "exec",
   "desc": "v6 route 2001:db8:20::/48",
   "cmd": "$ORACLE/bin/l3-frames tx=Ethernet128 rx=Ethernet16,Ethernet128 dmac=02:00:00:00:01:0a smac=02:00:00:00:0a:02 src=fc00:1::2 dst=2001:db8:20::77 count=100 pps=1000",
   "may_fail": true
  },
  {
