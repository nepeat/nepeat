     "oid",
     "$rifA"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "connected 10.2.0.0/24 (glean)",
   "vr": "$vr",
   "prefix": "10.2.0.0/24",
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$rifB"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "connected fc00:2::/64 (glean)",
   "vr": "$vr",
   "prefix": "fc00:2::/64",
   "attrs": [
    [
