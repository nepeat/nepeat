{
 "name": "hostif-create: SAI_TERALYNX_NETDEV=create netdevs (ifcs_netdev_create), TX and RX on them over the loop, deletion [h2: cage 3 <-> 17, cage 3 behind the Credo PHY]",
 "steps": [
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ],
    [
     "PORT_STATE_CHANGE_NOTIFY",
     "ptr",
     "port_state"
    ],
    [
     "SWITCH_SHUTDOWN_REQUEST_NOTIFY",
     "ptr",
     "shutdown"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "CPU_PORT",
    "oid"
   ],
   "as": "cpu"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VIRTUAL_ROUTER_ID",
    "oid"
   ],
   "as": "vr"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VLAN_ID",
    "oid"
   ],
   "as": "vlan1"
  },
  {
   "op": "get",
   "obj": "$vlan1",
   "desc": "VLAN 1 members (no flood domain over the loop)",
   "attr": [
    "MEMBER_LIST",
    "oidlist",
    64
   ],
   "as": "vmembers"
  },
  {
   "op": "foreach",
   "list": "vmembers",
   "as": "m",
   "steps": [
    {
     "op": "remove",
     "obj": "$m",
     "desc": "VLAN 1 member"
    }
   ]
  },
  {
   "op": "set",
   "obj": "$ports[2]",
   "desc": "mtu",
   "attr": [
    "MTU",
    "u32",
    9100
   ]
  },
  {
   "op": "set",
   "obj": "$ports[2]",
   "desc": "fec rs",
   "attr": [
    "FEC_MODE",
    "s32",
    "RS"
   ]
  },
  {
   "op": "set",
   "obj": "$ports[2]",
   "desc": "admin up",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "set",
   "obj": "$ports[16]",
   "desc": "mtu",
   "attr": [
    "MTU",
    "u32",
    9100
   ]
  },
  {
   "op": "set",
   "obj": "$ports[16]",
   "desc": "fec rs",
   "attr": [
    "FEC_MODE",
    "s32",
    "RS"
   ]
  },
  {
   "op": "set",
   "obj": "$ports[16]",
   "desc": "admin up",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF",
   "as": "hif0",
   "desc": "Ethernet16",
   "attrs": [
    [
     "TYPE",
     "s32",
     "NETDEV"
    ],
    [
     "OBJ_ID",
     "oid",
     "$ports[2]"
    ],
    [
     "NAME",
     "chardata",
     "Ethernet16"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF",
   "as": "hif1",
   "desc": "Ethernet128",
   "attrs": [
    [
     "TYPE",
     "s32",
     "NETDEV"
    ],
    [
     "OBJ_ID",
     "oid",
     "$ports[16]"
    ],
    [
     "NAME",
     "chardata",
     "Ethernet128"
    ]
   ]
  },
  {
   "op": "sleep",
   "ms": 3000
  },
  {
   "op": "exec",
   "desc": "netdevs after create",
   "cmd": "/run/current-system/sw/bin/ip -br link show | /run/current-system/sw/bin/grep -E 'Ethernet|inno_0_0003|inno_0_0017' || true"
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP_GROUP",
   "as": "g_q1",
   "desc": "queue 1",
   "attrs": [
    [
     "QUEUE",
     "u32",
     1
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP_GROUP",
   "as": "g_q3",
   "desc": "queue 3",
   "attrs": [
    [
     "QUEUE",
     "u32",
     3
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_ip2me",
   "desc": "IP2ME queue 1",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "IP2ME"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q1"
    ]
   ]
  },
  {
   "op": "create",
   "type": "ROUTER_INTERFACE",
   "as": "rif",
   "desc": "port RIF on Ethernet128",
   "attrs": [
    [
     "VIRTUAL_ROUTER_ID",
     "oid",
     "$vr"
    ],
    [
     "TYPE",
     "s32",
     "PORT"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[16]"
    ],
    [
     "SRC_MAC_ADDRESS",
     "mac",
     "02:00:00:00:01:20"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "10.99.0.1/32 -> CPU (ip2me)",
   "vr": "$vr",
   "prefix": "10.99.0.1/32",
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$cpu"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "2001:db8::1/128 -> CPU (ip2me)",
   "vr": "$vr",
   "prefix": "2001:db8::1/128",
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$cpu"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "sleep",
   "ms": 15000
  },
  {
   "op": "get",
   "obj": "$ports[2]",
   "desc": "oper Ethernet16",
   "attr": [
    "OPER_STATUS",
    "s32"
   ]
  },
  {
   "op": "get",
   "obj": "$ports[16]",
   "desc": "oper Ethernet128",
   "attr": [
    "OPER_STATUS",
    "s32"
   ]
  },
  {
   "op": "diag",
   "cmd": "copp"
  },
  {
   "op": "exec",
   "desc": "ip2me x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet16 Ethernet128 ip2me 50 100 02:00:00:00:01:20 10.99.0.1"
  },
  {
   "op": "exec",
   "desc": "lldp x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet16 Ethernet128 lldp 50 100"
  },
  {
   "op": "exec",
   "desc": "Ethernet128 counters",
   "cmd": "/run/current-system/sw/bin/ip -s link show Ethernet128 | /run/current-system/sw/bin/head -8"
  },
  {
   "op": "remove",
   "obj": "$t_ip2me"
  },
  {
   "op": "remove_route",
   "vr": "$vr",
   "prefix": "10.99.0.1/32"
  },
  {
   "op": "remove_route",
   "vr": "$vr",
   "prefix": "2001:db8::1/128",
   "may_fail": true
  },
  {
   "op": "remove",
   "obj": "$rif"
  },
  {
   "op": "remove",
   "obj": "$g_q1"
  },
  {
   "op": "remove",
   "obj": "$g_q3"
  },
  {
   "op": "remove",
   "obj": "$hif0"
  },
  {
   "op": "remove",
   "obj": "$hif1"
  },
  {
   "op": "exec",
   "desc": "netdevs after remove",
   "cmd": "/run/current-system/sw/bin/ip -br link show | /run/current-system/sw/bin/grep -E 'Ethernet' || echo none"
  },
  {
   "op": "set",
   "obj": "$ports[2]",
   "desc": "admin down",
   "attr": [
    "ADMIN_STATE",
    "bool",
    false
   ]
  },
  {
   "op": "set",
   "obj": "$ports[16]",
   "desc": "admin down",
   "attr": [
    "ADMIN_STATE",
    "bool",
    false
   ]
  },
  {
   "op": "remove_switch"
  }
 ]
}
