  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "stats",
   "obj": "$ports[30]",
   "desc": "Ethernet240 ingress erspan",
   "ids": [
    "IF_IN_UCAST_PKTS",
    "IF_IN_OCTETS",
    "IF_OUT_UCAST_PKTS",
    "IF_OUT_OCTETS"
