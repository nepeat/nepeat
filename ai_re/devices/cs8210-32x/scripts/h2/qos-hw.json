   "may_fail": true
  },
  {
   "op": "stats",
   "obj": "$ports[31]",
   "desc": "Ethernet248 ingress erspan",
   "ids": [
    "IF_IN_UCAST_PKTS",
    "IF_IN_OCTETS",
    "IF_OUT_UCAST_PKTS",
    "IF_OUT_OCTETS"
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[31]",
   "attr": [
    "INGRESS_MIRROR_SESSION",
    "oids",
    []
   ],
   "may_fail": true
  },
  {
   "op": "print",
   "text": "== K: SAMPLEPACKET 1 in 100 then 1 in 1000 on Ethernet248 ingress (samples = rx beyond sent)"
