     "u8",
     4
    ],
    [
     "TOS",
     "u8",
     32
    ],
    [
     "TTL",
     "u8",
     64
    ],
    [
     "SRC_IP_ADDRESS",
     "ip",
     "10.99.1.1"
    ],
    [
     "DST_IP_ADDRESS",
     "ip",
     "10.99.1.2"
    ],
    [
     "SRC_MAC_ADDRESS",
     "mac",
     "02:00:00:00:01:20"
    ],
    [
     "DST_MAC_ADDRESS",
     "mac",
     "02:00:00:00:05:05"
    ],
    [
     "GRE_PROTOCOL_TYPE",
     "u16",
     35006
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[31]",
   "attr": [
    "INGRESS_MIRROR_SESSION",
    "oids",
    [
     "$erspan"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "exec",
   "cmd": "$ORACLE/bin/qos-frames Ethernet240 Ethernet248 1000 1000 256 02:99:99:99:99:99 10.99.9.1 10.99.9.2 0"
