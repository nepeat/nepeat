{
 "name": "qos-hw: DSCP -> queue on the 400G loop (L3 hairpin on Ethernet248), port shaper, DWRR / strict under the shaper, WRED/ECN, PFC frames, SPAN / ERSPAN copies, sFlow sampling (ours; VLAN 10 / 20 single-port VLANs flood frames to the CPU) [h2: cage 31 <-> 32]",
 "steps": [
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ],
    [
     "PORT_STATE_CHANGE_NOTIFY",
     "ptr",
     "port_state"
    ],
    [
     "SWITCH_SHUTDOWN_REQUEST_NOTIFY",
     "ptr",
     "shutdown"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VIRTUAL_ROUTER_ID",
    "oid"
   ],
   "as": "vr"
  },
  {
   "op": "create",
   "type": "HOSTIF",
   "as": "hif0",
   "desc": "Ethernet240",
   "attrs": [
    [
     "TYPE",
     "s32",
     "NETDEV"
    ],
    [
     "OBJ_ID",
     "oid",
     "$ports[30]"
    ],
    [
     "NAME",
     "chardata",
     "Ethernet240"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF",
   "as": "hif1",
   "desc": "Ethernet248",
   "attrs": [
    [
     "TYPE",
     "s32",
     "NETDEV"
    ],
    [
     "OBJ_ID",
     "oid",
     "$ports[31]"
    ],
    [
     "NAME",
     "chardata",
     "Ethernet248"
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[30]",
   "desc": "admin up",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "set",
   "obj": "$ports[31]",
   "desc": "admin up",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "sleep",
   "ms": 8000
  },
  {
   "op": "get",
   "obj": "$ports[30]",
   "attr": [
    "QOS_QUEUE_LIST",
    "oidlist",
    16
   ],
   "as": "q0"
  },
  {
   "op": "get",
   "obj": "$ports[31]",
   "attr": [
    "QOS_QUEUE_LIST",
    "oidlist",
    16
   ],
   "as": "q15"
  },
  {
   "op": "get",
   "obj": "$ports[31]",
   "attr": [
    "QOS_SCHEDULER_GROUP_LIST",
    "oidlist",
    16
   ],
   "as": "sg15"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_1Q_BRIDGE_ID",
    "oid"
   ],
   "as": "br"
  },
  {
   "op": "get",
   "obj": "$br",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "bps"
  },
  {
   "op": "get",
   "obj": "$bps[0]",
   "attr": [
    "PORT_ID",
    "oid"
   ],
   "desc": "bps[0] port (expect ports[0])"
  },
  {
   "op": "get",
   "obj": "$bps[15]",
   "attr": [
    "PORT_ID",
    "oid"
   ],
   "desc": "bps[15] port (expect ports[15])"
  },
  {
   "op": "create",
   "type": "VLAN",
   "as": "v10",
   "desc": "VLAN 10: Ethernet240 only (floods reach the CPU)",
   "attrs": [
    [
     "VLAN_ID",
     "u16",
     10
    ]
   ]
  },
  {
   "op": "create",
   "type": "VLAN_MEMBER",
   "as": "vm10",
   "attrs": [
    [
     "VLAN_ID",
     "oid",
     "$v10"
    ],
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bps[0]"
    ],
    [
     "VLAN_TAGGING_MODE",
     "s32",
     "UNTAGGED"
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[30]",
   "attr": [
    "PORT_VLAN_ID",
    "u16",
    10
   ]
  },
  {
   "op": "create",
   "type": "VLAN",
   "as": "v20",
   "desc": "VLAN 20: Ethernet248 only",
   "attrs": [
    [
     "VLAN_ID",
     "u16",
     20
    ]
   ]
  },
  {
   "op": "create",
   "type": "VLAN_MEMBER",
   "as": "vm20",
   "attrs": [
    [
     "VLAN_ID",
     "oid",
     "$v20"
    ],
    [
     "BRIDGE_PORT_ID",
     "oid",
     "$bps[15]"
    ],
    [
     "VLAN_TAGGING_MODE",
     "s32",
     "UNTAGGED"
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[31]",
   "attr": [
    "PORT_VLAN_ID",
    "u16",
    20
   ]
  },
  {
   "op": "print",
   "text": "== B: control: plain frames Ethernet240 -> Ethernet248 (VLAN 20 floods them to the CPU)"
  },
  {
   "op": "exec",
   "cmd": "$ORACLE/bin/qos-frames Ethernet240 Ethernet240,Ethernet248 1000 1000 256 02:99:99:99:99:99 10.99.9.1 10.99.9.2 0"
  },
  {
   "op": "print",
   "text": "== C: CPU TX out Ethernet240 (plain L2, DSCP 0/10/46): Ethernet240 queue counters before / after"
  },
  {
   "op": "sleep",
   "ms": 2500
  },
  {
   "op": "foreach",
   "list": "q0",
   "as": "qq",
   "steps": [
    {
     "op": "qstats",
     "obj": "$qq",
     "desc": "q0 before",
     "ids": [
      "PACKETS",
      "BYTES",
      "DROPPED_PACKETS",
      "WATERMARK_BYTES"
     ],
     "may_fail": true
    }
   ]
  },
  {
   "op": "exec",
   "cmd": "$ORACLE/bin/qos-frames Ethernet240 Ethernet248 3000 3000 256 02:99:99:99:99:99 10.99.9.1 10.99.9.2 0,10,46"
  },
  {
   "op": "sleep",
   "ms": 2500
  },
  {
   "op": "foreach",
   "list": "q0",
   "as": "qq",
   "steps": [
    {
     "op": "qstats",
     "obj": "$qq",
     "desc": "q0 after",
     "ids": [
      "PACKETS",
      "BYTES",
      "DROPPED_PACKETS",
      "WATERMARK_BYTES"
     ],
     "may_fail": true
    }
   ]
  },
  {
   "op": "print",
   "text": "== J2: SPAN ingress Ethernet248 -> monitor Ethernet248 (copies counted as Ethernet240 IN)"
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "stats",
   "obj": "$ports[30]",
   "desc": "Ethernet240 before",
   "ids": [
    "IF_IN_UCAST_PKTS",
    "IF_IN_OCTETS",
    "IF_OUT_UCAST_PKTS",
    "IF_OUT_OCTETS"
   ],
   "may_fail": true
  },
  {
   "op": "stats",
   "obj": "$ports[31]",
   "desc": "Ethernet248 before",
   "ids": [
    "IF_IN_UCAST_PKTS",
    "IF_IN_OCTETS",
    "IF_OUT_UCAST_PKTS",
    "IF_OUT_OCTETS"
   ],
   "may_fail": true
  },
  {
   "op": "create",
   "type": "MIRROR_SESSION",
   "as": "span",
   "attrs": [
    [
     "TYPE",
     "s32",
     "LOCAL"
    ],
    [
     "MONITOR_PORT",
     "oid",
     "$ports[31]"
    ]
   ]
  },
  {
   "op": "set",
   "obj": "$ports[31]",
   "attr": [
    "INGRESS_MIRROR_SESSION",
    "oids",
    [
     "$span"
    ]
   ],
   "may_fail": true
  },
  {
   "op": "exec",
   "cmd": "$ORACLE/bin/qos-frames Ethernet240 Ethernet248 1000 1000 256 02:99:99:99:99:99 10.99.9.1 10.99.9.2 0"
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "stats",
   "obj": "$ports[30]",
   "desc": "Ethernet240 ingress span",
   "ids": [
    "IF_IN_UCAST_PKTS",
    "IF_IN_OCTETS",
    "IF_OUT_UCAST_PKTS",
    "IF_OUT_OCTETS"
   ],
   "may_fail": true
  },
  {
   "op": "stats",
   "obj": "$ports[31]",
   "desc": "Ethernet248 ingress span",
   "ids": [
    "IF_IN_UCAST_PKTS",
    "IF_IN_OCTETS",
    "IF_OUT_UCAST_PKTS",
    "IF_OUT_OCTETS"
   ],
   "may_fail": true
  },
  {
   "op": "set",
   "obj": "$ports[31]",
   "attr": [
    "INGRESS_MIRROR_SESSION",
    "oids",
    []
   ],
   "may_fail": true
  },
  {
   "op": "print",
   "text": "== J3: ERSPAN ingress Ethernet248 -> Ethernet248 (Ethernet240 IN octets per copy = 260 + encapsulation)"
  },
  {
   "op": "create",
   "type": "MIRROR_SESSION",
   "as": "erspan",
   "attrs": [
