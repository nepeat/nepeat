{
 "name": "traps-hw: LLDP/LACP/EAPOL/ARP/BGP/IP2ME frames over the cage 31 -> 32 loop, CoPP counters and a policer [h2: cage 31 <-> 32]",
 "steps": [
  {
   "op": "create_switch",
   "attrs": [
    [
     "INIT_SWITCH",
     "bool",
     true
    ],
    [
     "PORT_STATE_CHANGE_NOTIFY",
     "ptr",
     "port_state"
    ],
    [
     "SWITCH_SHUTDOWN_REQUEST_NOTIFY",
     "ptr",
     "shutdown"
    ]
   ]
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "PORT_LIST",
    "oidlist",
    64
   ],
   "as": "ports"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "CPU_PORT",
    "oid"
   ],
   "as": "cpu"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VIRTUAL_ROUTER_ID",
    "oid"
   ],
   "as": "vr"
  },
  {
   "op": "get",
   "obj": "switch",
   "attr": [
    "DEFAULT_VLAN_ID",
    "oid"
   ],
   "as": "vlan1"
  },
  {
   "op": "get",
   "obj": "$vlan1",
   "desc": "VLAN 1 members (no flood domain over the loop)",
   "attr": [
    "MEMBER_LIST",
    "oidlist",
    64
   ],
   "as": "vmembers"
  },
  {
   "op": "foreach",
   "list": "vmembers",
   "as": "m",
   "steps": [
    {
     "op": "remove",
     "obj": "$m",
     "desc": "VLAN 1 member"
    }
   ]
  },
  {
   "op": "set",
   "obj": "$ports[30]",
   "desc": "mtu",
   "attr": [
    "MTU",
    "u32",
    9100
   ]
  },
  {
   "op": "set",
   "obj": "$ports[30]",
   "desc": "fec rs",
   "attr": [
    "FEC_MODE",
    "s32",
    "RS"
   ]
  },
  {
   "op": "set",
   "obj": "$ports[30]",
   "desc": "admin up",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "set",
   "obj": "$ports[31]",
   "desc": "mtu",
   "attr": [
    "MTU",
    "u32",
    9100
   ]
  },
  {
   "op": "set",
   "obj": "$ports[31]",
   "desc": "fec rs",
   "attr": [
    "FEC_MODE",
    "s32",
    "RS"
   ]
  },
  {
   "op": "set",
   "obj": "$ports[31]",
   "desc": "admin up",
   "attr": [
    "ADMIN_STATE",
    "bool",
    true
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF",
   "as": "hif0",
   "desc": "Ethernet240",
   "attrs": [
    [
     "TYPE",
     "s32",
     "NETDEV"
    ],
    [
     "OBJ_ID",
     "oid",
     "$ports[30]"
    ],
    [
     "NAME",
     "chardata",
     "Ethernet240"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF",
   "as": "hif1",
   "desc": "Ethernet248",
   "attrs": [
    [
     "TYPE",
     "s32",
     "NETDEV"
    ],
    [
     "OBJ_ID",
     "oid",
     "$ports[31]"
    ],
    [
     "NAME",
     "chardata",
     "Ethernet248"
    ]
   ]
  },
  {
   "op": "create",
   "type": "POLICER",
   "as": "pol_lldp",
   "desc": "100 pps",
   "attrs": [
    [
     "METER_TYPE",
     "s32",
     "PACKETS"
    ],
    [
     "MODE",
     "s32",
     "SR_TCM"
    ],
    [
     "CIR",
     "u64",
     100
    ],
    [
     "CBS",
     "u64",
     100
    ],
    [
     "RED_PACKET_ACTION",
     "s32",
     "DROP"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP_GROUP",
   "as": "g_lldp",
   "desc": "queue 4 + policer",
   "attrs": [
    [
     "QUEUE",
     "u32",
     4
    ],
    [
     "POLICER",
     "oid",
     "$pol_lldp"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP_GROUP",
   "as": "g_q4",
   "desc": "queue 4",
   "attrs": [
    [
     "QUEUE",
     "u32",
     4
    ]
   ]
  },
  {
   "op": "create",
   "type": "POLICER",
   "as": "pol_ip2me",
   "desc": "1000 pps",
   "attrs": [
    [
     "METER_TYPE",
     "s32",
     "PACKETS"
    ],
    [
     "MODE",
     "s32",
     "SR_TCM"
    ],
    [
     "CIR",
     "u64",
     1000
    ],
    [
     "CBS",
     "u64",
     1000
    ],
    [
     "RED_PACKET_ACTION",
     "s32",
     "DROP"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP_GROUP",
   "as": "g_q1",
   "desc": "queue 1 + policer",
   "attrs": [
    [
     "QUEUE",
     "u32",
     1
    ],
    [
     "POLICER",
     "oid",
     "$pol_ip2me"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_lldp",
   "desc": "LLDP",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "LLDP"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_lldp"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_lacp",
   "desc": "LACP",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "LACP"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q4"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_eapol",
   "desc": "EAPOL",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "EAPOL"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q4"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_arp",
   "desc": "ARP_REQUEST",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "ARP_REQUEST"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "COPY"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q4"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_ip2me",
   "desc": "IP2ME",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "IP2ME"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q1"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_bgp",
   "desc": "BGP",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "BGP"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q4"
    ]
   ]
  },
  {
   "op": "create",
   "type": "HOSTIF_TRAP",
   "as": "t_ttl",
   "desc": "TTL_ERROR",
   "attrs": [
    [
     "TRAP_TYPE",
     "s32",
     "TTL_ERROR"
    ],
    [
     "PACKET_ACTION",
     "s32",
     "TRAP"
    ],
    [
     "TRAP_GROUP",
     "oid",
     "$g_q1"
    ]
   ]
  },
  {
   "op": "create",
   "type": "ROUTER_INTERFACE",
   "as": "rif",
   "desc": "port RIF on Ethernet248",
   "attrs": [
    [
     "VIRTUAL_ROUTER_ID",
     "oid",
     "$vr"
    ],
    [
     "TYPE",
     "s32",
     "PORT"
    ],
    [
     "PORT_ID",
     "oid",
     "$ports[31]"
    ],
    [
     "SRC_MAC_ADDRESS",
     "mac",
     "02:00:00:00:01:20"
    ]
   ]
  },
  {
   "op": "create_route",
   "desc": "10.99.0.1/32 -> CPU (ip2me)",
   "vr": "$vr",
   "prefix": "10.99.0.1/32",
   "attrs": [
    [
     "NEXT_HOP_ID",
     "oid",
     "$cpu"
    ]
   ]
  },
  {
   "op": "sleep",
   "ms": 15000
  },
  {
   "op": "get",
   "obj": "$ports[30]",
   "desc": "oper Ethernet240",
   "attr": [
    "OPER_STATUS",
    "s32"
   ]
  },
  {
   "op": "get",
   "obj": "$ports[31]",
   "desc": "oper Ethernet248",
   "attr": [
    "OPER_STATUS",
    "s32"
   ]
  },
  {
   "op": "diag",
   "cmd": "copp"
  },
  {
   "op": "exec",
   "desc": "plain x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet240 Ethernet248 plain 50 100"
  },
  {
   "op": "exec",
   "desc": "lldp x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet240 Ethernet248 lldp 50 100"
  },
  {
   "op": "exec",
   "desc": "lacp x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet240 Ethernet248 lacp 50 100"
  },
  {
   "op": "exec",
   "desc": "eapol x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet240 Ethernet248 eapol 50 100"
  },
  {
   "op": "exec",
   "desc": "arp x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet240 Ethernet248 arp 50 100"
  },
  {
   "op": "exec",
   "desc": "bgp x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet240 Ethernet248 bgp 50 100 02:00:00:00:01:20 10.99.0.1"
  },
  {
   "op": "exec",
   "desc": "ip2me x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet240 Ethernet248 ip2me 50 100 02:00:00:00:01:20 10.99.0.1"
  },
  {
   "op": "diag",
   "cmd": "copp"
  },
  {
   "op": "stats",
   "obj": "$ports[30]",
   "desc": "Ethernet240",
   "ids": [
    "IF_IN_OCTETS",
    "IF_IN_UCAST_PKTS",
    "IF_IN_NON_UCAST_PKTS",
    "IF_OUT_OCTETS",
    "IF_OUT_UCAST_PKTS",
    "IF_OUT_NON_UCAST_PKTS"
   ]
  },
  {
   "op": "stats",
   "obj": "$ports[31]",
   "desc": "Ethernet248",
   "ids": [
    "IF_IN_OCTETS",
    "IF_IN_UCAST_PKTS",
    "IF_IN_NON_UCAST_PKTS",
    "IF_OUT_OCTETS",
    "IF_OUT_UCAST_PKTS",
    "IF_OUT_NON_UCAST_PKTS",
    "IF_IN_DISCARDS"
   ]
  },
  {
   "op": "set",
   "obj": "$pol_lldp",
   "desc": "LLDP policer CIR 10 pps",
   "attr": [
    "CIR",
    "u64",
    10
   ]
  },
  {
   "op": "set",
   "obj": "$pol_lldp",
   "desc": "LLDP policer CBS 10",
   "attr": [
    "CBS",
    "u64",
    10
   ]
  },
  {
   "op": "exec",
   "desc": "lldp x2000 @1000/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet240 Ethernet248 lldp 2000 1000"
  },
  {
   "op": "diag",
   "cmd": "copp"
  },
  {
   "op": "set",
   "obj": "$t_lldp",
   "desc": "LLDP -> DROP",
   "attr": [
    "PACKET_ACTION",
    "s32",
    "DROP"
   ]
  },
  {
   "op": "exec",
   "desc": "lldp x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet240 Ethernet248 lldp 50 100"
  },
  {
   "op": "set",
   "obj": "$t_lldp",
   "desc": "LLDP -> TRAP",
   "attr": [
    "PACKET_ACTION",
    "s32",
    "TRAP"
   ]
  },
  {
   "op": "set",
   "obj": "$pol_lldp",
   "desc": "LLDP policer CIR 100",
   "attr": [
    "CIR",
    "u64",
    100
   ]
  },
  {
   "op": "exec",
   "desc": "lldp x50 @100/s",
   "cmd": "$ORACLE/bin/trap-frames Ethernet240 Ethernet248 lldp 50 100"
  },
  {
   "op": "diag",
   "cmd": "copp"
  },
  {
   "op": "remove_route",
   "vr": "$vr",
   "prefix": "10.99.0.1/32"
  },
  {
   "op": "remove",
   "obj": "$rif"
  },
  {
   "op": "remove",
   "obj": "$t_lldp"
  },
  {
   "op": "remove",
   "obj": "$t_lacp"
  },
  {
   "op": "remove",
   "obj": "$t_eapol"
  },
  {
   "op": "remove",
   "obj": "$t_arp"
  },
  {
   "op": "remove",
   "obj": "$t_ip2me"
  },
  {
   "op": "remove",
   "obj": "$t_bgp"
  },
  {
   "op": "remove",
   "obj": "$t_ttl"
  },
  {
   "op": "remove",
   "obj": "$hif0"
  },
  {
   "op": "remove",
   "obj": "$hif1"
  },
  {
   "op": "set",
   "obj": "$ports[30]",
   "desc": "admin down",
   "attr": [
    "ADMIN_STATE",
    "bool",
    false
   ]
  },
  {
   "op": "set",
   "obj": "$ports[31]",
   "desc": "admin down",
   "attr": [
    "ADMIN_STATE",
    "bool",
    false
   ]
  },
  {
   "op": "remove_switch"
  }
 ]
}
