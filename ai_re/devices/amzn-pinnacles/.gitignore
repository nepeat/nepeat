# Pulled binaries and anything derived from them — regenerable from the device,
# far too big for git. The findings live in the .md files instead.
apks/
screens/

# PER-DEVICE SECRETS — never commit. kb is the Widevine/attestation keybox
# (5120B) and dkb the device keybox (1024B); eMMC boot2 holds the IDME region.
# Raw dumps of these contain real key material. Commit hashes, not bytes.
kb.bin
dkb.bin
keys.bin
*boot2*
*keybox*
rpmb*.bin

# belt and braces if anything lands outside apks/
*.apk
*.dex
*.arsc
*.png
jadx-out/
*-res/

# Reference firmware pulled from public Amazon OTAs — binary, regenerable.
# Hashes and findings are recorded in lk-analysis.md instead.
ref-firmware/

# Pulled system/vendor trees — ~1.2GB, regenerable from the device.
fw/

# Raw partition dumps — contain per-device SECRETS (kb/dkb keyboxes, keys,
# IDME boot area with serials). Never commit. Hashes go in dumps/.
fw-partitions/
*.img

# tools/ holds source scripts only — safe to commit (no binaries)

# TWRP prebuilt kernel (regenerate with extract-prebuilt-kernel.sh)
twrp/device/amazon/yacht/prebuilt/

# TWRP build and warm-payload outputs (regenerate from the device tree/image)
twrp/out/

# Kernel module build artifacts -- regenerable from the .c/.S sources + Makefile.
kernel-modules/**/out/
kernel-modules/**/*.ko
kernel-modules/**/*.o
kernel-modules/**/*.mod
kernel-modules/**/*.mod.c
kernel-modules/**/.*.cmd
kernel-modules/**/.tmp_versions/
kernel-modules/**/Module.symvers*
kernel-modules/**/modules.order
