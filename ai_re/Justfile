# ai_re: test builds of everything under nix/ (U-Boot variants, kernels,
# packages, NixOS systems and images) and the tools/ unit tests.
# What is built and how targets are found: tests/nixtargets.py, nix/README.md.
# Also: drvpaths (neutrality proof of a refactor), update (nixpkgs bump),
# uboot-variants (every U-Boot build and its patch scopes).
#
#   just test                      everything
#   just test-eval                 fast: every target evaluates (no building) + coverage guards
#   just test-uboot -k as7772      pytest arguments pass through
#   just nix_args="--max-jobs 2" test-systems
#   just jobs=3 test-packages      three targets at a time
#
# Works inside the devshell and outside it (then through "nix develop -c").
# A later -m replaces the recipe's: just test -m "not vm and not deploy".

# extra arguments for every "nix build" (also: AI_RE_NIX_ARGS)
nix_args := env_var_or_default("AI_RE_NIX_ARGS", "")
# targets built at the same time (pytest-xdist workers); nix parallelises inside a build already
jobs := "1"
# evaluations at the same time (each one can take a few GB for a NixOS system)
eval_jobs := "6"

export AI_RE_NIX_ARGS := nix_args
export PYTHONDONTWRITEBYTECODE := "1"

set positional-arguments

default:
    @just --list

# everything: evaluation, U-Boot, packages, systems, git-flake (deploy) builds, VM tests, tools
test *args:
    @tests/run-pytest.sh "{{jobs}}" tests tools/tests "$@"

# every target evaluates to a derivation, plus the coverage guards; builds nothing
test-eval *args:
    @tests/run-pytest.sh "{{eval_jobs}}" tests -m eval "$@"

# every uboot-* output (all boards) and the U-Boot test outputs
test-uboot *args:
    @tests/run-pytest.sh "{{jobs}}" tests -m uboot "$@"

# kernels, drivers, SDK/SAI/SONiC packages, build-time tests (flake outputs + EXTRAS in tests/nixtargets.py)
test-packages *args:
    @tests/run-pytest.sh "{{jobs}}" tests -m packages "$@"

# NixOS system toplevels and images from path:./nix (the working tree)
test-systems *args:
    @tests/run-pytest.sh "{{jobs}}" tests -m systems "$@"

# the root git flake as deploy.sh builds it: tracked files only, with fand
test-deploy *args:
    @tests/run-pytest.sh "{{jobs}}" tests -m deploy "$@"

# NixOS VM tests of the SONiC stack (kvm; slow unless cached)
test-vm *args:
    @tests/run-pytest.sh "{{jobs}}" tests -m vm "$@"

# unit tests of tools/ (ai-re-images) and lab-power (rust/lab-power: fmt, clippy and its tests run in its nix build)
test-tools *args:
    @tests/run-pytest.sh 1 tools/tests "$@"
    nix build --no-link {{nix_args}} .#lab-power

# list the targets without running anything
test-list *args:
    @tests/run-pytest.sh 1 tests --collect-only -q "$@"

# derivation paths of every target, to prove a refactor neutral: "just drvpaths snapshot", edit, "just drvpaths diff" (tests/drvpaths.py --help)
drvpaths *args:
    @tests/run-python.sh tests/drvpaths.py "$@"

# every U-Boot variant with its board, patch scopes and outputs (nix/packages/uboot/variants.nix)
uboot-variants:
    @nix eval --no-write-lock-file --raw --impure --expr 'import ./nix/packages/uboot/variants.nix { flake = builtins.getFlake "path:{{justfile_directory()}}/nix"; }'

# bump the systems' nixpkgs in both lock files to one revision (nix/flake.lock and the root flake's nixpkgs-systems), then the eval tier; build with "just test" before deploying
update:
    nix flake update nixpkgs --flake path:{{justfile_directory()}}/nix
    nix flake lock --override-input nixpkgs-systems "github:NixOS/nixpkgs/$(tests/run-python.sh tests/locks.py rev)" {{justfile_directory()}}
    @tests/run-python.sh tests/locks.py check
    @just test-eval

# bump the devshell's own inputs (root flake nixpkgs, flake-utils); no system is rebuilt by this
update-devshell:
    nix flake update nixpkgs flake-utils --flake {{justfile_directory()}}

# the Rust SAI's test suites, cross-built for big-endian ppc64, run ON a switch over ssh: userspace only, in a scratch dir under /tmp (rust/sai/README.md "Big-endian runs"); e.g. just sai-rs-test-on root@10.60.2.23 sudo ssh
sai-rs-test-on host *ssh:
    #!/usr/bin/env bash
    set -euo pipefail
    run=$(nix build --no-link --print-out-paths --impure {{nix_args}} --expr '
      let f = builtins.getFlake "path:{{justfile_directory()}}/nix"; ppc = f.nixosConfigurations.as7760.pkgs;
          dir = {{justfile_directory()}}/../rust/sai/nix;
          as7772 = f.nixosConfigurations.as7772.extendModules { modules = [ { hardware.openbcm.rustSai = dir; } ]; };
          profile = as7772.config.services.sonic.sai.profile;
          saiRs = ppc.callPackage (dir + "/package.nix") {
            saiSrc = (import (f.outPath + "/packages/sonic") { pkgs = ppc; }).sources.sairedis;
            glueSrc = f.outPath + "/packages/sai-openbcm/src";
          };
      in (ppc.callPackage (dir + "/target-tests.nix") {
        inherit saiRs;
        macsecTable = profile.SAI_OPENBCM_EXT_MACSEC_FILE;
        extPhyTable = profile.SAI_OPENBCM_EXT_PHY_FILE;
      }).runOn')
    shift
    exec "$run/bin/sai-rs-test-on" "{{host}}" "$@"
