# The IFCS declarations ifcs-sys binds (README "Teralynx backend"): ifcs_api.h and ifcs_api_qos.h,
# generated by the EXISTING generator of the C++ package (ai_re/nix/packages/sai-teralynx:
# tools/gen_ifcs_api.py over src/ifcs_api.h.in, src/ifcs_api_qos.h.in, src/ifcs_overrides.txt,
# read from there, never modified) on the pinned public ishell 2.0.1 ctypes (that package's
# passthru.ifcsCtypes). Generated at build time, never committed (vendor-derived; the owner's
# publishing question is open).
#   pkgs.callPackage ./ifcs-headers.nix { teralynxSrc = <ai_re/nix/packages/sai-teralynx>; saiSrc = <sairedis>; }
# $out/include/{ifcs_api.h,ifcs_api_qos.h}. passthru.identity: a check that the C++ package's own
# Makefile rule (the same derivation inputs, its build/gen) writes the same bytes.
{
  lib,
  runCommand,
  buildPackages,
  callPackage,
  teralynxSrc,
  saiSrc,
}:
let
  # only the generator, its templates and overrides: nothing else of the C++ package is an input
  gen = builtins.path {
    path = teralynxSrc;
    name = "sai-teralynx-ifcs-generator";
    filter = p: _:
      let rel = lib.removePrefix (toString teralynxSrc + "/") (toString p); in
      builtins.elem rel [ "tools" "src" "tools/gen_ifcs_api.py" "tools/ifcs_ctypes_model.py"
        "src/ifcs_api.h.in" "src/ifcs_api_qos.h.in" "src/ifcs_overrides.txt" ];
  };
  # the C++ package as its callers build it, for its passthru (the ctypes it pins) and the identity check
  cpp = callPackage teralynxSrc { sonic = { sources.sairedis = saiSrc; }; };
  inherit (cpp) ifcsCtypes;
  headers = runCommand "ifcs-api-headers" { nativeBuildInputs = [ buildPackages.python3 ]; } ''
    mkdir -p $out/include
    cd ${gen}
    # the Makefile's command (from the package directory, templates as src/...)
    python3 -I -B tools/gen_ifcs_api.py --ctypes ${ifcsCtypes} --overrides src/ifcs_overrides.txt \
      -o $out/include src/ifcs_api.h.in src/ifcs_api_qos.h.in
    test -s $out/include/ifcs_api.h && test -s $out/include/ifcs_api_qos.h
  '';
  # The C++ package's Makefile rule for build/gen/ifcs_api*.h, in its own derivation setup (same
  # src, makeFlags, ctypes): its two headers, to compare.
  cppGen = cpp.overrideAttrs (_: {
    pname = "sai-teralynx-gen-headers";
    buildFlags = [ "build/gen/ifcs_api.h" ];
    doCheck = false;
    installPhase = "mkdir -p $out && cp build/gen/ifcs_api.h build/gen/ifcs_api_qos.h $out/";
    dontFixup = true;
  });
in
headers.overrideAttrs (old: {
  passthru = (old.passthru or { }) // {
    inherit ifcsCtypes cppGen;
    identity = runCommand "ifcs-api-headers-identity" { } ''
      for h in ifcs_api.h ifcs_api_qos.h; do
        cmp ${headers}/include/$h ${cppGen}/$h
        echo "$h: $(sha256sum < ${headers}/include/$h | cut -c1-64) (= sai-teralynx build/gen)" >> $out
      done
    '';
  };
})
