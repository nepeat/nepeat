/* SPDX-License-Identifier: Apache-2.0
 *
 * TEMPLATE of ifcs_api.h (generated at build time by tools/gen_ifcs_api.py
 * into build/gen/; README.md "IFCS declarations"): the subset of the
 * Innovium IFCS API (Teralynx 7, the box's IFCS 0.12.41 libifcs.so) that the
 * sai-teralynx backend calls through dlsym. Names only, our selection: the
 * values (NAME = @), field lists (@struct / @union) and signatures (@fn) come
 * from a public ctypes file (ishell 2.0.1's pyctypes/ifcs_ctypes.py, see
 * default.nix), whose declarations of everything used here equal 0.12.41's
 * except the values in src/ifcs_overrides.txt and the @prefix struct.
 * The static_asserts at the end are 0.12.41 layout facts (DWARF of the SDK's
 * innovium.user, or computed from its pyctypes: marked), so a build from a
 * ctypes file that disagrees stops. Target library: libifcs.so sha256
 * 388031e7eb2443d77d89da826084976859bf92db19f9733be19b1c0b603c0d17; never
 * mix with IFCS 7.0.1 (its ifcs_attr_t is 296 B).
 * The ACL / hostif trap call forms follow SDK/scripts/sonic_l3snake_acl.py
 * (table, profiles, matches, actions, ACEs) and what isai 6.2.0 does on the
 * same chip (oracle traces, oracle/README.md).
 */
#ifndef SAI_TERALYNX_IFCS_API_H
#define SAI_TERALYNX_IFCS_API_H

#include <stddef.h>
#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

/* ------------------------------------------------------------ base types */
@typedef ifcs_status_t   /* low 5 bits: ifcs_reason (IFCS_STATUS_REASON) */
@typedef ifcs_handle_t
@typedef ifcs_node_id_t
@typedef ifcs_devport_t
@typedef ifcs_attr_id_t
@typedef ifcs_bool_t
@typedef ifcs_mac_t

enum {                                 /* ifcs_reason_e (DWARF + pyctypes) */
    IFCS_SUCCESS = @, IFCS_UNINIT = @, IFCS_BUSY = @, IFCS_CONFIG = @, IFCS_MEMORY = @,
    IFCS_PARAM = @, IFCS_EXIST = @, IFCS_MULTI_EXIST = @, IFCS_ENTRY_REPLACED = @,
    IFCS_LENGTH_MISMATCH = @, IFCS_NOTFOUND = @, IFCS_INVAL = @, IFCS_UNSUPPORTED = @,
    IFCS_RESOURCE_FULL = @, IFCS_TIMEOUT = @, IFCS_DEVICE_ACCESS_ERROR = @, IFCS_DRIVER_ERROR = @,
};
#define IFCS_STATUS_REASON(rc) ((int)((unsigned)(rc) & @{IFCS_STATUS_REASON_MASK}u))

enum { IFCS_BOOL_FALSE = @, IFCS_BOOL_TRUE = @ };
enum { IFCS_BOOT_COLD = @, IFCS_BOOT_WARM = @ };
enum { IFCS_SHUTDOWN_TYPE_COLD = @ };
enum { IFCS_IP_ADDR_FAMILY_IPV4 = @, IFCS_IP_ADDR_FAMILY_IPV6 = @ };
enum { IFCS_LOG_LEVEL_OFF = @, IFCS_LOG_LEVEL_FATAL = @, IFCS_LOG_LEVEL_ERROR = @, IFCS_LOG_LEVEL_WARN = @,
       IFCS_LOG_LEVEL_INFO = @, IFCS_LOG_LEVEL_DEBUG = @ };

/* ----------------------------------------------------------------- handles
 * 31..25 module, 24..21 object class, 20..0 value. */
#define IFCS_NULL_HANDLE @{IFCS_NULL_HANDLE}u
#define IFCS_HANDLE_MODULE_SHIFT @
#define IFCS_HANDLE_OBJECT_SHIFT @
#define IFCS_HANDLE_VALUE_MAX @{IFCS_HANDLE_VALUE_MAX:#x}u
#define IFCS_HANDLE(mod, cls, val) \
    ((((uint32_t)(mod) & @{IFCS_HANDLE_MODULE_MAX}u) << IFCS_HANDLE_MODULE_SHIFT) | (((uint32_t)(cls) & @{IFCS_HANDLE_OBJECT_MAX}u) << IFCS_HANDLE_OBJECT_SHIFT) | \
     ((uint32_t)(val) & IFCS_HANDLE_VALUE_MAX))
#define IFCS_HANDLE_VALUE(h) ((uint32_t)(h) & IFCS_HANDLE_VALUE_MAX)
enum { IFCS_MOD_HOSTIF = @, IFCS_MOD_L2VNI = @, IFCS_MOD_L3VNI = @, IFCS_MOD_SYSPORT = @ };
enum { IFCS_API_CLASS_HOSTIF_TRAP = @, IFCS_API_CLASS_L2VNI = @, IFCS_API_CLASS_L3VNI = @, IFCS_API_CLASS_SYSPORT = @ };
#define IFCS_HANDLE_L2VNI(v) IFCS_HANDLE(IFCS_MOD_L2VNI, IFCS_API_CLASS_L2VNI, (v))
#define IFCS_HANDLE_L3VNI(v) IFCS_HANDLE(IFCS_MOD_L3VNI, IFCS_API_CLASS_L3VNI, (v))
#define IFCS_HANDLE_SYSPORT(v) IFCS_HANDLE(IFCS_MOD_SYSPORT, IFCS_API_CLASS_SYSPORT, (v))

/* ------------------------------------------------------------------ lists */
@struct ifcs_u8_list_t
@struct ifcs_string_t   /* count: chars, no NUL */
@struct ifcs_i8_list_t
@struct ifcs_i32_list_t
@struct ifcs_u32_list_t
@struct ifcs_handle_list_t

/* ------------------------------------------------------------ IP and MAC */
@union ifcs_ip_addr_t   /* ipv4: host-order value */
@struct ifcs_ip_address_t
@struct ifcs_ip_prefix_t

/* --------------------------------------------------------------- policies */
enum { IFCS_FWD_ACTION_FORWARD = @, IFCS_FWD_ACTION_DROP = @ };
enum { IFCS_COPY_TO_CPU_DISABLE = @, IFCS_COPY_TO_CPU_ENABLE = @ };
@struct ifcs_fwd_policy_t
@struct ifcs_ctc_policy_t

/* --------------------------------------------------------------- attribute
 * The value union has 45 members in this version; only the ones we use are
 * named, the rest is padding to the verified size. The trailing bitmap says
 * which member is valid; the vendor CLI leaves it zero (it assigns the value
 * directly after zeroing the struct), and so do we. */
@union ifcs_attr_value_t u64 u32 int32 u16 u8 flt u8_list string i8_list i32_list u32_list devport cpu_queue data ip_addr ip_prefix mac handle handle_list ctc_policy fwd_policy

@as uint32_t ifcs_acl_action_t ifcs_stats_mode_t   /* two enums the backend has always written as uint32_t (same size; keeps its code unchanged) */
@bits ifcs_attr_value_bitmap_t   /* the bitmap (one bit per value member) is its uint64_t storage */
@struct ifcs_attr_t

/* ------------------------------------------------------- key structs (CTYPES) */
enum { IFCS_L2_ENTRY_KEY_TYPE_MAC_L2VNI = @ };
@struct ifcs_l2_entry_key_mac_l2vni_t
@union ifcs_l2_entry_key_map_t mac_l2vni   /* largest member: ip_sg_l2vni (2 prefixes + handle) */
@struct ifcs_l2_entry_key_t

enum { IFCS_ROUTE_ENTRY_KEY_TYPE_IP_DEST_L3VNI = @ };
@struct ifcs_route_entry_key_ip_dest_l3vni_t
@union ifcs_route_entry_key_map_t ip_dest_l3vni
@struct ifcs_route_entry_key_t

/* 0.12.41's ifcs_usage_s has only max and current (+ dirty bits); ishell 2.0.1 adds obj_api_class_id,
 * obj_type and available. Verified on the target libifcs.so: ifcs_usage_t_init (0x15eb890) clears
 * 12 bytes, and the only accessors it exports are ifcs_usage_t_{max,current}_{get,set}. */
@prefix ifcs_usage_t max current

/* ----------------------------------------------------------- events (CTYPES) */
enum { IFCS_DEVPORT_LINK_STATUS_DOWN = @, IFCS_DEVPORT_LINK_STATUS_UP = @ };
@struct ifcs_linkscan_event_info_t   /* port_state: IFCS_DEVPORT_LINK_STATUS_* */

enum { IFCS_L2_EVENT_TYPE_LEARNED = @, IFCS_L2_EVENT_TYPE_AGED = @, IFCS_L2_EVENT_TYPE_MOVED = @,
       IFCS_L2_EVENT_TYPE_FLUSHED = @ };
@struct ifcs_l2_event_info_t

@typedef ifcs_linkscan_event_notify_fn_t
@typedef ifcs_l2_event_notify_fn_t
@typedef ifcs_log_notify_t
@typedef ifcs_l2_entry_user_cb_t

/* ------------------------------------------------------------ attribute ids */
