/* ------------------------------------------------------------------- ACL
 * One ingress table (match + action profile), one ACL per inno block
 * (scope PER_IB), entries (ACE) = a match set + an action set. */
enum {                                 /* ifcs_acl_match_type_e (subset) */
    IFCS_ACL_MATCH_TYPE_DESTINATION_MAC_ADDRESS = @, IFCS_ACL_MATCH_TYPE_ETHER_TYPE = @,
    IFCS_ACL_MATCH_TYPE_L4_PROTOCOL = @, IFCS_ACL_MATCH_TYPE_SOURCE_L4_PORT = @,
    IFCS_ACL_MATCH_TYPE_DESTINATION_L4_PORT = @, IFCS_ACL_MATCH_TYPE_L4_BYTE1 = @, IFCS_ACL_MATCH_TYPE_HOSTIF_TRAP = @,
};
enum {                                 /* ifcs_acl_action_type_e (subset) */
    IFCS_ACL_ACTION_TYPE_METER = @, IFCS_ACL_ACTION_TYPE_ACL_COUNTER = @, IFCS_ACL_ACTION_TYPE_DROP = @,
    IFCS_ACL_ACTION_TYPE_COPY_TO_CPU = @, IFCS_ACL_ACTION_TYPE_COPY_TO_CPU_OVERRIDE = @,
};
enum { IFCS_ACL_DIRECTION_INGRESS = @ };
enum { IFCS_ACL_SCOPE_NODE = @, IFCS_ACL_SCOPE_PER_IB = @ };
enum { IFCS_ACL_TABLE_TYPE_CONTROL = @ };
enum { IFCS_ACL_ACTION_DISABLE = @, IFCS_ACL_ACTION_ENABLE = @ };   /* ifcs_acl_action_t: per colour */
enum { IFCS_ACL_METER_TYPE_BYTE = @ };
enum { IFCS_ACL_METER_MODE_DUAL_TOKEN_RFC_2697 = @, IFCS_ACL_METER_MODE_DUAL_TOKEN_RFC_2698 = @ };
enum { IFCS_ACL_COUNTER_MODE_COLOR_AWARE = @ };
enum { IFCS_ACL_COUNTER_STATS_ID_PACKETS = @, IFCS_ACL_COUNTER_STATS_ID_BYTES = @, IFCS_ACL_COUNTER_STATS_ID_GREEN_PACKETS = @,
       IFCS_ACL_COUNTER_STATS_ID_YELLOW_PACKETS = @, IFCS_ACL_COUNTER_STATS_ID_RED_PACKETS = @ };
enum { IFCS_ACL_MATCH_PROFILE_ATTR_MATCH_TYPES = @, IFCS_ACL_MATCH_PROFILE_ATTR_DIRECTION = @,
       IFCS_ACL_MATCH_PROFILE_ATTR_MAX_WIDTH = @ };
enum { IFCS_ACL_ACTION_PROFILE_ATTR_ACTION_TYPES = @, IFCS_ACL_ACTION_PROFILE_ATTR_DIRECTION = @ };
enum { IFCS_ACL_TABLE_ATTR_MATCH_PROFILE = @, IFCS_ACL_TABLE_ATTR_ACTION_PROFILE = @, IFCS_ACL_TABLE_ATTR_DIRECTION = @,
       IFCS_ACL_TABLE_ATTR_SCOPE = @, IFCS_ACL_TABLE_ATTR_PRIORITY = @, IFCS_ACL_TABLE_ATTR_SIZE = @,
       IFCS_ACL_TABLE_ATTR_MAX_METERS = @, IFCS_ACL_TABLE_ATTR_MAX_COUNTERS = @, IFCS_ACL_TABLE_ATTR_DEFAULT_STATS = @,
       IFCS_ACL_TABLE_ATTR_TYPE = @ };
enum { IFCS_ACL_ATTR_SCOPE = @, IFCS_ACL_ATTR_IB = @ };
enum { IFCS_ACL_MATCH_ATTR_MATCH_PROFILE = @, IFCS_ACL_MATCH_ATTR_TYPE = @, IFCS_ACL_MATCH_ATTR_VALUE = @,
       IFCS_ACL_MATCH_ATTR_MASK = @, IFCS_ACL_MATCH_ATTR_OBJECT = @ };
enum { IFCS_ACL_ACTION_ATTR_ACTION_PROFILE = @, IFCS_ACL_ACTION_ATTR_TYPE = @, IFCS_ACL_ACTION_ATTR_VALUE = @,
       IFCS_ACL_ACTION_ATTR_OBJECT = @ };
enum { IFCS_ACL_METER_ATTR_ACL_TABLE = @, IFCS_ACL_METER_ATTR_SCOPE = @, IFCS_ACL_METER_ATTR_IB = @,
       IFCS_ACL_METER_ATTR_TYPE = @, IFCS_ACL_METER_ATTR_MODE = @, IFCS_ACL_METER_ATTR_COLOR_AWARE = @,
       IFCS_ACL_METER_ATTR_COMMITTED_BURST_SIZE = @, IFCS_ACL_METER_ATTR_COMMITTED_INFORMATION_RATE = @,
       IFCS_ACL_METER_ATTR_EXCESS_BURST_SIZE = @, IFCS_ACL_METER_ATTR_EXCESS_INFORMATION_RATE = @ };
enum { IFCS_ACL_COUNTER_ATTR_ACL_TABLE = @, IFCS_ACL_COUNTER_ATTR_SCOPE = @, IFCS_ACL_COUNTER_ATTR_IB = @,
       IFCS_ACL_COUNTER_ATTR_MODE = @ };
enum { IFCS_ACE_ATTR_SCOPE = @, IFCS_ACE_ATTR_IB = @, IFCS_ACE_ATTR_PRIORITY = @, IFCS_ACE_ATTR_ENABLE = @,
       IFCS_ACE_ATTR_MATCH_SET = @, IFCS_ACE_ATTR_ACTION_SET = @ };
/* Members of ifcs_acl_action_value_u (CTYPES; identical in 0.16.2): the
 * action VALUE attribute holds one of these at value offset 0. Colour
 * fields are ifcs_acl_action_t; the trailing byte holds the dirty bits. */
@struct ifcs_acl_ctc_action_t   /* dirty: 1 hostif, 2 green, 4 yellow, 8 red */
@struct ifcs_acl_ctc_override_action_t   /* dirty: 1 green, 2 yellow, 4 red */
@struct ifcs_acl_drop_action_t   /* 1 2 4 8 */
@typedef ifcs_acl_counter_stats_id_t
@typedef ifcs_hostif_trap_stats_id_t
enum { IFCS_ECMP_MEMBER_ATTR_WEIGHT = @ };

/* -------------------------------------------- L2 extras, LAG, entropy (hash)
 * pyctypes 0.12.41; call forms: isai 6.2.0 on this chip (oracle lag-l2). */
enum { IFCS_L2VNI_ATTR_LEARN_ENABLE = @, IFCS_L2VNI_ATTR_L2_ENTRY_MAX_LEARN_COUNT = @ };   /* data, u32 */
enum { IFCS_LAG_ATTR_MEMBER_COUNT = @ };
enum { IFCS_LAG_MEMBER_ATTR_TYPE = @ };
enum { IFCS_LAG_MEMBER_TYPE_PRIMARY = @, IFCS_LAG_MEMBER_TYPE_SECONDARY = @ };
