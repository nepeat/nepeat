@typedef ifcs_intf_stats_id_t
enum { IFCS_NEXTHOP_ATTR_INTF = @, IFCS_NEXTHOP_ATTR_DEST_MAC = @, IFCS_NEXTHOP_ATTR_LOCAL_DESTINATION = @ };
enum { IFCS_ROUTE_ENTRY_ATTR_NEXTHOP = @, IFCS_ROUTE_ENTRY_ATTR_FWD_POLICY = @, IFCS_ROUTE_ENTRY_ATTR_CTC_POLICY = @,
       IFCS_ROUTE_ENTRY_ATTR_TTL_CHECK_PROFILE = @ };                       /* TTL_CHECK_PROFILE u32 (cmds/route_entry.py) */
