    IFCS_SYSPORT_ATTR_EGRESS_UNTAGGED_VLAN_ID_ENABLE = @,/* data */
    IFCS_SYSPORT_ATTR_EGRESS_UNTAGGED_VLAN_ID = @,       /* u16 */
