enum { IFCS_ACL_COMPARATOR_ATTR_OPERATION = @, IFCS_ACL_COMPARATOR_ATTR_TYPE = @, IFCS_ACL_COMPARATOR_ATTR_VALUE = @,
       IFCS_ACL_COMPARATOR_ATTR_HI_VALUE = @, IFCS_ACL_COMPARATOR_ATTR_DIRECTION = @ };   /* u32 each (isai) */
