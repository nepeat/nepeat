enum { IFCS_DEVPORT_SPEED_10G = @, IFCS_DEVPORT_SPEED_25G = @, IFCS_DEVPORT_SPEED_40G = @, IFCS_DEVPORT_SPEED_50G = @,
       IFCS_DEVPORT_SPEED_100G = @, IFCS_DEVPORT_SPEED_200G = @, IFCS_DEVPORT_SPEED_400G = @ };
