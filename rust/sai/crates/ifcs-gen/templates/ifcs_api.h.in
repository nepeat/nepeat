enum {                                 /* ifcs_devport_stats_id_e (subset) */
    IFCS_DEVPORT_STATS_ID_RX_FRAMES_DROP = @, IFCS_DEVPORT_STATS_ID_RX_FRAMES_UNICAST = @,
    IFCS_DEVPORT_STATS_ID_RX_FRAMES_MULTICAST = @, IFCS_DEVPORT_STATS_ID_RX_FRAMES_BROADCAST = @,
    IFCS_DEVPORT_STATS_ID_RX_FRAMES_ERR_ANY = @, IFCS_DEVPORT_STATS_ID_RX_BYTES_ALL = @,
    IFCS_DEVPORT_STATS_ID_TX_FRAMES_DROP = @, IFCS_DEVPORT_STATS_ID_TX_FRAMES_UNICAST = @,
    IFCS_DEVPORT_STATS_ID_TX_FRAMES_MULTICAST = @, IFCS_DEVPORT_STATS_ID_TX_FRAMES_BROADCAST = @,
