enum {                                 /* ifcs_intf_stats_id_e (subset) */
    IFCS_INTF_STATS_ID_L3INTF_INGRESS_PKTS = @, IFCS_INTF_STATS_ID_L3INTF_INGRESS_BYTES = @,
    IFCS_INTF_STATS_ID_L3INTF_INGRESS_UCAST_PKTS = @, IFCS_INTF_STATS_ID_L3INTF_INGRESS_UCAST_BYTES = @,
