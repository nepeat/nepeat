enum { IFCS_L2_ENTRY_TYPE_STATIC = @, IFCS_L2_ENTRY_TYPE_DYNAMIC = @ };

enum { IFCS_NETDEV_ATTR_INTF_NAME = @, IFCS_NETDEV_ATTR_DEVPORTNUM = @, IFCS_NETDEV_ATTR_MACADDR = @,
       IFCS_NETDEV_ATTR_VLAN_TAG = @ };
enum { IFCS_NETDEV_VLAN_TAG_ACTION_VLAN_TAG_ORIGINAL = @, IFCS_NETDEV_VLAN_TAG_ACTION_VLAN_TAG_STRIP = @,
       IFCS_NETDEV_VLAN_TAG_ACTION_VLAN_TAG_KEEP = @ };

enum { IFCS_INTF_ATTR_TYPE = @, IFCS_INTF_ATTR_FORWARDING_INSTANCE = @, IFCS_INTF_ATTR_TRANSPORT_INSTANCE = @,
       IFCS_INTF_ATTR_TRANSPORT_MAC = @, IFCS_INTF_ATTR_IPV4_UNICAST_ENABLE = @, IFCS_INTF_ATTR_IPV6_UNICAST_ENABLE = @,
       IFCS_INTF_ATTR_MTU = @ };
