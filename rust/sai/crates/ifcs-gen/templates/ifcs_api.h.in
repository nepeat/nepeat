    IFCS_DEVPORT_ATTR_LINK_STATUS = @, IFCS_DEVPORT_ATTR_FEC_MODE = @, IFCS_DEVPORT_ATTR_LOOPBACK = @,
    IFCS_DEVPORT_ATTR_AUTO_NEG = @, IFCS_DEVPORT_ATTR_LINK_TRAINING = @, IFCS_DEVPORT_ATTR_ADMIN_STATE = @,
    IFCS_DEVPORT_ATTR_TX_EQ_PRE1 = @, IFCS_DEVPORT_ATTR_TX_EQ_PRE2 = @, IFCS_DEVPORT_ATTR_TX_EQ_PRE3 = @,
    IFCS_DEVPORT_ATTR_TX_EQ_ATTN = @, IFCS_DEVPORT_ATTR_TX_EQ_POST = @, IFCS_DEVPORT_ATTR_RX_EQ_FINE_TUNE = @,
