};

enum { IFCS_STP_PORT_ATTR_STP_STATE = @ };
enum { IFCS_STP_PORT_STATE_BLOCKING = @, IFCS_STP_PORT_STATE_FORWARDING = @ };
enum { IFCS_MC_DEST_ATTR_LOCAL_DESTINATION = @ };
