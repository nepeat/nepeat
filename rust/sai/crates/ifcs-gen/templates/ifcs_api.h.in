    IFCS_NODE_ATTR_ENTROPY_SEED = @,                     /* u32 */
    IFCS_NODE_ATTR_MULTICAST_LAG_RESOLUTION_ENABLE = @,  /* data */
    IFCS_NODE_ATTR_ENTROPY_SELECT_IPV4_TCP_OR_UDP = @,   /* handle: extended field list */
    IFCS_NODE_ATTR_ENTROPY_SELECT_IPV4_NON_TCP_OR_UDP = @,
    IFCS_NODE_ATTR_ENTROPY_SELECT_IPV6_TCP_OR_UDP = @,
    IFCS_NODE_ATTR_ENTROPY_SELECT_IPV6_NON_TCP_OR_UDP = @,
    IFCS_NODE_ATTR_ENTROPY_SELECT_NON_IP = @,
};
enum {                                 /* ifcs_extended_field_e */
    IFCS_EXTENDED_FIELD_MAC_DA = @, IFCS_EXTENDED_FIELD_MAC_SA = @, IFCS_EXTENDED_FIELD_SVID = @,
    IFCS_EXTENDED_FIELD_CVID = @, IFCS_EXTENDED_FIELD_ETHERTYPE = @, IFCS_EXTENDED_FIELD_IPV4_DESTINATION_IP = @,
    IFCS_EXTENDED_FIELD_IPV4_SOURCE_IP = @, IFCS_EXTENDED_FIELD_IPV4_PROTOCOL = @,
    IFCS_EXTENDED_FIELD_IPV6_DESTINATION_IP = @, IFCS_EXTENDED_FIELD_IPV6_SOURCE_IP = @,
    IFCS_EXTENDED_FIELD_IPV6_NEXTHEADER = @, IFCS_EXTENDED_FIELD_IPV6_FLOW_LABEL = @,
    IFCS_EXTENDED_FIELD_TCP_OR_UDP_SOURCE_PORT = @, IFCS_EXTENDED_FIELD_TCP_OR_UDP_DESTINATION_PORT = @,
    IFCS_EXTENDED_FIELD_SOURCE_SYSPORT = @, IFCS_EXTENDED_FIELD_MAX = @,
};
enum { IFCS_EXTENDED_FIELD_LIST_ATTR_ELEMENTS = @ };      /* u32_list */

/* ------------------------------------- user ACLs, CPU queues, port counters
 * pyctypes 0.12.41; call forms: isai 6.2.0 on this chip (oracle acl,
 * hostif-counters, 2026-11-16). One node-scope table per SAI ACL table,
 * PORT_SHARING profile, the ACL bound to ports with ifcs_acl_port_add. */
enum {                                 /* ifcs_acl_match_type_e, more */
    IFCS_ACL_MATCH_TYPE_INGRESS_SYSPORT = @, IFCS_ACL_MATCH_TYPE_INGRESS_L2_INTERFACE = @,
