# Switch bring-up: create with attributes, what orchagent reads at init, set/get, capacity
# attributes, temperatures, remove and create again.
profile SAI_OPENBCM_FAKE_PORTS=4
switch SRC_MAC_ADDRESS=02:11:22:33:44:55 FDB_AGING_TIME=300
get switch switch PORT_NUMBER CPU_PORT PORT_LIST DEFAULT_VLAN_ID DEFAULT_VIRTUAL_ROUTER_ID DEFAULT_1Q_BRIDGE_ID
get switch switch DEFAULT_STP_INST_ID DEFAULT_TRAP_GROUP SRC_MAC_ADDRESS FDB_AGING_TIME
get switch switch PORT_LIST
set switch switch SRC_MAC_ADDRESS=02:00:00:00:aa:01
get switch switch SRC_MAC_ADDRESS
set switch switch FDB_AGING_TIME=600
get switch switch FDB_AGING_TIME
set switch switch ECMP_DEFAULT_HASH_SEED=1234
get switch switch ECMP_DEFAULT_HASH_SEED
get switch switch ECMP_HASH
get switch switch ACL_ENTRY_MINIMUM_PRIORITY ACL_ENTRY_MAXIMUM_PRIORITY MAX_ACL_ACTION_COUNT
get switch switch NUMBER_OF_ECMP_GROUPS ECMP_MEMBERS MAX_ECMP_MEMBER_COUNT TOTAL_BUFFER_SIZE
get switch switch AVAILABLE_IPV4_ROUTE_ENTRY AVAILABLE_IPV6_ROUTE_ENTRY AVAILABLE_IPV4_NEXTHOP_ENTRY AVAILABLE_FDB_ENTRY
get switch switch AVAILABLE_IPV4_NEIGHBOR_ENTRY AVAILABLE_IPV6_NEIGHBOR_ENTRY AVAILABLE_NEXT_HOP_GROUP_ENTRY
get switch switch MAX_NUMBER_OF_TEMP_SENSORS TEMP_LIST MAX_TEMP AVERAGE_TEMP
set switch switch MAX_TEMP=1
remove_switch
switch
get switch switch NUMBER_OF_ACTIVE_PORTS
remove_switch
